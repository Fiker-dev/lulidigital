{
  "crons": [
    {
      "path": "/api/cron/seo-agent",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/weekly-seo",
      "schedule": "15 4 * * 1"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.lulidigital.com"
        }
      ],
      "destination": "https://lulidigital.com/:path*",
      "permanent": true
    }
  ]
}

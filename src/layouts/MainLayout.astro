---
import "../styles/global.css";

const { title = "LuliDigital", description = "LuliDigital — Digital Studio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <div class="page">
      <header class="masthead">
        <div class="masthead__topline">
          <div class="masthead__kicker">LULIDIGITAL TIMES · EDITION 001</div>
        </div>

        <div class="masthead__brand">
          <a class="brand" href="/">
            <div class="brand__name">
              <span class="brand__luli">Luli</span><span class="brand__digital">Digital</span>
            </div>
            <div class="brand__sub">DIGITAL STUDIO</div>
          </a>
        </div>

        <nav class="nav">
          <a class="nav__link" href="/">HOME</a>
          <a class="nav__link" href="/marketing">MARKETING</a>
          <a class="nav__link" href="/ai">AI</a>
          <a class="nav__link" href="/virtual-assistant">VIRTUAL ASSISTANT</a>
          <a class="nav__link" href="/contact">CONTACT</a>
        </nav>
      </header>

      <main class="content">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer__rule"></div>
        <div class="footer__copy">© 2026 LULIDIGITAL</div>
      </footer>
    </div>

    <!-- Scroll Highlight Script -->
    <script is:inline>
      const keywords = document.querySelectorAll(".kw");

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.intersectionRatio >= 0.6) {
              entry.target.classList.add("is-on");
            } else {
              entry.target.classList.remove("is-on");
            }
          });
        },
        { threshold: [0, 0.6] }
      );

      keywords.forEach((el) => observer.observe(el));
    </script>

    <style is:global>
      :root {
        --red: #b01616;
        --soft-red: rgba(176, 22, 22, 0.10);
        --red-line: rgba(176, 22, 22, 0.45);
        --rule: rgba(17, 17, 17, 0.15);
        --muted: rgba(17, 17, 17, 0.6);
      }

      body {
        background: #f4efe8;
        color: #111;
        font-family: Georgia, "Times New Roman", serif;
      }

      .brand__luli {
        color: var(--red);
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .brand__digital {
        color: #111;
      }

      .nav__link {
        position: relative;
        margin: 0 16px;
        text-decoration: none;
        color: #111;
        letter-spacing: 0.15em;
        font-size: 13px;
      }

      .nav__link::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -6px;
        height: 1px;
        width: 100%;
        background: var(--red-line);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 300ms ease;
      }

      .nav__link:hover::after {
        transform: scaleX(1);
      }

      .footer__rule {
        height: 1px;
        background: var(--rule);
        margin: 40px 0 20px;
      }

      .footer__copy {
        text-align: center;
        font-size: 12px;
        color: var(--muted);
        letter-spacing: 0.2em;
      }

      /* KEYWORD HIGHLIGHT */
      .kw {
        position: relative;
        padding: 0 2px;
        background: transparent;
        transition: background 600ms ease;
      }

      .kw::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -2px;
        height: 2px;
        width: 100%;
        background: var(--red-line);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 600ms ease;
      }

      .kw.is-on {
        background: var(--soft-red);
      }

      .kw.is-on::after {
        transform: scaleX(1);
      }
    </style>
  </body>
</html>
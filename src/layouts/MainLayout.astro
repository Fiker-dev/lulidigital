---
import "../styles/global.css";

const { title = "LuliDigital", description = "LuliDigital — Digital Studio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <div class="page">
      <header class="masthead">
        <div class="masthead__topline">
          <div class="masthead__kicker">PERFORMANCE MARKETING · AI AUTOMATION · EXECUTIVE SUPPORT</div>
        </div>

        <div class="masthead__brand">
          <a class="brand" href="/">
            <div class="brand__name">
              <span class="brand__luli">Luli</span><span class="brand__digital">Digital</span>
            </div>
            <div class="brand__sub">DIGITAL STUDIO</div>
          </a>
        </div>

        <nav class="nav">
          <a class="nav__link" href="/">HOME</a>
          <a class="nav__link" href="/marketing">MARKETING</a>
          <a class="nav__link" href="/ai">AI</a>
          <a class="nav__link" href="/virtual-assistant">VIRTUAL ASSISTANT</a>
          <a class="nav__link" href="/contact">CONTACT</a>
        </nav>
      </header>

      <main class="content">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer__rule"></div>
        <div class="footer__copy">© 2026 LULIDIGITAL</div>
      </footer>
    </div>

    <!-- Scroll Highlight Script -->
    <script is:inline>
      (() => {
        const els = Array.from(document.querySelectorAll('[data-kw].kw'));
        if (!('IntersectionObserver' in window) || els.length === 0) {
          els.forEach(el => el.setAttribute('data-kw-on','true'));
          return;
        }
        const obs = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && entry.intersectionRatio >= 0.4) {
              // Force a paint with the "off" state before switching on
              requestAnimationFrame(() => {
                entry.target.setAttribute("data-kw-on", "true");
              });

              // Animate once only
              obs.unobserve(entry.target);
            }
            if (entry.isIntersecting && entry.intersectionRatio >= 0.4) {
              // Force a paint with the "off" state before switching on
              requestAnimationFrame(() => {
                entry.target.setAttribute("data-kw-on", "true");
              });

              // Animate once only
              obs.unobserve(entry.target);
            }
          }
        }, { threshold: 0.35, rootMargin: '0px 0px -12% 0px' });

        els.forEach(el => obs.observe(el));
      })();
    </script>

    <style is:global>
      :root {
        --red: #7f1a1a;
        --soft-red: rgba(127, 26, 26, 0.18);
        --red-line: rgba(127, 26, 26, 0.78);
        --rule: rgba(17, 17, 17, 0.15);
        --muted: rgba(17, 17, 17, 0.6);
      }

      body {
        background: #f4efe8;
        color: #111;
        font-family: Georgia, "Times New Roman", serif;
      }

      .brand__luli {
        color: var(--red);
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .brand__digital {
        color: #000;
      }

      .nav__link {
        position: relative;
        margin: 0 16px;
        text-decoration: none;
        color: #111;
        letter-spacing: 0.15em;
        font-size: 13px;
      }

      .nav__link::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -6px;
        height: 1px;
        width: 100%;
        background: var(--red-line);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 300ms ease;
      }

      .nav__link:hover::after {
        transform: scaleX(1);
      }

      .footer__rule {
        height: 1px;
        background: var(--rule);
        margin: 40px 0 20px;
      }

      .footer__copy {
        text-align: center;
        font-size: 12px;
        color: var(--muted);
        letter-spacing: 0.2em;
      }

      /* keyword highlight — soft wine wash behind text, animates on scroll */
      .kw[data-kw] {
        position: relative;
        display: inline;
        text-decoration: none !important;
        z-index: 0;
      }

      .kw[data-kw]::before {
        content: "";
        position: absolute;
        left: -0.08em;
        right: -0.08em;
        bottom: 0.05em;
        height: 0.9em;
        background: rgba(127, 26, 26, 0.16); /* muted wine wash */
        border-radius: 999px;
        transform: scaleX(0); /* start collapsed */
        transform-origin: left center;
        transition: transform 600ms cubic-bezier(.19,1,.22,1);
        z-index: -1;
      }

      .kw[data-kw][data-kw-on="true"]::before {
        transform: scaleX(1);
      }

      @media (prefers-reduced-motion: reduce) {
        .kw[data-kw]::before,
        .kw[data-kw][data-kw-on="true"]::before {
          transition: none;
          transform: scaleX(1);
        }
      }

    </style>
  </body>
</html>

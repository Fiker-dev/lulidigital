---
import "../styles/theme.css";
import SiteHeader from "../components/SiteHeader.astro";
import LanaChat from "../components/LanaChat.astro";

const {
  title = "LuliDigital",
  description = "LuliDigital — Digital Studio",
  active = "",
  canonicalPath,
} = Astro.props;

const siteUrl = "https://lulidigital.com";
const currentPath = canonicalPath ?? Astro.url.pathname;
const normalizedPath = currentPath === "/" ? "/" : currentPath.replace(/\/+$/, "");
const canonicalUrl = new URL(normalizedPath, siteUrl).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="google-site-verification" content="xbGV7pvPZoypa6X-2gd1dI1AeDPSke4sn0gCtwTS80Y" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "LuliDigital",
      "url": "https://lulidigital.com",
      "description": "The operations partner for founders and executives in the UK, Canada, UAE, and Australia. Virtual assistant, digital marketing, and AI — built to give your time back and your business an edge.",
      "email": "info@lulidigital.co.za",
      "telephone": "+27602551513",
      "areaServed": [
        { "@type": "Country", "name": "United Kingdom" },
        { "@type": "Country", "name": "Canada" },
        { "@type": "Country", "name": "United Arab Emirates" },
        { "@type": "Country", "name": "Australia" },
        { "@type": "Country", "name": "South Africa" }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "LuliDigital Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Executive Virtual Assistant",
              "description": "For founders and CEOs in the UK, Canada, Dubai, and Australia who are done being the bottleneck. Inbox managed. Calendar protected. Operations running without you holding it up."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Digital Marketing",
              "description": "Premium brand architecture for executives in the UK, Canada, UAE, and Australia. We shape the story, run the paid media, and make sure the right people find you."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "AI Integration for Business",
              "description": "Your business shouldn't need you to answer the same question twice. AI systems for founders and executives in the UK, Canada, Dubai, and Australia. Smarter operations. More of your time back."
            }
          }
        ]
      }
    }
    </script>
  </head>

  <body>
    <SiteHeader active={active} />
    <main class="page">
      <slot />
    </main>
    <LanaChat />
  </body>
</html>

<style>
  .page{
    max-width: var(--max);
    margin: 0 auto;
    padding: 26px 20px 88px;
  }
</style>

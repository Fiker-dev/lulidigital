---
import "../styles/theme.css";
import "../styles/motion.css";
import SiteHeader from "../components/SiteHeader.astro";
import LanaChat from "../components/LanaChat.astro";

const {
  title = "LuliDigital",
  description = "LuliDigital — Digital Studio",
  active = "",
  canonicalPath,
  serviceSchema,
  localBusinessSchema,
  organizationSchemaOverride,
  hreflangLinks = [],
} = Astro.props;

const siteUrl = "https://lulidigital.com";
const currentPath = canonicalPath ?? Astro.url.pathname;
const normalizedPath = currentPath === "/" ? "/" : currentPath.replace(/\/+$/, "");
const canonicalUrl = new URL(normalizedPath, siteUrl).toString();
const pageName = title.replace(/\s+[—–-]\s+LuliDigital$| · LuliDigital$/, "");
const breadcrumbSegments = normalizedPath === "/" ? [] : normalizedPath.split("/").filter(Boolean);
const breadcrumbSchema = breadcrumbSegments.length > 0 ? {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${siteUrl}/`,
    },
    ...breadcrumbSegments.map((segment, index) => {
      const path = `/${breadcrumbSegments.slice(0, index + 1).join("/")}`;

      return {
        "@type": "ListItem",
        "position": index + 2,
        "name": segment
          .split("-")
          .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
          .join(" "),
        "item": new URL(path, siteUrl).toString(),
      };
    }),
  ],
} : null;

const organizationSchema = {
  "@type": "ProfessionalService",
  "@id": `${siteUrl}/#organization`,
  "name": "LuliDigital",
  "url": siteUrl,
  "description": "Digital operations studio providing executive virtual assistant support, digital marketing, paid media, SEO, and AI automation services for founders, CEOs, and growing businesses.",
  "email": "info@lulidigital.co.za",
  "telephone": "+27602551513",
  "areaServed": [
    { "@type": "Country", "name": "United Kingdom" },
    { "@type": "Country", "name": "Canada" },
    { "@type": "Country", "name": "United Arab Emirates" },
    { "@type": "Country", "name": "Australia" },
    { "@type": "Country", "name": "South Africa" },
  ],
  "knowsAbout": [
    "executive virtual assistant services",
    "remote administrative support",
    "AI automation for business",
    "AI integration services",
    "digital marketing services",
    "paid media",
    "SEO services",
    "brand strategy",
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "LuliDigital Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Executive Virtual Assistant Services",
          "description": "Remote executive assistant support for founders and CEOs, including inbox management, calendar support, admin operations, follow-ups, and project coordination.",
        },
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Digital Marketing Services",
          "description": "Small business digital marketing, brand strategy, paid media, SEO, campaign planning, and content systems for growing businesses.",
        },
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "AI Integration and Automation Services",
          "description": "AI assistants, workflow automation, AI chatbot support, agent systems, and practical AI integration for business operations.",
        },
      },
    ],
  },
};

const resolvedOrganizationSchema = {
  ...organizationSchema,
  ...(organizationSchemaOverride ?? {}),
  "@id": `${siteUrl}/#organization`,
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "LuliDigital",
  "publisher": { "@id": `${siteUrl}/#organization` },
};

const webpageSchema = {
  "@type": "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  "url": canonicalUrl,
  "name": pageName,
  "description": description,
  "isPartOf": { "@id": `${siteUrl}/#website` },
  "about": { "@id": `${siteUrl}/#organization` },
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    resolvedOrganizationSchema,
    websiteSchema,
    webpageSchema,
    breadcrumbSchema,
    localBusinessSchema ? {
      "@type": "LocalBusiness",
      "@id": `${canonicalUrl}#localbusiness`,
      "url": canonicalUrl,
      ...localBusinessSchema,
    } : null,
    serviceSchema ? {
      "@type": "Service",
      "provider": { "@id": `${siteUrl}/#organization` },
      "url": canonicalUrl,
      "mainEntityOfPage": { "@id": `${canonicalUrl}#webpage` },
      ...serviceSchema,
    } : null,
  ].filter(Boolean),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="google-site-verification" content="xbGV7pvPZoypa6X-2gd1dI1AeDPSke4sn0gCtwTS80Y" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="LuliDigital" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <SiteHeader active={active} />
    <main class="page">
      <slot />
    </main>
    <LanaChat />
  </body>
</html>

<style>
  :global(html) { scroll-padding-top: 70px; }
  .page{
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 20px 88px;
  }
</style>

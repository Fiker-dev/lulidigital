---
import "../styles/theme.css";
import SiteHeader from "../components/SiteHeader.astro";
import LanaChat from "../components/LanaChat.astro";

const {
  title = "LuliDigital",
  description = "LuliDigital — Digital Studio",
  active = "",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="xbGV7pvPZoypa6X-2gd1dI1AeDPSke4sn0gCtwTS80Y" />
    <title>{title}</title>
  </head>

  <body>
    <SiteHeader active={active} />
    <main class="page">
      <slot />
    </main>
    <LanaChat />
  </body>
</html>

<style>
  .page{
    max-width: var(--max);
    margin: 0 auto;
    padding: 26px 20px 88px;
  }
</style>

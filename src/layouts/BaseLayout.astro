---
import "../styles/theme.css";
import "../styles/motion.css";
import SiteHeader from "../components/SiteHeader.astro";
import LanaChat from "../components/LanaChat.astro";

const {
  title = "LuliDigital",
  description = "LuliDigital — Digital Studio",
  active = "",
  canonicalPath,
  serviceSchema,
  localBusinessSchema,
  organizationSchemaOverride,
  extraSchemas = [],
  ogType = "website",
  hreflangLinks = [],
  showBee = true,
} = Astro.props;

const siteUrl = "https://lulidigital.com";
const currentPath = canonicalPath ?? Astro.url.pathname;
const normalizedPath = currentPath === "/" ? "/" : currentPath.replace(/\/+$/, "");
const canonicalUrl = new URL(normalizedPath, siteUrl).toString();
const pageName = title.replace(/\s+[—–-]\s+LuliDigital$| · LuliDigital$/, "");
const breadcrumbSegments = normalizedPath === "/" ? [] : normalizedPath.split("/").filter(Boolean);
const breadcrumbSchema = breadcrumbSegments.length > 0 ? {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${siteUrl}/`,
    },
    ...breadcrumbSegments.map((segment, index) => {
      const path = `/${breadcrumbSegments.slice(0, index + 1).join("/")}`;

      return {
        "@type": "ListItem",
        "position": index + 2,
        "name": segment
          .split("-")
          .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
          .join(" "),
        "item": new URL(path, siteUrl).toString(),
      };
    }),
  ],
} : null;

const organizationSchema = {
  "@type": "ProfessionalService",
  "@id": `${siteUrl}/#organization`,
  "name": "LuliDigital",
  "url": siteUrl,
  "logo": `${siteUrl}/favicon.png`,
  "description": "Digital operations studio providing executive virtual assistant support, digital marketing, paid media, SEO, and AI automation services for founders, CEOs, and growing businesses.",
  "email": "info@lulidigital.co.za",
  "telephone": "+27602551513",
  "areaServed": [
    { "@type": "Country", "name": "United Kingdom" },
    { "@type": "Country", "name": "Canada" },
    { "@type": "Country", "name": "United Arab Emirates" },
    { "@type": "Country", "name": "Australia" },
    { "@type": "Country", "name": "South Africa" },
  ],
  "knowsAbout": [
    "executive virtual assistant services",
    "remote administrative support",
    "AI automation for business",
    "AI integration services",
    "digital marketing services",
    "paid media",
    "SEO services",
    "brand strategy",
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "LuliDigital Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Executive Virtual Assistant Services",
          "description": "Remote executive assistant support for founders and CEOs, including inbox management, calendar support, admin operations, follow-ups, and project coordination.",
        },
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Digital Marketing Services",
          "description": "Small business digital marketing, brand strategy, paid media, SEO, campaign planning, and content systems for growing businesses.",
        },
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "AI Integration and Automation Services",
          "description": "AI assistants, workflow automation, AI chatbot support, agent systems, and practical AI integration for business operations.",
        },
      },
    ],
  },
};

const resolvedOrganizationSchema = {
  ...organizationSchema,
  ...(organizationSchemaOverride ?? {}),
  "@id": `${siteUrl}/#organization`,
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "LuliDigital",
  "publisher": { "@id": `${siteUrl}/#organization` },
};

const webpageSchema = {
  "@type": "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  "url": canonicalUrl,
  "name": pageName,
  "description": description,
  "isPartOf": { "@id": `${siteUrl}/#website` },
  "about": { "@id": `${siteUrl}/#organization` },
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    resolvedOrganizationSchema,
    websiteSchema,
    webpageSchema,
    breadcrumbSchema,
    localBusinessSchema ? {
      "@type": "LocalBusiness",
      "@id": `${canonicalUrl}#localbusiness`,
      "url": canonicalUrl,
      ...localBusinessSchema,
    } : null,
    serviceSchema ? {
      "@type": "Service",
      "provider": { "@id": `${siteUrl}/#organization` },
      "url": canonicalUrl,
      "mainEntityOfPage": { "@id": `${canonicalUrl}#webpage` },
      ...serviceSchema,
    } : null,
    ...extraSchemas,
  ].filter(Boolean),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="google-site-verification" content="xbGV7pvPZoypa6X-2gd1dI1AeDPSke4sn0gCtwTS80Y" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="LuliDigital" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <div class="scroll-bar" aria-hidden="true"></div>

    <!-- ══════════════════════════ FLYING BEE GUIDE ═══════════════ -->
    {showBee && (
      <div id="bee-guide" aria-hidden="true">
        <svg class="bee-svg" viewBox="0 0 96 72" xmlns="http://www.w3.org/2000/svg">
          <!-- Wings -->
          <g class="bee-wings">
            <ellipse cx="38" cy="18" rx="21" ry="12"
              fill="rgba(210,235,255,0.65)" stroke="rgba(130,170,230,0.45)" stroke-width="0.8"/>
            <ellipse cx="57" cy="19" rx="17" ry="10"
              fill="rgba(210,235,255,0.55)" stroke="rgba(130,170,230,0.45)" stroke-width="0.8"/>
          </g>
          <!-- Body -->
          <ellipse cx="42" cy="44" rx="23" ry="16" fill="#F5A41F"/>
          <!-- Stripes -->
          <rect x="23" y="31" width="10" height="26" rx="7" fill="rgba(20,10,0,0.72)"/>
          <rect x="37" y="30" width="10" height="28" rx="7" fill="rgba(20,10,0,0.72)"/>
          <rect x="51" y="32" width="8"  height="24" rx="6" fill="rgba(20,10,0,0.72)"/>
          <!-- Body sheen -->
          <ellipse cx="42" cy="44" rx="23" ry="16" fill="none" stroke="#E8991A" stroke-width="1.5" opacity="0.35"/>
          <!-- Fuzzy edge -->
          <ellipse cx="42" cy="44" rx="23" ry="16" fill="none" stroke="#FFC94A" stroke-width="3" opacity="0.12"/>
          <!-- Head -->
          <circle cx="68" cy="42" r="14" fill="#F5A41F"/>
          <circle cx="68" cy="42" r="14" fill="none" stroke="#E8991A" stroke-width="1.2" opacity="0.35"/>
          <!-- Eye -->
          <circle cx="73" cy="37" r="5"   fill="#130C04"/>
          <circle cx="74.5" cy="35.5" r="2" fill="white"/>
          <!-- Smile -->
          <path d="M63 47 Q68 52 74 47" stroke="#130C04" stroke-width="1.8" fill="none" stroke-linecap="round"/>
          <!-- Stinger -->
          <ellipse cx="17" cy="46" rx="6" ry="3" fill="#CC8A10" transform="rotate(-10 17 46)"/>
          <path d="M12 46 L5 49" stroke="#130C04" stroke-width="2.5" stroke-linecap="round"/>
          <!-- Antennae -->
          <path d="M66 29 Q63 17 60 9"  stroke="#130C04" stroke-width="2"   fill="none" stroke-linecap="round"/>
          <circle cx="60" cy="8"  r="3.5" fill="#130C04"/>
          <path d="M72 29 Q75 17 80 10" stroke="#130C04" stroke-width="2"   fill="none" stroke-linecap="round"/>
          <circle cx="80" cy="9"  r="3.5" fill="#130C04"/>
          <!-- Legs -->
          <path d="M30 57 L24 64" stroke="#130C04" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M42 60 L40 68" stroke="#130C04" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M54 57 L59 63" stroke="#130C04" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <!-- Trail dots -->
        <div class="bee-trail">
          <span class="trail-dot t1"></span>
          <span class="trail-dot t2"></span>
          <span class="trail-dot t3"></span>
        </div>
      </div>
    )}

    <SiteHeader active={active} />
    <main class="page">
      <slot />
    </main>
    <LanaChat />
  </body>
</html>

<script>
  const scheduleEnhancements = (callback: () => void) => {
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(callback, { timeout: 1200 });
      return;
    }
    window.setTimeout(callback, 450);
  };

  document.addEventListener("DOMContentLoaded", () => {
    scheduleEnhancements(initEnhancements);
  });

  async function initEnhancements() {
    const [{ initMotion }, { initInkHighlights }] = await Promise.all([
      import("../scripts/motion.js"),
      import("../scripts/inkHighlight.js"),
    ]);

    initMotion();
    initInkHighlights();
    initMagnetic();
    initScrollProgress();
    initBee();
  }

  function initBee() {
    const beeEl = document.getElementById("bee-guide");
    if (!beeEl) return;
    const bee = beeEl as HTMLElement;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const isSmall = window.innerWidth < 700;

    // Current smooth position (in viewport px, fixed coords)
    let cx = isSmall ? 18 : 48;
    let cy = isSmall ? 92 : 120;
    // Target position
    let tx = cx;
    let ty = cy;

    let isLanded  = false;
    let landTimer = 0;
    let lastTilt  = 0;
    let rawScroll = 0;
    let audioCtx: AudioContext | null = null;
    let audioReady = false;
    let lastBuzz = 0;
    let lastPassSignal = 0;

    const unlockAudio = () => {
      if (audioReady) return;
      const AudioCtor = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioCtor) return;
      audioCtx = new AudioCtor();
      audioReady = true;
      playBuzz(0.018, 0.08);
    };

    window.addEventListener("pointerdown", unlockAudio, { once: true, passive: true });

    function playBuzz(volume = 0.026, duration = 0.14) {
      if (!audioReady || !audioCtx || reduced) return;
      const now = audioCtx.currentTime;
      if (now - lastBuzz < 1.2) return;
      lastBuzz = now;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = "sawtooth";
      osc.frequency.setValueAtTime(170, now);
      osc.frequency.linearRampToValueAtTime(235, now + duration * 0.45);
      osc.frequency.linearRampToValueAtTime(150, now + duration);
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(volume, now + 0.018);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + duration + 0.02);
    }

    window.addEventListener("scroll", () => { rawScroll = window.scrollY; }, { passive: true });

    const stops = document.querySelectorAll<HTMLElement>("[data-bee-stop], [data-bee-final]");
    if (stops.length) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const r = (e.target as HTMLElement).getBoundingClientRect();
          const targetIsFinal = (e.target as HTMLElement).hasAttribute("data-bee-final");
          const beeOffset = isSmall ? 34 : 48;
          const leftLanding = r.left - beeOffset;
          const centerLanding = r.left + Math.min(r.width * 0.42, 180);
          tx = Math.max(8, Math.min(targetIsFinal ? centerLanding : leftLanding, window.innerWidth - (isSmall ? 42 : 58)));
          ty = Math.max(isSmall ? 70 : 80, Math.min(r.top + Math.min(34, r.height * 0.28), window.innerHeight - (isSmall ? 74 : 84)));
          isLanded = true;
          bee.classList.add("is-landed");
          playBuzz(targetIsFinal ? 0.035 : 0.024, targetIsFinal ? 0.18 : 0.12);
          clearTimeout(landTimer);
          landTimer = window.setTimeout(() => {
            isLanded = false;
            bee.classList.remove("is-landed");
          }, targetIsFinal ? 3600 : 2200);
        });
      }, { threshold: isSmall ? 0.32 : 0.45, rootMargin: "0px 0px -12% 0px" });
      stops.forEach((s) => io.observe(s));
    }

    function tick(ms: number) {
      if (!isLanded) {
        const docH = document.body.scrollHeight - window.innerHeight;
        const pct  = docH > 0 ? Math.min(rawScroll / docH, 1) : 0;
        ty = (isSmall ? 82 : 100) + pct * (window.innerHeight * (isSmall ? 0.56 : 0.68));
        tx = (isSmall ? 16 : 44) + Math.sin(ms * 0.00050) * (isSmall ? 12 : 28);
      }

      const ease = isLanded ? 0.07 : 0.04;
      cx += (tx - cx) * ease;
      cy += (ty - cy) * ease;

      const tilt = isLanded ? 0 : (Math.cos(ms * 0.00050) > 0 ? 9 : -9);
      lastTilt  += (tilt - lastTilt) * 0.09;

      bee.style.transform = `translate(${cx}px, ${cy}px) rotate(${lastTilt}deg)`;
      if (!reduced && ms - lastPassSignal > 520) {
        lastPassSignal = ms;
        window.dispatchEvent(new CustomEvent("luli:bee-pass", {
          detail: {
            x: cx + (isSmall ? 18 : 24),
            y: cy + (isSmall ? 17 : 21),
            landed: isLanded,
          },
        }));
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  function initMagnetic() {
    document.querySelectorAll<HTMLElement>(".magnetic").forEach((el) => {
      el.addEventListener("mousemove", (ev) => {
        const e = ev as MouseEvent;
        const r = el.getBoundingClientRect();
        const x = (e.clientX - (r.left + r.width  / 2)) * 0.28;
        const y = (e.clientY - (r.top  + r.height / 2)) * 0.28;
        el.style.transform = `translate(${x}px, ${y}px)`;
      });
      el.addEventListener("mouseleave", () => {
        el.style.transform = "";
        el.style.transition = "transform 500ms cubic-bezier(.16,1,.3,1)";
        setTimeout(() => { el.style.transition = ""; }, 500);
      });
    });
  }

  function initScrollProgress() {
    const bar = document.querySelector<HTMLElement>(".scroll-bar");
    if (!bar) return;
    window.addEventListener("scroll", () => {
      const max = document.body.scrollHeight - window.innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
    }, { passive: true });
  }
</script>

<style>
  :global(html) { scroll-padding-top: 70px; overflow-x: clip; }
  :global(body) { overflow-x: hidden; }
  .page {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 20px 88px;
  }
  .scroll-bar {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 2.5px;
    background: var(--brand, #7b2d2d);
    transform-origin: left;
    transform: scaleX(0);
    z-index: 200;
    pointer-events: none;
  }

  /* ── Flying Bee ─────────────────────────────────────────────── */
  #bee-guide {
    position: fixed;
    left: 0; top: 0;           /* origin; JS uses translate() to position */
    z-index: 90;
    pointer-events: none;
    will-change: transform;
    filter: drop-shadow(0 3px 8px rgba(180,120,0,.22));
    transition: filter 400ms ease;
  }
  #bee-guide.is-landed {
    filter: drop-shadow(0 6px 16px rgba(180,120,0,.35));
  }
  .bee-svg {
    width: 40px;               /* smaller */
    height: auto;
    display: block;
  }
  /* Wings flap fast while flying */
  .bee-wings {
    transform-origin: 48px 20px;
    animation: wingFlap 0.15s ease-in-out infinite alternate;
  }
  /* Wings barely move when landed */
  .is-landed .bee-wings {
    animation: wingLanded 1.2s ease-in-out infinite alternate;
  }
  @keyframes wingFlap {
    from { transform: scaleY(1) scaleX(1);   opacity: .9; }
    to   { transform: scaleY(.25) scaleX(.9); opacity: .35; }
  }
  @keyframes wingLanded {
    from { transform: scaleY(.85) scaleX(.95); opacity: .7; }
    to   { transform: scaleY(.65) scaleX(.9);  opacity: .5; }
  }
  /* Landed: gentle body bob */
  .is-landed .bee-svg {
    animation: beeLanded 1.4s ease-in-out infinite;
  }
  @keyframes beeLanded {
    0%,100% { transform: translateY(0); }
    50%     { transform: translateY(-4px); }
  }
  /* Trail dots (only while flying) */
  .bee-trail {
    position: absolute;
    top: 24px; left: -10px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    pointer-events: none;
  }
  .is-landed .bee-trail { opacity: 0; }
  .trail-dot {
    display: block;
    width: 4px; height: 4px;
    border-radius: 50%;
    background: #F5A41F;
    opacity: 0;
    animation: trailFade 0.8s ease-out infinite;
  }
  .t1 { animation-delay: 0s;   width: 4px; height: 4px; }
  .t2 { animation-delay: .16s; width: 3px; height: 3px; }
  .t3 { animation-delay: .32s; width: 2px; height: 2px; }
  @keyframes trailFade {
    0%   { opacity: .6; transform: translateX(4px) translateY(0); }
    100% { opacity: 0;  transform: translateX(12px) translateY(8px); }
  }
  @media (max-width: 699px) {
    #bee-guide { z-index: 75; }
    .bee-svg { width: 32px; }
    .bee-trail { top: 19px; left: -8px; gap: 4px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #bee-guide,
    .bee-wings,
    .is-landed .bee-svg,
    .trail-dot {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

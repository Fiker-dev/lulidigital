---
import "../styles/theme.css";
import SiteHeader from "../components/SiteHeader.astro";
import LanaChat from "../components/LanaChat.astro";

const {
  title = "LuliDigital",
  description = "LuliDigital — Digital Studio",
  active = "",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="xbGV7pvPZoypa6X-2gd1dI1AeDPSke4sn0gCtwTS80Y" />
    <title>{title}</title>
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "LuliDigital",
      "url": "https://lulidigital.com",
      "description": "Digital studio offering virtual assistant, digital marketing, and AI integration services to businesses in the UK, Canada, UAE, Nigeria, and Kenya.",
      "email": "info@lulidigital.co.za",
      "telephone": "+27602551513",
      "areaServed": [
        { "@type": "Country", "name": "United Kingdom" },
        { "@type": "Country", "name": "Canada" },
        { "@type": "Country", "name": "United Arab Emirates" },
        { "@type": "Country", "name": "Nigeria" },
        { "@type": "Country", "name": "Kenya" },
        { "@type": "Country", "name": "South Africa" }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "LuliDigital Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Virtual Assistant Services",
              "description": "Executive and leadership virtual assistant support including inbox management, calendar control, operations, and project coordination for businesses in the UK, Canada, Dubai, Nigeria, and Kenya."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Digital Marketing",
              "description": "Brand strategy, content systems, and paid media campaigns on Meta, Google, and TikTok for businesses in the UK, Canada, UAE, Nigeria, and Kenya."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "AI Integration for Business",
              "description": "Custom AI assistants, chatbots, and workflow automation tools that help businesses in the UK, Canada, Dubai, Nigeria, and Kenya scale intelligently."
            }
          }
        ]
      }
    }
    </script>
  </head>

  <body>
    <SiteHeader active={active} />
    <main class="page">
      <slot />
    </main>
    <LanaChat />
  </body>
</html>

<style>
  .page{
    max-width: var(--max);
    margin: 0 auto;
    padding: 26px 20px 88px;
  }
</style>

---
interface Props {
  operator: string;
  role: string;
  contact: string;
}

const { operator, role, contact } = Astro.props;
---

<section class="verification-page" aria-labelledby="verification-title">
  <header class="verification-head">
    <p class="kicker">PUBLIC NOTICE</p>
    <h1 id="verification-title" class="headline">LuliDigital – Digital Services</h1>
  </header>

  <div class="verification-grid">
    <div class="verification-copy">
      <p class="lede">
        We provide digital marketing, automation, and online business solutions to international clients.
      </p>
    </div>

    <section class="verification-card" aria-label="Business details">
      <dl class="details">
        <div class="detail-row">
          <dt>Operated by</dt>
          <dd>{operator}</dd>
        </div>

        <div class="detail-row">
          <dt>Role</dt>
          <dd>{role}</dd>
        </div>

        <div class="detail-row">
          <dt>Contact</dt>
          <dd>
            <a href={`mailto:${contact}`}>{contact}</a>
          </dd>
        </div>
      </dl>
    </section>
  </div>

  <footer class="verification-footer">
    <div class="footer-rule" aria-hidden="true"></div>
    <p class="footer-copy">© LuliDigital</p>
    <p class="footer-note">Digital marketing and automation services for international clients</p>
  </footer>
</section>

<style>
  .verification-page{
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(40px, 7vw, 78px) 0 32px;
  }

  .verification-head{
    margin-bottom: 32px;
    text-align: left;
  }

  .kicker{
    margin: 0 0 12px;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .headline{
    margin: 0;
    max-width: 13ch;
    font-size: clamp(2.2rem, 4.8vw, 3.9rem);
    line-height: 1;
    letter-spacing: -0.028em;
    color: var(--ink);
  }

  .verification-grid{
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.92fr);
    gap: clamp(28px, 4vw, 48px);
    align-items: start;
    padding: 24px 0 0;
  }

  .lede{
    margin: 0;
    max-width: 34ch;
    font-size: 1.06rem;
    line-height: 1.78;
    color: var(--ink-2);
  }

  .verification-card{
    border: 1px solid var(--rule);
    background: rgba(255, 255, 255, 0.36);
    padding: 18px 20px 0;
  }

  .details{
    margin: 0;
  }

  .detail-row{
    display: grid;
    grid-template-columns: minmax(136px, 150px) minmax(0, 1fr);
    gap: 22px;
    padding: 0 0 16px;
    margin: 0 0 16px;
    border-bottom: 1px solid var(--rule);
  }

  .detail-row:last-child{
    margin-bottom: 0;
    border-bottom: 0;
  }

  dt{
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dd{
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  dd a,
  dd a:visited{
    color: inherit;
    text-decoration-color: rgba(107, 47, 58, 0.35);
  }

  .verification-footer{
    margin-top: 56px;
  }

  .footer-rule{
    height: 1px;
    background: var(--rule);
    margin-bottom: 18px;
  }

  .footer-copy,
  .footer-note{
    margin: 0;
    text-align: center;
  }

  .footer-copy{
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .footer-note{
    margin-top: 8px;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--muted);
  }

  @media (max-width: 720px){
    .verification-grid{
      grid-template-columns: 1fr;
    }

    .verification-card{
      padding-left: 16px;
      padding-right: 16px;
    }

    .detail-row{
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>

---
/**
 * BlogActivities — scroll-reveal + a mini-you "reading companion" that performs
 * a different activity per section, to break up the text and pull readers down.
 *
 * PROTOTYPE: uses the 2D FikerAvatar pose pack as placeholders. To upgrade to the
 * 3D mini-you, drop transparent activity frames into /assets/mini-fiker/ and
 * swap the ACTIVITIES list below (e.g. mop-1..3, coffee-1..2, spill-1..3).
 *
 * Accessibility: honors prefers-reduced-motion (text shows instantly, companion
 * static); the companion is decorative (aria-hidden) and never gates content.
 */
---

<div class="blog-buddy" data-blog-buddy aria-hidden="true">
  <img class="blog-buddy__img" alt="" width="150" height="150" decoding="async" />
</div>

<style>
  /* --- section text-wipe reveal (the "mop reveals the text" effect) --- */
  #post-article.buddy-on > * {
    opacity: 0;
    transform: translateY(16px);
    clip-path: inset(0 100% 0 0);
    transition:
      opacity 0.55s ease,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      clip-path 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform, clip-path;
  }
  #post-article.buddy-on > .buddy-revealed {
    opacity: 1;
    transform: none;
    clip-path: inset(0 0 0 0);
  }

  /* --- the mini-you reading companion --- */
  .blog-buddy {
    position: fixed;
    left: clamp(8px, 3vw, 40px);
    bottom: clamp(8px, 3vw, 32px);
    width: clamp(88px, 14vw, 150px);
    z-index: 40;
    pointer-events: none;
    opacity: 0;
    transform: translateY(12px) scale(0.96);
    transition: opacity 0.5s ease, transform 0.5s ease;
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.18));
  }
  .blog-buddy[data-visible="true"] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .blog-buddy__img {
    width: 100%;
    height: auto;
    display: block;
    animation: buddy-bob 3.2s ease-in-out infinite;
  }
  /* little pop each time she changes activity */
  .blog-buddy--pop .blog-buddy__img {
    animation: buddy-pop 0.5s ease, buddy-bob 3.2s ease-in-out infinite 0.5s;
  }
  @keyframes buddy-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  @keyframes buddy-pop {
    0% { transform: translateY(0) scale(0.7); opacity: 0.4; }
    60% { transform: translateY(-4px) scale(1.08); opacity: 1; }
    100% { transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    #post-article.buddy-on > * {
      opacity: 1 !important;
      transform: none !important;
      clip-path: none !important;
      transition: none !important;
    }
    .blog-buddy__img { animation: none !important; }
    .blog-buddy { transition: none; }
  }
</style>

<script>
  (() => {
    const article = document.getElementById("post-article");
    const buddy = document.querySelector<HTMLElement>("[data-blog-buddy]");
    const img = buddy?.querySelector<HTMLImageElement>(".blog-buddy__img");
    if (!article || !buddy || !img) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Placeholder activities (2D pose pack). Swap for 3D /assets/mini-fiker/ frames later.
    const ROOT = "/assets/fiker-avatar-pack";
    const ACTIVITIES = [
      "coffee", "pointing-right", "thinking", "lightbulb",
      "explaining", "excited", "sitting-perch", "notebook",
    ];
    const src = (pose: string) => `${ROOT}/${pose}.webp`;

    // Preload so pose swaps don't flash.
    ACTIVITIES.forEach((p) => { const i = new Image(); i.src = src(p); });

    article.classList.add("buddy-on");
    img.src = src(ACTIVITIES[0]);

    if (reduce) {
      // Reveal everything, keep a static companion.
      Array.from(article.children).forEach((c) => c.classList.add("buddy-revealed"));
      buddy.setAttribute("data-visible", "true");
      return;
    }

    // 1) Text-wipe reveal for each top-level block.
    const revealIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("buddy-revealed");
            revealIO.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
    );
    Array.from(article.children).forEach((c) => revealIO.observe(c));

    // 2) Companion swaps activity per heading (assign a fixed pose per h2).
    const heads = Array.from(article.querySelectorAll("h2, h3"));
    heads.forEach((h, i) => h.setAttribute("data-activity", ACTIVITIES[i % ACTIVITIES.length]));

    let current = "";
    const setActivity = (pose: string) => {
      if (!pose || pose === current) return;
      current = pose;
      img.src = src(pose);
      buddy.classList.remove("blog-buddy--pop");
      void buddy.offsetWidth; // restart animation
      buddy.classList.add("blog-buddy--pop");
    };

    const activityIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) setActivity(e.target.getAttribute("data-activity") || "");
        });
      },
      { threshold: 0, rootMargin: "-35% 0px -55% 0px" }
    );
    heads.forEach((h) => activityIO.observe(h));

    // Show the companion once the reader is into the article.
    const showIO = new IntersectionObserver(
      (entries) => {
        const inArticle = entries.some((e) => e.isIntersecting);
        buddy.setAttribute("data-visible", inArticle ? "true" : "false");
      },
      { threshold: 0 }
    );
    showIO.observe(article);
  })();
</script>

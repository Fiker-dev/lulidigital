---
---

<!-- backdrop (mobile) -->
<div class="lana-backdrop" data-lana-backdrop aria-hidden="true"></div>

<!-- Persistent chat trigger pill — desktop + mobile -->
<button class="lana-trigger" id="lana-mobile-trigger" type="button" aria-label="Chat with Lana">
  <svg class="lana-trigger__bee" viewBox="0 0 96 72" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <g class="lw"><ellipse cx="38" cy="18" rx="21" ry="12" fill="rgba(210,235,255,.75)"/><ellipse cx="57" cy="19" rx="17" ry="10" fill="rgba(210,235,255,.65)"/></g>
    <ellipse cx="42" cy="44" rx="23" ry="16" fill="#F5A41F"/>
    <rect x="23" y="31" width="10" height="26" rx="7" fill="rgba(20,10,0,.72)"/>
    <rect x="37" y="30" width="10" height="28" rx="7" fill="rgba(20,10,0,.72)"/>
    <rect x="51" y="32" width="8" height="24" rx="6" fill="rgba(20,10,0,.72)"/>
    <circle cx="68" cy="42" r="14" fill="#F5A41F"/>
    <circle cx="73" cy="37" r="5" fill="#130C04"/>
    <circle cx="74.5" cy="35.5" r="1.8" fill="white"/>
  </svg>
  <span class="lana-trigger__label">Chat with Lana</span>
</button>

<div class="lana-chat" data-lana-chat>
  <section class="lana-chat__panel" id="lana-panel" role="dialog" aria-label="Chat with Lana" aria-modal="true">

    <!-- drag handle (mobile only) -->
    <div class="lana-chat__handle" aria-hidden="true"></div>

    <header class="lana-chat__header">
      <div class="lana-chat__identity">
        <!-- Small header bee with wing animation -->
        <div class="lana-hbee" aria-hidden="true">
          <svg viewBox="0 0 96 72" xmlns="http://www.w3.org/2000/svg">
            <g class="lw"><ellipse cx="38" cy="18" rx="21" ry="12" fill="rgba(210,235,255,.65)"/><ellipse cx="57" cy="19" rx="17" ry="10" fill="rgba(210,235,255,.55)"/></g>
            <ellipse cx="42" cy="44" rx="23" ry="16" fill="#F5A41F"/>
            <rect x="23" y="31" width="10" height="26" rx="7" fill="rgba(20,10,0,.72)"/>
            <rect x="37" y="30" width="10" height="28" rx="7" fill="rgba(20,10,0,.72)"/>
            <rect x="51" y="32" width="8" height="24" rx="6" fill="rgba(20,10,0,.72)"/>
            <circle cx="68" cy="42" r="14" fill="#F5A41F"/>
            <circle cx="73" cy="37" r="5" fill="#130C04"/>
            <circle cx="74.5" cy="35.5" r="1.8" fill="white"/>
          </svg>
        </div>
        <div class="lana-chat__nameblock">
          <span class="lana-name">Lana</span>
          <span class="lana-status"><span class="lana-status__dot"></span>online</span>
        </div>
      </div>
      <button class="lana-chat__close" type="button" aria-label="Close chat" data-lana-close>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </header>

    <!-- Messages -->
    <div class="lana-chat__messages" data-lana-messages aria-live="polite"></div>

    <form class="lana-chat__composer" data-lana-form>
      <label class="sr-only" for="lana-input">Ask Lana</label>
      <textarea id="lana-input" name="message" rows="1" maxlength="800"
        placeholder="Ask Lana something…" data-lana-input></textarea>
      <button type="submit" class="lana-chat__send" data-lana-send>Send</button>
    </form>

  </section>
</div>

<script is:inline>
(() => {
  // Bee SVG with named wing group for animation targeting
  const BEE_SVG = '<svg viewBox="0 0 96 72" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><g class="lw"><ellipse cx="38" cy="18" rx="21" ry="12" fill="rgba(210,235,255,.65)"/><ellipse cx="57" cy="19" rx="17" ry="10" fill="rgba(210,235,255,.55)"/></g><ellipse cx="42" cy="44" rx="23" ry="16" fill="#F5A41F"/><rect x="23" y="31" width="10" height="26" rx="7" fill="rgba(20,10,0,.72)"/><rect x="37" y="30" width="10" height="28" rx="7" fill="rgba(20,10,0,.72)"/><rect x="51" y="32" width="8" height="24" rx="6" fill="rgba(20,10,0,.72)"/><circle cx="68" cy="42" r="14" fill="#F5A41F"/><circle cx="73" cy="37" r="5" fill="#130C04"/><circle cx="74.5" cy="35.5" r="1.8" fill="white"/></svg>';

  const MARKET_MAP = {
    "/amsterdam":"Netherlands","/stockholm":"Sweden","/munich":"Germany",
    "/africa":"Africa","/united-states":"United States","/united-kingdom":"United Kingdom",
    "/denmark":"Denmark","/switzerland":"Switzerland","/ireland":"Ireland",
    "/belgium":"Belgium","/norway":"Norway",
  };
  const currentMarket = MARKET_MAP[window.location.pathname] || null;

  let initialized = false;

  const initLanaChat = () => {
    if (initialized) return;
    initialized = true;

    const root      = document.querySelector("[data-lana-chat]");
    const backdrop  = document.querySelector("[data-lana-backdrop]");
    if (!root) return;

    const panel      = root.querySelector("#lana-panel");
    const closeBtn   = root.querySelector("[data-lana-close]");
    const form       = root.querySelector("[data-lana-form]");
    const input      = root.querySelector("[data-lana-input]");
    const messagesEl = root.querySelector("[data-lana-messages]");
    const sendBtn    = root.querySelector("[data-lana-send]");

    const h = new Date().getHours();
    const timeWord = h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";

    const history = [];
    let greetingDone = false;

    // Helpers
    const sleep = (ms) => new Promise(r => setTimeout(r, ms));
    const typeWriter = (el, text, speed) => new Promise(resolve => {
      let i = 0;
      const tick = () => {
        if (i < text.length) {
          el.textContent += text[i++];
          messagesEl.scrollTop = messagesEl.scrollHeight;
          setTimeout(tick, speed ?? (text.length > 60 ? 18 : 24));
        } else { resolve(); }
      };
      tick();
    });

    const localFallback = (msg) => {
      const q = msg.toLowerCase();
      if (q.includes("contact")||q.includes("email")||q.includes("whatsapp"))
        return "You can reach the team at info@lulidigital.com or WhatsApp +27 60 255 1513.";
      if (q.includes("marketing")||q.includes("brand")||q.includes("ads"))
        return "The Marketing Desk handles positioning, creative direction, and paid media.";
      if (q.includes("ai")||q.includes("chatbot")||q.includes("automation"))
        return "The AI Desk builds assistants and workflows that keep things moving.";
      if (q.includes("virtual assistant")||q.includes("va")||q.includes("operations"))
        return "The VA Desk covers operations, inbox, calendar, and project coordination.";
      return "LuliDigital helps with Marketing, AI, and Virtual Assistant Desk support.";
    };

    const makeBeeAvatar = (animate) => {
      const av = document.createElement("div");
      av.className = "lana-av" + (animate ? " lana-av--think" : "");
      av.innerHTML = BEE_SVG;
      return av;
    };

    const makeBeeRow = (animateAvatar) => {
      const row = document.createElement("div");
      row.className = "lana-msg-row";
      const bubble = document.createElement("article");
      bubble.className = "lana-msg lana-msg--bot";
      row.appendChild(makeBeeAvatar(animateAvatar));
      row.appendChild(bubble);
      return { row, bubble };
    };

    const appendUserMsg = (content) => {
      const el = document.createElement("article");
      el.className = "lana-msg lana-msg--user";
      el.textContent = content;
      messagesEl.appendChild(el);
      messagesEl.scrollTop = messagesEl.scrollHeight;
    };

    const showTyping = () => {
      const row = document.createElement("div");
      row.className = "lana-msg-row lana-typing";
      const bubble = document.createElement("div");
      bubble.className = "lana-msg lana-msg--bot lana-typing__dots";
      bubble.innerHTML = "<span></span><span></span><span></span>";
      row.appendChild(makeBeeAvatar(true));
      row.appendChild(bubble);
      messagesEl.appendChild(row);
      messagesEl.scrollTop = messagesEl.scrollHeight;
    };

    const hideTyping = () => {
      const t = messagesEl.querySelector(".lana-typing");
      if (t) t.remove();
    };

    const setInputLocked = (on) => {
      sendBtn.disabled = on;
      sendBtn.textContent = on ? "…" : "Send";
      input.disabled = on;
    };

    const LEAD_RE    = /\[LEAD:[^\]]*\]/g;
    const CONTACT_RE = /\[CONTACT:reason=([^\]]+)\]/;

    const makeContactActions = () => {
      const wrap = document.createElement("div");
      wrap.className = "lana-contact-actions";
      const emailBtn = document.createElement("a");
      emailBtn.href = "mailto:info@lulidigital.com";
      emailBtn.className = "lana-contact-btn lana-contact-btn--email";
      emailBtn.textContent = "Email us";
      const waBtn = document.createElement("a");
      waBtn.href = "https://wa.me/27602551513";
      waBtn.target = "_blank"; waBtn.rel = "noopener noreferrer";
      waBtn.className = "lana-contact-btn lana-contact-btn--wa";
      waBtn.textContent = "WhatsApp";
      wrap.appendChild(emailBtn); wrap.appendChild(waBtn);
      return wrap;
    };

    const showErrorMsg = () => {
      const { row, bubble } = makeBeeRow(false);
      bubble.textContent = "Experiencing issues — please tap the contact desk.";
      messagesEl.appendChild(row);
      messagesEl.appendChild(makeContactActions());
      messagesEl.scrollTop = messagesEl.scrollHeight;
    };

    const autoSize = () => {
      input.style.height = "auto";
      input.style.height = Math.min(input.scrollHeight, 140) + "px";
    };

    const hbee = root.querySelector(".lana-hbee");

    const setOpen = (open) => {
      panel.classList.toggle("is-open", open);
      if (backdrop) backdrop.classList.toggle("is-open", open);
      panel.setAttribute("aria-hidden", String(!open));
      if (open) {
        input.focus();
        document.body.classList.add("lana-open");
        if (hbee) hbee.classList.add("is-alive");
      } else {
        document.body.classList.remove("lana-open");
        if (hbee) hbee.classList.remove("is-alive");
      }
    };

    const sendMessage = async (text) => {
      const msg = text.trim();
      if (!msg) return;

      appendUserMsg(msg);
      history.push({ role: "user", content: msg });
      input.value = "";
      autoSize();
      setInputLocked(true);
      showTyping();

      let res;
      try {
        res = await fetch("/api/lana", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ messages: history.slice(-14), market: currentMarket }),
        });
      } catch {
        hideTyping();
        showErrorMsg();
        history.push({ role: "assistant", content: "Experiencing issues — please tap the contact desk." });
        setInputLocked(false);
        return;
      }

      hideTyping();

      if (!res.ok) {
        showErrorMsg();
        history.push({ role: "assistant", content: "Experiencing issues — please tap the contact desk." });
        setInputLocked(false);
        return;
      }

      if (res.body) {
        const { row, bubble } = makeBeeRow(false);
        messagesEl.appendChild(row);
        messagesEl.scrollTop = messagesEl.scrollHeight;

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buf = "", fullText = "", leadData = null;

        try {
          outer: while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            buf += decoder.decode(value, { stream: true });
            const parts = buf.split("\n\n");
            buf = parts.pop() ?? "";
            for (const part of parts) {
              if (!part.startsWith("data: ")) continue;
              try {
                const json = JSON.parse(part.slice(6));
                if (typeof json.t === "string") {
                  fullText += json.t;
                  bubble.textContent = fullText
                    .replace(LEAD_RE, "").replace(CONTACT_RE, "")
                    .replace(/\[LEAD:[^\]]*$/, "").replace(/\[CONTACT:[^\]]*$/, "")
                    .trimEnd();
                  messagesEl.scrollTop = messagesEl.scrollHeight;
                } else if (json.done) {
                  leadData = json.lead || null;
                  break outer;
                }
              } catch { /* skip */ }
            }
          }
        } catch { /* stream interrupted */ }

        const displayText = fullText.replace(LEAD_RE,"").replace(CONTACT_RE,"").replace(/\s+/g," ").trim() || localFallback(msg);
        bubble.textContent = displayText;
        history.push({ role: "assistant", content: displayText });

        const contactMatch = fullText.match(CONTACT_RE);
        if (contactMatch) {
          messagesEl.appendChild(makeContactActions());
          messagesEl.scrollTop = messagesEl.scrollHeight;
          fetch("/api/lana-enquiry", {
            method:"POST", headers:{"content-type":"application/json"},
            body: JSON.stringify({ reason: contactMatch[1].trim() }),
          }).catch(() => {});
        }

        if (leadData?.email) {
          fetch("/api/lana-lead", {
            method:"POST", headers:{"content-type":"application/json"},
            body: JSON.stringify(leadData),
          }).catch(() => {});
        }
      } else {
        showErrorMsg();
        history.push({ role: "assistant", content: "Experiencing issues — please tap the contact desk." });
      }

      setInputLocked(false);
      input.focus();
    };

    const runGreeting = async () => {
      if (greetingDone) return;
      greetingDone = true;

      showTyping();
      await sleep(1000);
      hideTyping();

      const line1 = `${timeWord}! I'm Lana.`;
      const { row: r1, bubble: b1 } = makeBeeRow(false);
      messagesEl.appendChild(r1);
      await typeWriter(b1, line1);
      history.push({ role: "assistant", content: line1 });

      await sleep(600);
      showTyping();
      await sleep(950);
      hideTyping();

      const line2 = "I'm here to help — a LuliDigital question, an idea you want to bring to light, a problem to solve, or just curious about what we do. What do you need?";
      const { row: r2, bubble: b2 } = makeBeeRow(false);
      messagesEl.appendChild(r2);
      await typeWriter(b2, line2);
      history.push({ role: "assistant", content: line2 });

      input.focus();
    };

    const mobileTrigger = document.getElementById("lana-mobile-trigger");
    const dispatchClose = () => window.dispatchEvent(new CustomEvent("luli:lana-close"));
    const dispatchOpen  = () => window.dispatchEvent(new CustomEvent("luli:lana-open"));

    window.addEventListener("luli:lana-open", () => {
      setOpen(true);
      if (mobileTrigger) { mobileTrigger.style.opacity="0"; mobileTrigger.style.pointerEvents="none"; }
      runGreeting();
    });
    window.addEventListener("luli:lana-close", () => {
      setOpen(false);
      if (mobileTrigger) { mobileTrigger.style.opacity="1"; mobileTrigger.style.pointerEvents="auto"; }
    });

    if (mobileTrigger) mobileTrigger.addEventListener("click", dispatchOpen);
    closeBtn.addEventListener("click", dispatchClose);
    if (backdrop) backdrop.addEventListener("click", dispatchClose);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && panel.classList.contains("is-open")) dispatchClose();
    });

    form.addEventListener("submit", (e) => { e.preventDefault(); sendMessage(input.value); });
    input.addEventListener("input", autoSize);
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendMessage(input.value); }
    });

    autoSize();

    if (window.__lanaOpenQueued) { window.__lanaOpenQueued = false; dispatchOpen(); }
  };

  // Hide trigger pill while user is reading/scrolling — don't block content
  (() => {
    const pill = document.getElementById("lana-mobile-trigger");
    if (!pill) return;
    let scrollTimer = null;
    let chatOpen = false;
    window.addEventListener("luli:lana-open",  () => { chatOpen = true; });
    window.addEventListener("luli:lana-close", () => { chatOpen = false; });
    window.addEventListener("scroll", () => {
      if (chatOpen) return;
      pill.classList.add("is-scrolling");
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => pill.classList.remove("is-scrolling"), 800);
    }, { passive: true });
  })();

  window.__lanaOpenQueued = false;
  const earlyOpen = () => { window.__lanaOpenQueued = true; };
  window.addEventListener("luli:lana-open", earlyOpen, { once: true });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      window.removeEventListener("luli:lana-open", earlyOpen);
      initLanaChat();
    }, { once: true });
  } else {
    window.removeEventListener("luli:lana-open", earlyOpen);
    initLanaChat();
  }
})();
</script>

<style is:global>
  .sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0; }

  /* ── Wing flap — applied to <g class="lw"> inside any bee SVG ── */
  .lw {
    transform-origin: 48px 22px;
    animation: lanaWing 0.42s ease-in-out infinite alternate;
  }
  @keyframes lanaWing {
    from { transform: scaleY(1); }
    to   { transform: scaleY(0.28); }
  }

  /* ── Bee "thinking" bounce on avatar ────────────────────────── */
  .lana-av--think {
    animation: lanaThink 0.9s ease-in-out infinite;
  }
  @keyframes lanaThink {
    0%,100% { transform: translateY(0); }
    50%      { transform: translateY(-3px); }
  }

  /* ── Trigger pill ────────────────────────────────────────────── */
  .lana-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 195;
    background: #B86B00;
    color: white;
    border: 0;
    border-radius: 28px;
    padding: 9px 16px 9px 10px;
    font-family: var(--font-body, sans-serif);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(184,107,0,.40), 0 1px 3px rgba(0,0,0,.14);
    transition: opacity 280ms ease, transform 200ms ease, background 150ms ease;
  }
  .lana-trigger:hover  { background: #9A5800; transform: translateY(-1px); }
  .lana-trigger:active { transform: scale(0.97); }
  .lana-trigger.is-scrolling {
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px) scale(0.95);
  }
  .lana-trigger__bee  { width: 22px; height: auto; flex-shrink: 0; }
  .lana-trigger__label { white-space: nowrap; }

  @media (max-width: 640px) {
    .lana-trigger {
      padding: 7px 13px 7px 8px;
      font-size: 12px;
      bottom: 16px;
      right: 16px;
    }
    .lana-trigger__bee { width: 19px; }
  }

  /* ── Backdrop ────────────────────────────────────────────────── */
  .lana-backdrop {
    display: none;
    position: fixed; inset: 0;
    background: rgba(12,9,5,.50);
    opacity: 0; pointer-events: none;
    z-index: 205;
    transition: opacity 300ms ease;
  }
  @media (max-width: 640px) {
    .lana-backdrop { display: block; }
    .lana-backdrop.is-open { opacity: 1; pointer-events: auto; }
  }

  /* ── Wrapper ─────────────────────────────────────────────────── */
  .lana-chat {
    position: fixed;
    right: 24px; bottom: 24px;
    z-index: 200;
    pointer-events: none; /* pass-through to trigger pill when panel closed */
  }

  /* ── Panel — desktop bloom ───────────────────────────────────── */
  .lana-chat__panel {
    width: min(360px, calc(100vw - 32px));
    border-radius: 24px;
    border: 1px solid rgba(20,19,18,.10);
    background:
      radial-gradient(ellipse at 80% 0%, rgba(245,164,31,.14) 0%, transparent 50%),
      linear-gradient(175deg, rgba(255,252,240,.99) 0%, rgba(255,244,204,.99) 100%);
    box-shadow:
      0 2px 0 rgba(255,255,255,.8) inset,
      0 32px 64px rgba(0,0,0,.16),
      0 8px 24px rgba(180,120,0,.10);
    overflow: hidden;
    transform: scale(0.88) translateY(12px);
    opacity: 0; visibility: hidden; pointer-events: none;
    transform-origin: right bottom;
    transition:
      transform 360ms cubic-bezier(.16,1,.3,1),
      opacity   260ms ease,
      visibility 0s 360ms;
  }
  .lana-chat__panel.is-open {
    transform: scale(1) translateY(0);
    opacity: 1; visibility: visible; pointer-events: auto;
    transition:
      transform 360ms cubic-bezier(.16,1,.3,1),
      opacity   260ms ease,
      visibility 0s 0s;
  }

  /* ── Panel — mobile bottom sheet ────────────────────────────── */
  @media (max-width: 640px) {
    .lana-chat { right:0; bottom:0; left:0; width:100%; }
    .lana-chat__panel {
      position: fixed;
      bottom:0; left:0; right:0; width:100%;
      max-height: 84vh;
      border-radius: 28px 28px 0 0;
      border-bottom: 0;
      z-index: 210;
      transform-origin: bottom center;
      /* Use transform only on mobile — override desktop opacity/visibility */
      opacity: 1; visibility: visible; pointer-events: none;
      transform: translateY(106%);
      transition: transform 400ms cubic-bezier(.16,1,.3,1);
    }
    .lana-chat__panel.is-open {
      transform: translateY(0);
      pointer-events: auto;
      transition: transform 400ms cubic-bezier(.16,1,.3,1);
    }
  }

  /* ── Drag handle ─────────────────────────────────────────────── */
  .lana-chat__handle {
    display: none;
    width: 36px; height: 4px;
    border-radius: 2px;
    background: rgba(20,19,18,.16);
    margin: 14px auto 0;
  }
  @media (max-width: 640px) { .lana-chat__handle { display: block; } }

  /* ── Header ──────────────────────────────────────────────────── */
  .lana-chat__header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px 0;
  }
  .lana-chat__identity { display: flex; align-items: center; gap: 9px; }
  .lana-chat__nameblock { display: flex; flex-direction: column; gap: 1px; }

  /* ── Header bee (small, wings animated) ─────────────────────── */
  .lana-hbee {
    flex-shrink: 0;
    width: 34px; height: 34px;
    border-radius: 50%;
    background: rgba(245,164,31,.13);
    border: 1.5px solid rgba(245,164,31,.28);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .lana-hbee svg { width: 23px; height: auto; }

  /* Wings dormant until chat opens — overrides global .lw */
  .lana-hbee .lw { animation: none; }
  .lana-hbee.is-alive .lw { animation: lanaWing 0.42s ease-in-out infinite alternate; }

  .lana-name {
    font-family: var(--font-display, Georgia, serif);
    font-size: 18px; font-weight: 600;
    color: rgba(20,19,18,.92);
    letter-spacing: -.01em; line-height: 1;
  }
  .lana-status {
    display: flex; align-items: center; gap: 4px;
    font-size: 10.5px; color: rgba(20,19,18,.44); letter-spacing: .02em;
  }
  .lana-status__dot {
    display: inline-block; width: 6px; height: 6px;
    border-radius: 50%; background: #3dcc7a;
    box-shadow: 0 0 0 2px rgba(61,204,122,.22);
  }
  .lana-chat__close {
    display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px;
    border: 0; background: rgba(20,19,18,.06);
    border-radius: 50%; color: rgba(20,19,18,.50);
    cursor: pointer; transition: background 180ms ease, color 180ms ease;

---
const starters = [
  "What does LuliDigital help with?",
  "Which service is right for me?",
  "How can I contact the desk?",
];
---

<!-- backdrop (mobile only — dims page behind sheet) -->
<div class="lana-backdrop" data-lana-backdrop aria-hidden="true"></div>

<div class="lana-chat" data-lana-chat>
  <section
    class="lana-chat__panel"
    id="lana-panel"
    role="dialog"
    aria-label="Chat with Lana"
    aria-modal="true"
  >
    <!-- drag handle (mobile) -->
    <div class="lana-chat__handle" aria-hidden="true"></div>

    <header class="lana-chat__header">
      <div class="lana-chat__identity">
        <div class="lana-bee-avatar lana-bee-avatar--header" aria-hidden="true">
          <svg viewBox="0 0 96 72" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="38" cy="18" rx="21" ry="12" fill="rgba(210,235,255,.65)"/>
            <ellipse cx="57" cy="19" rx="17" ry="10" fill="rgba(210,235,255,.55)"/>
            <ellipse cx="42" cy="44" rx="23" ry="16" fill="#F5A41F"/>
            <rect x="23" y="31" width="10" height="26" rx="7" fill="rgba(20,10,0,.72)"/>
            <rect x="37" y="30" width="10" height="28" rx="7" fill="rgba(20,10,0,.72)"/>
            <rect x="51" y="32" width="8" height="24" rx="6" fill="rgba(20,10,0,.72)"/>
            <circle cx="68" cy="42" r="14" fill="#F5A41F"/>
            <circle cx="73" cy="37" r="5" fill="#130C04"/>
            <circle cx="74.5" cy="35.5" r="1.8" fill="white"/>
          </svg>
        </div>
        <span class="lana-name">Lana</span>
      </div>
      <button class="lana-chat__close" type="button" aria-label="Close chat" data-lana-close>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </header>

    <div class="lana-chat__messages" data-lana-messages aria-live="polite"></div>

    <div class="lana-chat__starters" data-lana-starters>
      {starters.map((s) => (
        <button type="button" class="lana-chat__starter" data-lana-starter={s}>{s}</button>
      ))}
    </div>

    <form class="lana-chat__composer" data-lana-form>
      <label class="sr-only" for="lana-input">Ask Lana</label>
      <textarea
        id="lana-input"
        name="message"
        rows="1"
        maxlength="800"
        placeholder="Ask Lana something…"
        data-lana-input
      ></textarea>
      <button type="submit" class="lana-chat__send" data-lana-send>Send</button>
    </form>
  </section>
</div>

<script is:inline>
  (() => {
    const BEE_SVG = '<svg viewBox="0 0 96 72" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><ellipse cx="38" cy="18" rx="21" ry="12" fill="rgba(210,235,255,.65)"/><ellipse cx="57" cy="19" rx="17" ry="10" fill="rgba(210,235,255,.55)"/><ellipse cx="42" cy="44" rx="23" ry="16" fill="#F5A41F"/><rect x="23" y="31" width="10" height="26" rx="7" fill="rgba(20,10,0,.72)"/><rect x="37" y="30" width="10" height="28" rx="7" fill="rgba(20,10,0,.72)"/><rect x="51" y="32" width="8" height="24" rx="6" fill="rgba(20,10,0,.72)"/><circle cx="68" cy="42" r="14" fill="#F5A41F"/><circle cx="73" cy="37" r="5" fill="#130C04"/><circle cx="74.5" cy="35.5" r="1.8" fill="white"/></svg>';

    let initialized = false;

    const initLanaChat = () => {
      if (initialized) return;
      initialized = true;

      const root     = document.querySelector("[data-lana-chat]");
      const backdrop = document.querySelector("[data-lana-backdrop]");
      if (!root) return;

      const panel      = root.querySelector("#lana-panel");
      const closeBtn   = root.querySelector("[data-lana-close]");
      const form       = root.querySelector("[data-lana-form]");
      const input      = root.querySelector("[data-lana-input]");
      const messagesEl = root.querySelector("[data-lana-messages]");
      const sendBtn    = root.querySelector("[data-lana-send]");
      const startersEl = root.querySelector("[data-lana-starters]");
      const starters   = Array.from(root.querySelectorAll("[data-lana-starter]"));

      const localFallback = (msg) => {
        const q = msg.toLowerCase();
        if (q.includes("contact") || q.includes("email") || q.includes("whatsapp") || q.includes("phone"))
          return "You can reach the desk on WhatsApp at +27 60 255 1513 or by email at info@lulidigital.com. WhatsApp is usually the fastest.";
        if (q.includes("marketing") || q.includes("brand") || q.includes("ads"))
          return "The Marketing Desk helps with brand positioning, creative direction, and paid media. A good fit for launches, rebrands, and stronger visibility.";
        if (q.includes("ai") || q.includes("chatbot") || q.includes("automation"))
          return "The AI Desk builds chatbots, assistants, and workflows that answer questions and take repetitive work off your team.";
        if (q.includes("virtual assistant") || q.includes("operations") || q.includes("admin"))
          return "The Virtual Assistant Desk supports operations, admin, follow-through, and project coordination.";
        return "LuliDigital helps with Marketing, AI systems, and Virtual Assistant support. Contact the desk on WhatsApp at +27 60 255 1513.";
      };

      const greeting = () => {
        const h = new Date().getHours();
        return `${h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening"}, I'm Lana. I can help you understand what LuliDigital offers, point you to the right desk, or help you reach the team.`;
      };

      const history = [];
      const initialMsg = greeting();
      history.push({ role: "assistant", content: initialMsg });

      const makeBeeRow = (content) => {
        const row = document.createElement("div");
        row.className = "lana-msg-row";
        const avatar = document.createElement("div");
        avatar.className = "lana-bee-avatar";
        avatar.innerHTML = BEE_SVG;
        const bubble = document.createElement("article");
        bubble.className = "lana-chat__message lana-chat__message--assistant";
        bubble.textContent = content;
        row.appendChild(avatar);
        row.appendChild(bubble);
        return row;
      };

      messagesEl.appendChild(makeBeeRow(initialMsg));

      const setOpen = (open) => {
        panel.classList.toggle("is-open", open);
        if (backdrop) backdrop.classList.toggle("is-open", open);
        panel.setAttribute("aria-hidden", String(!open));
        if (open) {
          input.focus();
          document.body.classList.toggle("lana-open", true);
        } else {
          document.body.classList.remove("lana-open");
        }
      };

      const autoSize = () => {
        input.style.height = "auto";
        input.style.height = Math.min(input.scrollHeight, 140) + "px";
      };

      const appendMsg = (role, content) => {
        if (role === "assistant") {
          messagesEl.appendChild(makeBeeRow(content));
        } else {
          const el = document.createElement("article");
          el.className = `lana-chat__message lana-chat__message--${role}`;
          el.textContent = content;
          messagesEl.appendChild(el);
        }
        messagesEl.scrollTop = messagesEl.scrollHeight;
      };

      const showTyping = () => {
        const row = document.createElement("div");
        row.className = "lana-msg-row lana-typing";
        const avatar = document.createElement("div");
        avatar.className = "lana-bee-avatar";
        avatar.innerHTML = BEE_SVG;
        const bubble = document.createElement("div");
        bubble.className = "lana-chat__message lana-chat__message--assistant lana-typing__bubble";
        bubble.innerHTML = "<span></span><span></span><span></span>";
        row.appendChild(avatar);
        row.appendChild(bubble);
        messagesEl.appendChild(row);
        messagesEl.scrollTop = messagesEl.scrollHeight;
      };

      const hideTyping = () => {
        const t = messagesEl.querySelector(".lana-typing");
        if (t) t.remove();
      };

      const setPending = (on) => {
        sendBtn.disabled = on;
        sendBtn.textContent = on ? "…" : "Send";
        input.disabled = on;
        starters.forEach((s) => { s.disabled = on; });
        if (on) showTyping(); else hideTyping();
      };

      const sendMessage = async (text) => {
        const msg = text.trim();
        if (!msg) return;

        if (startersEl && !startersEl.dataset.used) {
          startersEl.dataset.used = "1";
          startersEl.style.display = "none";
        }

        appendMsg("user", msg);
        history.push({ role: "user", content: msg });
        input.value = "";
        autoSize();
        setPending(true);

        try {
          const res  = await fetch("/api/lana", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ messages: history.slice(-14) }),
          });
          const data  = await res.json();
          const reply = res.ok && typeof data.reply === "string" && data.reply.trim()
            ? data.reply.trim()
            : localFallback(msg);
          appendMsg("assistant", reply);
          history.push({ role: "assistant", content: reply });
          // fire lead notification silently if API captured a lead
          if (res.ok && data.lead && data.lead.email) {
            fetch("/api/lana-lead", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify(data.lead),
            }).catch(() => {});
          }
        } catch {
          const fb = localFallback(msg);
          appendMsg("assistant", fb);
          history.push({ role: "assistant", content: fb });
        } finally {
          setPending(false);
        }
      };

      window.addEventListener("luli:lana-open", () => setOpen(true));
      window.addEventListener("luli:lana-close", () => setOpen(false));
      closeBtn.addEventListener("click", () => setOpen(false));
      if (backdrop) backdrop.addEventListener("click", () => setOpen(false));

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && panel.classList.contains("is-open")) setOpen(false);
      });

      form.addEventListener("submit", (e) => { e.preventDefault(); sendMessage(input.value); });
      input.addEventListener("input", autoSize);
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendMessage(input.value); }
      });

      starters.forEach((s) => {
        s.addEventListener("click", () => {
          setOpen(true);
          sendMessage(s.getAttribute("data-lana-starter") || "");
        });
      });

      autoSize();
    };

    const schedule = window.requestIdleCallback
      ? (fn) => window.requestIdleCallback(fn, { timeout: 1800 })
      : (fn) => window.setTimeout(fn, 900);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => schedule(initLanaChat), { once: true });
    } else {
      schedule(initLanaChat);
    }
  })();
</script>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0;
    margin: -1px; overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  /* ── Backdrop (mobile) ───────────────────────────────────────── */
  .lana-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(12, 9, 5, 0.48);
    opacity: 0;
    pointer-events: none;
    z-index: 105;
    transition: opacity 320ms ease;
  }
  @media (max-width: 640px) {
    .lana-backdrop { display: block; }
    .lana-backdrop.is-open { opacity: 1; pointer-events: auto; }
  }

  /* ── Wrapper ─────────────────────────────────────────────────── */
  .lana-chat {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
  }

  /* ── Panel — desktop bloom ───────────────────────────────────── */
  .lana-chat__panel {
    width: min(348px, calc(100vw - 32px));
    border-radius: 24px;
    border: 1px solid rgba(20,19,18,0.12);
    background:
      radial-gradient(ellipse at 80% 0%, rgba(245,164,31,.18) 0%, transparent 55%),
      linear-gradient(175deg, rgba(255,252,240,0.99) 0%, rgba(255,244,204,0.99) 100%);
    box-shadow:
      0 2px 0 rgba(255,255,255,.8) inset,
      0 28px 60px rgba(0,0,0,.14),
      0 8px 24px rgba(180,120,0,.10);
    overflow: hidden;

    transform: scale(0.90) translateY(8px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform-origin: right bottom;
    transition:
      transform 340ms cubic-bezier(.16,1,.3,1),
      opacity   260ms ease,
      visibility 0s   340ms;
  }
  .lana-chat__panel.is-open {
    transform: scale(1) translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      transform 340ms cubic-bezier(.16,1,.3,1),
      opacity   260ms ease,
      visibility 0s 0s;
  }

  /* ── Panel — mobile bottom sheet ────────────────────────────── */
  @media (max-width: 640px) {
    .lana-chat {
      right: 0; bottom: 0;
      left: 0; width: 100%;
    }
    .lana-chat__panel {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      width: 100%;
      max-height: 82vh;
      border-radius: 28px 28px 0 0;
      border-bottom: 0;
      z-index: 110;
      transform-origin: bottom center;
      transform: translateY(105%);
      transition:
        transform  400ms cubic-bezier(.16,1,.3,1),
        visibility 0s   400ms;
    }
    .lana-chat__panel.is-open {
      transform: translateY(0);
      transition:
        transform  400ms cubic-bezier(.16,1,.3,1),
        visibility 0s 0s;
    }
  }

  /* ── Drag handle ─────────────────────────────────────────────── */
  .lana-chat__handle {
    display: none;
    width: 36px; height: 4px;
    border-radius: 2px;
    background: rgba(20,19,18,0.16);
    margin: 14px auto 0;
  }
  @media (max-width: 640px) {
    .lana-chat__handle { display: block; }
  }

  /* ── Header ──────────────────────────────────────────────────── */
  .lana-chat__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px 0;
  }
  .lana-chat__identity {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* ── Bee avatar (header + messages) ─────────────────────────── */
  .lana-bee-avatar {
    flex-shrink: 0;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(245,164,31,0.14);
    border: 1.5px solid rgba(245,164,31,0.30);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .lana-bee-avatar svg {
    width: 22px;
    height: auto;
  }
  .lana-bee-avatar--header {
    width: 36px; height: 36px;
    animation: beeAvatarPulse 2.8s ease-in-out infinite;
  }
  .lana-bee-avatar--header svg {
    width: 24px;
  }
  @keyframes beeAvatarPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(245,164,31,.28); }
    50%       { box-shadow: 0 0 0 5px rgba(245,164,31,.0); }
  }

  .lana-name {
    font-family: var(--serif, Georgia, serif);
    font-size: 22px;
    font-weight: 600;
    color: rgba(20,19,18,0.92);
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .lana-chat__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px; height: 32px;
    border: 0;
    background: rgba(20,19,18,0.06);
    border-radius: 50%;
    color: rgba(20,19,18,0.55);
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease;
  }
  .lana-chat__close:hover {
    background: rgba(20,19,18,0.12);
    color: rgba(20,19,18,0.80);
  }

  /* ── Messages ────────────────────────────────────────────────── */
  .lana-chat__messages {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 280px;
    overflow-y: auto;
    padding: 14px 18px 10px;
    overscroll-behavior: contain;
  }
  @media (max-width: 640px) {
    .lana-chat__messages { max-height: 38vh; }
  }

  /* Row wrapper for bee avatar + assistant bubble */
  .lana-msg-row {
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }
  .lana-msg-row .lana-bee-avatar {
    margin-bottom: 2px;
  }
  .lana-msg-row .lana-chat__message {
    margin: 0;
  }

  .lana-chat__message {
    max-width: 82%;
    padding: 10px 14px;
    border-radius: 16px;
    font-size: 13.5px;
    line-height: 1.5;
    white-space: pre-wrap;
    text-wrap: pretty;
  }
  .lana-chat__message--assistant {
    background: rgba(255,255,255,0.78);
    border: 1px solid rgba(20,19,18,0.07);
    color: rgba(20,19,18,0.88);
    border-bottom-left-radius: 5px;
  }
  .lana-chat__message--user {
    align-self: flex-end;
    margin-left: auto;
    background: rgba(245,164,31,0.18);
    color: rgba(20,19,18,0.90);
    border-bottom-right-radius: 5px;
  }

  /* ── Typing indicator ────────────────────────────────────────── */
  .lana-typing__bubble {
    padding: 12px 18px;
    display: flex;
    gap: 5px;
    align-items: center;
  }
  .lana-typing__bubble span {
    display: block;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: rgba(20,19,18,0.35);
    animation: typingDot 1.2s ease-in-out infinite;
  }
  .lana-typing__bubble span:nth-child(2) { animation-delay: .2s; }
  .lana-typing__bubble span:nth-child(3) { animation-delay: .4s; }
  @keyframes typingDot {
    0%, 60%, 100% { transform: translateY(0); opacity: .35; }
    30%            { transform: translateY(-5px); opacity: 1; }
  }

  /* ── Starters ────────────────────────────────────────────────── */
  .lana-chat__starters {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 4px 18px 12px;
  }
  .lana-chat__starter {
    text-align: left;
    border: 1px solid rgba(20,19,18,0.10);
    background: rgba(255,255,255,0.50);
    border-radius: 12px;
    padding: 9px 13px;
    font-size: 12.5px;
    color: rgba(20,19,18,0.72);
    cursor: pointer;
    transition: background 180ms ease, border-color 180ms ease;
    line-height: 1.35;
  }
  .lana-chat__starter:hover {
    background: rgba(255,255,255,0.85);
    border-color: rgba(245,164,31,0.35);
    color: rgba(20,19,18,0.90);
  }
  .lana-chat__starter:disabled { opacity: 0.5; cursor: not-allowed; }

  /* ── Composer ────────────────────────────────────────────────── */
  .lana-chat__composer {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    padding: 6px 14px 16px;
  }
  .lana-chat__composer textarea {
    resize: none;
    border: 1px solid rgba(20,19,18,0.12);
    border-radius: 14px;
    padding: 11px 14px;
    font: inherit;
    font-size: 13.5px;
    min-height: 44px;
    max-height: 140px;
    background: rgba(255,255,255,0.82);
    color: rgba(20,19,18,0.92);
    outline: none;
    transition: border-color 180ms ease;
  }
  .lana-chat__composer textarea:focus {
    border-color: rgba(245,164,31,0.55);
  }
  .lana-chat__send {
    align-self: flex-end;
    border: 0;
    border-radius: 14px;
    padding: 0 18px;
    height: 44px;
    background: #B86B00;
    color: white;
    font: inherit;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: 0.01em;
    transition: background 180ms ease, opacity 180ms ease;
  }
  .lana-chat__send:hover  { background: #9A5800; }
  .lana-chat__send:disabled { opacity: 0.55; cursor: not-allowed; }
</style>

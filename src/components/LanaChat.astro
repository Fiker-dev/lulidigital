---
const starters = [
  "What does LuliDigital help with?",
  "Which service is right for me?",
  "How can I contact the desk?",
];
---

<!-- backdrop (mobile only — dims page behind sheet) -->
<div class="lana-backdrop" data-lana-backdrop aria-hidden="true"></div>

<!-- Mobile chat trigger — visible only on small screens when chat is closed -->
<button class="lana-mobile-trigger" id="lana-mobile-trigger" type="button" aria-label="Chat with Lana">
  <svg class="lana-trigger-bee" viewBox="0 0 96 72" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <ellipse cx="38" cy="18" rx="21" ry="12" fill="rgba(210,235,255,.7)"/>
    <ellipse cx="57" cy="19" rx="17" ry="10" fill="rgba(210,235,255,.6)"/>
    <ellipse cx="42" cy="44" rx="23" ry="16" fill="#F5A41F"/>
    <rect x="23" y="31" width="10" height="26" rx="7" fill="rgba(20,10,0,.72)"/>
    <rect x="37" y="30" width="10" height="28" rx="7" fill="rgba(20,10,0,.72)"/>
    <rect x="51" y="32" width="8" height="24" rx="6" fill="rgba(20,10,0,.72)"/>
    <circle cx="68" cy="42" r="14" fill="#F5A41F"/>
    <circle cx="73" cy="37" r="5" fill="#130C04"/>
    <circle cx="74.5" cy="35.5" r="1.8" fill="white"/>
  </svg>
  <span class="lana-trigger-label">Chat with Lana</span>
</button>

<div class="lana-chat" data-lana-chat>
  <section
    class="lana-chat__panel"
    id="lana-panel"
    role="dialog"
    aria-label="Chat with Lana"
    aria-modal="true"
  >
    <!-- drag handle (mobile) -->
    <div class="lana-chat__handle" aria-hidden="true"></div>

    <header class="lana-chat__header">
      <div class="lana-chat__identity">
        <div class="lana-bee-avatar lana-bee-avatar--header" aria-hidden="true">
          <svg viewBox="0 0 96 72" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="38" cy="18" rx="21" ry="12" fill="rgba(210,235,255,.65)"/>
            <ellipse cx="57" cy="19" rx="17" ry="10" fill="rgba(210,235,255,.55)"/>
            <ellipse cx="42" cy="44" rx="23" ry="16" fill="#F5A41F"/>
            <rect x="23" y="31" width="10" height="26" rx="7" fill="rgba(20,10,0,.72)"/>
            <rect x="37" y="30" width="10" height="28" rx="7" fill="rgba(20,10,0,.72)"/>
            <rect x="51" y="32" width="8" height="24" rx="6" fill="rgba(20,10,0,.72)"/>
            <circle cx="68" cy="42" r="14" fill="#F5A41F"/>
            <circle cx="73" cy="37" r="5" fill="#130C04"/>
            <circle cx="74.5" cy="35.5" r="1.8" fill="white"/>
          </svg>
        </div>
        <span class="lana-name">Lana</span>
      </div>
      <button class="lana-chat__close" type="button" aria-label="Close chat" data-lana-close>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </header>

    <div class="lana-chat__messages" data-lana-messages aria-live="polite"></div>

    <div class="lana-chat__starters" data-lana-starters>
      {starters.map((s) => (
        <button type="button" class="lana-chat__starter" data-lana-starter={s}>{s}</button>
      ))}
    </div>

    <form class="lana-chat__composer" data-lana-form>
      <label class="sr-only" for="lana-input">Ask Lana</label>
      <textarea
        id="lana-input"
        name="message"
        rows="1"
        maxlength="800"
        placeholder="Ask Lana something…"
        data-lana-input
      ></textarea>
      <button type="submit" class="lana-chat__send" data-lana-send>Send</button>
    </form>
  </section>
</div>

<script is:inline>
  (() => {
    const BEE_SVG = '<svg viewBox="0 0 96 72" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><ellipse cx="38" cy="18" rx="21" ry="12" fill="rgba(210,235,255,.65)"/><ellipse cx="57" cy="19" rx="17" ry="10" fill="rgba(210,235,255,.55)"/><ellipse cx="42" cy="44" rx="23" ry="16" fill="#F5A41F"/><rect x="23" y="31" width="10" height="26" rx="7" fill="rgba(20,10,0,.72)"/><rect x="37" y="30" width="10" height="28" rx="7" fill="rgba(20,10,0,.72)"/><rect x="51" y="32" width="8" height="24" rx="6" fill="rgba(20,10,0,.72)"/><circle cx="68" cy="42" r="14" fill="#F5A41F"/><circle cx="73" cy="37" r="5" fill="#130C04"/><circle cx="74.5" cy="35.5" r="1.8" fill="white"/></svg>';

    // Detect which market page the visitor is on
    const MARKET_MAP = {
      "/amsterdam": "Netherlands", "/stockholm": "Sweden", "/munich": "Germany",
      "/africa": "Africa", "/united-states": "United States",
      "/united-kingdom": "United Kingdom", "/denmark": "Denmark",
      "/switzerland": "Switzerland", "/ireland": "Ireland",
      "/belgium": "Belgium", "/norway": "Norway",
    };
    const currentMarket = MARKET_MAP[window.location.pathname] || null;

    let initialized = false;

    const initLanaChat = () => {
      if (initialized) return;
      initialized = true;

      const root     = document.querySelector("[data-lana-chat]");
      const backdrop = document.querySelector("[data-lana-backdrop]");
      if (!root) return;

      const panel      = root.querySelector("#lana-panel");
      const closeBtn   = root.querySelector("[data-lana-close]");
      const form       = root.querySelector("[data-lana-form]");
      const input      = root.querySelector("[data-lana-input]");
      const messagesEl = root.querySelector("[data-lana-messages]");
      const sendBtn    = root.querySelector("[data-lana-send]");
      const startersEl = root.querySelector("[data-lana-starters]");
      const starters   = Array.from(root.querySelectorAll("[data-lana-starter]"));

      const localFallback = (msg) => {
        const q = msg.toLowerCase();
        if (q.includes("contact") || q.includes("email") || q.includes("whatsapp") || q.includes("phone"))
          return "You can reach the team at info@lulidigital.com or WhatsApp +27 60 255 1513 — WhatsApp is fastest.";
        if (q.includes("marketing") || q.includes("brand") || q.includes("ads"))
          return "The Marketing Desk handles positioning, creative direction, and paid media. Great for launches, rebrands, and growth.";
        if (q.includes("ai") || q.includes("chatbot") || q.includes("automation"))
          return "The AI Desk builds assistants and workflows that keep things moving. Humans stay in control — the AI handles the repetitive work.";
        if (q.includes("virtual assistant") || q.includes("va") || q.includes("operations"))
          return "The VA Desk covers operations, inbox, calendar, and project coordination for leaders who need reliable backup.";
        return "LuliDigital helps with Marketing, AI, and Virtual Assistant Desk support. Tell me a bit about your business and I'll point you in the right direction.";
      };

      const greeting = () => {
        const h = new Date().getHours();
        const time = h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";
        const market = currentMarket;
        if (market) return `${time}, I'm Lana. Tell me what's going on in your business and I'll help you figure out the right next step.`;
        return `${time}, I'm Lana. What brings you here today?`;
      };

      const history = [];
      const initialMsg = greeting();
      history.push({ role: "assistant", content: initialMsg });

      // Create a bee row — returns { row, bubble } so callers can stream into bubble
      const makeBeeRow = () => {
        const row = document.createElement("div");
        row.className = "lana-msg-row";
        const avatar = document.createElement("div");
        avatar.className = "lana-bee-avatar";
        avatar.innerHTML = BEE_SVG;
        const bubble = document.createElement("article");
        bubble.className = "lana-chat__message lana-chat__message--assistant";
        row.appendChild(avatar);
        row.appendChild(bubble);
        return { row, bubble };
      };

      const { row: greetRow, bubble: greetBubble } = makeBeeRow();
      greetBubble.textContent = initialMsg;
      messagesEl.appendChild(greetRow);

      const setOpen = (open) => {
        panel.classList.toggle("is-open", open);
        if (backdrop) backdrop.classList.toggle("is-open", open);
        panel.setAttribute("aria-hidden", String(!open));
        if (open) {
          input.focus();
          document.body.classList.toggle("lana-open", true);
        } else {
          document.body.classList.remove("lana-open");
        }
      };

      const autoSize = () => {
        input.style.height = "auto";
        input.style.height = Math.min(input.scrollHeight, 140) + "px";
      };

      const appendUserMsg = (content) => {
        const el = document.createElement("article");
        el.className = "lana-chat__message lana-chat__message--user";
        el.textContent = content;
        messagesEl.appendChild(el);
        messagesEl.scrollTop = messagesEl.scrollHeight;
      };

      const showTyping = () => {
        const row = document.createElement("div");
        row.className = "lana-msg-row lana-typing";
        const avatar = document.createElement("div");
        avatar.className = "lana-bee-avatar";
        avatar.innerHTML = BEE_SVG;
        const bubble = document.createElement("div");
        bubble.className = "lana-chat__message lana-chat__message--assistant lana-typing__bubble";
        bubble.innerHTML = "<span></span><span></span><span></span>";
        row.appendChild(avatar);
        row.appendChild(bubble);
        messagesEl.appendChild(row);
        messagesEl.scrollTop = messagesEl.scrollHeight;
      };

      const hideTyping = () => {
        const t = messagesEl.querySelector(".lana-typing");
        if (t) t.remove();
      };

      const setInputLocked = (on) => {
        sendBtn.disabled = on;
        sendBtn.textContent = on ? "…" : "Send";
        input.disabled = on;
        starters.forEach((s) => { s.disabled = on; });
      };

      const LEAD_RE    = /\[LEAD:[^\]]*\]/g;
      const CONTACT_RE = /\[CONTACT:reason=([^\]]+)\]/;

      const makeContactActions = () => {
        const wrap = document.createElement("div");
        wrap.className = "lana-contact-actions";
        const emailBtn = document.createElement("a");
        emailBtn.href = "mailto:info@lulidigital.com";
        emailBtn.className = "lana-contact-btn lana-contact-btn--email";
        emailBtn.textContent = "Email us";
        const waBtn = document.createElement("a");
        waBtn.href = "https://wa.me/27602551513";
        waBtn.target = "_blank";
        waBtn.rel = "noopener noreferrer";
        waBtn.className = "lana-contact-btn lana-contact-btn--wa";
        waBtn.textContent = "WhatsApp";
        wrap.appendChild(emailBtn);
        wrap.appendChild(waBtn);
        return wrap;
      };

      const showErrorMsg = () => {
        const { row, bubble } = makeBeeRow();
        bubble.textContent = "Experiencing issues — please tap the contact desk.";
        messagesEl.appendChild(row);
        messagesEl.appendChild(makeContactActions());
        messagesEl.scrollTop = messagesEl.scrollHeight;
      };

      const sendMessage = async (text) => {
        const msg = text.trim();
        if (!msg) return;

        if (startersEl && !startersEl.dataset.used) {
          startersEl.dataset.used = "1";
          startersEl.style.display = "none";
        }

        appendUserMsg(msg);
        history.push({ role: "user", content: msg });
        input.value = "";
        autoSize();
        setInputLocked(true);
        showTyping();

        let res;
        try {
          res = await fetch("/api/lana", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ messages: history.slice(-14), market: currentMarket }),
          });
        } catch {
          hideTyping();
          showErrorMsg();
          history.push({ role: "assistant", content: "Experiencing issues — please tap the contact desk." });
          setInputLocked(false);
          return;
        }

        hideTyping();

        if (!res.ok) {
          showErrorMsg();
          history.push({ role: "assistant", content: "Experiencing issues — please tap the contact desk." });
          setInputLocked(false);
          return;
        }

        // ── Streaming path ───────────────────────────────────────
        if (res.body) {
          const { row, bubble } = makeBeeRow();
          messagesEl.appendChild(row);
          messagesEl.scrollTop = messagesEl.scrollHeight;

          const reader = res.body.getReader();
          const decoder = new TextDecoder();
          let buf = "";
          let fullText = "";
          let leadData = null;

          try {
            outer: while (true) {
              const { done, value } = await reader.read();
              if (done) break;

              buf += decoder.decode(value, { stream: true });
              const parts = buf.split("\n\n");
              buf = parts.pop() ?? "";

              for (const part of parts) {
                if (!part.startsWith("data: ")) continue;
                try {
                  const json = JSON.parse(part.slice(6));
                  if (typeof json.t === "string") {
                    fullText += json.t;
                    // Render live — hide any accumulating triggers
                    bubble.textContent = fullText
                      .replace(LEAD_RE, "")
                      .replace(CONTACT_RE, "")
                      .replace(/\[LEAD:[^\]]*$/, "")
                      .replace(/\[CONTACT:[^\]]*$/, "")
                      .trimEnd();
                    messagesEl.scrollTop = messagesEl.scrollHeight;
                  } else if (json.done) {
                    leadData = json.lead || null;
                    break outer;
                  }
                } catch { /* skip malformed chunk */ }
              }
            }
          } catch { /* stream interrupted */ }

          // Finalise display text (strip both triggers)
          const displayText = fullText
            .replace(LEAD_RE, "")
            .replace(CONTACT_RE, "")
            .replace(/\s+/g, " ")
            .trim() || localFallback(msg);
          bubble.textContent = displayText;
          history.push({ role: "assistant", content: displayText });

          // Check for CONTACT trigger — show email/WhatsApp buttons
          const contactMatch = fullText.match(CONTACT_RE);
          if (contactMatch) {
            const reason = contactMatch[1].trim();
            messagesEl.appendChild(makeContactActions());
            messagesEl.scrollTop = messagesEl.scrollHeight;
            fetch("/api/lana-enquiry", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ reason }),
            }).catch(() => {});
          }

          if (leadData?.email) {
            fetch("/api/lana-lead", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify(leadData),
            }).catch(() => {});
          }
        } else {
          // Non-streaming fallback (shouldn't happen but defensive)
          showErrorMsg();
          history.push({ role: "assistant", content: "Experiencing issues — please tap the contact desk." });
        }

        setInputLocked(false);
        input.focus();
      };

      const mobileTrigger = document.getElementById("lana-mobile-trigger");

      const dispatchClose = () => window.dispatchEvent(new CustomEvent("luli:lana-close"));
      const dispatchOpen  = () => window.dispatchEvent(new CustomEvent("luli:lana-open"));

      // All open/close goes through events so every listener (bee, trigger) stays in sync
      window.addEventListener("luli:lana-open", () => {
        setOpen(true);
        if (mobileTrigger) { mobileTrigger.style.opacity = "0"; mobileTrigger.style.pointerEvents = "none"; }
      });
      window.addEventListener("luli:lana-close", () => {
        setOpen(false);
        if (mobileTrigger) { mobileTrigger.style.opacity = "1"; mobileTrigger.style.pointerEvents = "auto"; }
      });

      if (mobileTrigger) mobileTrigger.addEventListener("click", dispatchOpen);
      closeBtn.addEventListener("click", dispatchClose);
      if (backdrop) backdrop.addEventListener("click", dispatchClose);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && panel.classList.contains("is-open")) dispatchClose();
      });

      form.addEventListener("submit", (e) => { e.preventDefault(); sendMessage(input.value); });
      input.addEventListener("input", autoSize);
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendMessage(input.value); }
      });

      starters.forEach((s) => {
        s.addEventListener("click", () => {
          dispatchOpen();
          sendMessage(s.getAttribute("data-lana-starter") || "");
        });
      });

      autoSize();

      // Replay any open event that fired before we were ready
      if (window.__lanaOpenQueued) { window.__lanaOpenQueued = false; dispatchOpen(); }
    };

    // Capture open events that fire before init finishes
    window.__lanaOpenQueued = false;
    const earlyOpen = () => { window.__lanaOpenQueued = true; };
    window.addEventListener("luli:lana-open", earlyOpen, { once: true });

    // Initialize immediately — no deferral so triggers always work
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        window.removeEventListener("luli:lana-open", earlyOpen);
        initLanaChat();
      }, { once: true });
    } else {
      window.removeEventListener("luli:lana-open", earlyOpen);
      initLanaChat();
    }
  })();
</script>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0;
    margin: -1px; overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  /* ── Backdrop (mobile) ───────────────────────────────────────── */
  .lana-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(12, 9, 5, 0.48);
    opacity: 0;
    pointer-events: none;
    z-index: 105;
    transition: opacity 320ms ease;
  }
  @media (max-width: 640px) {
    .lana-backdrop { display: block; }
    .lana-backdrop.is-open { opacity: 1; pointer-events: auto; }
  }

  /* ── Wrapper ─────────────────────────────────────────────────── */
  .lana-chat {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 200;
  }

  /* ── Panel — desktop bloom ───────────────────────────────────── */
  .lana-chat__panel {
    width: min(348px, calc(100vw - 32px));
    border-radius: 24px;
    border: 1px solid rgba(20,19,18,0.12);
    background:
      radial-gradient(ellipse at 80% 0%, rgba(245,164,31,.18) 0%, transparent 55%),
      linear-gradient(175deg, rgba(255,252,240,0.99) 0%, rgba(255,244,204,0.99) 100%);
    box-shadow:
      0 2px 0 rgba(255,255,255,.8) inset,
      0 28px 60px rgba(0,0,0,.14),
      0 8px 24px rgba(180,120,0,.10);
    overflow: hidden;

    transform: scale(0.90) translateY(8px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform-origin: right bottom;
    transition:
      transform 340ms cubic-bezier(.16,1,.3,1),
      opacity   260ms ease,
      visibility 0s   340ms;
  }
  .lana-chat__panel.is-open {
    transform: scale(1) translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      transform 340ms cubic-bezier(.16,1,.3,1),
      opacity   260ms ease,
      visibility 0s 0s;
  }

  /* ── Panel — mobile bottom sheet ────────────────────────────── */
  @media (max-width: 640px) {
    .lana-chat {
      right: 0; bottom: 0;
      left: 0; width: 100%;
    }
    .lana-chat__panel {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      width: 100%;
      max-height: 82vh;
      border-radius: 28px 28px 0 0;
      border-bottom: 0;
      z-index: 210;
      transform-origin: bottom center;
      /* Override desktop opacity/visibility — use transform-only to show/hide on mobile */
      opacity: 1;
      visibility: visible;
      pointer-events: none;
      transform: translateY(105%);
      transition: transform 400ms cubic-bezier(.16,1,.3,1);
    }
    .lana-chat__panel.is-open {
      transform: translateY(0);
      pointer-events: auto;
      transition: transform 400ms cubic-bezier(.16,1,.3,1);
    }
  }

  /* ── Drag handle ─────────────────────────────────────────────── */
  .lana-chat__handle {
    display: none;
    width: 36px; height: 4px;
    border-radius: 2px;
    background: rgba(20,19,18,0.16);
    margin: 14px auto 0;
  }
  @media (max-width: 640px) {
    .lana-chat__handle { display: block; }
  }

  /* ── Header ──────────────────────────────────────────────────── */
  .lana-chat__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px 0;
  }
  .lana-chat__identity {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* ── Bee avatar (header + messages) ─────────────────────────── */
  .lana-bee-avatar {
    flex-shrink: 0;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(245,164,31,0.14);
    border: 1.5px solid rgba(245,164,31,0.30);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .lana-bee-avatar svg {
    width: 22px;
    height: auto;
  }
  .lana-bee-avatar--header {
    width: 36px; height: 36px;
    animation: beeAvatarPulse 2.8s ease-in-out infinite;
  }
  .lana-bee-avatar--header svg {
    width: 24px;
  }
  @keyframes beeAvatarPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(245,164,31,.28); }
    50%       { box-shadow: 0 0 0 5px rgba(245,164,31,.0); }
  }

  .lana-name {
    font-family: var(--serif, Georgia, serif);
    font-size: 22px;
    font-weight: 600;
    color: rgba(20,19,18,0.92);
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .lana-chat__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px; height: 32px;
    border: 0;
    background: rgba(20,19,18,0.06);
    border-radius: 50%;
    color: rgba(20,19,18,0.55);
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease;
  }
  .lana-chat__close:hover {
    background: rgba(20,19,18,0.12);
    color: rgba(20,19,18,0.80);
  }

  /* ── Messages ────────────────────────────────────────────────── */
  .lana-chat__messages {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 280px;
    overflow-y: auto;
    padding: 14px 18px 10px;
    overscroll-behavior: contain;
  }
  @media (max-width: 640px) {
    .lana-chat__messages { max-height: 38vh; }
  }

  /* Row wrapper for bee avatar + assistant bubble */
  .lana-msg-row {
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }
  .lana-msg-row .lana-bee-avatar {
    margin-bottom: 2px;
  }
  .lana-msg-row .lana-chat__message {
    margin: 0;
  }

  .lana-chat__message {
    max-width: 82%;
    padding: 10px 14px;
    border-radius: 16px;
    font-size: 13.5px;
    line-height: 1.5;
    white-space: pre-wrap;
    text-wrap: pretty;
  }
  .lana-chat__message--assistant {
    background: rgba(255,255,255,0.78);
    border: 1px solid rgba(20,19,18,0.07);
    color: rgba(20,19,18,0.88);
    border-bottom-left-radius: 5px;
  }
  .lana-chat__message--user {
    align-self: flex-end;
    margin-left: auto;
    background: rgba(245,164,31,0.18);
    color: rgba(20,19,18,0.90);
    border-bottom-right-radius: 5px;
  }

  /* ── Typing indicator ────────────────────────────────────────── */
  .lana-typing__bubble {
    padding: 12px 18px;
    display: flex;
    gap: 5px;
    align-items: center;
  }
  .lana-typing__bubble span {
    display: block;
    width: 6px; height: 6px;

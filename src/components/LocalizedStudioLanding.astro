---
const { market } = Astro.props;
const isAmsterdam = market.variant === "amsterdam";
const isMunich = market.variant === "munich";
const isStockholm = market.variant === "stockholm";
const hasCustomVisual = isAmsterdam || isMunich || isStockholm;
const marketLinks = [
  { href: "/united-states", label: "United States", copy: "Founders and remote-first teams" },
  { href: "/united-kingdom", label: "United Kingdom", copy: "Founders and scale-ups" },
  { href: "/amsterdam", label: "Amsterdam", copy: "Tech founders and scale-ups" },
  { href: "/stockholm", label: "Stockholm", copy: "Nordic startups and brands" },
  { href: "/denmark", label: "Denmark", copy: "Danish tech and Nordic businesses" },
  { href: "/norway", label: "Norway", copy: "Nordic enterprises and tech" },
  { href: "/switzerland", label: "Switzerland", copy: "Enterprises and precision businesses" },
  { href: "/ireland", label: "Ireland", copy: "Tech founders and EU-facing teams" },
  { href: "/belgium", label: "Belgium", copy: "EU agencies and international teams" },
  { href: "/munich", label: "Munich", copy: "Enterprise and B2B teams" },
  { href: "/africa", label: "Africa", copy: "International and dollar-earning teams" },
];
const currentMarketPath = `/${market.variant}`;
---

<section class:list={["local-landing", `local-landing--${market.variant}`]}>
  <section class="local-hero reveal-block" data-atmosphere="hero" data-hive-section>
    <div class="local-hero__copy">
      <p class="local-eyebrow">{market.eyebrow}</p>
      <h1>{market.h1}</h1>
      <p class="local-positioning">{market.positioning}</p>
      <p class="local-intro">{market.intro}</p>
      <div class="local-actions">
        <a class="local-btn local-btn--primary" href="#local-contact">{market.primaryCta}</a>
        <a class="local-btn local-btn--ghost" href="#capabilities">{market.secondaryCta}</a>
      </div>
    </div>

    <aside class="hero-visual" aria-label={`${market.city} campaign system preview`}>
      {isAmsterdam && (
        <div class="ams-console">
          <div class="ams-console__top">
            <span>Global Campaign OS</span>
            <strong>AMS / LIVE</strong>
          </div>
          <div class="ams-console__grid">
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
          </div>
          <div class="ams-console__metric">
            <strong>Fast</strong>
            <span>asset workflow</span>
          </div>
        </div>
      )}

      {isMunich && (
        <div class="munich-dashboard">
          <div class="dash-row">
            <span>Pipeline</span>
            <strong>Active</strong>
          </div>
          <div class="dash-bars" aria-hidden="true">
            <span style="--h:72%"></span>
            <span style="--h:46%"></span>
            <span style="--h:88%"></span>
            <span style="--h:58%"></span>
            <span style="--h:78%"></span>
          </div>
          <div class="dash-grid">
            <span>Automation</span>
            <span>Optimization</span>
            <span>Brand QA</span>
            <span>Reporting</span>
          </div>
        </div>
      )}

      {isStockholm && (
        <div class="stockholm-glass" data-tilt-card>
          <div class="glass-orbit" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <p>Asset Engine</p>
          <strong>cinematic / automated / exact</strong>
          <div class="asset-strip" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>
        </div>
      )}

      {!hasCustomVisual && (
        <div class="studio-signal">
          <div class="signal-top">
            <span>Studio Signal</span>
            <span class="signal-live">● LIVE</span>
          </div>
          <div class="signal-bars" aria-hidden="true">
            <span style="--sh:68%"></span>
            <span style="--sh:44%"></span>
            <span style="--sh:84%"></span>
            <span style="--sh:52%"></span>
            <span style="--sh:76%"></span>
            <span style="--sh:38%"></span>
          </div>
          <div class="signal-desks" aria-hidden="true">
            <div><strong>Marketing</strong><span class="signal-dot"></span></div>
            <div><strong>AI Desk</strong><span class="signal-dot"></span></div>
            <div><strong>VA Desk</strong><span class="signal-dot"></span></div>
          </div>
          <p class="signal-market">{market.city}</p>
        </div>
      )}
    </aside>
  </section>

  {market.seoRecommendation && (
    <section class="local-seo-pulse reveal-block" aria-label={`${market.city} daily search focus`}>
      <div>
        <p class="local-eyebrow">Daily Search Focus</p>
        <p class="local-seo-pulse__source">
          {market.city} market signal, refreshed from {market.seoRecommendation.source}
        </p>
      </div>

      <div>
        <h2>{market.seoRecommendation.keyword}</h2>
        <p>
          The SEO agent checks country-level search trends each morning, then keeps this landing page aligned with the
          strongest relevant demand for {market.city} across marketing, AI automation, and executive operations.
        </p>
      </div>
    </section>
  )}

  <section id="capabilities" class="local-section reveal-block" data-atmosphere="services" data-hive-section>
    <div class="section-head">
      <p class="local-eyebrow">Studio Capabilities</p>
      <h2>{market.h2}</h2>
    </div>

    <div class:list={["capability-grid", isAmsterdam && "capability-grid--bento", isMunich && "capability-grid--catalog", isStockholm && "capability-grid--minimal"]}>
      {market.capabilities.map((item: any, index: number) => (
        <article class="capability-card" style={`--i:${index}`}>
          <span>{item.label}</span>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </article>
      ))}
    </div>
  </section>

  {isMunich && (
    <section class="munich-timeline reveal-block" aria-label="Enterprise production timeline">
      <div class="timeline-track">
        {[
          ["01", "Audit", "Campaign stack, brand standards, conversion paths."],
          ["02", "Architecture", "Automated marketing infrastructure and lead quality rules."],
          ["03", "Production", "High-end brand design Munich teams can deploy globally."],
          ["04", "Optimization", "Performance marketing optimization across paid and owned channels."],
        ].map(([step, title, copy]) => (
          <article class="timeline-card">
            <span>{step}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="local-services reveal-block" data-atmosphere="services" data-hive-section>
    <div class="section-head">
      <p class="local-eyebrow">Full Studio Suite</p>
      <h2>Marketing, AI &amp; operations — serving {market.city} and beyond.</h2>
    </div>
    <div class="services-grid">
      <a class="service-card" href="/marketing-desk">
        <span class="service-label">Marketing Desk</span>
        <h3>Brand, paid media &amp; campaign production</h3>
        <p>Brand positioning, visual direction, and paid media across Meta, Google, and TikTok. Automated launch systems built for international scale.</p>
        <span class="service-link">Explore the desk →</span>
      </a>
      <a class="service-card" href="/ai-desk">
        <span class="service-label">AI Desk</span>
        <h3>AI integration &amp; business automation</h3>
        <p>Custom chatbots, AI assistants, and smart workflows that answer customer questions, route leads, and move repetitive work out of your team's way.</p>
        <span class="service-link">Explore the desk →</span>
      </a>
      <a class="service-card" href="/va-desk">
        <span class="service-label">Virtual Assistant Desk</span>
        <h3>Executive operations &amp; admin support</h3>
        <p>Inbox management, calendar control, project tracking, and structured execution for founders and team leads who need quiet, reliable follow-through.</p>
        <span class="service-link">Explore the desk →</span>
      </a>
    </div>
  </section>

  <section class="market-links reveal-block" aria-label="Market landing pages">
    <div class="section-head">
      <p class="local-eyebrow">Markets</p>
      <h2>Local pages for the markets we serve.</h2>
    </div>

    <div class="market-links__grid">
      {marketLinks.map((item) => (
        <a class:list={["market-link-card", item.href === currentMarketPath && "is-current"]} href={item.href}>
          <span>{item.label}</span>
          <p>{item.copy}</p>
        </a>
      ))}
    </div>
  </section>

  <section class:list={["local-proof", isStockholm && "local-proof--dark"]} data-atmosphere="marketing" data-hive-section>
    <div class="proof-copy reveal-block">
      <p class="local-eyebrow">Why It Works</p>
      <h2>{market.proofTitle}</h2>
      <p>{market.proofCopy}</p>
    </div>
  </section>

  <section id="local-contact" class="local-contact reveal-block" data-atmosphere="cta" data-hive-section>
    <div>
      <p class="local-eyebrow">Get Started</p>
      <h2>{market.formTitle}</h2>
      <p>{market.formCopy}</p>
    </div>

    <div class="lana-invite">
      <div class="lana-invite__bee" aria-hidden="true">
        <svg viewBox="0 0 96 72" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="38" cy="18" rx="21" ry="12" fill="rgba(210,235,255,.65)"/>
          <ellipse cx="57" cy="19" rx="17" ry="10" fill="rgba(210,235,255,.55)"/>
          <ellipse cx="42" cy="44" rx="23" ry="16" fill="#F5A41F"/>
          <rect x="23" y="31" width="10" height="26" rx="7" fill="rgba(20,10,0,.72)"/>
          <rect x="37" y="30" width="10" height="28" rx="7" fill="rgba(20,10,0,.72)"/>
          <rect x="51" y="32" width="8" height="24" rx="6" fill="rgba(20,10,0,.72)"/>
          <circle cx="68" cy="42" r="14" fill="#F5A41F"/>
          <circle cx="73" cy="37" r="5" fill="#130C04"/>
          <circle cx="74.5" cy="35.5" r="1.8" fill="white"/>
        </svg>
      </div>
      <div class="lana-invite__text">
        <p class="lana-invite__name">Lana</p>
        <p class="lana-invite__desc">Tell me what you're building and I'll walk you through your options, match you to the right desk, and connect you with Fiker when you're ready.</p>
      </div>
      <button class="lana-invite__btn" data-open-lana>
        Chat with Lana
      </button>
      <p class="lana-invite__fallback">
        Prefer email? <a href="mailto:info@lulidigital.com">info@lulidigital.com</a>
        &nbsp;·&nbsp; WhatsApp: <a href="https://wa.me/27602551513" target="_blank" rel="noopener noreferrer">+27 60 255 1513</a>
      </p>
    </div>
  </section>
</section>

<script>
  // Open Lana chat from the invite button
  document.querySelectorAll("[data-open-lana]").forEach((btn) => {
    btn.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("luli:lana-open"));
    });
  });

  const revealBlocks = Array.from(document.querySelectorAll(".reveal-block"));

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.18 });

    revealBlocks.forEach((block) => observer.observe(block));
  } else {
    revealBlocks.forEach((block) => block.classList.add("is-visible"));
  }

  document.querySelectorAll("[data-tilt-card]").forEach((card) => {
    const el = card as HTMLElement;
    el.addEventListener("pointermove", (event) => {
      const e = event as PointerEvent;
      const rect = el.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width - 0.5) * 10;
      const y = ((e.clientY - rect.top) / rect.height - 0.5) * -10;
      el.style.setProperty("--rx", `${y}deg`);
      el.style.setProperty("--ry", `${x}deg`);
    });

    el.addEventListener("pointerleave", () => {
      el.style.removeProperty("--rx");
      el.style.removeProperty("--ry");
    });
  });
</script>

<style>
  .local-landing{
    --local-bg: var(--paper);
    --local-card: var(--paper-card);
    --local-ink: var(--ink);
    --local-muted: var(--muted);
    --local-line: var(--rule);
    --local-accent: var(--brand);
    color: var(--local-ink);
    padding: 16px 0 72px;
  }

  .local-landing--stockholm{
    --local-accent: var(--wine-strong);
  }

  .reveal-block{
    opacity: 0;
    transform: translateY(18px) scale(.992);
    transition: opacity 760ms ease, transform 760ms cubic-bezier(.16,1,.3,1);
  }

  .reveal-block.is-visible{
    opacity: 1;
    transform: translateY(0);
  }

  .local-hero{
    min-height: 650px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, .82fr);
    gap: clamp(34px, 6vw, 76px);
    align-items: center;
  }

  .local-hero h1{
    margin: 0;
    max-width: 11ch;
    font-family: ui-serif, Georgia, "Times New Roman", serif;
    font-size: clamp(56px, 8vw, 106px);
    line-height: .88;
    letter-spacing: 0;
  }

  .local-landing--stockholm .local-hero h1{
    max-width: 10ch;
  }

  .local-eyebrow{
    margin: 0 0 16px;
    font-size: 12px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--local-accent);
  }

  .local-positioning{
    margin: 26px 0 0;
    max-width: 740px;
    font-size: clamp(19px, 2.2vw, 27px);
    line-height: 1.36;
  }

  .local-intro{
    max-width: 650px;
    margin: 18px 0 0;
    color: var(--local-muted);
    font-size: 17px;
    line-height: 1.75;
  }

  .local-actions{
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .local-btn,
  .lead-form button,
  .quick-consult{
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--local-line);
    padding: 0 18px;
    border-radius: 0;
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 220ms ease, border-color 220ms ease, background 220ms ease;
  }

  .local-btn:hover,
  .lead-form button:hover,
  .quick-consult:hover{
    transform: translateY(-2px);
    border-color: var(--local-accent);
  }

  .local-btn--primary,
  .lead-form button{
    background: var(--local-ink);
    color: var(--local-bg);
  }

  .hero-visual{
    min-height: 460px;
    display: grid;
    place-items: center;
  }

  .ams-console,
  .munich-dashboard,
  .stockholm-glass{
    width: min(100%, 440px);
    border: 1px solid var(--local-line);
  }

  .ams-console{
    padding: 18px;
    background: var(--local-ink);
    color: var(--local-bg);
    box-shadow: 18px 18px 0 rgba(123,45,45,.18);
    animation: studioFloat 7s ease-in-out infinite;
  }

  .ams-console__top,
  .dash-row{
    display: flex;
    justify-content: space-between;
    gap: 18px;
    font-size: 12px;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .ams-console__grid{
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 26px 0;
  }

  .ams-console__grid span{
    aspect-ratio: 1;
    background: linear-gradient(135deg, rgba(255,255,255,.22), rgba(255,255,255,.04));
    animation: consolePulse 2.8s ease-in-out infinite;
    animation-delay: calc(var(--pulse, 0) * 120ms);
  }

  .ams-console__grid span:nth-child(2n){ --pulse: 2; }
  .ams-console__grid span:nth-child(3n){ --pulse: 4; }

  .ams-console__metric{
    border-top: 1px solid rgba(255,255,255,.18);
    padding-top: 18px;
  }

  .ams-console__metric strong{
    display: block;
    font-size: 72px;
    line-height: .9;
  }

  .munich-dashboard{
    padding: 22px;
    background: var(--local-card);
    box-shadow: 0 28px 70px rgba(0,0,0,.12);
    animation: studioFloat 8s ease-in-out infinite;
  }

  .dash-bars{
    height: 230px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    align-items: end;
    margin: 34px 0;
  }

  .dash-bars span{
    height: var(--h);
    background: linear-gradient(180deg, var(--local-ink), var(--local-accent));
    transform-origin: bottom;
    animation: barRise 900ms cubic-bezier(.16,1,.3,1) both;
  }

  .dash-grid{
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .dash-grid span{
    padding: 14px;
    border: 1px solid var(--local-line);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .stockholm-glass{
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    min-height: 430px;
    overflow: hidden;
    padding: 28px;
    border-color: var(--local-line);
    background:
      linear-gradient(135deg, rgba(107, 47, 58, .16), rgba(255,255,255,.22)),
      var(--local-card);
    backdrop-filter: blur(18px);
    transform: perspective(1000px) rotateX(var(--rx)) rotateY(var(--ry));
    box-shadow: 0 28px 70px rgba(0,0,0,.10);
  }

  .stockholm-glass p{
    margin: 0 0 10px;
    color: var(--local-accent);
    text-transform: uppercase;
    letter-spacing: .18em;
    font-size: 12px;
  }

  .stockholm-glass strong{
    display: block;
    max-width: 8ch;
    font-size: clamp(42px, 5vw, 76px);
    line-height: .9;
    text-transform: uppercase;
  }

  .glass-orbit span{
    position: absolute;
    border: 1px solid rgba(107,47,58,.28);
    border-radius: 50%;
    inset: auto;
  }

  .glass-orbit span:nth-child(1){ width: 260px; height: 260px; right: -70px; top: 34px; }
  .glass-orbit span:nth-child(2){ width: 150px; height: 150px; right: 92px; bottom: 70px; }
  .glass-orbit span:nth-child(3){ width: 90px; height: 90px; left: 34px; bottom: 42px; }

  .asset-strip{
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 26px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .asset-strip span{
    height: 72px;
    border: 1px solid var(--local-line);
    background: rgba(255,255,255,.22);
    animation: consolePulse 3s ease-in-out infinite;
  }

  .local-section,
  .market-links,
  .local-proof,
  .local-contact{
    padding: 86px 0;
    border-top: 1px solid var(--local-line);
  }

  /* ── Lana invite (replaces the old lead form) ─────────────────── */
  .lana-invite {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 36px 40px;
    border-radius: 24px;
    background:
      radial-gradient(ellipse at 90% 10%, rgba(245,164,31,.14) 0%, transparent 50%),
      linear-gradient(160deg, rgba(255,252,240,1) 0%, rgba(255,248,220,1) 100%);
    border: 1px solid rgba(245,164,31,.22);
    box-shadow: 0 8px 32px rgba(180,120,0,.08), 0 2px 0 rgba(255,255,255,.9) inset;
    align-self: start;
  }
  .lana-invite__bee {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: rgba(245,164,31,.15);
    border: 1.5px solid rgba(245,164,31,.30);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .lana-invite__bee svg { width: 38px; height: auto; }
  .lana-invite__text { display: flex; flex-direction: column; gap: 6px; }
  .lana-invite__name {
    font-family: var(--serif, Georgia, serif);
    font-size: 20px;
    font-weight: 600;
    color: rgba(20,19,18,.92);
    margin: 0;
  }
  .lana-invite__desc {
    font-size: 14.5px;
    line-height: 1.6;
    color: rgba(20,19,18,.62);
    margin: 0;
    max-width: 38ch;
  }
  .lana-invite__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 100px;
    border: 0;
    background: #B86B00;
    color: white;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    align-self: flex-start;
    transition: background 200ms ease, transform 200ms ease;
  }
  .lana-invite__btn:hover {
    background: #9A5800;
    transform: translateY(-1px);
  }
  .lana-invite__fallback {
    font-size: 12.5px;
    color: rgba(20,19,18,.42);
    margin: 0;
  }
  .lana-invite__fallback a {
    color: rgba(20,19,18,.58);
    text-decoration: underline;
    text-decoration-color: rgba(20,19,18,.22);
  }
  .lana-invite__fallback a:hover { color: rgba(20,19,18,.80); }

  .local-seo-pulse{
    display: grid;
    grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr);
    gap: 28px;
    padding: 48px 0;
    border-top: 1px solid var(--local-line);
  }

  .local-seo-pulse h2{
    margin: 0 0 12px;
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1;
    letter-spacing: 0;
    text-transform: capitalize;
  }

  .local-seo-pulse p{
    margin: 0;
    max-width: 68ch;
    color: var(--local-muted);
    line-height: 1.7;
  }

  .local-seo-pulse__source{
    font-size: 13px;
  }

  .section-head{
    display: grid;
    grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr);
    gap: 28px;
    align-items: end;
    margin-bottom: 34px;
  }

  .section-head h2,
  .proof-copy h2,
  .local-contact h2{
    margin: 0;
    font-size: clamp(34px, 5vw, 66px);
    line-height: 1;
    letter-spacing: 0;
  }

  .capability-grid{
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .capability-grid--bento{
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .capability-grid--bento .capability-card:nth-child(1),
  .capability-grid--bento .capability-card:nth-child(4){
    grid-column: span 3;

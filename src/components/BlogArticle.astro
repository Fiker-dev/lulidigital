---
import { type FikerAvatarPose } from "./FikerAvatar";
import BlogActivities from "./BlogActivities.astro";

// Shared blog article renderer used by both the live post page
// (src/pages/blog/[...slug].astro) and the secured draft preview
// (src/pages/draft/[slug].astro). Keeps rendering, styles, and the
// scroll/animation script in one place so a preview looks exactly like the
// published article.

interface Props {
  title: string;
  description: string;
  category: string;
  readingTime?: string;
  pubDate: Date;
  animIndex?: number;
  showAvatar?: boolean;
  preview?: boolean;
  /** Pre-rendered HTML body. When omitted, the default slot is used. */
  bodyHtml?: string;
}

const {
  title,
  description,
  category,
  readingTime,
  pubDate,
  animIndex = 0,
  showAvatar = false, // intro host retired — the traveling BlogActivities companion is the single mini-you now
  preview = false,
  bodyHtml,
} = Astro.props;

// Fiker host avatar — pick the intro pose by topic (expression by topic), and a
// fixed approving pose at the CTA. Uses the canonical fiker-avatar-pack.
const introPoseByCategory: Record<string, FikerAvatarPose> = {
  "AI Automation": "laptop",
  "Virtual Assistant": "notebook",
  "Digital Marketing": "phone",
};
const introPose: FikerAvatarPose = introPoseByCategory[category] ?? "confidence";

function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
}
---

<div id="read-progress" aria-hidden="true"></div>

<!-- Bee reading companion — follows scroll on desktop -->
<button id="blog-bee" aria-label="Chat with Lana" title="Chat with Lana">
  <svg viewBox="0 0 96 72" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <g class="lw"><ellipse cx="38" cy="18" rx="21" ry="12" fill="rgba(210,235,255,.75)"/><ellipse cx="57" cy="19" rx="17" ry="10" fill="rgba(210,235,255,.65)"/></g>
    <ellipse cx="42" cy="44" rx="23" ry="16" fill="#F5A41F"/>
    <rect x="23" y="31" width="10" height="26" rx="7" fill="rgba(20,10,0,.72)"/>
    <rect x="37" y="30" width="10" height="28" rx="7" fill="rgba(20,10,0,.72)"/>
    <rect x="51" y="32" width="8" height="24" rx="6" fill="rgba(20,10,0,.72)"/>
    <circle cx="68" cy="42" r="14" fill="#F5A41F"/>
    <circle cx="73" cy="37" r="5" fill="#130C04"/>
    <circle cx="74.5" cy="35.5" r="1.8" fill="white"/>
  </svg>
</button>

<main class="post-page">
  {preview && (
    <div class="draft-banner" role="status">
      <span class="draft-banner__dot" aria-hidden="true"></span>
      <span>Draft preview</span>
    </div>
  )}

  <nav class="post-back">
    <a href="/blog">← The Desk Report</a>
  </nav>

  <header class="post-header reveal-header">
    <div class="post-header__meta">
      <span class="post-category">{category}</span>
      {readingTime && <span class="post-time">{readingTime}</span>}
      <time class="post-date" datetime={pubDate.toISOString()}>
        {formatDate(pubDate)}
      </time>
    </div>
    {showAvatar && (
      <div class="post-host post-host--scroll" aria-hidden="true" data-intro-pose={introPose}>
        <div class="post-host__bob">
          <img id="host-avatar" src={`/assets/fiker-avatar-pack/${introPose}.webp`} alt="" decoding="async" />
        </div>
      </div>
    )}
    <h1 class="post-title">{title}</h1>
    <p class="post-description">{description}</p>
  </header>

  <hr class="rule" />

  <article class="post-body prose" id="post-article" data-anim={`t${animIndex}`}>
    {bodyHtml ? <Fragment set:html={bodyHtml} /> : <slot />}
  </article>

  <BlogActivities />

  <hr class="rule rule--bottom" />

  <footer class="post-footer">
    <div class="post-footer__cta reveal-cta">
      <p class="footer-kicker">Ready to move?</p>
      <p class="footer-headline">Let's build something that doesn't need explaining.</p>
      <p class="footer-line">Marketing, AI automation, and executive virtual assistant services for founders and growing teams.</p>
      <div class="footer-links">
        <a href="/ai-desk" class="footer-pill">AI Desk →</a>
        <a href="/marketing-desk" class="footer-pill">Marketing Desk →</a>
        <a href="/va-desk" class="footer-pill">VA Desk →</a>
      </div>
    </div>
    <a class="back-link" href="/blog">← Back to The Desk Report</a>
  </footer>
</main>

<style is:global>
  /* ── Reading progress bar (honey) ───────────────────────── */
  #read-progress {
    position: fixed;
    top: 0; left: 0;
    height: 3px;
    width: 0%;
    background: linear-gradient(90deg, var(--honey), var(--wine));
    z-index: 9999;
    transition: width 80ms linear;
    pointer-events: none;
    border-radius: 0 2px 2px 0;
  }

  /* ── Header entrance ────────────────────────────────────── */
  @keyframes hdReveal {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .reveal-header .post-header__meta { animation: hdReveal 600ms cubic-bezier(.16,1,.3,1) 80ms both; }
  .reveal-header .post-title        { animation: hdReveal 720ms cubic-bezier(.16,1,.3,1) 200ms both; }
  .reveal-header .post-description  { animation: hdReveal 680ms cubic-bezier(.16,1,.3,1) 360ms both; }

  /* ── Block scroll-reveal ────────────────────────────────── */
  /* JS wraps each H2 + its content into a .post-section and tags
     intro elements as .reveal-block. Each fades up as it enters view;
     list items stagger in once their section is visible. */
  .prose .reveal-block {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 640ms ease,
      transform 640ms cubic-bezier(.16,1,.3,1);
  }
  .prose .reveal-block.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Section blocks — generous scene spacing (longer screen) ─ */
  .prose .post-section {
    margin: clamp(46px, 8vh, 104px) 0;
  }
  .prose .post-section:first-of-type { margin-top: clamp(36px, 5vh, 64px); }

  /* Numbered honey badge above each H2 */
  .prose .post-section > h2 {
    position: relative;
    margin: 0 0 16px;
    padding-top: 30px;
  }
  .prose .post-section > h2::before {
    content: attr(data-num);
    position: absolute;
    top: 0; left: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .24em;
    font-weight: 600;
    color: var(--brand);
  }
  .prose .post-section > h2::after {
    content: "";
    position: absolute;
    top: 6px; left: 34px;
    width: 28px; height: 1px;
    background: var(--paper-line);
  }

  /* ── Headings (Fraunces display, on-brand) ──────────────── */
  .prose h2 {
    font-family: var(--font-display);
    font-size: clamp(23px, 3vw, 30px);
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: 1.18;
    color: var(--ink);
  }
  /* Word-by-word headline reveal */
  .prose h2 .w {
    display: inline-block;
    opacity: 0;
    transform: translateY(16px) rotate(2deg);
    transition:
      opacity 520ms ease,
      transform 640ms cubic-bezier(.18,1,.3,1);
  }
  .prose .reveal-block.is-visible h2 .w {
    opacity: 1;
    transform: none;
  }
  .prose h3 {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -.01em;
    margin: 26px 0 10px;
    color: var(--ink);
  }

  /* ── Card lists — the "blocks" that break up the text ───── */
  .prose ul,
  .prose ol {
    list-style: none;
    padding: 0;
    margin: 24px 0;
    display: grid;
    gap: 10px;
  }
  .prose li {
    position: relative;
    background: var(--paper-card);
    border: 1px solid var(--paper-line);
    border-radius: 14px;
    padding: 15px 20px 15px 52px;
    line-height: 1.58;
    color: var(--ink);
    opacity: 0;
    transform-origin: top left;
    transition:
      opacity 600ms ease,
      box-shadow 260ms ease,
      border-color 260ms ease;
  }
  .prose .reveal-block.is-visible li { opacity: 1; }
  /* Cards sway gently like they hang on a string (pivot top-left) */
  @media (prefers-reduced-motion: no-preference) {
    .prose .reveal-block.is-visible li {
      animation: cardSway 5.5s ease-in-out infinite;
    }
  }
  .prose li:hover {
    box-shadow: var(--shadow);
    border-color: var(--brand);
    animation-play-state: paused;
  }
  @keyframes cardSway {
    0%, 100% { transform: rotate(-1.3deg) translateY(0); }
    50%      { transform: rotate(1.3deg) translateY(-6px); }
  }

  /* Unordered → honey arrow marker */
  .prose ul li::before {
    content: "→";
    position: absolute;
    left: 20px; top: 14px;
    color: var(--wine);
    font-weight: 800;
  }
  /* Ordered → numbered honey chip */
  .prose ol { counter-reset: step; }
  .prose ol li { counter-increment: step; padding-left: 56px; }
  .prose ol li::before {
    content: counter(step);
    position: absolute;
    left: 13px; top: 12px;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--honey);
    color: var(--honey-dark);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  /* ── Pull quote — big honey panel ───────────────────────── */
  .prose blockquote {
    margin: 32px 0 !important;
    padding: 30px 32px 30px 36px !important;
    border: none !important;
    border-left: 4px solid var(--honey) !important;
    border-radius: 18px;
    background: linear-gradient(180deg, var(--paper-card), rgba(255,242,200,.35));
    font-family: var(--font-display) !important;
    font-size: clamp(20px, 2.6vw, 25px) !important;
    font-style: normal !important;
    font-weight: 500;
    line-height: 1.4 !important;
    letter-spacing: -.012em;
    color: var(--ink) !important;
    position: relative;
    box-shadow: var(--shadow);
    opacity: 0;
    transform: scale(.94);
    transition: opacity 720ms ease, transform 760ms cubic-bezier(.22,1,.3,1);
  }
  .prose .reveal-block.is-visible blockquote {
    opacity: 1;
    transform: scale(1);
  }

  /* ════════ Animation themes — rotated per post via [data-anim] ════════
     t0 (default above): pendulum sway · word lift · quote scale-in
     t1: vertical drift  · word slide-up · quote rise
     t2: tilt wobble     · word zoom     · quote 3D flip               */

  /* ── t1 · Drift ─────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .prose[data-anim="t1"] .reveal-block.is-visible li { animation: cardDrift 5s ease-in-out infinite; }
  }
  @keyframes cardDrift {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }
  .prose[data-anim="t1"] h2 .w { transform: translateY(22px); }
  .prose[data-anim="t1"] .reveal-block.is-visible h2 .w { transform: none; }
  .prose[data-anim="t1"] blockquote { transform: translateY(26px); }
  .prose[data-anim="t1"] .reveal-block.is-visible blockquote { transform: translateY(0); }

  /* ── t2 · Wobble ────────────────────────────────────────── */
  .prose[data-anim="t2"] li { transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .prose[data-anim="t2"] .reveal-block.is-visible li { animation: cardWobble 4.6s ease-in-out infinite; }
  }
  @keyframes cardWobble {
    0%, 100% { transform: rotate(-1.9deg) scale(1); }
    50%      { transform: rotate(1.9deg) scale(1.015); }
  }
  .prose[data-anim="t2"] h2 .w { transform: scale(.6); transform-origin: left bottom; }
  .prose[data-anim="t2"] .reveal-block.is-visible h2 .w { transform: none; }
  .prose[data-anim="t2"] blockquote { transform: perspective(700px) rotateX(14deg); transform-origin: top center; }
  .prose[data-anim="t2"] .reveal-block.is-visible blockquote { transform: perspective(700px) rotateX(0); }

  .prose blockquote::before {
    content: '\201C';
    position: absolute;
    top: 10px; right: 22px;
    font-family: var(--font-display);
    font-size: 72px;
    line-height: 1;
    color: rgba(245,164,31,.28);
    font-weight: 700;
    pointer-events: none;
  }
  .prose blockquote > :global(p) { margin: 0 !important; position: relative; z-index: 1; }

  /* ── Section ornament (--- between sections) ────────────── */
  .prose hr {
    border: none !important;
    margin: 30px auto !important;
    height: 16px !important;
    position: relative;
    overflow: visible;
    width: auto;
  }
  .prose hr::after {
    content: '\00B7\00A0\00B7\00A0\00B7';
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    font-size: 18px;
    letter-spacing: 5px;
    color: rgba(154,90,0,.4);
  }

  /* ── Body text ──────────────────────────────────────────── */
  .prose p { margin: 0 0 18px; }
  .prose > :global(p:first-child) {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.5vw, 23px);
    font-weight: 400;
    line-height: 1.5;
    color: var(--ink);
  }
  .prose strong { font-weight: 700; color: var(--wine-strong); }
  .prose a {
    color: var(--wine);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
    transition: color 180ms ease;
  }
  .prose a:hover { color: var(--brand); }

  /* ── Reduced motion / no-JS: show everything, no motion ──── */
  @media (prefers-reduced-motion: reduce) {
    .prose .reveal-block,
    .prose li,
    .prose blockquote,
    .prose h2 .w {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      animation: none !important;
    }
  }

  /* ── Blog bee reading companion ─────────────────────────── */
  #blog-bee {
    display: none;
    position: fixed;
    left: calc(50% + 392px);
    top: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255,242,200,.92);
    border: 1px solid var(--paper-line);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    cursor: pointer;
    z-index: 190;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: top 260ms cubic-bezier(.16,1,.3,1),
                background 200ms ease,
                border-color 200ms ease,
                transform 200ms ease;
    will-change: top;
  }
  @media (min-width: 1020px) { #blog-bee { display: flex; } }
  #blog-bee:hover {
    background: rgba(245,164,31,.2);
    border-color: var(--brand);
    transform: scale(1.08);
  }
  #blog-bee:active { transform: scale(0.96); }
  #blog-bee svg { width: 24px; height: auto; }
  #blog-bee .lw {
    animation: lanaWing 0.44s ease-in-out infinite alternate;
    transform-origin: 56px 20px;
  }

  /* Footer CTA reveal */
  .reveal-cta {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 700ms ease, transform 700ms cubic-bezier(.16,1,.3,1);
  }
  .reveal-cta.is-visible { opacity: 1; transform: translateY(0); }

  @media (max-width: 600px) {
    .prose blockquote { padding: 24px 22px 24px 26px !important; }
    .prose li { padding: 13px 16px 13px 46px; }
  }
</style>

<style>
  .post-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 56px 24px 80px;
    color: var(--ink);
    position: relative;
  }

  /* Draft preview marker — small, unobtrusive pill on the secured preview route */
  .draft-banner {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 0 0 18px;
    padding: 5px 12px;
    border: 1px solid var(--paper-line);
    border-radius: 100px;
    background: var(--paper-card);
    font-size: 10px;
    letter-spacing: .14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--muted);
  }
  .draft-banner__dot {
    flex: none;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--brand);
    box-shadow: 0 0 0 0 rgba(245,164,31,.55);
    animation: draftPulse 2.6s ease-out infinite;
  }
  @keyframes draftPulse {
    0%   { box-shadow: 0 0 0 0 rgba(245,164,31,.55); }
    70%  { box-shadow: 0 0 0 8px rgba(245,164,31,0); }
    100% { box-shadow: 0 0 0 0 rgba(245,164,31,0); }
  }

  /* Fiker host avatar — small, tucked beside the title on phones/tablets so the
     headline leads, then detaches into a scroll-following companion in the
     right gutter once there's room (desktop). */
  .post-host {
    float: left;
    width: 84px;
    margin: 2px 16px 6px 0;
    pointer-events: none;
    shape-outside: margin-box;
  }
  /* Idle "breathing" float layer — keeps the still illustration feeling alive.
     Kept separate from the wrapper's positioning transform and the image's
     swap transform so the three never fight. */
  .post-host__bob {
    width: 100%;
    animation: hostBob 6s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes hostBob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-5px); }
  }
  .post-host img {
    width: 100%;
    height: auto;
    display: block;
    transform: scale(1);
    transform-origin: center bottom;
    filter: drop-shadow(0 10px 20px rgba(20,19,18,.16));
    /* Springy settle when the pose crossfades (see swap() in the script). */
    transition: opacity 300ms ease, transform 550ms cubic-bezier(.2,1.1,.3,1);
  }
  @media (min-width: 560px) {
    .post-host { width: 104px; margin: 4px 20px 8px 0; }
  }
  @media (min-width: 1200px) {
    /* Follows scroll in the right gutter; JS swaps the pose per block. */
    .post-host--scroll {
      float: none;
      display: block;
      position: fixed;
      top: 50%;
      left: calc(50% + 372px);
      width: 208px;
      margin: 0;
      transform: translateY(-50%);
      pointer-events: none;
      z-index: 40;
      opacity: 0;
      animation: hostIn 800ms cubic-bezier(.16,1,.3,1) 400ms forwards;
    }
    .post-host--scroll img {
      width: 100%;
      height: auto;
      display: block;
      filter: drop-shadow(0 16px 32px rgba(20,19,18,.24));
    }
  }
  @keyframes hostIn { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .post-host--scroll { animation: none; opacity: 1; }
    .post-host__bob { animation: none; }
    .post-host img { transition: none; }
  }

  .post-back a {
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms ease;
  }
  .post-back a:hover { color: var(--ink); }

  .post-header { margin-top: 32px; }
  .post-header::after { content: ""; display: block; clear: both; }
  .post-header__meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }
  .post-category {
    font-size: 10px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--brand);
    font-weight: 700;
  }
  .post-time, .post-date {
    font-size: 11px;
    letter-spacing: .08em;
    color: var(--muted);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.4vw, 52px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -.025em;
    margin: 0 0 16px;
    color: var(--ink);
  }
  .post-description {
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0;
  }

  .rule {
    border: none;
    border-top: 1px solid var(--paper-line);
    margin: 30px 0;
  }
  .rule--bottom { margin: 50px 0 36px; }

  .post-body {
    font-size: 17px;
    line-height: 1.78;
    color: var(--ink);
  }

  /* Footer CTA — warm dark honey panel */
  .post-footer { display: flex; flex-direction: column; gap: 24px; position: relative; }
  .post-footer__cta {
    background: linear-gradient(160deg, #2a1c05, #160f02);
    border-radius: 22px;
    padding: 44px 40px 40px;
    color: rgba(255,247,223,.92);
  }
  .footer-kicker {
    font-size: 10px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--honey-bright);
    margin: 0 0 10px;
  }
  .footer-headline {
    font-family: var(--font-display);
    font-size: clamp(23px, 3vw, 33px);
    font-weight: 600;
    letter-spacing: -.022em;
    line-height: 1.12;
    color: #fff;
    margin: 0 0 12px;
  }
  .footer-line {
    font-size: 15px;
    line-height: 1.66;
    color: rgba(255,247,223,.6);
    margin: 0 0 26px;
  }
  .footer-links { display: flex; gap: 10px; flex-wrap: wrap; }
  .footer-pill {
    display: inline-block;
    padding: 9px 20px;
    border: 1px solid rgba(245,164,31,.32);
    border-radius: 100px;
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--honey-bright);
    text-decoration: none;
    font-weight: 600;
    transition: background 200ms ease, border-color 200ms ease, color 200ms ease;
  }
  .footer-pill:hover {
    background: rgba(245,164,31,.16);
    border-color: var(--honey);
    color: #fff;
  }

  .back-link {
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms ease;
  }
  .back-link:hover { color: var(--ink); }

  @media (max-width: 600px) {
    .post-page { padding: 40px 18px 60px; }
    .post-footer__cta { padding: 32px 24px 28px; }
  }
</style>

<script>
  // Reading progress bar
  const bar = document.getElementById("read-progress");
  if (bar) {
    const update = () => {
      const total = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = total > 0 ? `${Math.min(100, (window.scrollY / total) * 100)}%` : "0%";
    };
    window.addEventListener("scroll", update, { passive: true });
    update();
  }

  // Turn flat markdown into animated blocks:
  //   - group each H2 + its following content into a numbered .post-section
  //   - tag intro elements (before the first H2) as reveal blocks
  //   - reveal blocks on scroll; stagger list items within a section
  const article = document.getElementById("post-article");
  if (article) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const kids = Array.from(article.children);
    const frag = document.createDocumentFragment();
    let current: HTMLElement | null = null;
    let n = 0;
    for (const node of kids) {
      if (node.tagName === "H2") {
        n += 1;
        node.setAttribute("data-num", String(n).padStart(2, "0"));
        current = document.createElement("section");
        current.className = "post-section reveal-block";
        frag.appendChild(current);
        current.appendChild(node);
      } else if (current) {
        current.appendChild(node);
      } else {
        (node as HTMLElement).classList.add("reveal-block");
        frag.appendChild(node);
      }
    }
    article.appendChild(frag);

    // Word-by-word headline reveal: wrap each H2 word in a span
    article.querySelectorAll<HTMLElement>(".post-section > h2").forEach((h2) => {
      const words = (h2.textContent ?? "").trim().split(/\s+/);
      h2.innerHTML = words
        .map((w, i) => `<span class="w" style="transition-delay:${i * 55}ms">${w}</span>`)
        .join(" ");
    });

    // Stagger list items in, and offset each card's sway phase
    article.querySelectorAll("ul, ol").forEach((list) => {
      Array.from(list.children).forEach((li, i) => {
        const el = li as HTMLElement;
        el.style.transitionDelay = `${i * 70}ms`;
        el.style.animationDelay = `${-(i * 0.7).toFixed(2)}s`;
      });
    });

    const blocks = article.querySelectorAll(".reveal-block");
    if (reduced) {
      blocks.forEach((b) => b.classList.add("is-visible"));
    } else {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); }
        }),
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );
      blocks.forEach((b) => io.observe(b));
    }
  }

  // Scroll-following host: swap the avatar's pose to match the block in view.
  const hostWrap = document.querySelector<HTMLElement>(".post-host--scroll");
  const hostImg = document.getElementById("host-avatar") as HTMLImageElement | null;
  if (hostWrap && hostImg) {
    const introPose = hostWrap.dataset.introPose || "confidence";
    const pool = ["explaining", "lightbulb", "thinking", "notebook", "pointing-left", "confidence"];

    // React to what the section is actually about (topic + sentiment), so the
    // pose is a meaningful reaction, not just a rotation.
    const reactionFor = (sec: Element): string | null => {
      const heading = (sec.querySelector("h2")?.textContent ?? "").toLowerCase();
      const body = (sec.textContent ?? "").slice(0, 260).toLowerCase();
      const t = `${heading} ${body}`;
      const has = (...w: string[]) => w.some((x) => t.includes(x));
      if (has("problem", "challenge", "struggle", "pain", "broken", "stuck", "mistake", "risk", "fail", "wrong", "waste", "bottleneck", "friction", "messy")) return "thinking";
      if (has("idea", "tip", "insight", "secret", "realize", "clever", "lesson", "trick")) return "lightbulb";
      if (has("win", "success", "result", "growth", "scale", "boost", "payoff", "compound", "momentum", "thrive")) return "excited";
      if (has("step", "process", "how to", "action", "start", "audit", "map", "next move", "do this", "checklist")) return "pointing-left";
      if (has("automat", "workflow", "tool", "software", "system", "tech", " ai", "ai ", "agent")) return "laptop";
      if (has("plan", "organize", "manage", "schedule", "prioritise", "prioritize")) return "notebook";
      if (has("explain", "understand", "what is", "why ", "means", "clarify", "matters")) return "explaining";
      return null;
    };

    const targets: { el: Element; pose: string }[] = [];
    const header = document.querySelector(".post-header");
    if (header) targets.push({ el: header, pose: introPose });
    Array.from(document.querySelectorAll(".post-section")).forEach((sec, i) => {
      let pose: string;
      if (sec.querySelector("blockquote")) pose = "explaining";
      else pose = reactionFor(sec) ?? pool[i % pool.length];
      targets.push({ el: sec, pose });
    });
    const footer = document.querySelector(".post-footer");
    if (footer) targets.push({ el: footer, pose: "thumbsup" });

    const poseOf = new Map(targets.map((t) => [t.el, t.pose]));
    let currentPose = introPose;
    const swap = (pose?: string) => {
      if (!pose || pose === currentPose) return;
      currentPose = pose;
      // Dip + shrink slightly, then settle back with the springy transition.
      hostImg.style.opacity = "0";
      hostImg.style.transform = "scale(0.9)";
      const next = new Image();
      next.onload = () => {
        hostImg.src = next.src;
        hostImg.style.opacity = "1";
        hostImg.style.transform = "scale(1)";
      };
      next.src = `/assets/fiker-avatar-pack/${pose}.webp`;
    };

    const ratios = new Map<Element, number>();
    const hostIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => ratios.set(e.target, e.isIntersecting ? e.intersectionRatio : 0));
        let best: Element | null = null;
        let bestRatio = 0;
        ratios.forEach((r, el) => { if (r > bestRatio) { bestRatio = r; best = el; } });
        if (best) swap(poseOf.get(best));
      },
      { threshold: [0.1, 0.35, 0.6, 0.85], rootMargin: "-22% 0px -22% 0px" }
    );
    targets.forEach((t) => hostIo.observe(t.el));
  }

  // Footer CTA reveal
  const cta = document.querySelector(".reveal-cta");
  if (cta) {
    const io2 = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("is-visible"); io2.unobserve(e.target); }
      }),
      { threshold: 0.15 }
    );
    io2.observe(cta);
  }

  // Mark body so LanaChat skips scroll-hide on blog pages
  document.body.classList.add("is-blog");

  // Bee reading companion — follows scroll beside the article
  const blogBee = document.getElementById("blog-bee");
  const postArticle = document.getElementById("post-article");
  if (blogBee && postArticle) {
    const moveBee = () => {
      const rect = postArticle.getBoundingClientRect();
      const articleTop    = rect.top  + window.scrollY;
      const articleBottom = articleTop + rect.height;
      const eyeY    = window.scrollY + window.innerHeight * 0.42;
      const progress = Math.max(0, Math.min(1, (eyeY - articleTop) / (articleBottom - articleTop)));
      const minY = Math.max(88, rect.top + 8);
      const maxY = window.innerHeight - 96;
      const targetTop = minY + progress * Math.max(0, maxY - minY);
      blogBee.style.top = `${targetTop}px`;
    };
    window.addEventListener("scroll", moveBee, { passive: true });
    moveBee();
    blogBee.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("luli:lana-open"));
    });
  }
</script>

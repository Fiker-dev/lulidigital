---
const { compact = false } = Astro.props;
const paths = [
  ["attention", "We are too easy to overlook", "Attention", "Make the offer easier to notice and remember.", "We start with positioning, the page or campaign carrying the offer, and the path from first impression to enquiry.", "/marketing-desk", "See the marketing desk"],
  ["followup", "Leads wait too long for an answer", "Response", "Shorten the distance between interest and action.", "We map the handoffs, build the right automations, and keep uncertain or high-stakes decisions with a person.", "/ai-desk", "See the AI desk"],
  ["capacity", "The founder is still the system", "Capacity", "Move recurring work out of one person’s head.", "We document the rhythm, assign human ownership, and automate only the repeatable parts that can fail safely.", "/va-desk", "See the VA desk"],
  ["website", "Our website undersells the business", "Conversion", "Turn the site into a confident sales conversation.", "We clarify the promise, remove decision friction, and build a fast page that earns the next click on every screen.", "/web-design-desk", "See the web design desk"],
];
---
<section class:list={["decision-bridge", compact && "decision-bridge--compact"]} aria-labelledby="decision-title">
  <header class="decision-head">
    <p class="decision-kicker">Start with the pressure point</p>
    <h2 id="decision-title">What is costing you momentum right now?</h2>
    <p>Pick the sentence that feels most familiar. We will show you where we would begin.</p>
  </header>
  <div class="decision-shell">
    <div class="decision-choices" role="list" aria-label="Choose a business pressure point">
      {paths.map((path, index) => <button class:list={["decision-choice", index === 0 && "is-active"]} type="button" data-decision-choice={path[0]} aria-pressed={index === 0 ? "true" : "false"}><span>{String(index + 1).padStart(2, "0")}</span>{path[1]}</button>)}
    </div>
    <div class="decision-answers" aria-live="polite">
      {paths.map((path, index) => <article class:list={["decision-answer", index === 0 && "is-active"]} data-decision-answer={path[0]} hidden={index !== 0}><span class="decision-signal">{path[2]}</span><h3>{path[3]}</h3><p>{path[4]}</p><a href={path[5]}>{path[6]} <span aria-hidden="true">→</span></a></article>)}
    </div>
  </div>
  <footer class="decision-reassurance"><strong>The first conversation is a fit check.</strong><span>No prepared pitch. No pressure. You leave knowing the clearest next move, even if it is not us.</span></footer>
</section>
<script>
  document.querySelectorAll<HTMLElement>(".decision-bridge").forEach((bridge) => {
    const choices = [...bridge.querySelectorAll<HTMLButtonElement>("[data-decision-choice]")];
    const answers = [...bridge.querySelectorAll<HTMLElement>("[data-decision-answer]")];
    choices.forEach((choice) => choice.addEventListener("click", () => {
      const selected = choice.dataset.decisionChoice;
      choices.forEach((item) => { const active = item === choice; item.classList.toggle("is-active", active); item.setAttribute("aria-pressed", String(active)); });
      answers.forEach((answer) => { const active = answer.dataset.decisionAnswer === selected; answer.hidden = !active; answer.classList.toggle("is-active", active); });
    }));
  });
</script>
<style>
  .decision-bridge{width:min(1120px,calc(100% - 40px));margin:clamp(72px,10vw,132px) auto;color:#fdf7e8}.decision-head{max-width:760px;margin-bottom:30px}.decision-kicker{margin:0 0 12px;color:#9a5a00;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.decision-head h2{max-width:720px;margin:0 0 14px;color:#17120c;font-size:clamp(34px,5vw,66px);line-height:.98;letter-spacing:-.04em;text-wrap:balance}.decision-head>p:last-child{max-width:58ch;margin:0;color:rgba(23,18,12,.68);font-size:17px}.decision-shell{display:grid;grid-template-columns:minmax(280px,.82fr) minmax(0,1.18fr);min-height:430px;overflow:hidden;border:1px solid rgba(255,255,255,.12);border-radius:24px;background:#21170d;box-shadow:0 34px 90px rgba(74,42,5,.18)}.decision-choices{padding:14px;border-right:1px solid rgba(255,255,255,.1);background:#17110b}.decision-choice{display:grid;grid-template-columns:34px 1fr;width:100%;padding:19px 16px;border:0;border-radius:14px;background:transparent;color:rgba(255,249,235,.66);font:700 15px/1.35 var(--font-body,ui-sans-serif,system-ui);text-align:left;cursor:pointer;transition:color 180ms ease,background 180ms ease,transform 180ms ease}.decision-choice span{color:#f5a41f;font-size:11px;letter-spacing:.12em;padding-top:3px}.decision-choice:hover{color:#fff9eb;background:rgba(255,255,255,.055)}.decision-choice:active{transform:scale(.99)}.decision-choice.is-active{color:#21170d;background:#ffd45a}.decision-choice.is-active span{color:#6b3b00}.decision-choice:focus-visible{outline:3px solid #fff7df;outline-offset:2px}.decision-answers{display:grid;padding:clamp(34px,6vw,72px);align-items:center;background:radial-gradient(circle at 86% 14%,rgba(245,164,31,.2),transparent 34%),#2a1b0e}.decision-answer{grid-area:1/1;max-width:580px}.decision-answer.is-active{animation:decisionIn 360ms cubic-bezier(.16,1,.3,1)}.decision-signal{display:block;margin-bottom:28px;color:#ffd45a;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.decision-answer h3{margin:0 0 18px;color:#fff9eb;font-size:clamp(30px,4vw,50px);line-height:1;letter-spacing:-.035em;text-wrap:balance}.decision-answer p{max-width:52ch;margin:0 0 28px;color:rgba(255,249,235,.7);font-size:16px;line-height:1.65}.decision-answer a{display:inline-flex;gap:10px;align-items:center;color:#ffd45a;font-size:14px;font-weight:800;text-decoration:none}.decision-answer a:hover span{transform:translateX(4px)}.decision-answer a span{transition:transform 180ms ease}.decision-reassurance{display:flex;gap:14px 28px;align-items:baseline;padding:18px 4px 0;color:rgba(23,18,12,.66);font-size:13px}.decision-reassurance strong{color:#17120c}.decision-bridge--compact{margin-top:72px;margin-bottom:72px}@keyframes decisionIn{from{opacity:.3;transform:translateY(9px)}to{opacity:1;transform:none}}@media(max-width:720px){.decision-bridge{width:min(100% - 28px,1120px)}.decision-shell{grid-template-columns:1fr}.decision-choices{border-right:0;border-bottom:1px solid rgba(255,255,255,.1)}.decision-choice{padding:15px 13px}.decision-answers{min-height:370px;padding:34px 24px}.decision-reassurance{display:grid}}@media(prefers-reduced-motion:reduce){.decision-choice,.decision-answer,.decision-answer a span{animation:none!important;transition:none!important}}
</style>

---
const currentYear = 2026;

const links = [
  { href: "/marketing-desk", label: "Marketing Desk" },
  { href: "/ai-desk", label: "AI Desk" },
  { href: "/va-desk", label: "Virtual Assistant Desk" },
  { href: "/web-design-desk", label: "Web Design Desk" },
  { href: "/work", label: "Work" },
  { href: "/blog", label: "Blog Desk" },
  { href: "/founder", label: "Founder" },
];

const markets = [
  { href: "/united-kingdom", label: "United Kingdom" },
  { href: "/united-states", label: "United States" },
  { href: "/amsterdam", label: "Amsterdam" },
  { href: "/munich", label: "Munich" },
  { href: "/stockholm", label: "Stockholm" },
  { href: "/denmark", label: "Denmark" },
  { href: "/switzerland", label: "Switzerland" },
  { href: "/ireland", label: "Ireland" },
  { href: "/belgium", label: "Belgium" },
  { href: "/norway", label: "Norway" },
];
---

<footer class="site-footer" aria-label="LuliDigital footer">
  <div class="site-footer__inner">
    <section class="site-footer__brand" aria-label="Company summary">
      <a class="site-footer__logo" href="/" aria-label="LuliDigital home">
        <span>Luli</span>Digital
      </a>
      <p>
        AI Automation, Digital Strategy, and Virtual Assistant Desk services for fast-scaling teams across the UK, Europe, and the US. Remote-first.
      </p>
    </section>

    <section class="site-footer__group" aria-label="Footer navigation">
      <h2>Studio</h2>
      <nav class="site-footer__links" aria-label="Footer service links">
        {links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
    </section>

    <section class="site-footer__group" aria-label="Markets we serve">
      <h2>Markets</h2>
      <nav class="site-footer__links" aria-label="Footer market links">
        {markets.map((market) => (
          <a href={market.href}>{market.label}</a>
        ))}
      </nav>
    </section>

    <section class="site-footer__group" aria-label="Contact details">
      <h2>Contact</h2>
      <address class="site-footer__contact">
        <a href="https://wa.me/27602551513" target="_blank" rel="noopener noreferrer" class="whatsapp-btn">Global WhatsApp Desk</a>
        <a href="mailto:info@lulidigital.com">info@lulidigital.com</a>
      </address>
    </section>
  </div>

  <div class="site-footer__bottom">
    <p>© {currentYear} LuliDigital. All Rights Reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 34px 20px 30px;
    color: var(--ink, #141312);
    background:
      linear-gradient(30deg, transparent 32%, rgba(196, 118, 0, .08) 33%, rgba(196, 118, 0, .08) 34%, transparent 35%),
      linear-gradient(150deg, transparent 32%, rgba(196, 118, 0, .06) 33%, rgba(196, 118, 0, .06) 34%, transparent 35%),
      rgba(255, 247, 224, .48);
    background-size: 40px 68px;
    border-top: 1px solid rgba(30, 24, 22, .1);
  }

  .site-footer__inner {
    max-width: var(--max, 1120px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(220px, 1.3fr) repeat(3, minmax(140px, .7fr));
    gap: clamp(22px, 3.4vw, 48px);
  }

  .site-footer__logo {
    display: inline-block;
    color: var(--ink, #141312);
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    font-size: 26px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
  }

  .site-footer__logo span {
    color: var(--brand, #7b2d2d);
  }

  .site-footer__brand p {
    max-width: 420px;
    margin: 16px 0 0;
    color: rgba(20, 19, 18, .64);
    font-size: 14px;
    line-height: 1.7;
  }

  .site-footer__group h2 {
    margin: 0 0 14px;
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(20, 19, 18, .48);
  }

  .site-footer__links,
  .site-footer__contact {
    display: grid;
    gap: 9px;
  }

  .site-footer__links a,
  .site-footer__contact a,
  .site-footer__contact span {
    color: rgba(20, 19, 18, .76);
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 14px;
    font-style: normal;
    line-height: 1.4;
    text-decoration: none;
  }

  .site-footer__links a:hover,
  .site-footer__contact a:hover {
    color: var(--brand, #7b2d2d);
  }

  .whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    border: 1px solid rgba(30, 24, 22, .18);
    font-size: 12px !important;
    letter-spacing: .1em;
    text-transform: uppercase;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .whatsapp-btn:hover {
    border-color: var(--brand, #7b2d2d);
    color: var(--brand, #7b2d2d) !important;
  }

  .site-footer__bottom {
    max-width: var(--max, 1120px);
    margin: 28px auto 0;
    padding-top: 18px;
    border-top: 1px solid rgba(30, 24, 22, .1);
  }

  .site-footer__bottom p {
    margin: 0;
    color: rgba(20, 19, 18, .52);
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 12px;
    letter-spacing: .08em;
  }

  @media (max-width: 1024px) {
    .site-footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 28px 40px;
    }
  }

  @media (max-width: 820px) {
    .site-footer {
      padding: 30px 16px 116px;
    }

    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>

    target=MOODS[sc.dataset.mood];rippleAt=performance.now()/1000;
    document.documentElement.style.setProperty('--accent',sc.style.getPropertyValue('--accent'));
    chapter.style.opacity=0;setTimeout(function(){chapter.textContent=String(i+1).padStart(2,'0')+'  ·  '+sc.dataset.title;chapter.style.opacity=1;},350);
    fills.forEach(function(f,j){f.style.transform='scaleX('+(j<i?1:0)+')';});
    started=true;
  }

  var toggle=document.getElementById('toggle'), icoP=document.getElementById('icoPause'), icoPl=document.getElementById('icoPlay');
  function setPlaying(p){playing=p;document.body.classList.toggle('paused',!p);icoP.style.display=p?'':'none';icoPl.style.display=p?'none':'';toggle.setAttribute('aria-label',p?'Pause':'Play');}
  toggle.addEventListener('click',function(){if(ended){go(0);setPlaying(true);return;}setPlaying(!playing);});
  document.getElementById('replay').addEventListener('click',function(){go(0);setPlaying(true);});
  addEventListener('keydown',function(e){
    if(e.key===' '){e.preventDefault();toggle.click();}
    if(e.key==='ArrowRight')go(Math.min(idx+1,scenes.length-1));
    if(e.key==='ArrowLeft')go(Math.max(idx-1,0));
  });
  document.addEventListener('visibilitychange',function(){if(document.hidden)setPlaying(false);});
  addEventListener('resize',function(){resize();if(idx>=0)fit(scenes[idx]);});
  // test/preview hook: ?scene=N jumps to a scene
  var qs=new URLSearchParams(location.search), jump=parseInt(qs.get('scene'),10);

  var last=performance.now(), seaT=0;
  function lerp(a,b,k){for(var i=0;i<a.length;i++)a[i]+=(b[i]-a[i])*k;}
  function frame(now){
    var dt=Math.min(.05,(now-last)/1000);last=now;
    if(playing&&idx>=0&&!ended){
      elapsed+=dt;var dur=+scenes[idx].dataset.dur;
      fills[idx].style.transform='scaleX('+Math.min(1,elapsed/dur)+')';
      if(elapsed>=dur){if(idx<scenes.length-1)go(idx+1);else{ended=true;document.body.classList.add('ended');}}
    }
    seaT+=dt*(reduce?.15:1);
    var k=1-Math.exp(-dt*.7);
    ['top','hor','deep','shal','sun','sp'].forEach(function(n){lerp(cur[n],target[n],k);});
    if(gl){
      gl.uniform2f(U.R,canvas.width,canvas.height);gl.uniform1f(U.T,seaT);gl.uniform1f(U.HOR,HOR);
      gl.uniform1f(U.RIP,reduce?-1:(now/1000-rippleAt));
      gl.uniform3fv(U.skyTop,cur.top);gl.uniform3fv(U.skyHor,cur.hor);gl.uniform3fv(U.deep,cur.deep);
      gl.uniform3fv(U.shal,cur.shal);gl.uniform3fv(U.sunC,cur.sun);gl.uniform2fv(U.sunP,cur.sp);
      gl.drawArrays(gl.TRIANGLES,0,3);
    }
    requestAnimationFrame(frame);
  }
  function start(){
    if(jump>=1&&jump<=scenes.length){go(jump-1);cur=JSON.parse(JSON.stringify(target));}else go(0);
    requestAnimationFrame(function(t){last=t;frame(t);});
  }
  var fontsReady=document.fonts?Promise.race([document.fonts.ready,new Promise(function(r){setTimeout(r,1500);})]):Promise.resolve();
  fontsReady.then(start);
})();
</script>
</body>
</html>

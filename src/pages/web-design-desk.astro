---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getWeeklyPageSeoTarget } from "../lib/seoAgent.js";

export const prerender = false;

const seoTarget = getWeeklyPageSeoTarget("/web-design-desk");

Astro.response.headers.set("Cache-Control", "s-maxage=604800, stale-while-revalidate=86400");

const serviceSchema = {
  "name": "Premium Web Design, Landing Page Design & UI Experience Services",
  "serviceType": [
    "web design services",
    "premium web design",
    "landing page design",
    "conversion-optimised web design",
    "brand-aligned web design",
    "UI design services",
    "website redesign services",
    "web design for founders",
    "web design for small business",
    "Astro web design",
    "custom website design",
    "web design agency",
  ],
  "description": "LuliDigital builds premium, brand-aligned websites and landing pages for founders and growing businesses — designed to convert and built to perform.",
};

const faqs = [
  {
    q: "What makes a website “premium”?",
    a: "It is not visual decoration — it is decisions. Clear hierarchy, a brand-true look, and a deliberate path to one action. Premium is what is left after we remove everything that does not earn its place.",
  },
  {
    q: "Do you design from a template?",
    a: "No — every site is designed from your brand up. Layout, type, and colour all come from who you are, so the result looks and feels unmistakably yours.",
  },
  {
    q: "How long does a project take?",
    a: "It depends on scope and how quickly content and feedback come back. After a short discovery call we give you a realistic timeline for your project — and we hold to it.",
  },
  {
    q: "Do you handle the build, or only the design?",
    a: "Both. We design and build — performance-first development on Astro, so the site that ships is the one you approved: fast, mobile-perfect, and ready to grow on.",
  },
  {
    q: "What do I need to have ready?",
    a: "Your brand assets, your content or a plan for it, and a clear sense of what success looks like. If you are missing pieces, we will help you shape them along the way.",
  },
  {
    q: "Will it be good for SEO and speed?",
    a: "Yes — both are built in from the first line, not bolted on after. Clean structure, semantic markup, and Core Web Vitals kept in mind throughout.",
  },
];

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a },
  })),
};
---

<BaseLayout
  title="Premium Web Design, Landing Page Design & UI Experience | LuliDigital"
  description="LuliDigital builds premium, brand-aligned websites and landing pages for founders and growing businesses — designed to convert and built to perform."
  active="web-design"
  seoTarget={seoTarget}
  serviceSchema={serviceSchema}
  extraSchemas={[faqSchema]}
>

  <!-- ═══════════════════════════════════════════════════════ HERO -->
  <section class="wd-hero" aria-label="Web Design services" data-bee-stop data-atmosphere="hero" data-hive-section>
    <div class="wd-grid-field" aria-hidden="true"></div>

    <div class="wd-hero-inner">
      <span class="eyebrow wd-eyebrow" data-blur-in>Design Studio</span>
      <h1 class="wd-title" data-word-reveal>
        Websites that convert.<br/>Designs that are remembered.
      </h1>
      <p class="wd-sub" data-blur-in data-blur-delay="200">
        Premium, brand-aligned web design for founders and growing businesses —
        built to perform, optimised to convert, and finished to a standard that feels unmistakably premium.
      </p>
      <div class="wd-ctas" data-stagger data-stagger-gap="80">
        <a class="pill pill--filled magnetic" href="https://wa.me/27602551513">Start a project →</a>
        <a class="pill pill--outline magnetic" href="/marketing-desk">Marketing Desk →</a>
      </div>
      <p class="wd-capabilities" data-blur-in data-blur-delay="360">
        Brand-aligned&nbsp; · &nbsp;Conversion-focused&nbsp; · &nbsp;Performance-first&nbsp; · &nbsp;Built on Astro
      </p>
    </div>
  </section>

  <section class="selling-point selling-point--web" aria-label="Premium web design selling point" data-reveal="up" data-bee-stop data-atmosphere="web" data-hive-section>
    <span class="eyebrow">The Difference</span>
    <h2 class="selling-title">You get a website your business can actually grow on.</h2>
    <p class="selling-copy">
      We design brand-aligned, conversion-optimised experiences that feel premium, load fast,
      and make every visitor understand why you are worth choosing. Every decision — layout,
      type, colour, flow — is made on purpose, around your brand and the action you want people to take.
    </p>
    <p class="selling-copy selling-copy--direct">
      Want to know what your website could look like? Talk to the desk and we will walk you through the approach.
    </p>
    <div class="selling-links">
      <a class="pill pill--filled magnetic" href="https://wa.me/27602551513">WhatsApp the desk</a>
      <a class="pill pill--outline magnetic" href="mailto:info@lulidigital.com">Email the desk</a>
    </div>
  </section>

  <!-- ════════════════════════════ WHAT PREMIUM MEANS -->
  <section class="wd-principles" aria-label="What premium web design means" data-reveal="up" data-bee-stop data-atmosphere="web" data-hive-section>
    <span class="eyebrow">What “premium” actually means</span>
    <h2 class="section-title">It isn’t decoration. It’s decisions.</h2>

    <div class="principles-grid" data-stagger data-stagger-gap="90">
      <article class="principle">
        <span class="principle-index">01</span>
        <h3 class="principle-title">Designed around your brand</h3>
        <p class="principle-desc">
          Every layout, type choice, and colour is drawn from your brand — so the site looks
          and feels unmistakably like you, and like nothing else out there.
        </p>
      </article>

      <article class="principle">
        <span class="principle-index">02</span>
        <h3 class="principle-title">Designed to convert</h3>
        <p class="principle-desc">
          Clear hierarchy, a deliberate reading flow, and copy structure that guides every
          visitor toward one obvious next step — not a wall of pretty noise.
        </p>
      </article>

      <article class="principle">
        <span class="principle-index">03</span>
        <h3 class="principle-title">Clarity over clutter</h3>
        <p class="principle-desc">
          We cut everything that doesn’t help a visitor decide. The restraint is the point —
          a calm, confident page reads as far more premium than a loud one.
        </p>
      </article>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ METRICS STRIP -->
  <div class="metrics-strip" aria-label="Web design impact" data-reveal="up">
    <div class="metric-item">
      <span class="metric-num metric-word">Clear</span>
      <span class="metric-label">hierarchy that guides every visitor</span>
    </div>
    <div class="metric-divider" aria-hidden="true"></div>
    <div class="metric-item">
      <span class="metric-num metric-word">Premium</span>
      <span class="metric-label">feel that earns trust instantly</span>
    </div>
    <div class="metric-divider" aria-hidden="true"></div>
    <div class="metric-item">
      <span class="metric-num metric-word">Converts</span>
      <span class="metric-label">visitors into action, not just views</span>
    </div>
  </div>

  <!-- ══════════════════════════════════════════ SERVICE BENTO GRID -->
  <section class="wd-services" aria-label="Web design services we offer" data-reveal="up" data-bee-stop data-atmosphere="services" data-hive-section>
    <span class="eyebrow">What We Build</span>
    <div class="bento-grid" data-stagger data-stagger-gap="70">

      <article class="glow-card svc-card" data-tilt="7" data-reveal="float-l" data-reveal-delay="0">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:10px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          </div>
          <h3 class="svc-title">Brand Website Design</h3>
          <p class="svc-desc">Full website design and build — strategy, visual identity application, layout architecture, and performance-optimised delivery that represents your business at its best.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="drop" data-reveal-delay="80">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:10px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 19-9-9 19-2-8-8-2z"/></svg>
          </div>
          <h3 class="svc-title">Landing Page Design</h3>
          <p class="svc-desc">Conversion-focused single pages built for specific campaigns, offers, or audiences — with clear hierarchy, compelling copy structure, and measurable outcomes.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="float-r" data-reveal-delay="160">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:10px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>
          </div>
          <h3 class="svc-title">UI Experience Design</h3>
          <p class="svc-desc">Premium interface design for web apps, dashboards, and digital products — visual systems, component libraries, and interaction patterns that feel effortless to use.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="float-l" data-reveal-delay="80">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:10px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 14.14 14.14"/></svg>
          </div>
          <h3 class="svc-title">Website Redesign</h3>
          <p class="svc-desc">Existing site transformations — audit, strategy, visual refresh, and rebuild. We diagnose what is holding your current site back and fix it properly.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="pop" data-reveal-delay="160">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:10px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          </div>
          <h3 class="svc-title">Design Systems</h3>
          <p class="svc-desc">Component libraries, token systems, and visual guidelines that scale — so every new page or campaign stays on brand without needing to start from scratch.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="float-r" data-reveal-delay="240">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:10px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </div>
          <h3 class="svc-title">Performance &amp; SEO</h3>
          <p class="svc-desc">Technical performance optimisation, Lighthouse audits, Core Web Vitals, and SEO-structured markup — so your beautiful site also ranks and loads at full speed.</p>
        </div>
      </article>

    </div>
  </section>

  <!-- ════════════════════════════════════ PROCESS TIMELINE -->
  <section class="wd-process" aria-label="Web design process" data-reveal="up" data-bee-stop>
    <span class="eyebrow">The Process</span>
    <h2 class="section-title">Strategy first. Design second. Launch with confidence.</h2>

    <div class="timeline" data-stagger data-stagger-gap="110">
      <div class="timeline-step">
        <div class="timeline-dot" aria-hidden="true"></div>
        <div class="timeline-content">
          <h3 class="timeline-num">01</h3>
          <h4 class="timeline-name">Discovery</h4>
          <p class="timeline-desc">Brand voice, audience, goals, conversion targets</p>
        </div>
      </div>
      <div class="timeline-connector" aria-hidden="true"></div>
      <div class="timeline-step">
        <div class="timeline-dot" aria-hidden="true"></div>
        <div class="timeline-content">
          <h3 class="timeline-num">02</h3>
          <h4 class="timeline-name">Design</h4>
          <p class="timeline-desc">Visual direction, layout system, component design</p>
        </div>
      </div>
      <div class="timeline-connector" aria-hidden="true"></div>
      <div class="timeline-step">
        <div class="timeline-dot" aria-hidden="true"></div>
        <div class="timeline-content">
          <h3 class="timeline-num">03</h3>
          <h4 class="timeline-name">Build</h4>
          <p class="timeline-desc">Performance-first development, mobile-perfect</p>
        </div>
      </div>
      <div class="timeline-connector" aria-hidden="true"></div>
      <div class="timeline-step">
        <div class="timeline-dot" aria-hidden="true"></div>
        <div class="timeline-content">
          <h3 class="timeline-num">04</h3>
          <h4 class="timeline-name">Launch</h4>
          <p class="timeline-desc">QA, Lighthouse audit, SEO check, go live</p>
        </div>
      </div>
    </div>

    <p class="process-note">Best for: new launches, rebrands, and campaign pages.</p>
  </section>

  <!-- ════════════════════════════════════ FAQ -->
  <section class="wd-faq" aria-label="Web design questions answered" data-reveal="up" data-bee-stop>
    <span class="eyebrow">Questions, answered</span>
    <h2 class="section-title">The things people ask before we start.</h2>

    <div class="faq-list" data-stagger data-stagger-gap="60">
      {faqs.map(({ q, a }) => (
        <details class="faq-item">
          <summary class="faq-q">
            <span>{q}</span>
            <span class="faq-mark" aria-hidden="true"></span>
          </summary>
          <p class="faq-a">{a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════ BOLD DARK STATEMENT -->
  <section class="bold-statement" aria-label="Web design promise">
    <div class="bs-inner">
      <p class="bs-line" data-reveal="up" data-reveal-delay="0">Your site is your first impression.</p>
      <p class="bs-line bs-accent" data-reveal="up" data-reveal-delay="140">Make it unforgettable.</p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════ CTA -->
  <section class="wd-cta-section" aria-label="Start a web design project" data-reveal="fade" data-bee-final data-atmosphere="cta" data-hive-section>
    <div class="hive-glow-ring" style="width:600px;height:600px;left:50%;top:50%;transform:translate(-50%,-50%)" aria-hidden="true"></div>
    <h2 class="cta-title" data-blur-in>Let’s make something they remember.</h2>
    <p class="cta-sub" data-blur-in data-blur-delay="150">Tell us what you’re building. We’ll show you what premium looks like for it.</p>
    <div data-stagger data-stagger-gap="80" class="cta-links">
      <a class="pill pill--filled magnetic" href="https://wa.me/27602551513">WhatsApp us →</a>
      <a class="pill pill--outline magnetic" href="mailto:info@lulidigital.com">Email the desk →</a>
    </div>
  </section>

</BaseLayout>


<style>
  /* ── Hero ───────────────────────────────────────────────────── */
  .wd-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(72px, 10vw, 120px) 0 clamp(56px, 7vw, 88px);
    isolation: isolate;
    background:
      radial-gradient(circle at 50% 0%, rgba(123,45,45,.10), transparent 42%),
      radial-gradient(circle at 80% 18%, rgba(245,164,31,.10), transparent 34%),
      linear-gradient(180deg, rgba(255,255,255,.28), transparent 70%);
  }
  .wd-grid-field {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(90deg, rgba(123,45,45,.05) 1px, transparent 1px),
      linear-gradient(0deg, rgba(123,45,45,.04) 1px, transparent 1px);
    background-size: 72px 72px, 72px 72px;
    mask-image: radial-gradient(circle at 50% 36%, #000 0%, #000 46%, transparent 78%);
  }
  .wd-eyebrow { color: var(--brand, #7b2d2d); }

  .wd-hero-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .wd-title {
    font-size: clamp(34px, 5.4vw, 66px);
    font-weight: 700; line-height: 1.04; letter-spacing: -.038em;
    margin: 16px 0 22px;
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    color: var(--ink, #141312); max-width: 640px;
  }
  .wd-sub {
    font-size: clamp(15px, 1.8vw, 18px); line-height: 1.65;
    color: var(--muted, rgba(20,19,18,.66)); margin: 0 auto 32px; max-width: 520px;
  }
  .wd-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .wd-capabilities {
    margin: 30px 0 0;
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600;
    color: var(--muted, rgba(20,19,18,.5));
    font-family: var(--font-body, "DM Sans", sans-serif);
  }

  /* Pills */
  .pill {
    display: inline-flex; align-items: center; gap: 8px; padding: 13px 26px;
    border-radius: 999px; font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
    font-weight: 700; text-decoration: none; cursor: pointer; will-change: transform;
    transition: box-shadow 250ms ease, background 200ms ease, color 200ms ease;
  }
  .pill--filled { background: var(--brand); color: #f9f5ef; box-shadow: 0 8px 28px rgba(123,45,45,.35); }
  .pill--filled:hover { box-shadow: 0 14px 36px rgba(123,45,45,.48); background: #6a2828; }
  .pill--outline { border: 1.5px solid var(--brand); color: var(--brand); }
  .pill--outline:hover { background: rgba(123,45,45,.07); }

  /* ── What premium means ─────────────────────────────────────── */
  .wd-principles { padding: clamp(64px, 8vw, 96px) 0; border-top: 1px solid rgba(30,24,22,.1); }
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(28px, 4vw, 56px);
    margin-top: clamp(36px, 5vw, 56px);
  }
  .principle {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 22px;
    border-top: 1px solid rgba(123,45,45,.18);
  }
  .principle-index {
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    font-size: 13px; font-weight: 700; letter-spacing: .14em;
    color: var(--honey-mid, #f5a41f);
  }
  .principle-title {
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    font-size: clamp(19px, 2.2vw, 24px); font-weight: 700; letter-spacing: -.02em;
    line-height: 1.18; margin: 0; color: var(--ink, #141312);
  }
  .principle-desc {
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 14px; line-height: 1.7; margin: 0;
    color: var(--muted, rgba(20,19,18,.64));
  }

  /* ── Process ────────────────────────────────────────────────── */
  .wd-process { padding: 72px 0 80px; border-top: 1px solid rgba(30,24,22,.1); }
  .timeline { display: flex; align-items: flex-start; margin: 36px 0 24px; overflow-x: auto; }
  .timeline-step { flex: 1; min-width: 120px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; padding: 0 8px; }
  .timeline-dot {
    width: 12px; height: 12px; border-radius: 50%; background: var(--brand, #7b2d2d); flex-shrink: 0;
    animation: tdotPulse 2.4s ease-in-out infinite;
  }
  .timeline-step:nth-child(3) .timeline-dot { animation-delay: .6s; }
  .timeline-step:nth-child(5) .timeline-dot { animation-delay: 1.2s; }
  .timeline-step:nth-child(7) .timeline-dot { animation-delay: 1.8s; }
  @keyframes tdotPulse { 0%,100%{box-shadow:0 0 0 0 rgba(123,45,45,0)} 50%{box-shadow:0 0 0 5px rgba(123,45,45,.15)} }
  .timeline-connector { width: 48px; height: 1px; background: var(--brand, #7b2d2d); opacity: .28; margin-top: 6px; flex-shrink: 0; }
  .timeline-num { font-size: 11px; font-weight: 700; letter-spacing: .12em; color: var(--brand, #7b2d2d); margin: 0; }
  .timeline-name { font-size: 14px; font-weight: 700; letter-spacing: -.01em; margin: 0; color: var(--ink, #141312); font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif); }
  .timeline-desc { font-size: 12px; color: var(--muted, rgba(20,19,18,.6)); line-height: 1.5; margin: 0; }
  .process-note { font-size: 13px; color: var(--muted, rgba(20,19,18,.55)); margin: 0; }

  /* ── FAQ ────────────────────────────────────────────────────── */
  .wd-faq { padding: 72px 0 80px; border-top: 1px solid rgba(30,24,22,.1); }
  .faq-list { margin-top: clamp(28px, 4vw, 44px); }
  .faq-item { border-bottom: 1px solid rgba(30,24,22,.1); }
  .faq-q {
    display: flex; align-items: center; justify-content: space-between; gap: 18px;
    cursor: pointer; list-style: none;
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    font-size: clamp(17px, 2vw, 22px); font-weight: 600; letter-spacing: -.012em;
    line-height: 1.3; color: var(--ink, #141312); padding: 22px 0;
    transition: color 200ms ease;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q:hover { color: var(--brand, #7b2d2d); }
  .faq-mark { position: relative; width: 14px; height: 14px; flex-shrink: 0; }
  .faq-mark::before, .faq-mark::after {
    content: ""; position: absolute; background: var(--brand, #7b2d2d); border-radius: 2px;
    transition: transform 260ms ease, opacity 200ms ease;
  }
  .faq-mark::before { left: 0; top: 6px; width: 14px; height: 2px; }
  .faq-mark::after { left: 6px; top: 0; width: 2px; height: 14px; }
  .faq-item[open] .faq-mark::after { transform: rotate(90deg); opacity: 0; }
  .faq-a {
    margin: 0; padding: 0 0 24px; max-width: 700px;
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 14px; line-height: 1.78; color: var(--muted, rgba(20,19,18,.66));

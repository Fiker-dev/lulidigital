---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getWeeklyPageSeoTarget } from "../lib/seoAgent.js";

export const prerender = false;

const seoTarget = getWeeklyPageSeoTarget("/marketing-desk");

Astro.response.headers.set("Cache-Control", "s-maxage=604800, stale-while-revalidate=86400");

const serviceSchema = {
  "name": "Digital Marketing, Performance Marketing & Brand Strategy Services",
  "serviceType": [
    "digital marketing services",
    "performance marketing agency",
    "brand strategy services",
    "paid media management",
    "social media marketing agency",
    "content marketing services",
    "SEO services for small business",
    "Meta ads management",
    "Google ads management",
    "TikTok marketing agency",
    "campaign management services",
    "creative direction services",
    "growth marketing services",
    "digital marketing agency for founders",
    "AI powered digital marketing",
    "AI marketing automation",
  ],
  "description": "Digital marketing services for founders and growing brands: paid media management, brand strategy, SEO, content marketing, and performance campaigns across Meta, Google, and TikTok.",
};

const mktMarquee = [
  "Meta Ads", "Google Campaigns", "TikTok Strategy", "Brand Positioning",
  "Content Calendar", "Paid Media", "SEO", "Campaign Launch",
  "Creative Direction", "Performance Marketing", "Brand Voice", "Audience Strategy",
];
---

<BaseLayout
  title="Digital Marketing Services, Performance Marketing & Brand Strategy | LuliDigital"
  description="Digital marketing services for founders and growing brands: paid media management, brand strategy, SEO, content marketing, and performance campaigns across Meta, Google, and TikTok."
  active="marketing"
  seoTarget={seoTarget}
  serviceSchema={serviceSchema}
>

  <!-- ═══════════════════════════════════════════════════════ HERO -->
  <section class="mkt-hero" aria-label="Marketing services" data-bee-stop data-atmosphere="hero" data-hive-section>
    <div class="mkt-signal-field" aria-hidden="true"></div>

    <div class="mkt-hero-split">
      <div class="mkt-hero-text">
        <span class="eyebrow mkt-eyebrow" data-blur-in>Campaign Studio</span>
        <h1 class="mkt-title" data-word-reveal>
          Get found. Get understood. Get chosen.
        </h1>
        <p class="mkt-sub" data-blur-in data-blur-delay="200">
          Brand strategy, performance marketing, and paid media across Meta, Google, and TikTok —
          content and campaigns that turn quiet attention into customers who choose you.
        </p>
        <div class="mkt-ctas" data-stagger data-stagger-gap="80">
          <a class="pill pill--filled magnetic" href="https://wa.me/27602551513">Request a walkthrough</a>
          <a class="pill pill--outline magnetic" href="/ai-desk">Visit AI Desk</a>
        </div>
      </div>

      <!-- Animated growth chart character -->
      <div class="mkt-chart" aria-hidden="true">
        <div class="mc-flight-line"></div>
        <div class="mc-header">
          <span class="mc-label">Campaign Performance</span>
          <span class="mc-live"><span class="mc-live-dot"></span>Live</span>
        </div>
        <div class="mc-bars">
          <div class="mc-bar-wrap" style="--bh:38%;--bd:0ms">
            <div class="mc-bar"></div>
            <span class="mc-bar-label">Jan</span>
          </div>
          <div class="mc-bar-wrap" style="--bh:52%;--bd:80ms">
            <div class="mc-bar"></div>
            <span class="mc-bar-label">Feb</span>
          </div>
          <div class="mc-bar-wrap" style="--bh:44%;--bd:160ms">
            <div class="mc-bar"></div>
            <span class="mc-bar-label">Mar</span>
          </div>
          <div class="mc-bar-wrap" style="--bh:68%;--bd:240ms">
            <div class="mc-bar"></div>
            <span class="mc-bar-label">Apr</span>
          </div>
          <div class="mc-bar-wrap" style="--bh:75%;--bd:320ms">
            <div class="mc-bar"></div>
            <span class="mc-bar-label">May</span>
          </div>
          <div class="mc-bar-wrap mc-bar-wrap--accent" style="--bh:91%;--bd:400ms">
            <div class="mc-bar"></div>
            <span class="mc-bar-label">Now</span>
          </div>
        </div>
        <div class="mc-stats">
          <div class="mc-stat">
            <span class="mc-stat-num mc-stat-word">Offer</span>
            <span class="mc-stat-label">clearer</span>
          </div>
          <div class="mc-stat-div"></div>
          <div class="mc-stat">
            <span class="mc-stat-num mc-stat-word">SEO</span>
            <span class="mc-stat-label">structured</span>
          </div>
          <div class="mc-stat-div"></div>
          <div class="mc-stat">
            <span class="mc-stat-num mc-stat-word">Launch</span>
            <span class="mc-stat-label">ready</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════ MARQUEE -->
  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee-track">
      {[...mktMarquee, ...mktMarquee].map((item) => (
        <span class="marquee-item">{item}</span>
      ))}
    </div>
  </div>

  <section class="selling-point selling-point--marketing" aria-label="AI powered digital marketing selling point" data-reveal="up" data-bee-stop data-atmosphere="marketing" data-hive-section>
    <span class="eyebrow">Why This Works</span>
    <h2 class="selling-title">You get digital marketing powered by AI, guided by human strategy.</h2>
    <p class="selling-copy">
      Your campaigns should not guess. We use AI where it makes the work faster and sharper:
      audience research, keyword direction, content angles, campaign reporting, and optimisation signals.
      Then we bring the human judgment that keeps your brand clear, trustworthy, and worth choosing.
    </p>
    <p class="selling-copy selling-copy--direct">
      Want to know how this would work for your business? Talk to the desk and we will walk you through it.
    </p>
    <div class="selling-links">
      <a class="pill pill--filled magnetic" href="https://wa.me/27602551513">WhatsApp the desk</a>
      <a class="pill pill--outline magnetic" href="mailto:info@lulidigital.com">Email the desk</a>
    </div>
  </section>

  <!-- ════════════════════════════════════════ PROCESS TIMELINE -->
  <section class="process-section" aria-label="Marketing process" data-reveal="up" data-bee-stop>
    <span class="eyebrow">The Process</span>
    <h2 class="section-title">Clean story. Clear offer. Measurable lift.</h2>

    <div class="timeline" data-stagger data-stagger-gap="110">
      <div class="timeline-step">
        <div class="timeline-dot" aria-hidden="true"></div>
        <div class="timeline-content">
          <h3 class="timeline-num">01</h3>
          <h4 class="timeline-name">Brand</h4>
          <p class="timeline-desc">Positioning, voice, visual direction</p>
        </div>
      </div>
      <div class="timeline-connector" aria-hidden="true"></div>
      <div class="timeline-step">
        <div class="timeline-dot" aria-hidden="true"></div>
        <div class="timeline-content">
          <h3 class="timeline-num">02</h3>
          <h4 class="timeline-name">Content</h4>
          <p class="timeline-desc">Scripts, hooks, shoot-day planning</p>
        </div>
      </div>
      <div class="timeline-connector" aria-hidden="true"></div>
      <div class="timeline-step">
        <div class="timeline-dot" aria-hidden="true"></div>
        <div class="timeline-content">
          <h3 class="timeline-num">03</h3>
          <h4 class="timeline-name">Paid Media</h4>
          <p class="timeline-desc">Meta, Google, TikTok campaigns</p>
        </div>
      </div>
      <div class="timeline-connector" aria-hidden="true"></div>
      <div class="timeline-step">
        <div class="timeline-dot" aria-hidden="true"></div>
        <div class="timeline-content">
          <h3 class="timeline-num">04</h3>
          <h4 class="timeline-name">Report &amp; Iterate</h4>
          <p class="timeline-desc">Weekly learnings, monthly compounding</p>
        </div>
      </div>
    </div>

    <p class="process-note">Best for: Launches, rebrands, and growth sprints — weekly reporting, monthly iteration.</p>
  </section>

  <!-- ═══════════════════════════════════════════ METRICS STRIP -->
  <div class="metrics-strip" aria-label="Marketing impact" data-reveal="up">
    <div class="metric-item">
      <span class="metric-num metric-word">Clear offer</span>
      <span class="metric-label">positioning people understand</span>
    </div>
    <div class="metric-divider" aria-hidden="true"></div>
    <div class="metric-item">
      <span class="metric-num metric-word">Better SEO</span>
      <span class="metric-label">pages built around search intent</span>
    </div>
    <div class="metric-divider" aria-hidden="true"></div>
    <div class="metric-item">
      <span class="metric-num metric-word">Smarter ads</span>
      <span class="metric-label">campaigns guided by learning</span>
    </div>
  </div>

  <!-- ══════════════════════════════════════════ SERVICE BENTO GRID -->
  <section class="mkt-services" aria-label="Marketing services we offer" data-reveal="up" data-bee-stop data-atmosphere="services" data-hive-section>
    <span class="eyebrow">What We Do</span>
    <div class="bento-grid" data-stagger data-stagger-gap="70">

      <article class="glow-card svc-card" data-tilt="7" data-reveal="float-l" data-reveal-delay="0">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:10px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 14.14 14.14"/></svg>
          </div>
          <h3 class="svc-title">Brand Strategy &amp; Positioning</h3>
          <p class="svc-desc">Messaging architecture, brand voice, competitive positioning, and visual identity systems built to win in your market.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="drop" data-reveal-delay="80">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:10px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
          </div>
          <h3 class="svc-title">Paid Media Management</h3>
          <p class="svc-desc">Performance campaigns across Meta, Google, and TikTok — audience strategy, creative testing, budget management, and weekly reporting.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="float-r" data-reveal-delay="160">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:10px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>
          </div>
          <h3 class="svc-title">Content Marketing &amp; SEO</h3>
          <p class="svc-desc">Content systems, editorial calendars, and SEO strategy that build organic visibility and keep your brand present at every stage.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="float-l" data-reveal-delay="80">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:10px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
          </div>
          <h3 class="svc-title">Creative Direction</h3>
          <p class="svc-desc">On-brand visual direction, campaign angles, shoot-day planning, and consistency audits so every asset earns its place.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="pop" data-reveal-delay="160">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:10px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </div>
          <h3 class="svc-title">Performance Optimisation</h3>
          <p class="svc-desc">Conversion rate testing, landing page strategy, tracking setup, and monthly iteration cycles that compound results over time.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="float-r" data-reveal-delay="240">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:10px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 19-9-9 19-2-8-8-2z"/></svg>
          </div>
          <h3 class="svc-title">Campaign Production</h3>
          <p class="svc-desc">Full-funnel campaign builds — from positioning and hooks to creative assets, launch management, and post-campaign reporting.</p>
        </div>
      </article>

    </div>
  </section>

  <!-- ════════════════════════════════════════ STRATEGY FLOW GRID -->
  <section class="strategy-section" aria-label="Marketing strategy overview" data-reveal="up" data-bee-stop>
    <span class="eyebrow">The Full System</span>
    <h2 class="section-title">Every piece connected.</h2>
    <div class="strategy-flow" data-stagger data-stagger-gap="80">
      <div class="how-node">
        <span class="how-node-num">01</span>
        <span class="how-node-title">Brand Strategy</span>
        <span class="how-node-sub">Positioning · Voice · Visual direction</span>
      </div>
      <div class="how-node">
        <span class="how-node-num">02</span>
        <span class="how-node-title">Content System</span>
        <span class="how-node-sub">Scripts · Hooks · Shoot planning · Posting rhythm</span>
      </div>
      <div class="how-node how-node--accent">
        <span class="how-node-num">03</span>
        <span class="how-node-title">Paid Media</span>
        <span class="how-node-sub">Meta · Google · TikTok · Budget management</span>
      </div>
      <div class="how-node">
        <span class="how-node-num">04</span>
        <span class="how-node-title">Report &amp; Iterate</span>
        <span class="how-node-sub">Weekly learnings · Monthly compounding · Growth</span>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ BOLD DARK STATEMENT -->
  <section class="bold-statement" aria-label="Marketing promise">
    <div class="bs-hive-overlay" aria-hidden="true">⬡ ⬡ ⬡ ⬡ ⬡ ⬡ ⬡ ⬡ ⬡</div>
    <div class="bs-inner">
      <p class="bs-line" data-reveal="up" data-reveal-delay="0">Invisible brands go nowhere.</p>
      <p class="bs-line bs-accent" data-reveal="up" data-reveal-delay="140">Let's fix that.</p>
    </div>
    <div class="bs-reel" aria-hidden="true">
      <div class="bs-reel-track">
        <span class="bsr-word">Meta</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Google</span><span class="bsr-sep">—</span>
        <span class="bsr-word">TikTok</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Brand</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Content</span><span class="bsr-sep">—</span>
        <span class="bsr-word">SEO</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Meta</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Google</span><span class="bsr-sep">—</span>
        <span class="bsr-word">TikTok</span><span class="bsr-sep">—</span>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════ LIVE DESK FEED -->
  <div class="desk-feed" aria-hidden="true">
    <span class="df-badge"><span class="df-dot"></span>Live</span>
    <div class="df-track-wrap">
      <div class="df-track">
        {[
          "Audience research complete — strongest search angles selected",
          "Creative refresh queued — stronger hooks ready for testing",
          "Landing page story tightened — offer easier to understand",
          "Google campaign mapped — keywords grouped by intent",
          "Content system live — posts aligned with the offer",
          "SEO content compounding — pages built around buyer questions",
          "Audience research complete — strongest search angles selected",
          "Creative refresh queued — stronger hooks ready for testing",
          "Landing page story tightened — offer easier to understand",
        ].map((item) => (
          <>
            <span class="df-item">{item}</span>
            <span class="df-sep" aria-hidden="true">·</span>
          </>
        ))}
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════ CTA -->
  <section class="mkt-cta-section" aria-label="Get started with marketing" data-reveal="fade" data-bee-final data-atmosphere="cta" data-hive-section>
    <div class="hive-glow-ring" style="width:600px;height:600px;left:50%;top:50%;transform:translate(-50%,-50%)" aria-hidden="true"></div>
    <h2 class="cta-title" data-blur-in>Let’s get you seen.</h2>
    <p class="cta-sub" data-blur-in data-blur-delay="150">You built something good. Let’s make sure the right people find it.</p>
    <div data-stagger data-stagger-gap="80" class="cta-links">
      <a class="pill pill--filled magnetic" href="https://wa.me/27602551513">WhatsApp us →</a>
      <a class="pill pill--outline magnetic" href="mailto:info@lulidigital.com">Email the desk →</a>
    </div>
  </section>

</BaseLayout>


<style>
  /* ── Hero ───────────────────────────────────────────────────── */
  .mkt-hero {
    position: relative; overflow: hidden;
    padding: 88px 0 72px;
    isolation: isolate;
    background:
      linear-gradient(135deg, rgba(123,45,45,.08), transparent 38%),
      linear-gradient(180deg, rgba(255,255,255,.25), transparent 72%);
  }
  .mkt-signal-field {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(90deg, rgba(123,45,45,.09) 1px, transparent 1px),
      linear-gradient(0deg, rgba(123,45,45,.07) 1px, transparent 1px),
      radial-gradient(circle at 76% 24%, rgba(255,177,66,.22), transparent 28%);
    background-size: 72px 72px, 72px 72px, 100% 100%;
    mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    animation: signalPan 18s linear infinite;
  }
  @keyframes signalPan {
    to { background-position: 72px 0, 0 72px, 0 0; }
  }
  .mkt-eyebrow { color: #a35b20; }

  .mkt-hero-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 380px);
    gap: clamp(28px, 5vw, 48px);
    align-items: center;
  }
  .mkt-hero-text { text-align: left; }

  .mkt-title {
    font-size: clamp(32px, 4.5vw, 60px);
    font-weight: 700; line-height: 1.06; letter-spacing: -.035em;
    margin: 14px 0 20px;
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    color: var(--ink, #141312); max-width: 580px;
  }
  .mkt-sub {
    font-size: clamp(15px, 1.8vw, 17px); line-height: 1.65;
    color: var(--muted, rgba(20,19,18,.66)); margin: 0 0 32px; max-width: 480px;
  }
  .mkt-ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  /* Pills */
  .pill {
    display: inline-flex; align-items: center; gap: 8px; padding: 13px 26px;
    border-radius: 999px; font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
    font-weight: 700; text-decoration: none; cursor: pointer; will-change: transform;
    transition: box-shadow 250ms ease, background 200ms ease, color 200ms ease;
  }
  .pill--filled { background: var(--brand); color: #f9f5ef; box-shadow: 0 8px 28px rgba(123,45,45,.35); }
  .pill--filled:hover { box-shadow: 0 14px 36px rgba(123,45,45,.48); background: #6a2828; }
  .pill--outline { border: 1.5px solid var(--brand); color: var(--brand); }
  .pill--outline:hover { background: rgba(123,45,45,.07); }

  /* ── Chart Character ────────────────────────────────────────── */
  .mkt-chart {
    position: relative;
    background: var(--paper-card, #f6f2ea);
    border: 1px solid rgba(30,24,22,.12);
    border-radius: 14px; overflow: hidden;
    box-shadow: 0 18px 36px rgba(61,37,20,.12), 0 2px 8px rgba(123,45,45,.08);
    animation: chartFloat 6s ease-in-out infinite;
    will-change: transform;
    padding: 20px;
  }
  .mkt-chart::before {
    content: "";
    position: absolute;
    inset: 12px;
    border-radius: 10px;
    border: 1px dashed rgba(163,91,32,.18);
    pointer-events: none;
  }
  .mc-flight-line {
    position: absolute;
    left: -18%;
    right: -18%;
    top: 64%;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(245,164,31,.78), transparent);
    transform: rotate(-18deg);
    opacity: .9;
    animation: lineSweep 3.8s ease-in-out infinite;
  }
  @keyframes lineSweep {
    0%,100% { transform: translateX(-16%) rotate(-18deg); opacity: .15; }
    48% { transform: translateX(16%) rotate(-18deg); opacity: .95; }
  }
  @keyframes chartFloat {
    0%,100% { transform: translateY(0) rotate(0deg); }
    45%     { transform: translateY(-12px) rotate(.3deg); }
    75%     { transform: translateY(-5px) rotate(-.2deg); }
  }
  .mc-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px;
  }
  .mc-label {
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--muted, rgba(20,19,18,.55)); font-weight: 600;
    font-family: var(--font-body, "DM Sans", sans-serif);
  }
  .mc-live {
    display: flex; align-items: center; gap: 6px;
    font-size: 10px; letter-spacing: .14em; text-transform: uppercase;
    color: #22c55e; font-weight: 700;
    font-family: var(--font-body, "DM Sans", sans-serif);
  }
  .mc-live-dot {
    width: 6px; height: 6px; border-radius: 50%; background: #22c55e;
    box-shadow: 0 0 8px rgba(34,197,94,.7); animation: badgePulse 2s ease-in-out infinite;
  }
  .mc-bars {
    display: flex; align-items: flex-end; gap: 8px; height: 100px; margin-bottom: 16px;
  }
  .mc-bar-wrap {
    display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1;
  }
  .mc-bar {
    width: 100%; border-radius: 4px 4px 0 0;
    background: rgba(123,45,45,.25);
    height: 0;
    animation: barRise 700ms cubic-bezier(.34,1.4,.64,1) forwards;
    animation-delay: calc(var(--bd, 0ms) + 600ms);
    --final-h: var(--bh, 60%);
  }
  @keyframes barRise { to { height: var(--final-h); } }

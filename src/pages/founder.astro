---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDailySeoRecommendation, getWeeklyPageSeoTarget } from "../lib/seoAgent.js";

export const prerender = false;

const seoRecommendation = await getDailySeoRecommendation({ geo: "NL", market: "founder" });
const seoTarget = getWeeklyPageSeoTarget("/founder");

Astro.response.headers.set("Cache-Control", "s-maxage=21600, stale-while-revalidate=86400");

const title = "Fiker Abate — Founder & Studio Lead | LuliDigital";
const description = "Former healthcare worker. Now founder of LuliDigital — a creative agency built to take brands from invisible to unforgettable.";

const personSchema = {
  "@type": "Person",
  "@id": "https://lulidigital.com/founder#person",
  "name": "Fiker Abate",
  "jobTitle": "Founder & Studio Lead",
  "worksFor": { "@id": "https://lulidigital.com/#organization" },
  "url": "https://lulidigital.com/founder",
  "image": "https://lulidigital.com/images/founder/fiker-portrait.jpg",
  "description": "Fiker Abate is the founder of LuliDigital, a creative agency providing AI Automation, Marketing, and Virtual Assistant services to fast-scaling teams across Europe and the US.",
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/founder"
  active="founder"
  ogImage="/images/founder/fiker-portrait.jpg"
  seoTarget={seoTarget}
  extraSchemas={[personSchema]}
>

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="f-hero" data-atmosphere="hero" data-hive-section>
    <div class="f-hero__inner">
      <div class="f-hero__text">
        <span class="f-badge">Founder & Studio Lead</span>
        <h1 class="f-hero__name">Fiker<br/><em>Abate.</em></h1>
        <p class="f-hero__line">
          Healthcare worker.<br/>
          <strong>Agency builder.</strong>
        </p>
        <a class="f-cta-pill" href="/contact">Work with me <span aria-hidden="true">→</span></a>
      </div>
      <div class="f-hero__portrait">
        <div class="f-portrait-frame">
          <img
            src="/images/founder/fiker-portrait.jpg"
            alt="Fiker Abate — Founder of LuliDigital"
            width="520" height="640"
            loading="eager"
            fetchpriority="high"
          />
          <div class="f-portrait-overlay" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── THE ARC ───────────────────────────────────────────────── -->
  <section class="f-arc" data-atmosphere="hero" data-hive-section>
    <div class="f-arc__inner">
      <div class="f-arc__panel f-arc__panel--before" data-reveal="up">
        <span class="f-arc__label">Then</span>
        <p class="f-arc__copy">
          Hospital corridors.<br/>12-hour shifts.<br/>Someone else's ceiling.
        </p>
      </div>
      <div class="f-arc__divider" aria-hidden="true">
        <span class="f-arc__arrow">↓</span>
        <span class="f-arc__since">LuliDigital</span>
        <span class="f-arc__arrow">↓</span>
      </div>
      <div class="f-arc__panel f-arc__panel--after" data-reveal="up" data-reveal-delay="80">
        <span class="f-arc__label">Now</span>
        <p class="f-arc__copy">
          A creative agency.<br/>Built from scratch.<br/><strong>No ceiling.</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- ── WHO THIS IS FOR ───────────────────────────────────────── -->
  <section class="f-who" data-atmosphere="marketing" data-hive-section>
    <div class="f-who__inner">
      <span class="f-eyebrow">This is for you if —</span>
      <ul class="f-who__list" role="list">
        <li data-reveal="up" data-reveal-delay="0">Your work is brilliant. <em>Your brand isn't showing it.</em></li>
        <li data-reveal="up" data-reveal-delay="60">You're doing everything. <em>Something has to give.</em></li>
        <li data-reveal="up" data-reveal-delay="120">You're ready to grow. <em>You just need the team.</em></li>
        <li data-reveal="up" data-reveal-delay="180">You've outgrown where you started. <em>You just haven't moved yet.</em></li>
      </ul>
    </div>
  </section>

  <!-- ── THE LIFT ───────────────────────────────────────────────── -->
  <section class="f-lift" data-atmosphere="ai" data-hive-section>
    <div class="f-lift__inner">
      <span class="f-eyebrow">What changes</span>
      <div class="f-lift__rows">
        <div class="f-lift__row" data-reveal="up" data-reveal-delay="0">
          <span class="f-lift__before">Invisible</span>
          <span class="f-lift__bridge" aria-hidden="true">→</span>
          <span class="f-lift__after">Unmissable</span>
        </div>
        <div class="f-lift__row" data-reveal="up" data-reveal-delay="60">
          <span class="f-lift__before">Scattered</span>
          <span class="f-lift__bridge" aria-hidden="true">→</span>
          <span class="f-lift__after">Strategic</span>
        </div>
        <div class="f-lift__row" data-reveal="up" data-reveal-delay="120">
          <span class="f-lift__before">Overwhelmed</span>
          <span class="f-lift__bridge" aria-hidden="true">→</span>
          <span class="f-lift__after">Operating</span>
        </div>
        <div class="f-lift__row" data-reveal="up" data-reveal-delay="180">
          <span class="f-lift__before">Average presence</span>
          <span class="f-lift__bridge" aria-hidden="true">→</span>
          <span class="f-lift__after">Premium brand</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── THE DESKS ─────────────────────────────────────────────── -->
  <section class="f-desks" data-atmosphere="services" data-hive-section>
    <div class="f-desks__inner">
      <span class="f-eyebrow">The tools I built</span>
      <div class="f-desks__list">
        <a class="f-desk-item" href="/marketing-desk" data-reveal="up" data-reveal-delay="0">
          <span class="f-desk-num">01</span>
          <span class="f-desk-name">Marketing Desk</span>
          <span class="f-desk-word">Reach</span>
          <span class="f-desk-arrow" aria-hidden="true">→</span>
        </a>
        <a class="f-desk-item" href="/ai-desk" data-reveal="up" data-reveal-delay="60">
          <span class="f-desk-num">02</span>
          <span class="f-desk-name">AI Desk</span>
          <span class="f-desk-word">Leverage</span>
          <span class="f-desk-arrow" aria-hidden="true">→</span>
        </a>
        <a class="f-desk-item" href="/va-desk" data-reveal="up" data-reveal-delay="120">
          <span class="f-desk-num">03</span>
          <span class="f-desk-name">VA Desk</span>
          <span class="f-desk-word">Capacity</span>
          <span class="f-desk-arrow" aria-hidden="true">→</span>
        </a>
        <a class="f-desk-item" href="/web-design-desk" data-reveal="up" data-reveal-delay="180">
          <span class="f-desk-num">04</span>
          <span class="f-desk-name">Web Design Desk</span>
          <span class="f-desk-word">Presence</span>
          <span class="f-desk-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────── -->
  <section class="f-final" data-atmosphere="cta" data-hive-section data-bee-final>
    <div class="f-final__inner">
      <p class="f-final__pre">You've seen the arc.</p>
      <h2 class="f-final__title">Ready to<br/><em>move up?</em></h2>
      <div class="f-final__actions">
        <a class="f-cta-pill f-cta-pill--light" href="/contact">Start the conversation <span aria-hidden="true">→</span></a>
        <a class="f-cta-pill f-cta-pill--ghost" href="https://wa.me/27602551513" target="_blank" rel="noopener noreferrer">WhatsApp Fiker</a>
      </div>
    </div>
    <div class="hive-glow-ring" aria-hidden="true"></div>
  </section>

</BaseLayout>

<style>

  /* ─── HERO ──────────────────────────────────────────── */
  .f-hero {
    padding: clamp(72px, 10vw, 140px) 0 clamp(56px, 8vw, 100px);
    overflow: hidden;
  }
  .f-hero__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 56px);
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .f-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--brand, #7b2d2d);
    font-family: var(--font-body, "DM Sans", sans-serif);
    margin-bottom: 20px;
  }
  .f-hero__name {
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    font-size: clamp(64px, 10vw, 120px);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -.04em;
    color: var(--ink, #141312);
    margin: 0 0 28px;
  }
  .f-hero__name em {
    font-style: italic;
    color: var(--brand, #7b2d2d);
  }
  .f-hero__line {
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    font-size: clamp(20px, 2.8vw, 34px);
    line-height: 1.3;
    color: var(--muted, rgba(20,19,18,.55));
    margin: 0 0 36px;
    font-weight: 400;
  }
  .f-hero__line strong {
    color: var(--ink, #141312);
    font-weight: 700;
  }
  .f-portrait-frame {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4/5;
    background: linear-gradient(145deg, rgba(245,164,31,.1), rgba(123,45,45,.07));
  }
  .f-portrait-frame img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  .f-portrait-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(123,45,45,.22) 0%, transparent 50%);
    pointer-events: none;
  }

  /* ─── ARC ───────────────────────────────────────────── */
  .f-arc {
    padding: clamp(56px, 7vw, 96px) 0;
    border-top: 1px solid rgba(30,24,22,.08);
    border-bottom: 1px solid rgba(30,24,22,.08);
  }
  .f-arc__inner {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 56px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 32px;
    align-items: center;
  }
  .f-arc__panel {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .f-arc__panel--after {
    text-align: right;
  }
  .f-arc__label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    font-family: var(--font-body, "DM Sans", sans-serif);
  }
  .f-arc__panel--before .f-arc__label { color: rgba(20,19,18,.35); }
  .f-arc__panel--after  .f-arc__label { color: var(--brand, #7b2d2d); }
  .f-arc__copy {
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    font-size: clamp(18px, 2.2vw, 26px);
    line-height: 1.35;
    margin: 0;
  }
  .f-arc__panel--before .f-arc__copy { color: rgba(20,19,18,.38); }
  .f-arc__panel--after  .f-arc__copy { color: var(--ink, #141312); }
  .f-arc__panel--after  .f-arc__copy strong { color: var(--brand, #7b2d2d); }
  .f-arc__divider {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: var(--honey-mid, #f5a41f);
  }
  .f-arc__arrow {
    font-size: 18px;
    opacity: .5;
  }
  .f-arc__since {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .24em;
    text-transform: uppercase;
    font-family: var(--font-body, "DM Sans", sans-serif);
    color: var(--honey-mid, #f5a41f);
    writing-mode: vertical-rl;
    padding: 8px 0;
  }

  /* ─── WHO ───────────────────────────────────────────── */
  .f-who {
    padding: clamp(72px, 9vw, 120px) 0;
  }
  .f-who__inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 56px);
  }
  .f-eyebrow {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--brand, #7b2d2d);
    font-family: var(--font-body, "DM Sans", sans-serif);
    margin-bottom: 36px;
  }
  .f-who__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .f-who__list li {
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    font-size: clamp(22px, 3.2vw, 40px);
    font-weight: 600;
    line-height: 1.2;
    color: rgba(20,19,18,.28);
    padding: clamp(18px, 2.5vw, 28px) 0;
    border-bottom: 1px solid rgba(30,24,22,.07);
    transition: color 400ms ease;
  }
  .f-who__list li:hover { color: var(--ink, #141312); }
  .f-who__list li em {
    font-style: italic;
    color: var(--ink, #141312);
  }

  /* ─── LIFT ──────────────────────────────────────────── */
  .f-lift {
    padding: clamp(72px, 9vw, 120px) 0;
    background: #0f0a09;
    border-top: 1px solid rgba(245,164,31,.08);
    border-bottom: 1px solid rgba(245,164,31,.08);
  }
  .f-lift .f-eyebrow { color: rgba(245,164,31,.5); }
  .f-lift__inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 56px);
  }
  .f-lift__rows {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .f-lift__row {
    display: grid;
    grid-template-columns: 1fr 48px 1fr;
    align-items: center;
    padding: clamp(16px, 2.2vw, 26px) 0;
    border-bottom: 1px solid rgba(245,240,232,.05);
  }
  .f-lift__before {
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    font-size: clamp(20px, 2.8vw, 36px);
    font-weight: 400;
    font-style: italic;
    color: rgba(245,240,232,.22);
    text-align: right;
  }
  .f-lift__bridge {
    text-align: center;
    color: rgba(245,164,31,.35);
    font-size: 20px;
  }
  .f-lift__after {
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    font-size: clamp(20px, 2.8vw, 36px);
    font-weight: 700;
    color: rgba(245,240,232,.88);
  }

  /* ─── DESKS ─────────────────────────────────────────── */
  .f-desks {
    padding: clamp(72px, 9vw, 120px) 0;
    border-bottom: 1px solid rgba(30,24,22,.08);
  }
  .f-desks__inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 56px);
  }
  .f-desks__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 8px;
  }
  .f-desk-item {
    display: grid;
    grid-template-columns: 40px 1fr auto 28px;
    align-items: center;
    gap: 20px;
    padding: clamp(18px, 2.2vw, 26px) 0;
    border-bottom: 1px solid rgba(30,24,22,.08);
    text-decoration: none;
    transition: background 240ms ease;
    border-radius: 4px;
  }
  .f-desk-item:hover { background: rgba(123,45,45,.04); }
  .f-desk-item:hover .f-desk-arrow { opacity: 1; transform: translateX(4px); }
  .f-desk-item:hover .f-desk-name { color: var(--brand, #7b2d2d); }
  .f-desk-num {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .14em;
    color: rgba(20,19,18,.25);
    font-family: var(--font-body, "DM Sans", sans-serif);
  }
  .f-desk-name {
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    font-size: clamp(18px, 2.2vw, 28px);
    font-weight: 600;
    color: var(--ink, #141312);
    transition: color 240ms ease;
  }
  .f-desk-word {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--honey-mid, #f5a41f);
    font-family: var(--font-body, "DM Sans", sans-serif);
  }
  .f-desk-arrow {
    color: var(--brand, #7b2d2d);
    font-size: 16px;
    opacity: 0.3;
    transition: opacity 240ms ease, transform 240ms ease;
  }

  /* ─── CTA ───────────────────────────────────────────── */
  .f-final {
    padding: clamp(96px, 12vw, 160px) 0;
    background: #0f0a09;
    text-align: center;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .f-final__inner {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 56px);
    position: relative;
    z-index: 1;
  }
  .f-final__pre {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: rgba(245,164,31,.5);
    font-family: var(--font-body, "DM Sans", sans-serif);
    margin: 0 0 20px;
  }
  .f-final__title {
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 900;
    letter-spacing: -.04em;
    line-height: 0.95;
    color: rgba(245,240,232,.92);
    margin: 0 0 40px;
  }
  .f-final__title em {
    font-style: italic;
    color: var(--honey-mid, #f5a41f);
  }
  .f-final__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }

  /* ─── SHARED PILL ───────────────────────────────────── */
  .f-cta-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 30px;
    border-radius: 999px;
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    font-weight: 700;
    text-decoration: none;
    background: var(--brand, #7b2d2d);
    color: #f9f5ef;
    box-shadow: 0 10px 28px rgba(123,45,45,.28);
    transition: background 200ms ease, box-shadow 200ms ease;
  }
  .f-cta-pill:hover {
    background: #6a2828;
    box-shadow: 0 16px 40px rgba(123,45,45,.4);
  }
  .f-cta-pill--light {
    background: rgba(245,240,232,.92);
    color: #0f0a09;
    box-shadow: 0 10px 28px rgba(0,0,0,.2);
  }
  .f-cta-pill--light:hover {
    background: #fff;
    box-shadow: 0 16px 40px rgba(0,0,0,.3);
  }
  .f-cta-pill--ghost {
    background: transparent;
    border: 1px solid rgba(245,240,232,.2);
    color: rgba(245,240,232,.7);
    box-shadow: none;
  }
  .f-cta-pill--ghost:hover {
    border-color: rgba(245,240,232,.45);
    color: rgba(245,240,232,.92);
  }

  /* ─── RESPONSIVE ────────────────────────────────────── */
  @media (max-width: 860px) {
    .f-hero__inner { grid-template-columns: 1fr; }
    .f-hero__portrait { order: -1; max-width: 280px; margin: 0 auto; }
    .f-arc__inner { grid-template-columns: 1fr; text-align: center; }
    .f-arc__panel--after { text-align: center; }
    .f-arc__divider { flex-direction: row; writing-mode: horizontal-tb; }
    .f-arc__since { writing-mode: horizontal-tb; padding: 0 8px; }
    .f-lift__row { grid-template-columns: 1fr 32px 1fr; }
    .f-desk-item { grid-template-columns: 32px 1fr auto; }
    .f-desk-arrow { display: none; }
  }
  @media (max-width: 500px) {
    .f-who__list li { font-size: clamp(18px, 5vw, 24px); }
    .f-lift__before, .f-lift__after { font-size: clamp(17px, 4.5vw, 22px); }
    .f-final__actions .f-cta-pill { width: 100%; justify-content: center; }
  }
</style>

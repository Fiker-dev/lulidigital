---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDailySeoRecommendation } from "../lib/seoAgent.js";

const seoRecommendation = await getDailySeoRecommendation();
const dailyKeyword = seoRecommendation.keyword;

const serviceSchema = {
  "name": "Digital Marketing, AI Automation & Executive Virtual Assistant Services",
  "serviceType": [
    dailyKeyword,
    "executive virtual assistant services",
    "remote executive assistant",
    "virtual assistant for founders",
    "digital marketing services",
    "performance marketing agency",
    "brand strategy services",
    "paid media management",
    "SEO services",
    "content marketing services",
    "AI automation services",
    "AI workflow automation",
    "conversational AI assistant",
    "AI agent implementation",
    "business process automation",
    "AI integration services",
  ],
  "description": `LuliDigital helps founders and executives with ${dailyKeyword}, performance marketing, brand strategy, AI workflow automation, conversational AI assistants, and executive virtual assistant services.`,
};
---

<BaseLayout
  title={`LuliDigital | Performance Marketing, AI Automation & Executive Virtual Assistant`}
  description={`LuliDigital helps founders and executives with ${dailyKeyword}, brand strategy, AI workflow automation, conversational AI assistants, and remote executive virtual assistant services.`}
  serviceSchema={serviceSchema}
>

  <!-- ═══════════════════════════════════════════════════════ HERO -->
  <section class="hero" aria-label="Introduction">
    <div class="hero-orb orb-a" aria-hidden="true"></div>
    <div class="hero-orb orb-b" aria-hidden="true"></div>

    <div class="hero-inner">
      <span class="eyebrow" data-blur-in>Digital Studio</span>

      <h1 class="hero-title" data-word-reveal>
        We run your brand, operations, and AI.
      </h1>

      <p class="hero-sub" data-blur-in data-blur-delay="180">
        Marketing. Virtual Assistant. AI Automation.
        LuliDigital works behind the scenes so you focus on what moves the needle.
      </p>

      <div class="hero-ctas" data-stagger data-stagger-gap="90">
        <a class="cta-link" href="/marketing">Marketing Desk <span class="arr">→</span></a>
        <a class="cta-link" href="/ai">AI Desk <span class="arr">→</span></a>
        <a class="cta-link" href="/virtual-assistant">Virtual Assistant <span class="arr">→</span></a>
      </div>

      {dailyKeyword && (
        <p class="seo-chip" aria-label={`Today's content focus: ${dailyKeyword}`}>
          Focus: <span>{dailyKeyword}</span>
        </p>
      )}
    </div>
  </section>

  <!-- ══════════════════════════════════════════════ SERVICES BENTO -->
  <section class="bento-section" aria-label="Services" data-reveal="up">
    <span class="eyebrow">What We Do</span>
    <div class="bento-grid" data-stagger data-stagger-gap="90">

      <article class="glow-card bento-card" aria-label="Marketing services">
        <div class="bento-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
        </div>
        <h2 class="bento-title">Marketing</h2>
        <ul class="bento-list">
          <li>Brand strategy &amp; positioning</li>
          <li>Paid media: Meta, Google, TikTok</li>
          <li>Content systems &amp; SEO</li>
        </ul>
        <a class="cta-link" href="/marketing">Explore <span class="arr">→</span></a>
      </article>

      <article class="glow-card bento-card" aria-label="AI Automation services">
        <div class="bento-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M7 8V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/><circle cx="12" cy="14" r="2"/></svg>
        </div>
        <h2 class="bento-title">AI Automation</h2>
        <ul class="bento-list">
          <li>Conversational AI assistants</li>
          <li>Workflow automation end-to-end</li>
          <li>AI agent implementation</li>
        </ul>
        <a class="cta-link" href="/ai">Explore <span class="arr">→</span></a>
      </article>

      <article class="glow-card bento-card" aria-label="Virtual Assistant services">
        <div class="bento-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h2 class="bento-title">Virtual Assistant</h2>
        <ul class="bento-list">
          <li>Inbox &amp; calendar management</li>
          <li>Project coordination</li>
          <li>Operations follow-through</li>
        </ul>
        <a class="cta-link" href="/virtual-assistant">Explore <span class="arr">→</span></a>
      </article>

    </div>
  </section>

  <!-- ════════════════════════════════════════ HOW IT WORKS (ASCII) -->
  <section class="how-section" aria-label="How LuliDigital works" data-reveal="up">
    <span class="eyebrow">How It Works</span>
    <h2 class="section-title">Three desks. One studio.</h2>

    <pre class="ascii-diagram" role="img" aria-label="Three connected service desks: Marketing leads to Virtual Assistant which leads to AI">
<span class="dim">┌──────────────┐    ┌──────────────┐    ┌──────────────┐</span>
│  <span class="hi">MARKETING</span>   │    │   <span class="hi">VIRTUAL</span>    │    │     <span class="hi">AI</span>       │
│    <span class="hi">DESK</span>     │<span class="hi">───▶</span>│  <span class="hi">ASSISTANT</span>  │<span class="hi">───▶</span>│    <span class="hi">DESK</span>     │
│              │    │     <span class="hi">DESK</span>     │    │              │
<span class="dim">└──────────────┘    └──────────────┘    └──────────────┘</span>
  Brand. Story.       Ops. Clarity.     Systems. Scale.</pre>

    <p class="how-desc">Each desk is distinct but connected. Marketing builds the signal. The VA keeps operations clean. AI scales what works — without scaling headcount.</p>
  </section>

  <!-- ════════════════════════════════════════════════════ STATS ROW -->
  <section class="stats-section" aria-label="Key statistics" data-reveal="fade">
    <div class="stats-grid" data-stagger data-stagger-gap="120">
      <div class="stat">
        <span class="stat-number" data-count="48" data-count-suffix="h">0h</span>
        <span class="stat-label">Average time to first deliverable</span>
      </div>
      <div class="stat">
        <span class="stat-number" data-count="3" data-count-suffix="x">0x</span>
        <span class="stat-label">Services under one studio roof</span>
      </div>
      <div class="stat">
        <span class="stat-number" data-count="100" data-count-suffix="%">0%</span>
        <span class="stat-label">Remote — global founders served</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ CASE STUDIES -->
  <section class="cases-section" aria-label="Client stories" data-reveal="up">
    <span class="eyebrow">In Practice</span>
    <div class="cases-grid" data-stagger data-stagger-gap="70">

      <article class="case-card glow-card">
        <div class="case-label">Marketing</div>
        <h3 class="case-name">Jane</h3>
        <p class="case-summary">Brand built. Visible online. Customers found her.</p>
        <p class="case-detail">She got brand voice, creative direction, a finished website, and SEO that made her show up. Jando never caught up.</p>
        <a class="cta-link" href="/marketing">Marketing Desk <span class="arr">→</span></a>
      </article>

      <article class="case-card glow-card">
        <div class="case-label">AI Automation</div>
        <h3 class="case-name">Bob</h3>
        <p class="case-summary">Team stopped repeating. Customers stopped waiting.</p>
        <p class="case-detail">An AI assistant trained on his business answered questions 24/7. His team's time freed up for work that actually needed them.</p>
        <a class="cta-link" href="/ai">AI Desk <span class="arr">→</span></a>
      </article>

      <article class="case-card glow-card">
        <div class="case-label">Virtual Assistant</div>
        <h3 class="case-name">Sandy</h3>
        <p class="case-summary">One source of truth. Nothing slips anymore.</p>
        <p class="case-detail">A VA brought order: owned timelines, managed the inbox, tracked deliverables — so Sandy could lead instead of chase.</p>
        <a class="cta-link" href="/virtual-assistant">VA Desk <span class="arr">→</span></a>
      </article>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════ CTA -->
  <section class="final-cta" aria-label="Contact" data-reveal="fade">
    <h2 class="cta-title" data-blur-in>Be smart. Get help.</h2>
    <p class="cta-sub" data-blur-in data-blur-delay="150">Side by side, so you don't carry it alone.</p>
    <div class="cta-links" data-stagger data-stagger-gap="80">
      <a class="cta-link" href="mailto:info@lulidigital.co.za">Email the desk <span class="arr">→</span></a>
      <a class="cta-link" href="https://wa.me/27602551513">WhatsApp <span class="arr">→</span></a>
    </div>
  </section>

</BaseLayout>

<script>
  import { initMotion } from "../scripts/motion.js";
  document.addEventListener("DOMContentLoaded", () => initMotion());
</script>

<style>
  /* ── Hero ───────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 88px 0 100px;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 740px;
    margin: 0 auto;
  }
  .orb-a {
    width: 560px; height: 560px;
    top: -120px; right: -180px;
    animation-delay: 0s;
  }
  .orb-b {
    width: 380px; height: 380px;
    bottom: -60px; left: -140px;
    animation-delay: -3.5s;
  }
  .hero-title {
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -.035em;
    margin: 14px 0 22px;
    font-family: ui-serif, Georgia, serif;
    color: var(--ink, #141312);
  }
  .hero-sub {
    font-size: clamp(15px, 1.8vw, 19px);
    line-height: 1.65;
    color: var(--muted, rgba(20,19,18,.66));
    margin: 0 0 36px;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }
  .hero-ctas {
    display: flex;
    justify-content: center;
    gap: 28px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .seo-chip {
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted, rgba(20,19,18,.55));
    margin: 0;
  }
  .seo-chip span { color: var(--brand, #7b2d2d); font-weight: 600; }

  /* ── Bento grid ─────────────────────────────────────────────── */
  .bento-section { padding: 72px 0 80px; }
  .bento-card {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 260px;
  }
  .bento-icon {
    width: 44px; height: 44px;
    border-radius: 12px;
    background: rgba(123,45,45,.1);
    display: grid;
    place-items: center;
    color: var(--brand, #7b2d2d);
    flex-shrink: 0;
  }
  .bento-title {
    font-size: clamp(20px, 2.4vw, 28px);
    font-weight: 700;
    letter-spacing: -.02em;
    margin: 0;
    line-height: 1.15;
    font-family: ui-serif, Georgia, serif;
    color: var(--ink, #141312);
  }
  .bento-list {
    list-style: none;
    padding: 0; margin: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .bento-list li {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted, rgba(20,19,18,.66));
    padding-left: 14px;
    position: relative;
  }
  .bento-list li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--brand, #7b2d2d);
    opacity: .55;
  }

  /* ── How it works ───────────────────────────────────────────── */
  .how-section { padding: 72px 0 80px; border-top: 1px solid rgba(30,24,22,.1); }
  .how-section .ascii-diagram { margin: 28px 0; }
  .how-desc {
    font-size: 15px;
    line-height: 1.72;
    color: var(--muted, rgba(20,19,18,.66));
    max-width: 600px;
    margin: 0;
  }

  /* ── Stats ──────────────────────────────────────────────────── */
  .stats-section {
    padding: 56px 0;
    border-top: 1px solid rgba(30,24,22,.1);
    border-bottom: 1px solid rgba(30,24,22,.1);
    margin-bottom: 80px;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    text-align: center;
  }
  .stat { display: flex; flex-direction: column; gap: 10px; }
  .stat-number { font-size: clamp(44px, 6vw, 72px); }
  .stat-label {
    font-size: 13px;
    color: var(--muted, rgba(20,19,18,.6));
    line-height: 1.5;
    max-width: 18ch;
    margin: 0 auto;
  }

  /* ── Case studies ───────────────────────────────────────────── */
  .cases-section { padding: 0 0 80px; }
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 28px;
  }
  .case-card { padding: 28px 24px; display: flex; flex-direction: column; gap: 10px; }
  .case-label {
    font-size: 10px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--brand, #7b2d2d);
    font-weight: 600;
  }
  .case-name {
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
    margin: 0;
    letter-spacing: -.02em;
    font-family: ui-serif, Georgia, serif;
    line-height: 1.1;
    color: var(--ink, #141312);
  }
  .case-summary {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink, #141312);
    font-weight: 500;
    margin: 0;
  }
  .case-detail {
    font-size: 13px;
    line-height: 1.65;
    color: var(--muted, rgba(20,19,18,.62));
    margin: 0;
    flex: 1;
  }

  /* ── Final CTA ──────────────────────────────────────────────── */
  .final-cta {
    text-align: center;
    padding: 80px 0 40px;
    border-top: 1px solid rgba(30,24,22,.1);
  }
  .cta-title {
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 700;
    letter-spacing: -.03em;
    margin: 0 0 12px;
    font-family: ui-serif, Georgia, serif;
    line-height: 1.05;
  }
  .cta-sub {
    font-size: 16px;
    color: var(--muted, rgba(20,19,18,.62));
    margin: 0 0 32px;
  }
  .cta-links {
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .cases-grid { grid-template-columns: 1fr; }
    .stats-grid { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 600px) {
    .hero { padding: 60px 0 72px; }
    .hero-ctas { gap: 20px; }
    .how-section .ascii-diagram { font-size: 9px; padding: 20px 16px; }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    initTypewriter();
    initParallaxOrbs();
    initSignalField();
  });

  function initTypewriter() {
    const el = document.getElementById("typewriter");
    if (!(el instanceof HTMLElement)) return;
    const node = el;
    const words = ["brand.", "systems.", "AI.", "future."];
    let wi = 0, ci = 0, deleting = false;
    function tick() {
      const word = words[wi];
      if (!deleting) {
        node.textContent = word.slice(0, ++ci);
        if (ci === word.length) { deleting = true; setTimeout(tick, 1900); return; }
        setTimeout(tick, 95);
      } else {
        node.textContent = word.slice(0, --ci);
        if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; setTimeout(tick, 320); return; }
        setTimeout(tick, 48);
      }
    }
    tick();
  }

  function initParallaxOrbs() {
    const orbs = document.querySelectorAll<HTMLElement>(".hero-orb");
    if (!orbs.length || window.innerWidth < 768) return;
    window.addEventListener("mousemove", (ev) => {
      const e = ev as MouseEvent;
      const cx = e.clientX / window.innerWidth  - 0.5;
      const cy = e.clientY / window.innerHeight - 0.5;
      orbs.forEach((orb, i) => {
        const f = i === 0 ? 22 : i === 1 ? -16 : 10;
        orb.style.transform = `translate(${cx * f}px, ${cy * f}px)`;
      });
    }, { passive: true });
  }

  function initSignalField() {
    const field = document.querySelector<HTMLElement>("[data-signal-field]");
    const canvas = document.querySelector<HTMLCanvasElement>("[data-signal-canvas]");
    if (!field || !canvas) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    const nodes = [
      { x: 0.21, y: 0.38 },
      { x: 0.5, y: 0.18 },
      { x: 0.79, y: 0.42 },
      { x: 0.35, y: 0.72 },
      { x: 0.66, y: 0.7 },
    ];
    const links = [[0, 1], [1, 2], [0, 3], [3, 4], [4, 2], [1, 4]];
    let width = 1;
    let height = 1;
    let dpr = 1;
    let raf = 0;
    let running = false;
    let pointerX = 0;
    let pointerY = 0;

    const resize = () => {
      const rect = field.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (reduced) draw(900);
    };

    const pointFor = (node: { x: number; y: number }, time: number) => {
      const driftX = reduced ? 0 : Math.sin(time * 0.0007 + node.x * 9) * 8;
      const driftY = reduced ? 0 : Math.cos(time * 0.00055 + node.y * 11) * 6;
      return {
        x: width * node.x + pointerX * (node.x - 0.5) * 18 + driftX,
        y: height * node.y + pointerY * (node.y - 0.5) * 16 + driftY,
      };
    };

    const draw = (time: number) => {
      ctx.clearRect(0, 0, width, height);
      const glow = ctx.createRadialGradient(width * 0.5, height * 0.48, 10, width * 0.5, height * 0.48, Math.max(width, height) * 0.58);
      glow.addColorStop(0, "rgba(127,26,26,0.12)");
      glow.addColorStop(0.48, "rgba(245,164,31,0.05)");
      glow.addColorStop(1, "rgba(127,26,26,0)");
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, width, height);

      const points = nodes.map((node) => pointFor(node, time));
      const pulse = reduced ? 0.55 : 0.5 + Math.sin(time * 0.0012) * 0.5;

      links.forEach(([a, b], i) => {
        const p1 = points[a];
        const p2 = points[b];
        const cx = (p1.x + p2.x) / 2 + Math.sin(time * 0.00045 + i) * 18;
        const cy = (p1.y + p2.y) / 2 + Math.cos(time * 0.00042 + i) * 14;
        const grad = ctx.createLinearGradient(p1.x, p1.y, p2.x, p2.y);
        grad.addColorStop(0, "rgba(127,26,26,0)");
        grad.addColorStop(0.5, `rgba(127,26,26,${0.18 + pulse * 0.08})`);
        grad.addColorStop(1, "rgba(245,164,31,0)");
        ctx.strokeStyle = grad;
        ctx.lineWidth = i % 2 === 0 ? 1.2 : 0.8;
        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y);
        ctx.quadraticCurveTo(cx, cy, p2.x, p2.y);
        ctx.stroke();

        if (!reduced) {
          const t = (time * 0.00018 + i * 0.17) % 1;
          const x = (1 - t) * (1 - t) * p1.x + 2 * (1 - t) * t * cx + t * t * p2.x;
          const y = (1 - t) * (1 - t) * p1.y + 2 * (1 - t) * t * cy + t * t * p2.y;
          ctx.fillStyle = "rgba(245,164,31,0.42)";
          ctx.beginPath();
          ctx.arc(x, y, 2.4, 0, Math.PI * 2);
          ctx.fill();
        }
      });

      points.forEach((point, i) => {
        const active = reduced ? 0.55 : 0.5 + Math.sin(time * 0.0015 + i * 1.7) * 0.5;
        const radius = 17 + active * 9;
        const halo = ctx.createRadialGradient(point.x, point.y, 0, point.x, point.y, radius * 2.7);
        halo.addColorStop(0, `rgba(245,164,31,${0.18 + active * 0.12})`);
        halo.addColorStop(0.38, "rgba(127,26,26,0.08)");
        halo.addColorStop(1, "rgba(127,26,26,0)");
        ctx.fillStyle = halo;
        ctx.beginPath();
        ctx.arc(point.x, point.y, radius * 2.7, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = i < 3 ? "rgba(127,26,26,0.74)" : "rgba(245,164,31,0.62)";
        ctx.beginPath();
        ctx.arc(point.x, point.y, i < 3 ? 3.8 : 2.8, 0, Math.PI * 2);
        ctx.fill();
      });
    };

    const tick = (time: number) => {
      draw(time);
      if (running && !reduced) raf = requestAnimationFrame(tick);
    };

    const start = () => {
      if (running) return;
      running = true;
      raf = requestAnimationFrame(tick);
    };

    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    window.addEventListener("pointermove", (event) => {
      const rect = field.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) return;
      pointerX += ((event.clientX - rect.left) / rect.width - 0.5 - pointerX) * 0.18;
      pointerY += ((event.clientY - rect.top) / rect.height - 0.5 - pointerY) * 0.18;
    }, { passive: true });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) start();
        else stop();
      });
    }, { threshold: 0.08 });

    resize();
    observer.observe(field);
    window.addEventListener("resize", resize, { passive: true });
  }
</script>


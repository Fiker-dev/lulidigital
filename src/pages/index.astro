<script>
  document.addEventListener("DOMContentLoaded", () => {
    initTypewriter();
    initParallaxOrbs();
    initMobileFisher();
  });

  function initTypewriter() {
    const el = document.getElementById("typewriter");
    if (!(el instanceof HTMLElement)) return;
    const node = el;
    const words = ["brand.", "systems.", "AI.", "future."];
    let wi = 0, ci = 0, deleting = false;
    function tick() {
      const word = words[wi];
      if (!deleting) {
        node.textContent = word.slice(0, ++ci);
        if (ci === word.length) { deleting = true; setTimeout(tick, 1900); return; }
        setTimeout(tick, 95);
      } else {
        node.textContent = word.slice(0, --ci);
        if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; setTimeout(tick, 320); return; }
        setTimeout(tick, 48);
      }
    }
    tick();
  }

  function initMobileFisher() {
    const fisher = document.getElementById("mobile-fisher");
    if (!fisher) return;
    const fish = fisher.querySelector<HTMLElement>(".mobile-fish");
    const body = fisher.querySelectorAll<HTMLElement>(".mobile-fisher-body");
    let tapping = false;
    fisher.addEventListener("click", () => {
      if (tapping) return;
      tapping = true;
      // Fish jumps
      if (fish) { fish.style.animation = "none"; void fish.offsetWidth; fish.style.animation = "mobileFishJump .6s ease-out forwards"; }
      // Body bounces
      body.forEach(el => { el.style.animation = "none"; void el.offsetWidth; el.style.animation = "mobileBounce .5s cubic-bezier(.36,.07,.19,.97) forwards"; });
      const label = fisher.querySelector<HTMLElement>(".mobile-char-label");
      if (label) label.textContent = "✓ nice catch!";
      setTimeout(() => {
        tapping = false;
        if (fish) fish.style.animation = "";
        body.forEach(el => el.style.animation = "");
        if (label) label.textContent = "tap me";
      }, 2200);
    });
  }

  function initParallaxOrbs() {
    const orbs = document.querySelectorAll<HTMLElement>(".hero-orb");
    if (!orbs.length) return;
    window.addEventListener("mousemove", (ev) => {
      const e = ev as MouseEvent;
      const cx = e.clientX / window.innerWidth  - 0.5;
      const cy = e.clientY / window.innerHeight - 0.5;
      orbs.forEach((orb, i) => {
        const f = i === 0 ? 22 : i === 1 ? -16 : 10;
        orb.style.transform = `translate(${cx * f}px, ${cy * f}px)`;
      });
    }, { passive: true });
  }
</script>

<style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getWeeklyPageSeoTarget } from "../lib/seoAgent.js";

export const prerender = false;

const seoTarget = getWeeklyPageSeoTarget("/");

Astro.response.headers.set("Cache-Control", "s-maxage=604800, stale-while-revalidate=86400");

const serviceSchema = {
  "name": "Digital Marketing, AI Automation & Executive Virtual Assistant Services",
  "serviceType": [
    "executive virtual assistant services","remote executive assistant",
    "virtual assistant for founders","digital marketing services",
    "performance marketing agency","brand strategy services",
    "paid media management","SEO services","content marketing services",
    "AI automation services","AI workflow automation",
    "conversational AI assistant","AI agent implementation",
    "business process automation","AI integration services",
  ],
  "description": "LuliDigital helps founders and executives with performance marketing, brand strategy, AI workflow automation, conversational AI assistants, and executive virtual assistant services.",
};

const marqueeItems = [
  "Brand Strategy","AI Automation","Paid Media","Virtual Assistant Desk",
  "Workflow Systems","Content Marketing","SEO","Agent Implementation",
  "Performance Marketing","Operations Support","Creative Direction","TikTok · Meta · Google",
];

const marqueeItems2 = [
  "Inbox Zero","Lead Generation","Content Calendar","CRM Integration",
  "Email Systems","TikTok Strategy","Process Design","AI Chatbot Build",
  "Campaign Strategy","Analytics Setup","Team Ops","Brand Voice",
];
---

<BaseLayout
  title="LuliDigital | Performance Marketing, AI Automation & Executive Virtual Assistant"
  description="LuliDigital helps founders and executives with performance marketing, brand strategy, AI workflow automation, conversational AI assistants, and remote executive virtual assistant services."
  seoTarget={seoTarget}
  serviceSchema={serviceSchema}
>

  <!-- ═══════════════════════════════════════════════════════ HERO -->
  <section class="hero" aria-label="Introduction" data-atmosphere="hero" data-hive-section>
    <div class="hero-orb orb-a" aria-hidden="true"></div>
    <div class="hero-orb orb-b" aria-hidden="true"></div>
    <div class="hero-orb orb-c" aria-hidden="true"></div>
    <div class="hero-particles" aria-hidden="true"></div>
    <div class="signal-field" aria-hidden="true" data-signal-field>
      <canvas class="signal-field__canvas" data-signal-canvas></canvas>
      <div class="signal-field__aura"></div>
      <div class="signal-node signal-node--marketing">
        <span class="signal-node__core"></span>
        <span class="signal-node__label">Marketing</span>
      </div>
      <div class="signal-node signal-node--ai">
        <span class="signal-node__core"></span>
        <span class="signal-node__label">AI</span>
      </div>
      <div class="signal-node signal-node--ops">
        <span class="signal-node__core"></span>
        <span class="signal-node__label">Ops</span>
      </div>
    </div>

    <div class="hero-inner">
      <span class="hero-badge" data-blur-in>
        <span class="badge-dot" aria-hidden="true"></span>
        Digital Studio · Available Now
      </span>

      <h1 class="hero-title">
        <span class="hero-line-1" data-blur-in>The studio that</span>
        <span class="hero-line-2" data-blur-in data-blur-delay="120">runs your</span>
        <span class="hero-cycling" aria-live="polite">
          <span class="hero-typed" id="typewriter"></span><span class="hero-cursor" aria-hidden="true"></span>
        </span>
      </h1>

      <p class="hero-sub" data-blur-in data-blur-delay="400">
        Marketing Desk. Virtual Assistant Desk. AI Desk.<br/>
        One studio behind the scenes — so you can lead.
      </p>

      <div class="hero-ctas" data-stagger data-stagger-gap="80">
        <a class="pill pill--filled magnetic" href="/marketing-desk">
          <span>Marketing Desk</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a class="pill pill--outline magnetic" href="/ai-desk">
          <span>AI Desk</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a class="pill pill--ghost" href="/va-desk">Virtual Assistant Desk →</a>
      </div>

      <div class="scroll-hint" aria-label="Scroll to explore">
        <span class="scroll-hint__line"></span>
        <span class="scroll-hint__dot"></span>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════ MARQUEE -->
  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee-track">
      {[...marqueeItems, ...marqueeItems].map((item) => (
        <span class="marquee-item">{item}</span>
      ))}
    </div>
  </div>

  <!-- ══════════════════════════════════════ MARQUEE ROW 2 -->
  <div class="marquee-wrap marquee-wrap--alt" aria-hidden="true">
    <div class="marquee-track marquee-track--rev">
      {[...marqueeItems2, ...marqueeItems2].map((item) => (
        <span class="marquee-item marquee-item--alt">{item}</span>
      ))}
    </div>
  </div>

  <!-- ═════════════════════════════════════ STORY: THE PROBLEM -->
  <section class="story-problem" aria-label="The problem we solve" data-atmosphere="problem" data-hive-section>
    <div class="problem-inner honey-text-block" data-reveal="up" data-bee-stop>
      <span class="eyebrow">Sound familiar?</span>
      <div class="problem-grid">
        <div class="problem-card glow-card" data-motion-kind="rise" data-tilt="8" data-reveal="float-l" data-reveal-delay="0">
          <div class="tilt-layer">
            <div class="prob-stat" aria-hidden="true">
              <span class="prob-num">Too many</span>
              <span class="prob-unit">loose tasks<br/>every week</span>
            </div>
            <p class="problem-text">You're doing everything yourself.<br/>And the important work keeps waiting.</p>
            <p class="card-typed" data-card-type="sorting tasks... finding the leak..."></p>
          </div>
        </div>

        <div class="problem-card glow-card" data-motion-kind="pop" data-tilt="8" data-reveal="drop" data-reveal-delay="120">
          <div class="tilt-layer">
            <div class="prob-stat" aria-hidden="true">
              <span class="prob-num">No time</span>
              <span class="prob-unit">for strategy<br/>or deep work</span>
            </div>
            <p class="problem-text">Your calendar is full.<br/>None of it moves the needle.</p>
            <p class="card-typed" data-card-type="protecting deep work..."></p>
          </div>
        </div>

        <div class="problem-card glow-card" data-motion-kind="steam" data-tilt="8" data-reveal="float-r" data-reveal-delay="240">
          <div class="tilt-layer">
            <div class="prob-stat" aria-hidden="true">
              <span class="prob-num">No system</span>
              <span class="prob-unit">for predictable<br/>growth</span>
            </div>
            <p class="problem-text">Systems aren't in place.<br/>Growth is guesswork.</p>
            <p class="card-typed" data-card-type="building the operating system..."></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════════ STORY: THE SOLUTION -->
  <section class="bento-section" aria-label="Services" data-bee-stop data-atmosphere="services" data-hive-section>
    <!-- Honeycomb fits the bee theme -->
    <div class="honeycomb" aria-hidden="true" data-reveal="fade">
      <pre class="honeycomb-pre">
<span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span>
  <span class="hc-b">⬡</span> <span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span>
<span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span></pre>
    </div>

    <div class="section-header" data-reveal="up">
      <span class="eyebrow">The Studio</span>
      <h2 class="section-title">One studio. Three desks.<br/>Every system covered.</h2>
    </div>

    <div class="desk-status" aria-hidden="true" data-reveal="fade" data-reveal-delay="200">
      <div class="ds-item">
        <span class="ds-dot"></span>
        <span class="ds-label">Marketing Desk</span>
        <span class="ds-active">active</span>
      </div>
      <div class="ds-item">
        <span class="ds-dot"></span>
        <span class="ds-label">AI Desk</span>
        <span class="ds-active">building</span>
      </div>
      <div class="ds-item">
        <span class="ds-dot"></span>
        <span class="ds-label">Virtual Assistant Desk</span>
        <span class="ds-active">running</span>
      </div>
    </div>

    <div class="bento-grid">
      <article class="glow-card bento-card" data-motion-kind="float" data-reveal="float-l" data-reveal-delay="0" data-tilt="9" data-particle-zone="marketing">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:14px;height:100%">
          <div class="bento-num" aria-hidden="true">01</div>
          <div class="bento-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
          </div>
          <h3 class="bento-title">Marketing Desk</h3>
          <!-- Desk state: scattered → coordinated -->
          <div class="desk-state-tag" aria-hidden="true">
            <span class="dst-before">scattered signals</span>
            <span class="dst-arrow">→</span>
            <span class="dst-after">coordinated growth</span>
          </div>
          <!-- Transformation visual -->
          <div class="mkt-transform" aria-hidden="true" data-desk-transform="marketing">
            <div class="mkt-dot" style="--sx:8%;--sy:18%;--offset-x:-18px"></div>
            <div class="mkt-dot" style="--sx:82%;--sy:12%;--offset-x:16px"></div>
            <div class="mkt-dot" style="--sx:15%;--sy:74%;--offset-x:-14px"></div>
            <div class="mkt-dot" style="--sx:78%;--sy:68%;--offset-x:12px"></div>
            <div class="mkt-dot" style="--sx:48%;--sy:8%;--offset-x:0px"></div>
            <div class="mkt-dot" style="--sx:52%;--sy:82%;--offset-x:0px"></div>
            <div class="mkt-center"></div>
          </div>
          <p class="card-typed" data-card-type="AI finds the angle. Strategy makes it sell."></p>
          <ul class="bento-list">
            <li style="--li-i:0">Brand strategy &amp; positioning</li>
            <li style="--li-i:1">Paid media: Meta, Google, TikTok</li>
            <li style="--li-i:2">Content systems &amp; SEO</li>
          </ul>
          <a class="cta-link" href="/marketing-desk">Explore <span class="arr">→</span></a>
        </div>
      </article>

      <article class="glow-card bento-card" data-motion-kind="pop" data-reveal="drop" data-reveal-delay="130" data-tilt="9" data-particle-zone="ai">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:14px;height:100%">
          <div class="bento-num" aria-hidden="true">02</div>
          <div class="bento-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M7 8V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/><circle cx="12" cy="14" r="2"/></svg>
          </div>
          <h3 class="bento-title">AI Desk</h3>
          <!-- Desk state: disconnected → intelligent network -->
          <div class="desk-state-tag" aria-hidden="true">
            <span class="dst-before">disconnected data</span>
            <span class="dst-arrow">→</span>
            <span class="dst-after">intelligent automation</span>
          </div>
          <!-- AI network transformation visual -->
          <div class="ai-transform" aria-hidden="true" data-desk-transform="ai">
            <svg class="ai-net-svg" viewBox="0 0 120 56" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <filter id="ai-node-glow" x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="2" result="blur"/>
                  <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                </filter>
              </defs>
              <!-- Connection lines (draw on activation) -->
              <line class="ai-line" x1="22" y1="18" x2="58" y2="10" style="--ld:320ms"/>
              <line class="ai-line" x1="58" y1="10" x2="98" y2="22" style="--ld:440ms"/>
              <line class="ai-line" x1="22" y1="18" x2="42" y2="44" style="--ld:540ms"/>
              <line class="ai-line" x1="58" y1="10" x2="42" y2="44" style="--ld:620ms"/>
              <line class="ai-line" x1="98" y1="22" x2="42" y2="44" style="--ld:700ms"/>
              <line class="ai-line" x1="58" y1="10" x2="78" y2="44" style="--ld:780ms"/>
              <line class="ai-line" x1="98" y1="22" x2="78" y2="44" style="--ld:840ms"/>
              <!-- Nodes (appear sequentially) -->
              <circle class="ai-node" cx="22" cy="18" r="6" style="--nd:0ms" filter="url(#ai-node-glow)"/>
              <circle class="ai-node" cx="58" cy="10" r="6" style="--nd:120ms" filter="url(#ai-node-glow)"/>
              <circle class="ai-node" cx="98" cy="22" r="6" style="--nd:240ms" filter="url(#ai-node-glow)"/>
              <circle class="ai-node" cx="42" cy="44" r="5" style="--nd:360ms" filter="url(#ai-node-glow)"/>
              <circle class="ai-node" cx="78" cy="44" r="5" style="--nd:460ms" filter="url(#ai-node-glow)"/>
            </svg>
          </div>
          <p class="card-typed" data-card-type="Your support layer keeps working after hours."></p>
          <ul class="bento-list">
            <li style="--li-i:0">Conversational AI assistants</li>
            <li style="--li-i:1">Workflow automation end-to-end</li>
            <li style="--li-i:2">AI agent implementation</li>
          </ul>
          <a class="cta-link" href="/ai-desk">Explore <span class="arr">→</span></a>
        </div>
      </article>

      <article class="glow-card bento-card" data-motion-kind="rise" data-reveal="float-r" data-reveal-delay="260" data-tilt="9" data-particle-zone="va">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:14px;height:100%">
          <div class="bento-num" aria-hidden="true">03</div>
          <div class="bento-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="bento-title">Virtual Assistant Desk</h3>
          <!-- Desk state: chaos → ordered operations -->
          <div class="desk-state-tag" aria-hidden="true">
            <span class="dst-before">daily chaos</span>
            <span class="dst-arrow">→</span>
            <span class="dst-after">operations that run</span>
          </div>
          <!-- VA chaos → order transformation -->
          <div class="va-transform" aria-hidden="true" data-desk-transform="va">
            <div class="va-item" style="--chaos-x:28%;--chaos-y:6px;--chaos-r:-9deg;--chaos-w:52%;--order-y:6px;--order-w:88%;--vd:0ms"></div>
            <div class="va-item" style="--chaos-x:12%;--chaos-y:18px;--chaos-r:12deg;--chaos-w:40%;--order-y:20px;--order-w:70%;--vd:60ms"></div>
            <div class="va-item" style="--chaos-x:38%;--chaos-y:30px;--chaos-r:-6deg;--chaos-w:48%;--order-y:34px;--order-w:55%;--vd:120ms"></div>
            <div class="va-item" style="--chaos-x:8%;--chaos-y:42px;--chaos-r:14deg;--chaos-w:44%;--order-y:48px;--order-w:80%;--vd:180ms"></div>
          </div>
          <p class="card-typed" data-card-type="Human care. AI backup. Cleaner weeks."></p>
          <ul class="bento-list">
            <li style="--li-i:0">Inbox &amp; calendar management</li>
            <li style="--li-i:1">Project coordination</li>
            <li style="--li-i:2">Operations follow-through</li>
          </ul>
          <a class="cta-link" href="/va-desk">Explore <span class="arr">→</span></a>
        </div>
      </article>

      <article class="glow-card bento-card" data-motion-kind="float" data-reveal="pop" data-reveal-delay="390" data-tilt="9" data-particle-zone="web">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:14px;height:100%">
          <div class="bento-num" aria-hidden="true">04</div>
          <div class="bento-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          </div>
          <h3 class="bento-title">Web Design Desk</h3>
          <div class="desk-state-tag" aria-hidden="true">
            <span class="dst-before">your brand</span>
            <span class="dst-arrow">→</span>
            <span class="dst-after">premium experience</span>
          </div>
          <div class="web-transform" aria-hidden="true" data-desk-transform="web">
            <div class="web-bar web-bar--hero"></div>
            <div class="web-bar web-bar--content"></div>
            <div class="web-bar web-bar--action"></div>
          </div>
          <p class="card-typed" data-card-type="Premium by design. Built to convert."></p>
          <ul class="bento-list">
            <li style="--li-i:0">Brand-aligned web design</li>
            <li style="--li-i:1">Landing pages that convert</li>
            <li style="--li-i:2">Premium UI experiences</li>
          </ul>
          <a class="cta-link" href="/web-design-desk">Explore <span class="arr">→</span></a>
        </div>
      </article>
    </div>
  </section>

  <!-- ══════════════════════════════ HIVE SIGNAL FLOW ══════════ -->
  <div class="hive-signal-flow" aria-hidden="true">
    {Array.from({length: 10}).map(() => <span class="hsf-dot"></span>)}
    <span class="hsf-label">signal active</span>
    {Array.from({length: 10}).map(() => <span class="hsf-dot"></span>)}
  </div>

  <!-- ══════════════════════════ BOLD DARK STATEMENT (Floema) -->
  <section class="bold-statement" aria-label="Our promise" data-atmosphere="statement" data-hive-section>
    <!-- Living hive overlay: hex chars drift in the dark -->
    <div class="bs-hive-overlay" aria-hidden="true">⬡ ⬡ ⬡ ⬡ ⬡ ⬡ ⬡ ⬡ ⬡</div>
    <div class="bs-inner">
      <p class="bs-line" data-reveal="up" data-reveal-delay="0">You run your business.</p>
      <p class="bs-line bs-accent" data-reveal="up" data-reveal-delay="120">We run everything else.</p>
    </div>
    <div class="bs-reel" aria-hidden="true">
      <div class="bs-reel-track">
        <span class="bsr-word">Marketing</span><span class="bsr-sep">—</span>
        <span class="bsr-word">AI Automation</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Virtual Assistant</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Web Design</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Marketing</span><span class="bsr-sep">—</span>
        <span class="bsr-word">AI Automation</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Virtual Assistant</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Web Design</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Marketing</span><span class="bsr-sep">—</span>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════ DROP GUIDE -->
  <div class="drop-guide" aria-hidden="true">
    <div class="drop-guide__line"></div>
    <div class="drop-guide__ball"></div>
  </div>

  <!-- ═════════════════════════════════════════════ HOW ASCII -->
  <section class="how-section" aria-label="How LuliDigital works" data-reveal="up" data-atmosphere="how" data-hive-section data-hive-node="how">
    <span class="eyebrow">How It Works</span>
    <h2 class="section-title">Marketing feeds the machine.<br/>The VA runs it. AI scales it.</h2>
    <div class="how-flow" data-reveal="fade" data-reveal-delay="280" aria-label="Service flow: Marketing feeds VA, VA feeds AI">
      <div class="how-node">
        <span class="how-node-num">01</span>
        <span class="how-node-title">Marketing</span>
        <span class="how-node-sub">Brand. Story.</span>
      </div>
      <svg class="how-arrow" viewBox="0 0 48 24" aria-hidden="true" fill="none">
        <path d="M4 12 L40 12" stroke="rgba(123,45,45,.4)" stroke-width="1.5"/>
        <path d="M34 6 L44 12 L34 18" stroke="rgba(123,45,45,.4)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <div class="how-node how-node--accent">
        <span class="how-node-num">02</span>
        <span class="how-node-title">Virtual Assistant Desk</span>
        <span class="how-node-sub">Ops. Clarity.</span>
      </div>
      <svg class="how-arrow" viewBox="0 0 48 24" aria-hidden="true" fill="none">
        <path d="M4 12 L40 12" stroke="rgba(123,45,45,.4)" stroke-width="1.5"/>
        <path d="M34 6 L44 12 L34 18" stroke="rgba(123,45,45,.4)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <div class="how-node">
        <span class="how-node-num">03</span>
        <span class="how-node-title">AI Desk</span>
        <span class="how-node-sub">Systems. Scale.</span>
      </div>
    </div>
    <p class="how-desc">Each desk is distinct but connected. Marketing builds the signal. The VA keeps operations clean. AI scales what works — without scaling headcount.</p>

    <!-- Animated connection lines between how-nodes -->
    <div class="how-connect-wrap" aria-hidden="true">
      <svg class="hive-connect-svg" viewBox="0 0 900 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <filter id="hive-glow-filter" x="-60%" y="-60%" width="220%" height="220%">
            <feGaussianBlur stdDeviation="2.5" result="blur"/>
            <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
        </defs>
        <!-- Bezier path: Marketing → VA → AI -->
        <path class="hive-path-line" data-hive-path="how"

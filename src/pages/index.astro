---
import BaseLayout from "../layouts/BaseLayout.astro";

const serviceSchema = {
  "name": "Digital Marketing, AI Automation & Executive Virtual Assistant Services",
  "serviceType": [
    "executive virtual assistant services",
    "remote executive assistant",
    "virtual assistant for founders",
    "digital marketing services",
    "performance marketing agency",
    "brand strategy services",
    "paid media management",
    "SEO services",
    "content marketing services",
    "AI automation services",
    "AI workflow automation",
    "conversational AI assistant",
    "AI agent implementation",
    "business process automation",
    "AI integration services",
  ],
  "description": "LuliDigital helps founders and executives with performance marketing, brand strategy, AI workflow automation, conversational AI assistants, and executive virtual assistant services.",
};

const marqueeItems = [
  "Brand Strategy", "AI Automation", "Paid Media", "Virtual Assistant",
  "Workflow Systems", "Content Marketing", "SEO", "Agent Implementation",
  "Performance Marketing", "Operations Support", "Creative Direction", "TikTok · Meta · Google",

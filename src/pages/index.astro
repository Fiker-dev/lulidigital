          <stop offset="0%"   stop-color="rgba(123,45,45,0)"/>
          <stop offset="25%"  stop-color="rgba(123,45,45,0.3)"/>
          <stop offset="50%"  stop-color="rgba(123,45,45,0.45)"/>
          <stop offset="75%"  stop-color="rgba(123,45,45,0.3)"/>
          <stop offset="100%" stop-color="rgba(123,45,45,0)"/>
        </linearGradient>
      </defs>
      <path d="M0,35 C150,5 350,65 600,35 C850,5 1050,65 1200,35"
            fill="none" stroke="url(#wave-grad)" stroke-width="1.5"/>
      <circle r="5.5" fill="rgba(123,45,45,0.8)" style="filter:drop-shadow(0 0 6px rgba(123,45,45,.7))">
        <animateMotion dur="3.8s" repeatCount="indefinite" calcMode="spline"
          keyTimes="0;1" keySplines="0.4 0 0.6 1"
          path="M0,35 C150,5 350,65 600,35 C850,5 1050,65 1200,35"/>

  </div>

  <!-- ═════════════════════════════════════ STORY: THE PROBLEM -->
  <section class="story-problem" aria-label="The problem we solve">
    <div class="problem-inner honey-text-block" data-reveal="up" data-bee-stop>
      <span class="eyebrow">Sound familiar?</span>
      <div class="problem-grid">
        <div class="problem-card glow-card" data-motion-kind="rise" data-tilt="8" data-reveal="float-l" data-reveal-delay="0">
          <div class="tilt-layer">
            <div class="prob-stat" aria-hidden="true">
              <span class="prob-num">Too many</span>
              <span class="prob-unit">loose tasks<br/>every week</span>
            </div>
            <p class="problem-text">You're doing everything yourself.<br/>And the important work keeps waiting.</p>
            <p class="card-typed" data-card-type="sorting tasks... finding the leak..."></p>
          </div>
        </div>

        <div class="problem-card glow-card" data-motion-kind="pop" data-tilt="8" data-reveal="drop" data-reveal-delay="120">
          <div class="tilt-layer">
            <div class="prob-stat" aria-hidden="true">
              <span class="prob-num">No time</span>
              <span class="prob-unit">for strategy<br/>or deep work</span>

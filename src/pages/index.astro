  </div>

  <!-- ═══════════════════════════════════════════════ CASE STUDIES -->
  <section class="cases-section" aria-label="Client stories">
    <div class="section-header" data-reveal="up">
      <span class="eyebrow">In Practice</span>
      <h2 class="section-title">Real results.<br/>Real businesses.</h2>
    </div>

    <div class="cases-grid" data-stagger data-stagger-gap="80">

      <article class="case-card glow-card">

</BaseLayout>

<script>
  import { initMotion } from "../scripts/motion.js";

  document.addEventListener("DOMContentLoaded", () => {
    initMotion();
    initTypewriter();
    initMagnetic();
    initParallaxOrbs();
    initScrollProgress();
  });

  // ── Typewriter ────────────────────────────────────────────────
  function initTypewriter() {
    const el = document.getElementById("typewriter") as HTMLElement | null;
    if (!el) return;
    const words = ["brand.", "systems.", "AI.", "future."];
    let wi = 0, ci = 0, deleting = false;

    function tick() {
      const word = words[wi];
      if (!deleting) {
        el.textContent = word.slice(0, ++ci);
        if (ci === word.length) { deleting = true; setTimeout(tick, 1900); return; }
        setTimeout(tick, 95);
      } else {
        el.textContent = word.slice(0, --ci);
        if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; setTimeout(tick, 320); return; }
        setTimeout(tick, 48);
      }
    }
    tick();
  }

  // ── Magnetic buttons ──────────────────────────────────────────
  function initMagnetic() {
    document.querySelectorAll<HTMLElement>(".magnetic").forEach((el) => {
      const STRENGTH = 0.28;
      el.addEventListener("mousemove", (ev) => {
        const e = ev as MouseEvent;
        const r = el.getBoundingClientRect();
        const x = e.clientX - (r.left + r.width  / 2);
        const y = e.clientY - (r.top  + r.height / 2);
        el.style.transform = `translate(${x * STRENGTH}px, ${y * STRENGTH}px)`;
      });
      el.addEventListener("mouseleave", () => {
        el.style.transform = "";
        el.style.transition = "transform 500ms cubic-bezier(.16,1,.3,1)";
        setTimeout(() => { el.style.transition = ""; }, 500);
      });
    });
  }

  // ── Parallax orbs on mouse ────────────────────────────────────
  function initParallaxOrbs() {
    const orbs = document.querySelectorAll<HTMLElement>(".hero-orb");
    if (!orbs.length) return;
    window.addEventListener("mousemove", (ev) => {
      const e = ev as MouseEvent;
      const cx = e.clientX / window.innerWidth  - 0.5;
      const cy = e.clientY / window.innerHeight - 0.5;
      orbs.forEach((orb, i) => {
        const f = i === 0 ? 22 : i === 1 ? -16 : 10;
        orb.style.transform = `translate(${cx * f}px, ${cy * f}px)`;
      });
    }, { passive: true });
  }

  // ── Scroll progress bar ───────────────────────────────────────
  function initScrollProgress() {
    const bar = document.querySelector<HTMLElement>(".scroll-bar");
    if (!bar) return;
    window.addEventListener("scroll", () => {
      const max = document.body.scrollHeight - window.innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
    }, { passive: true });
  }
</script>

<style>
  /* ── Scroll bar ─────────────────────────────────────────────── */
  .scroll-bar {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 2.5px;
    background: var(--brand, #7b2d2d);
    transform-origin: left;
    transform: scaleX(0);
    z-index: 200;
    pointer-events: none;
  }

  /* ── Hero ───────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 100px 0 80px;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  /* Orbs */
  .orb-a { width: 640px; height: 640px; top: -180px; right: -200px; animation-delay: 0s; }
  .orb-b { width: 420px; height: 420px; bottom: -80px; left: -160px; animation-delay: -3.5s; }
  .orb-c { width: 280px; height: 280px; top: 30%;    left: 10%;    animation-delay: -6s; opacity: .5; }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--muted, rgba(20,19,18,.6));
    border: 1px solid rgba(30,24,22,.14);
    border-radius: 999px;
    padding: 6px 14px;
    background: rgba(243,239,231,.7);
    backdrop-filter: blur(8px);
    margin-bottom: 36px;
  }
  .badge-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px rgba(34,197,94,.7);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 6px rgba(34,197,94,.6); }
    50%       { box-shadow: 0 0 14px rgba(34,197,94,.9); }
  }

  /* Hero title */
  .hero-title {
    font-size: clamp(52px, 8vw, 108px);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -.04em;
    font-family: ui-serif, Georgia, serif;
    color: var(--ink, #141312);
    margin: 0 0 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }
  .hero-line-1, .hero-line-2 { display: block; }
  .hero-cycling {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand, #7b2d2d);
    min-height: 1.05em;
    min-width: 3ch;
  }
  .hero-typed { display: inline; }
  .hero-cursor {
    display: inline-block;
    width: 4px;
    height: .8em;
    background: var(--brand, #7b2d2d);
    border-radius: 2px;
    margin-left: 5px;
    vertical-align: middle;
    animation: blink .85s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  /* Sub */
  .hero-sub {
    font-size: clamp(15px, 1.8vw, 19px);
    line-height: 1.65;
    color: var(--muted, rgba(20,19,18,.62));
    margin: 0 0 40px;
    max-width: 480px;
  }

  /* CTAs */
  .hero-ctas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 52px;
  }

  /* Pills */
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    border-radius: 999px;
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    will-change: transform;
    transition: box-shadow 250ms ease, background 200ms ease, color 200ms ease;
  }
  .pill--filled {
    background: var(--brand, #7b2d2d);
    color: #f9f5ef;
    box-shadow: 0 8px 28px rgba(123,45,45,.35), 0 2px 8px rgba(123,45,45,.2);
  }
  .pill--filled:hover {
    box-shadow: 0 14px 36px rgba(123,45,45,.45), 0 4px 12px rgba(123,45,45,.25);
    background: #6a2828;
  }
  .pill--outline {
    border: 1.5px solid var(--brand, #7b2d2d);
    color: var(--brand, #7b2d2d);
  }
  .pill--outline:hover {
    background: rgba(123,45,45,.06);
  }
  .pill--ghost {
    color: var(--muted, rgba(20,19,18,.6));
    font-size: 12px;
    letter-spacing: .1em;
    text-decoration: none;
    padding: 13px 16px;
    transition: color 200ms ease;
  }
  .pill--ghost:hover { color: var(--ink, #141312); }

  /* Scroll hint */
  .scroll-hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    opacity: .5;
  }
  .scroll-hint__line {
    width: 1px;
    height: 28px;
    background: var(--brand, #7b2d2d);
    display: block;
  }
  .scroll-hint__dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--brand, #7b2d2d);
    animation: scrollBounce 1.8s cubic-bezier(.4,0,.2,1) infinite;
  }
  @keyframes scrollBounce {
    0%        { transform: translateY(0); opacity: .5; }
    60%       { transform: translateY(12px); opacity: 1; }
    100%      { transform: translateY(0); opacity: .5; }
  }

  /* ── Marquee ────────────────────────────────────────────────── */
  .marquee-wrap {
    overflow: hidden;
    border-top: 1px solid rgba(30,24,22,.1);
    border-bottom: 1px solid rgba(30,24,22,.1);
    padding: 16px 0;
    background: rgba(243,239,231,.5);
  }
  .marquee-track {
    display: flex;
    align-items: center;
    gap: 0;
    width: max-content;
    animation: marqueeScroll 28s linear infinite;
  }
  .marquee-track:hover { animation-play-state: paused; }
  @keyframes marqueeScroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .marquee-item {
    font-size: 11px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--muted, rgba(20,19,18,.5));
    font-weight: 600;
    padding: 0 28px;
    position: relative;
  }
  .marquee-item::after {
    content: "·";
    position: absolute;
    right: -2px;
    color: var(--brand, #7b2d2d);
    opacity: .4;
  }

  /* ── Bento section ──────────────────────────────────────────── */
  .bento-section { padding: 88px 0 80px; }
  .section-header { margin-bottom: 48px; }
  .section-header .section-title { margin-top: 10px; }
  .bento-card {
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 280px;
  }
  .bento-num {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
    color: var(--brand, #7b2d2d);
    opacity: .5;
  }
  .bento-icon {
    width: 46px; height: 46px;
    border-radius: 12px;
    background: rgba(123,45,45,.1);
    display: grid;
    place-items: center;
    color: var(--brand, #7b2d2d);
    flex-shrink: 0;
  }
  .bento-title {
    font-size: clamp(20px, 2.4vw, 28px);
    font-weight: 700;
    letter-spacing: -.02em;
    margin: 0;
    line-height: 1.15;
    font-family: ui-serif, Georgia, serif;
    color: var(--ink, #141312);

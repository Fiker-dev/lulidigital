        </span>
      </h1>

      <p class="hero-sub" data-blur-in data-blur-delay="400">
        Marketing Desk. Virtual Assistant Desk. AI Desk.<br/>
        One studio behind the scenes — so you can lead.
      </p>

      <div class="hero-ctas" data-stagger data-stagger-gap="80">
        <a class="pill pill--filled magnetic" href="/marketing-desk">
          <span>Marketing Desk</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a class="pill pill--outline magnetic" href="/ai-desk">
          <span>AI Desk</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a class="pill pill--ghost" href="/va-desk">Virtual Assistant Desk →</a>
      </div>

      <div class="scroll-hint" aria-label="Scroll to explore">
        <span class="scroll-hint__line"></span>
        <span class="scroll-hint__dot"></span>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════ MARQUEE -->
  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee-track">
      {[...marqueeItems, ...marqueeItems].map((item) => (
        <span class="marquee-item">{item}</span>
      ))}
    </div>
  </div>

  <!-- ══════════════════════════════════════ MARQUEE ROW 2 -->
  <div class="marquee-wrap marquee-wrap--alt" aria-hidden="true">
    <div class="marquee-track marquee-track--rev">
      {[...marqueeItems2, ...marqueeItems2].map((item) => (
        <span class="marquee-item marquee-item--alt">{item}</span>

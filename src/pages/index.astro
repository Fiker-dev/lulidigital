---
import BaseLayout from "../layouts/BaseLayout.astro";

const serviceSchema = {
  "name": "Digital Marketing, AI Automation & Executive Virtual Assistant Services",
  "serviceType": [
    "executive virtual assistant services","remote executive assistant",
    "virtual assistant for founders","digital marketing services",
    "performance marketing agency","brand strategy services",
    "paid media management","SEO services","content marketing services",
    "AI automation services","AI workflow automation",
    "conversational AI assistant","AI agent implementation",
    "business process automation","AI integration services",
  ],
  "description": "LuliDigital helps founders and executives with performance marketing, brand strategy, AI workflow automation, conversational AI assistants, and executive virtual assistant services.",
};

const marqueeItems = [
  "Brand Strategy","AI Automation","Paid Media","Virtual Assistant",
  "Workflow Systems","Content Marketing","SEO","Agent Implementation",
  "Performance Marketing","Operations Support","Creative Direction","TikTok · Meta · Google",
];
---

<BaseLayout
  title="LuliDigital | Performance Marketing, AI Automation & Executive Virtual Assistant"
  description="LuliDigital helps founders and executives with performance marketing, brand strategy, AI workflow automation, conversational AI assistants, and remote executive virtual assistant services."
  serviceSchema={serviceSchema}
>

  <!-- ═══════════════════════════════════════════════════════ HERO -->
  <section class="hero" aria-label="Introduction">
    <div class="hero-orb orb-a" aria-hidden="true"></div>
    <div class="hero-orb orb-b" aria-hidden="true"></div>
    <div class="hero-orb orb-c" aria-hidden="true"></div>

    <div class="hero-inner">
      <span class="hero-badge" data-blur-in>
        <span class="badge-dot" aria-hidden="true"></span>
        Digital Studio · Available Now
      </span>

      <h1 class="hero-title">
        <span class="hero-line-1" data-blur-in>The studio that</span>
        <span class="hero-line-2" data-blur-in data-blur-delay="120">runs your</span>
        <span class="hero-cycling" aria-live="polite">
          <span class="hero-typed" id="typewriter"></span><span class="hero-cursor" aria-hidden="true"></span>
        </span>
      </h1>

      <p class="hero-sub" data-blur-in data-blur-delay="400">
        Marketing. Virtual Assistant. AI Automation.<br/>
        One studio behind the scenes — so you can lead.
      </p>

      <div class="hero-ctas" data-stagger data-stagger-gap="80">
        <a class="pill pill--filled magnetic" href="/marketing">
          <span>Marketing Desk</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a class="pill pill--outline magnetic" href="/ai">
          <span>AI Desk</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a class="pill pill--ghost" href="/virtual-assistant">Virtual Assistant →</a>
      </div>

      <div class="scroll-hint" aria-label="Scroll to explore">
        <span class="scroll-hint__line"></span>
        <span class="scroll-hint__dot"></span>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════ MARQUEE -->
  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee-track">
      {[...marqueeItems, ...marqueeItems].map((item) => (
        <span class="marquee-item">{item}</span>
      ))}
    </div>
  </div>

  <!-- ══════════════════════════════════════════════ SERVICES BENTO -->
  <section class="bento-section" aria-label="Services">
    <!-- Honeycomb (bee theme — no people!) -->
    <div class="honeycomb" aria-hidden="true" data-reveal="fade">
      <pre class="honeycomb-pre">
<span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span>
  <span class="hc-b">⬡</span> <span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span>
<span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span>
  <span class="hc-b">⬡</span> <span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span> <span class="hc-b">⬡</span> <span class="hc-a">⬡</span></pre>
    </div>

    <div class="section-header" data-reveal="up">
      <span class="eyebrow">What We Do</span>
      <h2 class="section-title" data-bee-stop>Three desks.<br/>One studio.</h2>
    </div>

    <div class="bento-grid">
      <article class="glow-card bento-card" data-reveal="float-l" data-reveal-delay="0" aria-label="Marketing">
        <div class="bento-num" aria-hidden="true">01</div>
        <div class="bento-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
        </div>
        <h3 class="bento-title">Marketing</h3>
        <ul class="bento-list">
          <li>Brand strategy &amp; positioning</li>
          <li>Paid media: Meta, Google, TikTok</li>
          <li>Content systems &amp; SEO</li>
        </ul>
        <a class="cta-link" href="/marketing">Explore <span class="arr">→</span></a>
      </article>

      <article class="glow-card bento-card" data-reveal="drop" data-reveal-delay="120" aria-label="AI Automation">
        <div class="bento-num" aria-hidden="true">02</div>
        <div class="bento-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M7 8V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/><circle cx="12" cy="14" r="2"/></svg>
        </div>
        <h3 class="bento-title">AI Automation</h3>
        <ul class="bento-list">
          <li>Conversational AI assistants</li>
          <li>Workflow automation end-to-end</li>
          <li>AI agent implementation</li>
        </ul>
        <a class="cta-link" href="/ai">Explore <span class="arr">→</span></a>
      </article>

      <article class="glow-card bento-card" data-reveal="float-r" data-reveal-delay="240" aria-label="Virtual Assistant">
        <div class="bento-num" aria-hidden="true">03</div>
        <div class="bento-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="bento-title">Virtual Assistant</h3>
        <ul class="bento-list">
          <li>Inbox &amp; calendar management</li>
          <li>Project coordination</li>
          <li>Operations follow-through</li>
        </ul>
        <a class="cta-link" href="/virtual-assistant">Explore <span class="arr">→</span></a>
      </article>
    </div>
  </section>

  <!-- ══════════════════════════════════════════ DROP GUIDE ══════ -->
  <div class="drop-guide" aria-hidden="true">
    <div class="drop-guide__line"></div>
    <div class="drop-guide__ball"></div>
  </div>

  <!-- ════════════════════════════════════════ HOW IT WORKS ═════ -->
  <section class="how-section" aria-label="How LuliDigital works" data-reveal="up">
    <span class="eyebrow">How It Works</span>
    <h2 class="section-title">Three desks. One studio.</h2>
    <pre class="ascii-diagram" role="img" aria-label="Three connected service desks">
<span class="dim">┌──────────────┐    ┌──────────────┐    ┌──────────────┐</span>
│  <span class="hi">MARKETING</span>   │    │   <span class="hi">VIRTUAL</span>    │    │     <span class="hi">AI</span>       │
│    <span class="hi">DESK</span>     │<span class="hi">───▶</span>│  <span class="hi">ASSISTANT</span>  │<span class="hi">───▶</span>│    <span class="hi">DESK</span>     │
│              │    │     <span class="hi">DESK</span>     │    │              │
<span class="dim">└──────────────┘    └──────────────┘    └──────────────┘</span>
  Brand. Story.       Ops. Clarity.     Systems. Scale.</pre>
    <p class="how-desc">Marketing builds the signal. The VA keeps operations clean. AI scales what works — without scaling headcount.</p>
  </section>

  <!-- ══════════════════════════════════════════════ WAVE GUIDE -->
  <div class="wave-guide" aria-hidden="true">
    <svg class="wave-svg" viewBox="0 0 1200 70" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="wave-grad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%"   stop-color="rgba(123,45,45,0)"/>
          <stop offset="30%"  stop-color="rgba(123,45,45,0.35)"/>
          <stop offset="70%"  stop-color="rgba(123,45,45,0.35)"/>
          <stop offset="100%" stop-color="rgba(123,45,45,0)"/>
        </linearGradient>
      </defs>
      <path d="M0,35 C150,5 350,65 600,35 C850,5 1050,65 1200,35" fill="none" stroke="url(#wave-grad)" stroke-width="1.5"/>
      <circle r="5.5" fill="rgba(123,45,45,0.8)" style="filter:drop-shadow(0 0 6px rgba(123,45,45,.7))">
        <animateMotion dur="3.8s" repeatCount="indefinite" calcMode="spline" keyTimes="0;1" keySplines="0.4 0 0.6 1"
          path="M0,35 C150,5 350,65 600,35 C850,5 1050,65 1200,35"/>
      </circle>
    </svg>
  </div>

  <!-- ═══════════════════════════════════════════════ CASE STUDIES -->
  <section class="cases-section" aria-label="Client stories">
    <div class="section-header" data-reveal="up">
      <span class="eyebrow">In Practice</span>
      <h2 class="section-title" data-bee-stop>Real results.<br/>Real businesses.</h2>
    </div>

    <div class="cases-grid">
      <article class="glow-card case-card" data-reveal="fall" data-reveal-delay="0">
        <div class="case-label">Marketing</div>
        <h3 class="case-name">Jane</h3>
        <p class="case-summary">Brand built. Visible online. Customers found her.</p>
        <p class="case-detail">She got brand voice, creative direction, a finished website, and SEO that made her show up. Jando never caught up.</p>
        <a class="cta-link" href="/marketing">Marketing Desk <span class="arr">→</span></a>
      </article>

      <article class="glow-card case-card" data-reveal="pop" data-reveal-delay="150">
        <div class="case-label">AI Automation</div>
        <h3 class="case-name">Bob</h3>
        <p class="case-summary">Team stopped repeating. Customers stopped waiting.</p>
        <p class="case-detail">An AI assistant trained on his business answered questions 24/7. His team's time freed up for the work that actually needed them.</p>
        <a class="cta-link" href="/ai">AI Desk <span class="arr">→</span></a>
      </article>

      <article class="glow-card case-card" data-reveal="fall" data-reveal-delay="300">
        <div class="case-label">Virtual Assistant</div>
        <h3 class="case-name">Sandy</h3>
        <p class="case-summary">One source of truth. Nothing slips anymore.</p>
        <p class="case-detail">A VA brought order: owned timelines, managed the inbox, tracked deliverables — so Sandy could lead instead of chase.</p>
        <a class="cta-link" href="/virtual-assistant">VA Desk <span class="arr">→</span></a>
      </article>
    </div>
  </section>

  <!-- ══════════════════════════════════ DROP GUIDE 2 ═══════════ -->
  <div class="drop-guide" aria-hidden="true">
    <div class="drop-guide__line"></div>
    <div class="drop-guide__ball"></div>
  </div>

  <!-- ═══════════════════════════════════════════════════════ CTA -->
  <section class="final-cta" aria-label="Contact" data-reveal="fade">
    <div class="cta-inner">
      <span class="eyebrow">Ready?</span>
      <h2 class="cta-big" data-blur-in data-bee-stop>Be smart.<br/>Get help.</h2>
      <p class="cta-sub" data-blur-in data-blur-delay="150">Side by side, so you don't carry it alone.</p>
      <div class="cta-actions" data-stagger data-stagger-gap="80">
        <a class="pill pill--filled magnetic" href="mailto:info@lulidigital.co.za">
          <span>Email the desk</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a class="pill pill--outline magnetic" href="https://wa.me/27602551513">
          <span>WhatsApp</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    initTypewriter();
    initParallaxOrbs();
  });

  function initTypewriter() {
    const el = document.getElementById("typewriter");
    if (!(el instanceof HTMLElement)) return;
    const node = el;
    const words = ["brand.", "systems.", "AI.", "future."];
    let wi = 0, ci = 0, deleting = false;
    function tick() {
      const word = words[wi];
      if (!deleting) {
        node.textContent = word.slice(0, ++ci);
        if (ci === word.length) { deleting = true; setTimeout(tick, 1900); return; }
        setTimeout(tick, 95);
      } else {
        node.textContent = word.slice(0, --ci);
        if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; setTimeout(tick, 320); return; }
        setTimeout(tick, 48);
      }
    }
    tick();
  }

  function initParallaxOrbs() {
    const orbs = document.querySelectorAll<HTMLElement>(".hero-orb");
    if (!orbs.length) return;
    window.addEventListener("mousemove", (ev) => {
      const e = ev as MouseEvent;
      const cx = e.clientX / window.innerWidth  - 0.5;
      const cy = e.clientY / window.innerHeight - 0.5;
      orbs.forEach((orb, i) => {
        const f = i === 0 ? 22 : i === 1 ? -16 : 10;
        orb.style.transform = `translate(${cx * f}px, ${cy * f}px)`;
      });
    }, { passive: true });
  }
</script>

<style>
  /* ── Hero ───────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 100px 0 80px;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .orb-a { width: 640px; height: 640px; top: -180px; right: -200px; animation-delay: 0s; }
  .orb-b { width: 420px; height: 420px; bottom: -80px; left: -160px; animation-delay: -3.5s; }
  .orb-c { width: 280px; height: 280px; top: 30%; left: 10%; animation-delay: -6s; opacity: .5; }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--muted);
    border: 1px solid rgba(30,24,22,.14);
    border-radius: 999px;
    padding: 6px 14px;
    background: rgba(243,239,231,.7);
    backdrop-filter: blur(8px);
    margin-bottom: 36px;
    font-family: var(--font-body, "DM Sans", sans-serif);
  }
  .badge-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px rgba(34,197,94,.7);
    animation: badgePulse 2s ease-in-out infinite;
  }
  @keyframes badgePulse { 0%,100%{box-shadow:0 0 6px rgba(34,197,94,.6)} 50%{box-shadow:0 0 14px rgba(34,197,94,.9)} }

  .hero-title {
    font-size: clamp(52px, 8vw, 108px);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -.04em;
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    color: var(--ink);
    margin: 0 0 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-line-1, .hero-line-2 { display: block; }
  .hero-cycling {
    display: flex; align-items: center; justify-content: center;
    color: var(--brand); min-height: 1.05em; min-width: 3ch;
  }
  .hero-typed { display: inline; }
  .hero-cursor {
    display: inline-block; width: 4px; height: .8em;
    background: var(--brand); border-radius: 2px; margin-left: 5px;
    vertical-align: middle; animation: blink .85s step-end infinite;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

  .hero-sub {
    font-size: clamp(15px, 1.8vw, 19px);
    line-height: 1.65;
    color: var(--muted);
    margin: 0 0 40px;
    max-width: 480px;
    font-family: var(--font-body, "DM Sans", sans-serif);
  }
  .hero-ctas { display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; margin-bottom: 52px; }

  /* Pills */
  .pill {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 13px 26px; border-radius: 999px;
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 12px; letter-spacing: .1em; text-transform: uppercase; font-weight: 700;
    text-decoration: none; cursor: pointer; will-change: transform;
    transition: box-shadow 250ms ease, background 200ms ease, color 200ms ease;
  }
  .pill--filled { background: var(--brand); color: #f9f5ef; box-shadow: 0 8px 28px rgba(123,45,45,.35), 0 2px 8px rgba(123,45,45,.2); }
  .pill--filled:hover { box-shadow: 0 14px 36px rgba(123,45,45,.45); background: #6a2828; }
  .pill--outline { border: 1.5px solid var(--brand); color: var(--brand); }
  .pill--outline:hover { background: rgba(123,45,45,.06); }
  .pill--ghost { color: var(--muted); font-size: 12px; letter-spacing: .1em; text-decoration: none; padding: 13px 16px; transition: color 200ms ease; }
  .pill--ghost:hover { color: var(--ink); }

  /* Scroll hint */
  .scroll-hint { display: flex; flex-direction: column; align-items: center; gap: 6px; opacity: .5; }
  .scroll-hint__line { width: 1px; height: 28px; background: var(--brand); display: block; }
  .scroll-hint__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brand); animation: scrollBounce 1.8s cubic-bezier(.4,0,.2,1) infinite; }
  @keyframes scrollBounce { 0%,100%{transform:translateY(0);opacity:.5} 60%{transform:translateY(12px);opacity:1} }

  /* ── Marquee ────────────────────────────────────────────────── */
  .marquee-wrap { overflow: hidden; border-top: 1px solid rgba(30,24,22,.1); border-bottom: 1px solid rgba(30,24,22,.1); padding: 16px 0; background: rgba(243,239,231,.5); }
  .marquee-track { display: flex; align-items: center; width: max-content; animation: marqueeScroll 28s linear infinite; }
  .marquee-track:hover { animation-play-state: paused; }
  @keyframes marqueeScroll { from{transform:translateX(0)} to{transform:translateX(-50%)} }
  .marquee-item { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); font-weight: 600; padding: 0 28px; position: relative; font-family: var(--font-body, "DM Sans", sans-serif); }
  .marquee-item::after { content: "·"; position: absolute; right: -2px; color: var(--brand); opacity: .4; }

  /* ── Honeycomb ──────────────────────────────────────────────── */
  .honeycomb { text-align: center; margin-bottom: 40px; }
  .honeycomb-pre {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: clamp(16px, 2.5vw, 26px);
    line-height: 1.6;
    letter-spacing: .3em;
    margin: 0;
    background: none;
    border: none;
    padding: 0;
    display: inline-block;
  }
  .hc-a { color: var(--brand, #7b2d2d); opacity: .7; animation: hcPulse 3s ease-in-out infinite; }
  .hc-b { color: var(--brand, #7b2d2d); opacity: .3; animation: hcPulse 3s ease-in-out infinite; animation-delay: 1.5s; }
  @keyframes hcPulse { 0%,100%{opacity:.7} 50%{opacity:.2} }
  .hc-b { animation-name: hcPulse2; }
  @keyframes hcPulse2 { 0%,100%{opacity:.3} 50%{opacity:.7} }

  /* ── Bento ──────────────────────────────────────────────────── */
  .bento-section { padding: 88px 0 80px; }
  .section-header { margin-bottom: 48px; }
  .bento-card { padding: 36px 32px; display: flex; flex-direction: column; gap: 14px; min-height: 280px; }
  .bento-num { font-size: 11px; font-weight: 700; letter-spacing: .16em; color: var(--brand); opacity: .5; font-family: var(--font-body, "DM Sans", sans-serif); }
  .bento-icon { width: 46px; height: 46px; border-radius: 12px; background: rgba(123,45,45,.1); display: grid; place-items: center; color: var(--brand); flex-shrink: 0; }
  .bento-title { font-size: clamp(20px, 2.4vw, 28px); font-weight: 700; letter-spacing: -.02em; margin: 0; line-height: 1.15; font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif); color: var(--ink); }
  .bento-list { list-style: none; padding: 0; margin: 0; flex: 1; display: flex; flex-direction: column; gap: 7px; }
  .bento-list li { font-size: 13.5px; line-height: 1.55; color: var(--muted); padding-left: 14px; position: relative; font-family: var(--font-body, "DM Sans", sans-serif); }
  .bento-list li::before { content: "–"; position: absolute; left: 0; color: var(--brand); opacity: .5; }

  /* ── How it works ───────────────────────────────────────────── */
  .how-section { padding: 72px 0 80px; border-top: 1px solid rgba(30,24,22,.1); }
  .how-section .ascii-diagram { margin: 24px 0; }

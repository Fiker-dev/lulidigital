---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqSection from "../components/FaqSection.astro";
import FikerAvatar from "../components/FikerAvatar";
import { getWeeklyPageSeoTarget } from "../lib/seoAgent.js";

export const prerender = false;

const seoTarget = getWeeklyPageSeoTarget("/ai-desk");

Astro.response.headers.set("Cache-Control", "s-maxage=604800, stale-while-revalidate=86400");

const serviceSchema = {
  "name": "AI Automation, Conversational AI & Agent Implementation Services",
  "serviceType": [
    "AI automation services",
    "AI workflow automation",
    "conversational AI assistant",
    "AI agent implementation",
    "business process automation",
    "AI integration services",
    "custom AI chatbot development",
    "intelligent automation services",
    "AI automation for business",
    "custom AI assistant development",
    "AI automation for SMB",
    "enterprise AI automation",
  ],
  "description": "LuliDigital builds AI automation systems for business: conversational AI assistants, AI workflow automation, and custom agent implementation. Practical AI integration for executives and growing teams.",
};

const aiMarquee = [
  "24/7 Coverage", "Lead Qualified", "Workflow Automated", "Report Generated",
  "Query Answered", "Agent Deployed", "Process Optimised", "Task Routed",
  "Follow-up Sent", "Data Processed", "Knowledge Queried", "Always On",
];

const faqs = [
  {
    q: "Which parts of our workflow should we automate first?",
    a: "Start with a frequent, rules-based task whose inputs and expected outcome are easy to describe. Lead routing, meeting preparation, document summaries, recurring reports, and first-draft follow-ups are common candidates. We map the workflow before choosing tools, then prioritise the task that removes meaningful repetition without placing sensitive judgment in the system too early.",
  },
  {
    q: "Which decisions should remain human-approved?",
    a: "Keep a person responsible for financial commitments, contracts, unusual customer situations, sensitive data, public brand claims, and any action that is difficult to reverse. AI can gather context, draft the response, and route the task, but an accountable person should approve the final decision. We design those checkpoints into the workflow instead of relying on someone to remember them later.",
  },
  {
    q: "Can the automation use our existing tools?",
    a: "Usually, yes. We first review your CRM, inbox, calendar, documents, forms, and communication tools, then check the available APIs, permissions, and data quality. If a tool cannot support a reliable integration, we explain the limitation and propose a simpler route rather than building a fragile workaround that your team cannot maintain.",
  },
  {
    q: "How do you protect our business data?",
    a: "Access is limited to the accounts and information required for the workflow. We review where data enters, which services process it, what gets stored, and who can trigger an action. The right controls depend on your tools and risk level, so security and retention requirements are agreed before implementation rather than covered by a blanket promise.",
  },
  {
    q: "What happens when the AI is uncertain or wrong?",
    a: "The workflow should fail safely. Low-confidence cases, missing information, exceptions, and higher-risk actions are sent to a person with the relevant context. We also define logs and review points so errors can be traced and corrected. A useful automation is not one that pretends to be infallible; it makes uncertainty visible before it becomes a business problem.",
  },
];

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a },
  })),
};
---

<BaseLayout
  title="AI Automation Services, Conversational AI & Agent Implementation | LuliDigital"
  description="LuliDigital builds AI automation systems for business: conversational AI assistants, AI workflow automation, and AI agent implementation. Practical AI integration for executives and growing teams."
  active="ai"
  seoTarget={seoTarget}
  serviceSchema={serviceSchema}
  extraSchemas={[faqSchema]}
>

  <!-- ═══════════════════════════════════════════════════════ HERO -->
  <section class="ai-hero" aria-label="AI services" data-bee-stop data-atmosphere="hero" data-hive-section>
    <div class="ai-matrix-field" aria-hidden="true"></div>

    <div class="ai-hero-split">
      <div class="ai-hero-text">
        <span class="eyebrow ai-eyebrow" data-blur-in>Automation Console</span>
        <h1 class="ai-title" data-word-reveal>
          AI that does the work, not just the talking.
        </h1>
        <p class="ai-sub" data-blur-in data-blur-delay="200">
          Conversational AI assistants, workflow automation, and agent implementation —
          practical, managed, and live without the enterprise overhead.
        </p>
        <div class="ai-hero-ctas" data-stagger data-stagger-gap="80">
          <a class="pill pill--filled magnetic" href="https://wa.me/27602551513">Talk to us →</a>
          <a class="pill pill--outline magnetic" href="/marketing-desk">Marketing Desk →</a>
        </div>
      </div>

      <!-- Animated AI chat character -->
      <div class="ai-chat" aria-hidden="true">
        <div class="ac-header">
          <div class="ac-avatar">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M7 8V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/><circle cx="12" cy="14" r="2"/></svg>
          </div>
          <div class="ac-header-info">
            <span class="ac-name">AI AGENT ASSISTANT</span>
            <span class="ac-online"><span class="ac-online-dot"></span>Always on</span>
          </div>
        </div>
        <div class="ac-messages">
          <div class="ac-msg ac-msg--in" style="--mi:0">
            <p>How long does setup take?</p>
          </div>
          <div class="ac-msg ac-msg--out" style="--mi:1">
            <p>We scope it on a quick call, then handle the full build — design, training, and launch.</p>
          </div>
          <div class="ac-msg ac-msg--in" style="--mi:2">
            <p>What can it actually do?</p>
          </div>
          <div class="ac-msg ac-msg--out" style="--mi:3">
            <p>Answer queries 24/7, qualify leads, route tasks, generate reports — trained on your business.</p>
          </div>
          <div class="ac-typing" style="--mi:4">
            <span></span><span></span><span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════ MARQUEE -->
  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee-track">
      {[...aiMarquee, ...aiMarquee].map((item) => (
        <span class="marquee-item">{item}</span>
      ))}
    </div>
  </div>

  <section class="selling-point selling-point--ai" aria-label="AI automation selling point" data-reveal="up" data-bee-stop data-atmosphere="ai" data-hive-section>
    <span class="eyebrow">The Advantage</span>
    <h2 class="selling-title">You get practical AI that supports the work your team already does.</h2>
    <p class="selling-copy">
      We build AI assistants and automation systems around your real business: your questions,
      your workflows, your leads, your documents, and your reporting. The goal is simple:
      less manual chasing, faster replies, cleaner operations, and support that stays available after hours.
    </p>
    <p class="selling-copy selling-copy--direct">
      Want to know how much of your current workload can be automated? Talk to the desk and we will map it with you.
    </p>
    <div class="fiker-note fiker-note--ai">
      <FikerAvatar pose="lightbulb" size="120px" alt="" />
      <p>Fiker’s rule for AI builds is simple: automate the repeatable parts, keep people in charge of judgment, tone, and approval.</p>
    </div>
    <div class="selling-links">
      <a class="pill pill--filled magnetic" href="https://wa.me/27602551513">WhatsApp the desk</a>
      <a class="pill pill--outline magnetic" href="mailto:info@lulidigital.com">Email the desk</a>
    </div>
  </section>

  <!-- ════════════════════════════════════════ HOW IT WORKS -->
  <section class="ai-story" aria-labelledby="ai-story-title" data-ai-scroll-story data-bee-stop>
    <header class="ai-story__heading">
      <div>
        <span class="eyebrow">How It Works</span>
        <h2 class="section-title" id="ai-story-title">A useful agent knows when to stop.</h2>
      </div>
      <p>
        Routine work can move automatically. Sensitive decisions pause with the context a person needs to approve them.
      </p>
    </header>

    <div class="ai-story__pin">
      <div class="ai-story__visual" aria-hidden="true">
        <div class="ai-story__orbit"></div>
        <div class="ai-story__core">
          <span>LANa workflow</span>
          <strong>Context in.<br/>Control kept.</strong>
        </div>
        <div class="ai-story__state-stack">
          <span class="ai-story__state is-current" data-ai-story-state>Request received</span>
          <span class="ai-story__state" data-ai-story-state>Context checked</span>
          <span class="ai-story__state" data-ai-story-state>Action prepared</span>
          <span class="ai-story__state" data-ai-story-state>Human approval</span>
          <span class="ai-story__state" data-ai-story-state>Result logged</span>
        </div>
        <div class="ai-story__permission">
          <span class="ai-story__permission-dot"></span>
          <span>Guardrails active</span>
        </div>
      </div>

      <div class="ai-story__sequence">
        <div class="ai-story__progress" aria-hidden="true">
          <span class="ai-story__progress-track"></span>
          <span class="ai-story__progress-fill" data-ai-story-progress></span>
        </div>
        <ol class="ai-story__steps">
          <li class="ai-story__step is-current" data-ai-story-step>
            <span class="ai-story__step-index">01</span>
            <div>
              <h3>A request arrives</h3>
              <p>An enquiry, inbox task, document, or internal request enters one defined workflow.</p>
            </div>
            <span class="ai-story__step-owner">Input</span>
          </li>
          <li class="ai-story__step" data-ai-story-step>
            <span class="ai-story__step-index">02</span>
            <div>
              <h3>The agent checks context</h3>
              <p>It reads the relevant business rules, history, permissions, and source material before acting.</p>
            </div>
            <span class="ai-story__step-owner">AI prepares</span>
          </li>
          <li class="ai-story__step" data-ai-story-step>
            <span class="ai-story__step-index">03</span>
            <div>
              <h3>Routine work moves</h3>
              <p>Low-risk actions can be drafted, routed, scheduled, or completed inside agreed limits.</p>
            </div>
            <span class="ai-story__step-owner">Automated</span>
          </li>
          <li class="ai-story__step ai-story__step--approval" data-ai-story-step>
            <span class="ai-story__step-index">04</span>
            <div>
              <h3>Judgment pauses for a person</h3>
              <p>Financial, sensitive, unusual, or public-facing decisions arrive with context for approval.</p>
            </div>
            <span class="ai-story__step-owner">Human decides</span>
          </li>
          <li class="ai-story__step" data-ai-story-step>
            <span class="ai-story__step-index">05</span>
            <div>
              <h3>The result stays traceable</h3>
              <p>The action, approval, and outcome are recorded so the team can review what happened.</p>
            </div>
            <span class="ai-story__step-owner">Logged</span>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ METRICS STRIP -->
  <div class="metrics-strip" aria-label="AI impact" data-reveal="up">
    <div class="metric-item">
      <span class="metric-num ai-247">24<span class="metric-slash">/7</span></span>
      <span class="metric-label">AI coverage</span>
    </div>
    <div class="metric-divider" aria-hidden="true"></div>
    <div class="metric-item">
      <span class="metric-num metric-word">Fewer repeats</span>
      <span class="metric-label">routine questions handled first</span>
    </div>
    <div class="metric-divider" aria-hidden="true"></div>
    <div class="metric-item">
      <span class="metric-num metric-word">Cleaner flow</span>
      <span class="metric-label">tasks routed with context</span>
    </div>
  </div>

  <!-- ═════════════════════════════════════ HONEYCOMB AI LOOP -->
  <section class="loop-section" aria-label="How the AI agent assistant improves over time" data-reveal="up" data-bee-stop data-atmosphere="ai" data-hive-section>
    <div class="loop-heading">
      <div>
        <span class="eyebrow">The AI Hive</span>
        <h2 class="section-title">Every answer feeds the next one.</h2>
      </div>
      <p>
        The agent does not just reply. It collects context, follows your rules,
        acts inside your workflow, then stores what worked so the system gets cleaner.
      </p>
    </div>

    <div class="hive-loop" aria-label="Honeycomb workflow for AI agent assistant">
      {[
        {
          num: "01",
          title: "Collect",
          copy: "Questions, leads, documents, inbox requests, and staff tasks enter one managed knowledge hive.",
          stat: "Inputs",
        },
        {
          num: "02",
          title: "Process",
          copy: "The agent checks your SOPs, offer rules, tone, routing logic, and business context before it answers.",
          stat: "Rules",
        },
        {
          num: "03",
          title: "Act",
          copy: "It replies, qualifies, drafts, routes, creates a task, sends a follow-up, or escalates to a human.",
          stat: "Actions",
        },
        {
          num: "04",
          title: "Learn",
          copy: "Human corrections, missed questions, and outcomes become better prompts, knowledge, and automation.",
          stat: "Memory",
        },
      ].map((cell, index) => (
        <article class={`hive-cell hive-cell--${index + 1}`} style={`--hive-i:${index}`}>
          <span class="hive-num">{cell.num}</span>
          <h3>{cell.title}</h3>
          <p>{cell.copy}</p>
          <span class="hive-stat">{cell.stat}</span>
        </article>
      ))}
      <div class="hive-core" aria-hidden="true">
        <span>AI Agent</span>
        <span>Assistant</span>
      </div>
      <div class="hive-flow" aria-hidden="true"></div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════ SERVICE BENTO GRID -->
  <section class="services-section" aria-label="AI services we build" data-reveal="up" data-bee-stop>
    <span class="eyebrow">What We Build</span>
    <div class="bento-grid" data-stagger data-stagger-gap="80">

      <article class="glow-card svc-card" data-tilt="7" data-reveal="float-l" data-reveal-delay="0">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:12px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3 class="svc-title">Conversational AI assistant</h3>
          <ul class="bento-list">
            <li style="--li-i:0">Customer questions answered 24/7</li>
            <li style="--li-i:1">Leads qualified, scored &amp; routed</li>
            <li style="--li-i:2">Follow-ups triggered automatically</li>
          </ul>
          <p class="svc-footer">Always on. Always on-brand.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="drop" data-reveal-delay="130">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:12px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 12 7 7"/><path d="m17 2 5 5-5 5"/><path d="M22 7h-7"/></svg>
          </div>
          <h3 class="svc-title">Internal AI agent</h3>
          <ul class="bento-list">
            <li style="--li-i:0">Contracts &amp; SOPs found in seconds</li>
            <li style="--li-i:1">Staff questions answered automatically</li>
            <li style="--li-i:2">Knowledge bases made queryable</li>
          </ul>
          <p class="svc-footer">Your team's second brain.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="float-r" data-reveal-delay="260">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:12px;height:100%">
          <div class="svc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          </div>
          <h3 class="svc-title">AI workflow automation</h3>
          <ul class="bento-list">
            <li style="--li-i:0">Repetitive tasks automated end-to-end</li>
            <li style="--li-i:1">Reports generated on schedule</li>
            <li style="--li-i:2">Approvals &amp; routing handled without input</li>
          </ul>
          <p class="svc-footer">Less manual work. More capacity.</p>
        </div>
      </article>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════ FULL SERVICE LIST -->
  <section class="full-services" aria-label="Full list of AI services" data-reveal="up">
    <span class="eyebrow">All Services</span>
    <div class="bento-grid" data-stagger data-stagger-gap="60">
      {[
        { name: "AI workflow automation", desc: "End-to-end automation of repetitive business processes — reporting, routing, approvals, and follow-ups." },
        { name: "Conversational AI assistants", desc: "Custom AI chatbots trained on your business, deployed on your website, tools, or internal platforms." },
        { name: "AI agent implementation", desc: "Autonomous AI agents that execute multi-step tasks, make decisions, and move work forward without manual input." },
        { name: "Business process automation", desc: "Mapping, redesigning, and automating high-friction processes across operations, sales, and support." },
        { name: "AI integration services", desc: "Connecting AI systems to your existing tools — CRMs, inboxes, databases, and platforms." },
        { name: "Custom AI assistant development", desc: "Bespoke AI assistants built around your brand, knowledge base, and operational workflows." },
      ].map(({ name, desc }) => (
        <article class="glow-card mini-card" data-tilt="6">
          <h4 class="mini-title">{name}</h4>
          <p class="mini-desc">{desc}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════ BOLD DARK STATEMENT -->
  <section class="bold-statement" aria-label="AI promise">
    <div class="bs-hive-overlay" aria-hidden="true">⬡ ⬡ ⬡ ⬡ ⬡ ⬡ ⬡ ⬡ ⬡</div>
    <div class="bs-inner">
      <p class="bs-line" data-reveal="up" data-reveal-delay="0">Stop doing what machines</p>
      <p class="bs-line bs-accent" data-reveal="up" data-reveal-delay="140">can do better.</p>
    </div>
    <div class="bs-reel" aria-hidden="true">
      <div class="bs-reel-track">
        <span class="bsr-word">Automate</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Optimise</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Scale</span><span class="bsr-sep">—</span>
        <span class="bsr-word">24/7</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Deploy</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Automate</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Optimise</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Scale</span><span class="bsr-sep">—</span>
        <span class="bsr-word">24/7</span><span class="bsr-sep">—</span>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════ LIVE DESK FEED -->
  <div class="desk-feed" aria-hidden="true">
    <span class="df-badge"><span class="df-dot"></span>Live</span>
    <div class="df-track-wrap">
      <div class="df-track">
        {[
          "47 customer queries handled — zero human hours spent",
          "Lead qualification workflow triggered — 12 leads scored",
          "Automated report dispatched to 3 stakeholders",
          "New knowledge base query answered in 0.4 seconds",
          "Onboarding workflow completed — no manual steps required",
          "AI agent deployed for e-commerce support team",
          "47 customer queries handled — zero human hours spent",
          "Lead qualification workflow triggered — 12 leads scored",
          "Automated report dispatched to 3 stakeholders",
        ].map((item) => (
          <>
            <span class="df-item">{item}</span>
            <span class="df-sep" aria-hidden="true">·</span>
          </>
        ))}
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════ FAQ -->
  <FaqSection faqs={faqs} eyebrow="Questions, answered" title="What people ask before automating." />

  <!-- ═══════════════════════════════════════════════════════ CTA -->
  <section class="ai-cta" aria-label="Get started with AI" data-reveal="fade" data-bee-final data-atmosphere="cta" data-hive-section>
    <div class="hive-glow-ring" style="width:600px;height:600px;left:50%;top:50%;transform:translate(-50%,-50%)" aria-hidden="true"></div>
    <h2 class="cta-title" data-blur-in>Let’s automate the busywork.</h2>
    <p class="cta-sub">You stay on the work that needs a human. We’ll automate the rest.</p>
    <div data-stagger data-stagger-gap="80" class="cta-links">
      <a class="pill pill--filled magnetic" href="https://wa.me/27602551513">Talk to the desk →</a>
      <a class="pill pill--outline magnetic" href="/va-desk">Visit Virtual Assistant Desk →</a>
      <a class="pill pill--outline magnetic" href="/work">See recent work →</a>
    </div>
  </section>

</BaseLayout>

<script>
  import { initAiScrollStory } from "../scripts/aiScrollStory.js";

  const startAiScrollStory = () => initAiScrollStory();

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startAiScrollStory, { once: true });
  } else {
    startAiScrollStory();
  }
</script>

<style>
  /* ── Hero ───────────────────────────────────────────────────── */
  .ai-hero {
    --ai-ink: #fff8df;
    --ai-panel: #2b1a05;
    --ai-line: rgba(255, 212, 90, .34);
    position: relative;
    overflow: hidden;
    padding: 88px 0 72px;
    isolation: isolate;
    background:
      radial-gradient(circle at 78% 22%, rgba(255,212,90,.34), transparent 28%),
      linear-gradient(135deg, #2b1a05 0%, #734500 56%, var(--paper) 56.2%);
  }
  .ai-hero::before,
  .ai-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
  }
  .ai-hero::before {
    opacity: .28;
    background:
      linear-gradient(30deg, transparent 34%, rgba(255,212,90,.46) 35%, rgba(255,212,90,.46) 36%, transparent 37%),
      linear-gradient(150deg, transparent 34%, rgba(255,212,90,.34) 35%, rgba(255,212,90,.34) 36%, transparent 37%),
      linear-gradient(90deg, transparent 48%, rgba(245,164,31,.25) 49%, rgba(245,164,31,.25) 51%, transparent 52%);
    background-size: 58px 100px;
    mask-image: linear-gradient(90deg, #000, #000 58%, transparent 86%);
  }
  .ai-hero::after {
    opacity: .5;
    background:
      radial-gradient(10px 34px at 20% 14%, rgba(255,196,44,.78), transparent 68%),
      radial-gradient(7px 26px at 23% 19%, rgba(245,164,31,.58), transparent 70%),
      radial-gradient(9px 32px at 44% 8%, rgba(255,212,90,.55), transparent 68%);
    filter: blur(.2px);
    mask-image: linear-gradient(90deg, #000, #000 56%, transparent 72%);
  }
  .ai-matrix-field {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: .55;
    background-image:
      linear-gradient(90deg, rgba(255,212,90,.18) 1px, transparent 1px),
      linear-gradient(0deg, rgba(255,212,90,.14) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(90deg, #000, #000 52%, transparent 78%);
    animation: aiGridScan 16s linear infinite;
  }
  @keyframes aiGridScan {
    to { background-position: 44px 44px; }
  }
  .ai-eyebrow { color: var(--honey-bright); }

  .ai-hero-split {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(310px, 360px); gap: clamp(28px, 5vw, 48px); align-items: center;
  }
  .ai-hero-text { text-align: left; }

  .ai-title {
    font-size: clamp(32px, 4.5vw, 60px); font-weight: 700; line-height: 1.06;
    letter-spacing: -.035em; margin: 14px 0 20px;
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    color: var(--ai-ink); max-width: 560px;
  }
  .ai-sub {
    font-size: clamp(15px, 1.8vw, 17px); line-height: 1.65;
    color: rgba(223,253,244,.72); margin: 0 0 32px; max-width: 480px;
  }
  .ai-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  /* Pills */
  .pill {
    display: inline-flex; align-items: center; gap: 8px; padding: 13px 26px;
    border-radius: 999px; font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
    font-weight: 700; text-decoration: none; cursor: pointer; will-change: transform;
    transition: box-shadow 250ms ease, background 200ms ease, color 200ms ease;
  }
  .ai-hero .pill--filled { background: var(--honey-bright); color: #211300; box-shadow: 0 8px 24px rgba(245,164,31,.28); }
  .ai-hero .pill--filled:hover { box-shadow: 0 14px 34px rgba(245,164,31,.38); background: #ffe18a; }
  .ai-hero .pill--outline { border: 1.5px solid rgba(223,253,244,.55); color: var(--ai-ink); }
  .ai-hero .pill--outline:hover { background: rgba(255,212,90,.12); }
  .ai-cta .pill--filled { background: var(--brand); color: #f9f5ef; box-shadow: 0 8px 28px rgba(123,45,45,.28); }
  .ai-cta .pill--filled:hover { box-shadow: 0 14px 36px rgba(123,45,45,.42); background: #6a2828; }
  .ai-cta .pill--outline { border: 1.5px solid var(--brand); color: var(--brand); }
  .ai-cta .pill--outline:hover { background: rgba(123,45,45,.07); }

  /* ── Chat Character ─────────────────────────────────────────── */
  .ai-chat {
    position: relative;
    background:
      radial-gradient(circle at 22% 12%, rgba(255,212,90,.18), transparent 28%),
      linear-gradient(180deg, rgba(67,41,6,.98), rgba(31,19,4,.98));
    border: 1px solid var(--ai-line); border-radius: 14px; overflow: hidden;
    box-shadow: 0 22px 48px rgba(0,0,0,.3), 0 0 0 1px rgba(255,255,255,.03) inset;
    animation: chatFloat 5.5s ease-in-out infinite;
    will-change: transform;
  }
  .ai-chat::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent, rgba(255,212,90,.12) 52%, transparent);
    transform: translateY(-100%);
    animation: consoleScan 4.4s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes consoleScan {
    0%, 18% { transform: translateY(-100%); }
    62%, 100% { transform: translateY(100%); }
  }
  @keyframes chatFloat {
    0%,100% { transform: translateY(0); }
    45%     { transform: translateY(-12px) rotate(.2deg); }
    75%     { transform: translateY(-5px) rotate(-.15deg); }
  }
  .ac-header {
    display: flex; align-items: center; gap: 10px; padding: 14px 16px 12px;
    border-bottom: 1px solid var(--ai-line); background: rgba(255,212,90,.1);
  }
  .ac-avatar {
    width: 32px; height: 32px; border-radius: 8px; background: rgba(255,212,90,.18);
    display: grid; place-items: center; color: var(--honey-bright); flex-shrink: 0;
    border: 1px solid var(--ai-line);
  }
  .ac-name { display: block; font-size: 13px; font-weight: 700; color: var(--ai-ink); font-family: var(--font-body, "DM Sans", sans-serif); letter-spacing: .12em; }
  .ac-online { display: flex; align-items: center; gap: 5px; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: #22c55e; font-weight: 600; font-family: var(--font-body, "DM Sans", sans-serif); }
  .ac-online-dot { width: 5px; height: 5px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 6px rgba(34,197,94,.8); animation: badgePulse 2s ease-in-out infinite; }

  .ac-messages { padding: 14px 14px 16px; display: flex; flex-direction: column; gap: 10px; }
  .ac-msg {
    max-width: 85%; padding: 9px 13px; border-radius: 14px; font-size: 13px; line-height: 1.5;
    font-family: var(--font-body, "DM Sans", sans-serif);
    opacity: 0; transform: translateY(8px);
    animation: msgIn 350ms cubic-bezier(.34,1.4,.64,1) forwards;
    animation-delay: calc(var(--mi, 0) * 1000ms + 800ms);
  }
  .ac-msg p { margin: 0; }
  .ac-msg--in { background: rgba(255,248,223,.1); color: rgba(255,248,223,.9); border-bottom-left-radius: 4px; align-self: flex-start; }
  .ac-msg--out { background: rgba(255,212,90,.18); color: #fff8df; border: 1px solid var(--ai-line); border-bottom-right-radius: 4px; align-self: flex-end; }
  @keyframes msgIn { to { opacity: 1; transform: translateY(0); } }

  .ac-typing {
    display: flex; align-items: center; gap: 5px; padding: 10px 14px; border-radius: 14px;
    background: rgba(255,248,223,.1); width: fit-content; border-bottom-left-radius: 4px;
    opacity: 0; animation: msgIn 350ms cubic-bezier(.34,1.4,.64,1) forwards;
    animation-delay: calc(var(--mi, 4) * 1000ms + 800ms);
  }
  .ac-typing span {
    width: 6px; height: 6px; border-radius: 50%; background: var(--honey-bright); display: block;
    animation: typingDot 1.2s ease-in-out infinite;
  }
  .ac-typing span:nth-child(2) { animation-delay: .2s; }
  .ac-typing span:nth-child(3) { animation-delay: .4s; }
  @keyframes typingDot { 0%,80%,100%{transform:translateY(0);opacity:.4} 40%{transform:translateY(-5px);opacity:1} }

  /* ── Scroll story / How it works ───────────────────────────── */
  .ai-story {
    padding: 72px 0 80px;
    border-top: 1px solid rgba(30,24,22,.1);
  }
  .ai-story__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, .52fr);
    align-items: end;
    gap: clamp(24px, 5vw, 64px);
    margin-bottom: clamp(30px, 5vw, 52px);
  }
  .ai-story__heading p {
    max-width: 48ch;
    margin: 0;
    color: rgba(20,19,18,.72);
    font-size: 15px;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .ai-story__pin {
    display: grid;
    grid-template-columns: minmax(300px, .82fr) minmax(420px, 1.18fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
    min-height: min(680px, calc(100dvh - 104px));
    padding: clamp(26px, 4vw, 48px);
    border: 1px solid rgba(182,109,0,.2);
    border-radius: 24px;
    background:
      linear-gradient(30deg, transparent 34%, rgba(182,109,0,.1) 35%, rgba(182,109,0,.1) 36%, transparent 37%),
      linear-gradient(150deg, transparent 34%, rgba(182,109,0,.08) 35%, rgba(182,109,0,.08) 36%, transparent 37%),
      rgba(255,247,223,.92);
    background-size: 54px 94px, 54px 94px, auto;
    box-shadow: 0 28px 70px rgba(107,59,0,.08), inset 0 1px 0 rgba(255,255,255,.78);
  }
  .ai-story__visual {
    position: relative;
    min-height: 410px;
    display: grid;
    place-items: center;
    isolation: isolate;
  }
  .ai-story__orbit {
    position: absolute;
    width: min(330px, 86%);
    aspect-ratio: 1;
    border: 1px solid rgba(182,109,0,.2);
    border-radius: 50%;
  }
  .ai-story__orbit::before,
  .ai-story__orbit::after {
    content: "";
    position: absolute;
    inset: 12%;
    border: 1px dashed rgba(182,109,0,.24);
    border-radius: 50%;
  }
  .ai-story__orbit::after {
    inset: 28%;
    border-style: solid;
    background: rgba(255,212,90,.18);
    box-shadow: 0 0 72px rgba(245,164,31,.22);
  }
  .ai-story__core {
    position: relative;
    z-index: 2;
    width: 190px;
    aspect-ratio: 1.12;
    display: grid;
    place-content: center;
    gap: 8px;
    padding: 30px;
    text-align: center;
    color: #fff8df;
    clip-path: polygon(25% 4%, 75% 4%, 100% 50%, 75% 96%, 25% 96%, 0 50%);
    background: linear-gradient(155deg, #2b1a05, #7a4300);
    filter: drop-shadow(0 22px 28px rgba(107,59,0,.22));
  }
  .ai-story__core span,
  .ai-story__permission,
  .ai-story__step-owner {
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .ai-story__core span { color: rgba(255,248,223,.66); }
  .ai-story__core strong {
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    font-size: 22px;
    line-height: 1.08;
    letter-spacing: -.025em;
  }
  .ai-story__state-stack {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 28px;
    width: min(280px, 88%);
    transform: translateX(-50%);
    min-height: 42px;
  }
  .ai-story__state {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 11px 18px;
    border: 1px solid rgba(182,109,0,.2);
    border-radius: 999px;
    background: rgba(255,252,242,.96);
    color: var(--honey-dark);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .06em;
    opacity: 0;
  }
  .ai-story__state.is-current { opacity: 1; }
  .ai-story__permission {
    position: absolute;
    z-index: 3;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(69,41,0,.72);
    white-space: nowrap;
  }
  .ai-story__permission-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #25834f;
    box-shadow: 0 0 0 5px rgba(37,131,79,.1);
  }
  .ai-story__sequence {
    position: relative;
    display: grid;
    grid-template-columns: 2px minmax(0, 1fr);
    gap: 22px;
  }
  .ai-story__progress { position: relative; }
  .ai-story__progress-track,
  .ai-story__progress-fill {
    position: absolute;
    inset: 8px 0;
    border-radius: 999px;
  }
  .ai-story__progress-track { background: rgba(182,109,0,.16); }
  .ai-story__progress-fill {
    background: linear-gradient(180deg, var(--honey-bright), var(--brand));
    transform: scaleY(0);
    transform-origin: top;
  }
  .ai-story__steps {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ai-story__step {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: start;
    padding: 14px 16px;
    border: 1px solid transparent;
    border-radius: 14px;
    color: rgba(20,19,18,.72);
    transition: border-color 220ms ease, background 220ms ease, color 220ms ease;
  }
  .ai-story__step.is-current {
    border-color: rgba(182,109,0,.24);
    background: rgba(255,255,255,.58);
    color: var(--ink);
  }
  .ai-story__step--approval.is-current {
    border-color: rgba(37,131,79,.24);
    background: rgba(231,248,237,.68);
  }
  .ai-story__step-index {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid rgba(182,109,0,.2);
    border-radius: 50%;
    color: var(--brand);
    font-size: 10px;
    font-weight: 800;
  }
  .ai-story__step h3 {
    margin: 0 0 4px;
    color: inherit;
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.15;
    letter-spacing: -.018em;
  }
  .ai-story__step p {
    max-width: 54ch;
    margin: 0;
    color: inherit;
    font-size: 13px;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .ai-story__step-owner {
    align-self: center;
    color: rgba(107,59,0,.68);
    white-space: nowrap;
  }
  .ai-story__step--approval .ai-story__step-owner { color: #226b42; }

  /* ── AI metric 24/7 ─────────────────────────────────────────── */
  .ai-247 { display: inline-flex; align-items: baseline; gap: 2px; }
  .metric-slash { font-size: .5em; font-weight: 700; opacity: .7; }

  /* ── Honeycomb AI Loop ──────────────────────────────────────── */
  .loop-section { padding: 72px 0 80px; border-top: 1px solid rgba(30,24,22,.1); }
  .loop-heading {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(260px, .55fr);
    gap: clamp(20px, 4vw, 52px);
    align-items: end;
    margin-bottom: 34px;
  }
  .loop-heading p {
    margin: 0;
    max-width: 44ch;
    color: rgba(20,19,18,.68);
    font-size: 15px;
    line-height: 1.65;
  }
  .hive-loop {
    position: relative;
    min-height: 470px;
    border-radius: 24px;
    padding: clamp(22px, 5vw, 46px);
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 45%, rgba(255,212,90,.36), transparent 26%),
      linear-gradient(30deg, transparent 34%, rgba(182,109,0,.18) 35%, rgba(182,109,0,.18) 36%, transparent 37%),
      linear-gradient(150deg, transparent 34%, rgba(182,109,0,.14) 35%, rgba(182,109,0,.14) 36%, transparent 37%),
      linear-gradient(135deg, rgba(255,247,223,.92), rgba(255,235,166,.5));
    background-size: auto, 54px 94px, 54px 94px, auto;
    border: 1px solid rgba(182,109,0,.18);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.74), 0 24px 60px rgba(107,59,0,.08);
  }
  .hive-loop::before,
  .hive-loop::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }
  .hive-loop::before {
    left: 10%;
    right: 10%;
    top: 48%;
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, rgba(245,164,31,.85), rgba(255,212,90,.95), transparent);
    filter: blur(.2px);
    animation: honeyFlow 4.8s ease-in-out infinite;
  }
  .hive-loop::after {
    inset: 0;
    opacity: .42;
    background:
      radial-gradient(10px 46px at 22% 13%, rgba(245,164,31,.64), transparent 72%),
      radial-gradient(8px 36px at 73% 18%, rgba(255,196,44,.58), transparent 72%),
      radial-gradient(11px 42px at 54% 83%, rgba(182,109,0,.34), transparent 72%);
  }
  .hive-cell {
    position: absolute;
    z-index: 2;
    width: min(240px, 28vw);
    min-height: 205px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    padding: 32px clamp(38px, 4vw, 56px);
    background: transparent;
    color: #211300;
    filter: drop-shadow(0 18px 24px rgba(107,59,0,.14));
    transform: translateY(10px) scale(.96);
    animation: hiveCellFloat 6.2s ease-in-out infinite;
    animation-delay: calc(var(--hive-i) * -1.1s);
  }
  .hive-cell::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    clip-path: polygon(25% 4%, 75% 4%, 100% 50%, 75% 96%, 25% 96%, 0 50%);
    background:
      radial-gradient(circle at 35% 18%, rgba(255,255,255,.78), transparent 28%),
      linear-gradient(150deg, rgba(255,212,90,.94), rgba(245,164,31,.68) 64%, rgba(182,109,0,.3));
  }
  .hive-cell > * {
    position: relative;
    z-index: 1;
  }
  .hive-cell--1 { left: 7%; top: 13%; }
  .hive-cell--2 { right: 10%; top: 10%; }
  .hive-cell--3 { right: 17%; bottom: 9%; }
  .hive-cell--4 { left: 15%; bottom: 8%; }
  .hive-num,
  .hive-stat {
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-weight: 800;
    color: rgba(70,40,0,.68);
  }
  .hive-cell h3 {
    margin: 0;
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.08;
    letter-spacing: -.025em;
    text-wrap: balance;
  }
  .hive-cell p {
    margin: 0;
    font-size: 13px;
    line-height: 1.42;
    color: rgba(33,19,0,.76);
  }
  .hive-stat {
    margin-top: 2px;
    color: var(--honey-dark);
  }
  .hive-core {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: 50%;
    width: 170px;
    height: 148px;
    transform: translate(-50%, -50%);
    clip-path: polygon(25% 4%, 75% 4%, 100% 50%, 75% 96%, 25% 96%, 0 50%);
    display: grid;
    place-content: center;
    text-align: center;
    gap: 3px;
    background: linear-gradient(160deg, #2b1a05, #7a4300);
    color: #fff8df;
    box-shadow: 0 0 0 8px rgba(255,212,90,.2);
  }
  .hive-core span {
    display: block;
    font-size: 11px;
    line-height: 1.1;
    letter-spacing: .15em;
    text-transform: uppercase;
    font-weight: 800;
  }
  .hive-flow {
    position: absolute;
    z-index: 1;
    inset: 19% 14%;
    border: 2px dashed rgba(182,109,0,.25);
    border-radius: 48%;
    animation: hiveOrbit 18s linear infinite;
  }
  @keyframes honeyFlow {
    0%,100% { opacity: .2; transform: scaleX(.55); }
    45% { opacity: .95; transform: scaleX(1); }
  }
  @keyframes hiveOrbit {
    to { transform: rotate(360deg); }
  }
  @keyframes hiveCellFloat {
    0%,100% { transform: translateY(0) scale(.98); }
    48% { transform: translateY(-10px) scale(1.01); }
  }

  /* ── Service cards ──────────────────────────────────────────── */
  .services-section { padding: 72px 0 80px; border-top: 1px solid rgba(30,24,22,.1); }
  .svc-card { padding: 28px 24px; min-height: 240px; }
  .services-section .svc-card,
  .full-services .mini-card {
    border-radius: 12px;
    background:
      linear-gradient(180deg, rgba(67,41,6,.97), rgba(31,19,4,.97));
    border-color: rgba(255,212,90,.24);
  }
  .services-section .svc-card.is-honey-glazed,
  .full-services .mini-card.is-honey-glazed {
    background:
      radial-gradient(circle at 28% 18%, rgba(255,255,255,.26), transparent 26%),
      linear-gradient(145deg, rgba(255,212,90,.96), rgba(245,164,31,.82) 52%, rgba(122,67,0,.92));
    border-color: rgba(255,212,90,.58);
    color: #2b1a05;
  }
  .svc-icon {
    width: 40px; height: 40px; border-radius: 9px; background: rgba(255,212,90,.14);
    display: grid; place-items: center; color: var(--honey-bright); flex-shrink: 0;
    transition: background 350ms ease, color 300ms ease, transform 400ms cubic-bezier(.34,1.56,.64,1);
  }
  .svc-card:hover .svc-icon,
  .svc-card.is-honey-glazed .svc-icon { background: rgba(255,212,90,.3); color: #fff8df; transform: rotate(3deg) scale(1.08); }
  .svc-title {
    font-size: clamp(17px, 2vw, 21px); font-weight: 700; margin: 0; letter-spacing: -.015em;
    font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif);
    line-height: 1.2; color: #fff8df; transition: color 300ms ease;
  }
  .svc-card:hover .svc-title { color: rgba(245,240,232,.95); }
  .svc-card.is-honey-glazed .svc-title { color: #2b1a05; }
  .svc-footer { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--honey-bright); font-weight: 600; margin: 0; margin-top: auto; font-family: var(--font-body, "DM Sans", sans-serif); transition: color 300ms ease; }
  .svc-card:hover .svc-footer { color: rgba(245,240,232,.45); }
  .svc-card.is-honey-glazed .svc-footer { color: #4b2a00; }
  .bento-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 7px; flex: 1; }
  .bento-list li {
    font-size: 13.5px; line-height: 1.55; color: rgba(255,248,223,.7);
    padding-left: 14px; position: relative; font-family: var(--font-body, "DM Sans", sans-serif);
    transform: translateX(-8px);
    transition: transform 420ms cubic-bezier(.16,1,.3,1), color 300ms ease;
    transition-delay: calc(var(--li-i, 0) * 55ms + 60ms);
  }
  .bento-list li::before { content: "–"; position: absolute; left: 0; color: var(--honey-bright); opacity: .7; transition: color 300ms ease; }
  .svc-card:hover .bento-list li { transform: translateX(0); color: rgba(245,240,232,.7); }
  .svc-card.is-honey-glazed .bento-list li { transform: translateX(0); color: rgba(43,26,5,.76); }
  .svc-card:hover .bento-list li::before,
  .svc-card.is-honey-glazed .bento-list li::before { color: var(--honey-bright); opacity: .9; }

  /* ── Full services ──────────────────────────────────────────── */
  .full-services { padding: 72px 0 80px; border-top: 1px solid rgba(30,24,22,.1); }
  .mini-card { padding: 24px 22px; display: flex; flex-direction: column; gap: 10px; }
  .mini-title { font-size: 15px; font-weight: 700; margin: 0; letter-spacing: -.01em; color: #fff8df; font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif); transition: color 300ms ease; }
  .mini-desc { font-size: 13px; line-height: 1.65; color: rgba(255,248,223,.66); margin: 0; transition: color 300ms ease; }
  .mini-card:hover .mini-title { color: rgba(245,240,232,.95); }

---
import BaseLayout from "../layouts/BaseLayout.astro";
import LocalizedStudioLanding from "../components/LocalizedStudioLanding.astro";
import { localizedOrganizationSchema, markets, regionalAlternates } from "../data/localizedMarkets";
import { getDailySeoRecommendation } from "../lib/seoAgent.js";

const seoRecommendation = await getDailySeoRecommendation({ geo: "DE", market: "munich" });
const market = {
  ...markets.munich,
  title: `${seoRecommendation.keyword} | Munich Digital Marketing, Enterprise AI Automation & Virtual Assistant | LuliDigital`,
  description: `LuliDigital helps Munich enterprises and German tech teams with ${seoRecommendation.keyword}, performance marketing, enterprise AI automation, and executive virtual assistant services.`,
  seoRecommendation,
  serviceSchema: {
    ...markets.munich.serviceSchema,
    serviceType: [seoRecommendation.keyword, ...markets.munich.serviceSchema.serviceType],
    description: `Munich digital marketing agency offering ${seoRecommendation.keyword}, corporate performance marketing, enterprise AI workflow automation, and executive virtual assistant services.`,
  },
};
---

<BaseLayout
  title={market.title}
  description={market.description}
  canonicalPath="/munich"
  serviceSchema={market.serviceSchema}
  localBusinessSchema={market.localBusinessSchema}
  organizationSchemaOverride={localizedOrganizationSchema}
  hreflangLinks={regionalAlternates}
>
  <LocalizedStudioLanding market={market} />
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogArticle from "../../components/BlogArticle.astro";
import { getCollection, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  // Number of animation themes the blog rotates through (see [data-anim] CSS).
  const ANIM_THEMES = 3;

  const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .filter((post) => post.data.pubDate.valueOf() <= Date.now())
    // Oldest → newest so each successive post cycles to the next animation.
    .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

  return posts.map((post, i) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post, animIndex: i % ANIM_THEMES },
  }));
}

const { post, animIndex = 0 } = Astro.props;

const { Content } = await render(post);
const siteUrl = "https://lulidigital.com";
const canonicalPath = `/blog/${post.id.replace(/\.md$/, "")}`;
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const articleSchema = {
  "@type": "BlogPosting",
  "@id": `${canonicalUrl}#article`,
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.pubDate.toISOString(),
  "author": { "@id": `${siteUrl}/#organization` },
  "publisher": { "@id": `${siteUrl}/#organization` },
  "mainEntityOfPage": { "@id": `${canonicalUrl}#webpage` },
};
---

<BaseLayout
  title={`${post.data.title} | LuliDigital`}
  description={post.data.description}
  active="blog"
  canonicalPath={canonicalPath}
  extraSchemas={[articleSchema]}
  ogType="article"
>
  <BlogArticle
    title={post.data.title}
    description={post.data.description}
    category={post.data.category}
    readingTime={post.data.readingTime}
    pubDate={post.data.pubDate}
    animIndex={animIndex}
    showAvatar={post.data.avatar !== false}
  >
    <Content />
  </BlogArticle>
</BaseLayout>

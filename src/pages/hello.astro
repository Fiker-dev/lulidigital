---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "s-maxage=86400, stale-while-revalidate=604800");

const services = [
  {
    number: "01",
    title: "Admin & Operations",
    href: "/va-desk",
    copy: "Inbox and calendar management, research, client follow-up, scheduling, reporting and project coordination.",
  },
  {
    number: "02",
    title: "Marketing",
    href: "/marketing-desk",
    copy: "Content systems, social media, campaign support, SEO and consistent digital execution.",
  },
  {
    number: "03",
    title: "AI Systems & Automation",
    href: "/ai-desk",
    copy: "Practical automation, AI assistants, workflow systems and less repetitive work.",
  },
  {
    number: "04",
    title: "Web Design",
    href: "/web-design-desk",
    copy: "Fast, clear pages that explain the offer properly and make the next step obvious.",
  },
];
---

<BaseLayout
  title="Hi, I’m Fiker. | LuliDigital"
  description="Meet Fiker and see how LuliDigital supports business owners with operations, marketing, and practical AI systems."
  canonicalPath="/hello"
  ogImage="/assets/outreach/fiker-mini-fiker-outreach.jpg"
>
  <section class="hello-hero" aria-labelledby="hello-title" data-atmosphere="hero" data-hive-section>
    <div class="hello-copy">
      <p class="hello-kicker" data-blur-in>A personal hello from LuliDigital</p>
      <h1 id="hello-title" data-blur-in data-blur-delay="90">Hi, I’m <em>Fiker.</em></h1>
      <p class="hello-intro" data-blur-in data-blur-delay="220">I help business owners handle the work behind the scenes, so they can focus on leading, making decisions and growing the business.</p>
      <div class="hello-actions" data-stagger data-stagger-gap="80">
        <a class="hello-button" href="mailto:info@lulidigital.com?subject=Hello%20Fiker">Email Fiker <span aria-hidden="true">↗</span></a>
        <a class="hello-link" href="#services-title">See where I can help <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="video-wrap" data-reveal="fade" data-reveal-delay="120">
      <div class="video-frame">
        <iframe
          id="hello-video"
          src="https://www.youtube-nocookie.com/embed/88h6pCbbor4?autoplay=1&mute=1&loop=1&playlist=88h6pCbbor4&playsinline=1&rel=0&modestbranding=1&enablejsapi=1&origin=https%3A%2F%2Flulidigital.com"
          title="A short introduction from Fiker, founder of LuliDigital"
          allow="autoplay; encrypted-media; picture-in-picture"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="eager"
        ></iframe>
        <button type="button" class="sound-toggle" data-sound-toggle aria-pressed="false">
          <span class="sound-icon" aria-hidden="true">🔊</span>
          <span class="sound-label">Tap for sound</span>
        </button>
      </div>
      <p class="video-note" data-video-note><span aria-hidden="true"></span> Tap the video to turn the sound on</p>
      <a class="founder-link" href="/founder">
        <span>Read my founder story</span>
        <span class="founder-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="services" aria-labelledby="services-title" data-atmosphere="services" data-hive-section data-bee-stop>
    <div class="section-heading" data-reveal="up">
      <p class="hello-kicker">Where I can help</p>
      <h2 id="services-title">Support that fits the work.</h2>
    </div>
    <div class="service-list">
      {services.map((service, i) => (
        <a class="service-row" href={service.href} data-reveal="up" data-reveal-delay={i * 90}>
          <span class="service-number">{service.number}</span>
          <div>
            <h3>{service.title}</h3>
            <p>{service.copy}</p>
            <span class="service-action">Explore {service.title} <span aria-hidden="true">→</span></span>
          </div>
          <span class="service-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="positioning" aria-labelledby="positioning-title" data-atmosphere="story" data-hive-section>
    <div class="hello-buddy" data-hello-buddy data-reveal="float-l" aria-hidden="true">
      <div class="hello-buddy__stage">
        <img class="hello-buddy__img" src="/assets/mini-fiker/story-coffee.png" alt="" decoding="async" />
      </div>
      <p class="hello-buddy__caption" data-buddy-caption>Coffee first.</p>
    </div>
    <div class="positioning-copy" data-reveal="up" data-reveal-delay="120">
      <p class="hello-kicker">A lighter way to begin</p>
      <h2 id="positioning-title">Four ways to make the work lighter.</h2>
      <p>You do not need to begin with a large commitment. Start with one practical need, get it working properly, and build from there if it makes sense.</p>
    </div>
  </section>

  <section class="hello-final" aria-labelledby="final-title" data-reveal="fade" data-atmosphere="cta" data-hive-section data-bee-stop>
    <p class="hello-kicker">Let’s make room for the important work</p>
    <h2 id="final-title">What could I take off your plate?</h2>
    <a class="hello-button hello-button--light" href="mailto:info@lulidigital.com?subject=What%20I’d%20like%20to%20take%20off%20my%20plate">Email Fiker <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>

<script>
  // Browsers refuse to autoplay video WITH sound — it must start muted or it
  // won't play at all. So: autoplay muted, then unmute on the viewer's first
  // real interaction (a gesture is what the browser requires), and give them
  // an explicit control either way.
  (() => {
    const frame = document.getElementById("hello-video") as HTMLIFrameElement | null;
    const toggle = document.querySelector<HTMLButtonElement>("[data-sound-toggle]");
    const note = document.querySelector<HTMLElement>("[data-video-note]");
    if (!frame || !toggle) return;

    let on = false;

    const send = (func: string, args: unknown[] = []) => {
      frame.contentWindow?.postMessage(JSON.stringify({ event: "command", func, args }), "*");
    };

    const setSound = (next: boolean) => {
      on = next;
      if (on) {
        // Unmuting alone can leave the player paused (the browser may have
        // stopped it when the audio track came on), so always resume playback
        // too — a tap on the speaker should mean "play this, with sound".
        send("unMute");
        send("setVolume", [100]);
        send("playVideo");
      } else {
        send("mute");
      }
      toggle.setAttribute("aria-pressed", String(on));
      toggle.classList.toggle("is-on", on);
      toggle.querySelector(".sound-icon")!.textContent = on ? "🔊" : "🔇";
      toggle.querySelector(".sound-label")!.textContent = on ? "Sound on" : "Tap for sound";
      if (note) note.textContent = on ? "Sound is on — tap the speaker to mute" : "Tap the video to turn the sound on";
    };

    toggle.addEventListener("click", (e) => { e.stopPropagation(); setSound(!on); });

    // First genuine gesture anywhere on the page turns sound on once.
    const once = () => { if (!on) setSound(true); cleanup(); };
    const cleanup = () => {
      document.removeEventListener("pointerdown", once);
      document.removeEventListener("keydown", once);
      document.removeEventListener("touchstart", once);
    };
    document.addEventListener("pointerdown", once, { once: true });
    document.addEventListener("keydown", once, { once: true });
    document.addEventListener("touchstart", once, { once: true, passive: true });
  })();

  // Mini-me cycles through the blog's story poses while you read. Same assets
  // and same payoff as the blog buddy: the spill is immediately followed by
  // the mop, so the coffee drip gets cleaned up rather than just fading.
  // Timer-driven here (not scroll-driven) so she performs beside the copy.
  (() => {
    const buddy = document.querySelector<HTMLElement>("[data-hello-buddy]");
    const img = buddy?.querySelector<HTMLImageElement>(".hello-buddy__img");
    const caption = buddy?.querySelector<HTMLElement>("[data-buddy-caption]");
    const stage = buddy?.querySelector<HTMLElement>(".hello-buddy__stage");
    if (!buddy || !img || !stage) return;

    const ROOT = "/assets/mini-fiker";
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // spill sits directly before mop so the drip has a consequence.
    const beats = [
      { pose: "story-coffee", line: "Coffee first." },
      { pose: "laptop",       line: "Systems doing the boring bits." },
      { pose: "story-spill",  line: "\u2026oops." },
      { pose: "story-mop",    line: "Cleaned up. No fuss." },
      { pose: "idea",         line: "Which frees up the good ideas." },
      { pose: "celebrate",    line: "And the work actually moves." },
      { pose: "story-relax",  line: "Lighter already." },
    ];

    beats.forEach((b) => { const i = new Image(); i.src = `${ROOT}/${b.pose}.png`; });

    if (caption) { caption.textContent = beats[0].line; caption.classList.add("is-in"); }
    if (reduced) return;

    let idx = 0;
    let splash: HTMLElement | null = null;

    const step = () => {
      idx = (idx + 1) % beats.length;
      const beat = beats[idx];

      img.src = `${ROOT}/${beat.pose}.png`;
      buddy.classList.remove("hello-buddy--pop");
      void buddy.offsetWidth; // restart the pop
      buddy.classList.add("hello-buddy--pop");

      if (caption) {
        caption.classList.remove("is-in");
        window.setTimeout(() => {
          caption.textContent = beat.line;
          caption.classList.add("is-in");
        }, 260);
      }

      if (beat.pose === "story-spill") {
        splash?.remove();
        splash = document.createElement("span");
        splash.className = "coffee-splash";
        stage.appendChild(splash);
      } else if (beat.pose === "story-mop") {
        // she mops it up — the drip is cleared rather than left to fade.
        splash?.classList.add("is-cleaned");
        const el = splash;
        window.setTimeout(() => el?.remove(), 900);
        splash = null;
      }
    };

    let timer = window.setInterval(step, 3000);
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting && !timer) timer = window.setInterval(step, 3000);
        else if (!e.isIntersecting && timer) { clearInterval(timer); timer = 0; }
      }
    }, { threshold: 0.15 });
    io.observe(buddy);
  })();
</script>

<style>
  :global(body) { background: var(--paper); }
  :global(main.page) { overflow: hidden; }

  .hello-hero,
  .services,
  .positioning,
  .hello-final {
    max-width: 1120px;
    margin: 0 auto;
    padding-left: clamp(20px, 5vw, 56px);
    padding-right: clamp(20px, 5vw, 56px);
  }

  .hello-hero {
    min-height: calc(100svh - 76px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(290px, 390px);
    align-items: center;
    gap: clamp(44px, 8vw, 112px);
    padding-top: clamp(48px, 7vw, 92px);
    padding-bottom: clamp(64px, 9vw, 120px);
  }

  .hello-kicker {
    margin: 0 0 18px;
    color: var(--brand);
    font: 700 10px/1.2 var(--font-body, "DM Sans", sans-serif);
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  h1, h2, h3 { font-family: var(--font-display, "Fraunces", Georgia, serif); }
  h1 {
    max-width: 620px;
    margin: 0;
    color: var(--ink);
    font-size: clamp(58px, 8vw, 106px);
    font-weight: 760;
    letter-spacing: -.055em;
    line-height: .94;
  }
  h1 em { color: var(--brand); font-weight: 620; }
  .hello-intro {
    max-width: 600px;
    margin: 28px 0 32px;
    color: var(--muted);
    font: 400 clamp(18px, 2vw, 23px)/1.55 var(--font-body, "DM Sans", sans-serif);
  }

  .hello-button {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    min-height: 48px;
    padding: 13px 21px;
    border: 1px solid var(--brand);
    border-radius: 999px;
    background: var(--brand);
    color: var(--paper);
    font: 700 12px/1 var(--font-body, "DM Sans", sans-serif);
    letter-spacing: .12em;
    text-transform: uppercase;
    transition: transform 220ms cubic-bezier(.16,1,.3,1), background 180ms ease;
  }
  .hello-button:hover { color: var(--paper); background: var(--honey-dark); transform: translateY(-2px); }
  .hello-button:focus-visible, .service-row:focus-visible, .hello-link:focus-visible { outline: 3px solid var(--wine-soft); outline-offset: 4px; }

  .hello-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; }
  .hello-link {
    display: inline-flex; align-items: center; gap: 9px;
    color: var(--wine-strong);
    font: 700 12px/1 var(--font-body, "DM Sans", sans-serif);
    letter-spacing: .12em; text-transform: uppercase;
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px;
    transition: opacity 180ms ease;
  }
  .hello-link:hover { opacity: .7; }

  .video-wrap { width: min(100%, 390px); justify-self: end; }
  .video-frame {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 24px;
    background: #171412;
    box-shadow: 0 30px 80px rgba(43,25,18,.18), 0 0 0 1px rgba(23,20,18,.1);
  }
  .video-frame::before {
    content: "";
    position: absolute;
    inset: 10px;
    z-index: 1;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 16px;
    pointer-events: none;
  }
  .video-frame iframe { width: 100%; height: 100%; border: 0; display: block; }

  .sound-toggle {
    position: absolute;
    z-index: 2;
    right: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid rgba(255,255,255,.28);
    border-radius: 999px;
    background: rgba(18,14,12,.72);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fdf5e6;
    font: 700 11px/1 var(--font-body, "DM Sans", sans-serif);
    letter-spacing: .1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 180ms ease, transform 180ms ease, border-color 180ms ease;
  }
  .sound-toggle:hover { background: rgba(18,14,12,.9); transform: translateY(-1px); }
  .sound-toggle:focus-visible { outline: 3px solid var(--honey, #f5a41f); outline-offset: 3px; }
  .sound-toggle.is-on { border-color: rgba(245,164,31,.7); }
  .sound-icon { font-size: 13px; }

  /* Gentle pulse until sound is enabled, so it reads as an invitation. */
  .sound-toggle:not(.is-on) { animation: soundPulse 2.4s ease-in-out infinite; }
  @keyframes soundPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(245,164,31,.45); }
    50%      { box-shadow: 0 0 0 9px rgba(245,164,31,0); }
  }
  .video-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 15px 0 0;
    color: rgba(23,20,18,.55);
    font: 500 11px/1.4 var(--font-body, "DM Sans", sans-serif);
    letter-spacing: .06em;
  }
  .video-note span { width: 6px; height: 6px; border-radius: 50%; background: var(--honey); }

  .founder-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 14px;
    padding: 13px 18px;
    border: 1px solid rgba(23,20,18,.16);
    border-radius: 999px;
    background: rgba(255,255,255,.5);
    color: var(--ink);
    font: 700 11.5px/1 var(--font-body, "DM Sans", sans-serif);
    letter-spacing: .11em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 200ms ease, border-color 200ms ease, transform 200ms cubic-bezier(.16,1,.3,1);
  }
  .founder-link:hover {
    border-color: var(--brand);
    background: rgba(255,255,255,.9);
    transform: translateY(-2px);
  }
  .founder-link:focus-visible { outline: 3px solid var(--wine-soft); outline-offset: 4px; }
  .founder-arrow { color: var(--brand); transition: transform 200ms ease; }
  .founder-link:hover .founder-arrow { transform: translateX(4px); }

  .services {
    padding-top: clamp(74px, 10vw, 132px);
    padding-bottom: clamp(74px, 10vw, 132px);
    border-top: 1px solid rgba(23,20,18,.1);
  }
  .section-heading { display: grid; grid-template-columns: 1fr 2fr; gap: 40px; align-items: start; margin-bottom: 54px; }
  .section-heading h2, .positioning h2, .hello-final h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(40px, 5.4vw, 68px);
    font-weight: 650;
    letter-spacing: -.04em;
    line-height: 1.02;
  }
  .service-list { border-top: 1px solid rgba(23,20,18,.14); }
  .service-row {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 28px;
    gap: 18px;
    align-items: start;
    padding: clamp(25px, 4vw, 42px) 0;
    border-bottom: 1px solid rgba(23,20,18,.14);
    transition: padding-left 260ms cubic-bezier(.16,1,.3,1), color 180ms ease;
  }
  .service-row:hover { padding-left: 12px; }
  .service-number { padding-top: 9px; color: var(--brand); font: 700 10px/1 var(--font-body, sans-serif); letter-spacing: .16em; }
  .service-row h3 { margin: 0 0 8px; font-size: clamp(25px, 3vw, 37px); font-weight: 600; letter-spacing: -.025em; }
  .service-row p { max-width: 680px; margin: 0; color: rgba(23,20,18,.65); font: 400 16px/1.65 var(--font-body, "DM Sans", sans-serif); }
  .service-action {
    display: inline-flex;
    gap: 8px;
    margin-top: 18px;
    color: var(--wine-strong);
    font: 700 11px/1.2 var(--font-body, "DM Sans", sans-serif);
    letter-spacing: .12em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }
  .service-arrow { padding-top: 6px; color: var(--brand); font-size: 20px; }

  .positioning {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: clamp(48px, 9vw, 120px);
    align-items: center;
    padding-top: clamp(74px, 10vw, 132px);
    padding-bottom: clamp(74px, 10vw, 132px);
  }
  /* Mini-me replaces the repeated video still. Same animation vocabulary as
     the blog buddy (bob + pop on pose change + coffee spill), but driven by a
     timer rather than scroll — she cycles while you read. */
  .hello-buddy { display: grid; justify-items: center; gap: 14px; }
  .hello-buddy__stage {
    position: relative;
    display: grid;
    place-items: end center;
    width: min(100%, 300px);
    min-height: 320px;
  }
  .hello-buddy__img {
    display: block;
    width: min(100%, 260px);
    height: auto;
    animation: buddyBob 3.4s ease-in-out infinite;
  }
  .hello-buddy--pop .hello-buddy__img {
    animation: buddyPop .55s ease, buddyBob 3.4s ease-in-out infinite .55s;
  }
  @keyframes buddyBob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @keyframes buddyPop {
    0%   { transform: translateY(0) scale(.72) rotate(-3deg); opacity: .5; }
    60%  { transform: translateY(-4px) scale(1.07) rotate(1deg); opacity: 1; }
    100% { transform: translateY(0) scale(1) rotate(0); }
  }

  .hello-buddy__caption {
    margin: 0;
    min-height: 1.2em;
    color: var(--muted);
    font: 500 13px/1.3 var(--font-body, "DM Sans", sans-serif);
    text-align: center;
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .hello-buddy__caption.is-in { opacity: 1; }

  /* The coffee spill, borrowed from the blog buddy. */
  .coffee-splash {
    position: absolute;
    left: 12%;
    bottom: -6px;
    width: 120px;
    height: 60px;
    pointer-events: none;
    background: linear-gradient(180deg,
      rgba(94,55,22,.85) 0%, rgba(94,55,22,.55) 28%,
      rgba(94,55,22,.26) 62%, rgba(94,55,22,0) 100%);
    border-radius: 0 0 46% 46% / 0 0 86% 86%;
    transform-origin: top;
    animation: coffeeDrip 1.1s cubic-bezier(.4,0,.2,1) forwards;
    transition: opacity .8s ease, transform .8s ease;
  }
  @keyframes coffeeDrip {
    0%   { opacity: 0; transform: scaleY(.12); }
    70%  { opacity: .95; transform: scaleY(1.04); }
    100% { opacity: .9; transform: scaleY(1); }
  }
  /* mopped away rather than simply fading out */
  .coffee-splash.is-cleaned { opacity: 0; transform: scaleY(.15) translateX(14px); }
  .positioning-copy p:last-child { max-width: 620px; margin: 25px 0 0; color: rgba(23,20,18,.68); font: 400 18px/1.65 var(--font-body, "DM Sans", sans-serif); }

  .hello-final {
    max-width: none;
    padding-top: clamp(80px, 11vw, 146px);
    padding-bottom: clamp(80px, 11vw, 146px);
    text-align: center;
    background: var(--honey-dark);
  }
  .hello-final .hello-kicker { color: rgba(255,247,223,.7); }
  .hello-final h2 { max-width: 780px; margin: 0 auto 36px; color: var(--paper); }
  .hello-button--light { border-color: var(--paper); background: var(--paper); color: var(--honey-dark); }
  .hello-button--light:hover { background: var(--honey-bright); color: var(--honey-dark); }

  @media (max-width: 760px) {
    .hello-hero { grid-template-columns: 1fr; min-height: auto; gap: 45px; padding-top: 58px; }
    .video-wrap { width: min(100%, 340px); justify-self: center; order: -1; }
    .hello-copy { text-align: center; }
    .hello-intro { margin-left: auto; margin-right: auto; }
    .hello-actions { justify-content: center; }
    .section-heading { grid-template-columns: 1fr; gap: 2px; }
    .service-row { grid-template-columns: 36px minmax(0, 1fr) 22px; gap: 10px; }
    .positioning { grid-template-columns: 1fr; gap: 42px; }
    .hello-buddy { width: min(86vw, 320px); margin: 0 auto; }
    .positioning-copy { text-align: center; }
    .positioning-copy p:last-child { margin-left: auto; margin-right: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hello-button, .service-row, .sound-toggle, .founder-link, .founder-arrow { transition: none; }
    .hello-buddy__img { animation: none !important; }
    .coffee-splash { display: none; }
    .hello-buddy__caption { transition: none; }
    .sound-toggle:not(.is-on) { animation: none; }
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";

const serviceSchema = {
  "name": "Digital Marketing, Performance Marketing & Brand Strategy Services",
  "serviceType": [
    "digital marketing services",
    "performance marketing agency",
    "brand strategy services",
    "paid media management",
    "social media marketing agency",
    "content marketing services",
    "SEO services for small business",
    "Meta ads management",
    "Google ads management",
    "TikTok marketing agency",
    "campaign management services",
    "creative direction services",
    "growth marketing services",
    "digital marketing agency for founders",
  ],
  "description": "Digital marketing services for founders and growing brands: paid media management, brand strategy, SEO, content marketing, and performance campaigns across Meta, Google, and TikTok.",
};
---

<BaseLayout
  title="Digital Marketing Services, Performance Marketing & Brand Strategy | LuliDigital"
  description="Digital marketing services for founders and growing brands: paid media management, brand strategy, SEO, content marketing, and performance campaigns across Meta, Google, and TikTok."
  active="marketing"
  serviceSchema={serviceSchema}
>

  <!-- ═══════════════════════════════════════════════════════ HERO -->
  <section class="mkt-hero" aria-label="Marketing services">
    <div class="hero-orb orb-a" aria-hidden="true"></div>
    <span class="eyebrow" data-blur-in>Marketing Desk</span>
    <h1 class="mkt-title" data-word-reveal>
      Brand strategy, performance marketing &amp; paid media.
    </h1>
    <p class="mkt-sub" data-blur-in data-blur-delay="200">
      We build brand strategy, run performance campaigns across Meta, Google, and TikTok,
      and create content systems that make your business get found, understood, and chosen.
    </p>
    <div class="mkt-ctas" data-stagger data-stagger-gap="80">
      <a class="cta-link" href="https://wa.me/27602551513">Request a walkthrough <span class="arr">→</span></a>
      <a class="cta-link" href="/ai">Visit AI Desk <span class="arr">→</span></a>
    </div>
  </section>

  <!-- ════════════════════════════════════════ PROCESS TIMELINE -->
  <section class="process-section" aria-label="Marketing process" data-reveal="up">
    <span class="eyebrow">The Process</span>
    <h2 class="section-title">Clean story. Clear offer. Measurable lift.</h2>

    <div class="timeline" data-stagger data-stagger-gap="110">
      <div class="timeline-step">
        <div class="timeline-dot" aria-hidden="true"></div>
        <div class="timeline-content">
          <h3 class="timeline-num">01</h3>
          <h4 class="timeline-name">Brand</h4>
          <p class="timeline-desc">Positioning, voice, visual direction</p>
        </div>
      </div>
      <div class="timeline-connector" aria-hidden="true"></div>
      <div class="timeline-step">
        <div class="timeline-dot" aria-hidden="true"></div>
        <div class="timeline-content">
          <h3 class="timeline-num">02</h3>
          <h4 class="timeline-name">Content</h4>
          <p class="timeline-desc">Scripts, hooks, shoot-day planning</p>
        </div>
      </div>
      <div class="timeline-connector" aria-hidden="true"></div>
      <div class="timeline-step">
        <div class="timeline-dot" aria-hidden="true"></div>
        <div class="timeline-content">
          <h3 class="timeline-num">03</h3>
          <h4 class="timeline-name">Paid Media</h4>
          <p class="timeline-desc">Meta, Google, TikTok campaigns</p>
        </div>
      </div>
      <div class="timeline-connector" aria-hidden="true"></div>
      <div class="timeline-step">
        <div class="timeline-dot" aria-hidden="true"></div>
        <div class="timeline-content">
          <h3 class="timeline-num">04</h3>
          <h4 class="timeline-name">Report &amp; Iterate</h4>
          <p class="timeline-desc">Weekly learnings, monthly compounding</p>
        </div>
      </div>
    </div>

    <p class="process-note">Best for: Launches, rebrands, and growth sprints — weekly reporting, monthly iteration.</p>
  </section>

  <!-- ══════════════════════════════════════════ SERVICE BENTO GRID -->
  <section class="mkt-services" aria-label="Marketing services we offer" data-reveal="up">
    <span class="eyebrow">What We Do</span>
    <div class="bento-grid" data-stagger data-stagger-gap="70">

      <article class="glow-card svc-card">
        <h3 class="svc-title">Brand Strategy &amp; Positioning</h3>
        <p class="svc-desc">Messaging architecture, brand voice, competitive positioning, and visual identity systems built to win in your market.</p>
      </article>

      <article class="glow-card svc-card">
        <h3 class="svc-title">Paid Media Management</h3>
        <p class="svc-desc">Performance campaigns across Meta, Google, and TikTok — audience strategy, creative testing, budget management, and weekly reporting.</p>
      </article>

      <article class="glow-card svc-card">
        <h3 class="svc-title">Content Marketing &amp; SEO</h3>
        <p class="svc-desc">Content systems, editorial calendars, and SEO strategy that build organic visibility and keep your brand present at every stage.</p>
      </article>

      <article class="glow-card svc-card">
        <h3 class="svc-title">Creative Direction</h3>
        <p class="svc-desc">On-brand visual direction, campaign angles, shoot-day planning, and consistency audits so every asset earns its place.</p>
      </article>

      <article class="glow-card svc-card">
        <h3 class="svc-title">Performance Optimisation</h3>
        <p class="svc-desc">Conversion rate testing, landing page strategy, tracking setup, and monthly iteration cycles that compound results over time.</p>
      </article>

      <article class="glow-card svc-card">
        <h3 class="svc-title">Campaign Production</h3>
        <p class="svc-desc">Full-funnel campaign builds — from positioning and hooks to creative assets, launch management, and post-campaign reporting.</p>
      </article>

    </div>
  </section>

  <!-- ════════════════════════════════════════ ASCII STRATEGY MAP -->
  <section class="strategy-section" aria-label="Marketing strategy overview" data-reveal="up">
    <span class="eyebrow">The Full System</span>
    <pre class="ascii-diagram" role="img" aria-label="Marketing system: Brand strategy flows into Content which flows into Paid Media, all feeding into Reporting and Iteration">
  <span class="hi">BRAND STRATEGY</span>
  └── Positioning · Voice · Visual direction
       │
       ▼
  <span class="hi">CONTENT SYSTEM</span>
  └── Scripts · Hooks · Shoot planning · Posting rhythm
       │
       ▼
  <span class="hi">PAID MEDIA</span>
  └── Meta · Google · TikTok · Budget management
       │
       ▼
  <span class="hi">REPORT &amp; ITERATE</span>
  └── Weekly learnings · Monthly compounding · Growth</pre>
  </section>

  <!-- ═══════════════════════════════════════════════════════ CTA -->
  <section class="mkt-cta-section" aria-label="Get started with marketing" data-reveal="fade">
    <h2 class="cta-title" data-blur-in>You built it. We broadcast it.</h2>
    <p class="cta-sub" data-blur-in data-blur-delay="150">Let us help you put it out there for the world to see.</p>
    <div data-stagger data-stagger-gap="80" class="cta-links">
      <a class="cta-link" href="https://wa.me/27602551513">WhatsApp us <span class="arr">→</span></a>
      <a class="cta-link" href="mailto:info@lulidigital.co.za">Email the desk <span class="arr">→</span></a>
    </div>
  </section>

</BaseLayout>


<style>
  /* ── Hero ───────────────────────────────────────────────────── */
  .mkt-hero {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 88px 0 80px;
  }
  .orb-a { width: 500px; height: 500px; top: -100px; right: -160px; }
  .mkt-title {
    font-size: clamp(34px, 5vw, 66px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -.035em;
    margin: 14px auto 20px;
    font-family: ui-serif, Georgia, serif;
    color: var(--ink, #141312);
    max-width: 800px;
  }
  .mkt-sub {
    font-size: clamp(15px, 1.8vw, 18px);
    line-height: 1.65;
    color: var(--muted, rgba(20,19,18,.66));
    margin: 0 auto 32px;
    max-width: 580px;
  }
  .mkt-ctas { display: flex; justify-content: center; gap: 28px; flex-wrap: wrap; }

  /* ── Process Timeline ───────────────────────────────────────── */
  .process-section {
    padding: 72px 0 80px;
    border-top: 1px solid rgba(30,24,22,.1);
  }
  .timeline {
    display: flex;
    align-items: flex-start;
    margin: 36px 0 24px;
    overflow-x: auto;
  }
  .timeline-step {
    flex: 1;
    min-width: 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: 0 8px;
  }
  .timeline-dot {
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--brand, #7b2d2d);
    flex-shrink: 0;
  }
  .timeline-connector {
    width: 48px;
    height: 1px;
    background: var(--brand, #7b2d2d);
    opacity: .28;
    margin-top: 6px;
    flex-shrink: 0;
  }
  .timeline-num {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    color: var(--brand, #7b2d2d);
    margin: 0;
  }
  .timeline-name {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -.01em;
    margin: 0;
    color: var(--ink, #141312);
    font-family: ui-serif, Georgia, serif;
  }
  .timeline-desc {
    font-size: 12px;
    color: var(--muted, rgba(20,19,18,.6));
    line-height: 1.5;
    margin: 0;
  }
  .process-note {
    font-size: 13px;
    color: var(--muted, rgba(20,19,18,.55));
    margin: 0;
  }

  /* ── Services ───────────────────────────────────────────────── */
  .mkt-services {
    padding: 72px 0 80px;
    border-top: 1px solid rgba(30,24,22,.1);
  }
  .svc-card { padding: 26px 24px; display: flex; flex-direction: column; gap: 10px; }
  .svc-title {
    font-size: clamp(16px, 1.8vw, 19px);
    font-weight: 700;
    margin: 0;
    letter-spacing: -.015em;
    font-family: ui-serif, Georgia, serif;
    line-height: 1.2;
    color: var(--ink, #141312);
  }
  .svc-desc {
    font-size: 13px;
    line-height: 1.65;
    color: var(--muted, rgba(20,19,18,.62));
    margin: 0;
  }

  /* ── ASCII Strategy Map ─────────────────────────────────────── */
  .strategy-section {
    padding: 72px 0 80px;
    border-top: 1px solid rgba(30,24,22,.1);
  }
  .strategy-section .ascii-diagram { margin-top: 24px; }

  /* ── CTA ────────────────────────────────────────────────────── */
  .mkt-cta-section {
    text-align: center;
    padding: 80px 0 40px;
    border-top: 1px solid rgba(30,24,22,.1);
  }
  .cta-title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 700;
    letter-spacing: -.03em;
    margin: 0 0 10px;
    font-family: ui-serif, Georgia, serif;
  }
  .cta-sub { font-size: 15px; color: var(--muted, rgba(20,19,18,.62)); margin: 0 0 28px; }
  .cta-links { display: flex; justify-content: center; gap: 28px; flex-wrap: wrap; }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .timeline { flex-direction: column; align-items: flex-start; }
    .timeline-step { flex-direction: row; text-align: left; align-items: flex-start; gap: 12px; width: 100%; min-width: unset; }
    .timeline-connector { width: 1px; height: 24px; margin: 0 6px 0 5px; }
    .mkt-hero { padding: 60px 0 60px; }
    .strategy-section .ascii-diagram { font-size: 10px; padding: 20px 16px; }
  }
</style>

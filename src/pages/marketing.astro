---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Marketing Desk — LuliDigital">
  <header class="masthead" data-reveal>
    <div class="masthead-topline">LULIDIGITAL TIMES • EDITION 001</div>
    <h1 class="brand"><span class="brand-word">LuliDigital</span></h1>
    <div class="brand-sub">MARKETING DESK</div>

    <nav class="nav">
      <a href="/" class="nav-link">HOME</a>
      <a href="/marketing" class="nav-link is-active">MARKETING</a>
      <a href="/ai" class="nav-link">AI</a>
      <a href="/contact" class="nav-link">CONTACT</a>
    </nav>

    <div class="rule"></div>
  </header>

  <main class="page">
    <section class="simple" data-reveal>
      <div class="kicker">MARKETING DESK</div>
      <h2 class="headline">Strategy you can execute.</h2>
      <p class="body">
        We design positioning, campaigns, and performance systems that feel editorial — and convert in the real world.
      </p>
    </section>
  </main>
</MainLayout>
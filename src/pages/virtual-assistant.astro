---
import BaseLayout from "../layouts/BaseLayout.astro";

const serviceSchema = {
  "name": "Executive Virtual Assistant & Remote Operations Support Services",
  "serviceType": [
    "executive virtual assistant services",
    "remote executive assistant",
    "virtual assistant for founders",
    "virtual assistant for CEOs",
    "hire a virtual assistant",
    "online virtual assistant",
    "administrative support services",
    "inbox management services",
    "calendar management services",
    "project management virtual assistant",
    "remote admin support",
    "operations support services",
    "delegate business tasks",
    "virtual assistant for entrepreneurs",
  ],
  "description": "Executive virtual assistant services for founders, CEOs, and growing teams: remote admin support, inbox management, calendar control, project management, and operational follow-through — without the overhead of a full-time hire.",
};
---

<BaseLayout
  title="Executive Virtual Assistant Services for Founders & CEOs | LuliDigital"
  description="Executive virtual assistant services for founders, CEOs, and growing teams: remote admin support, inbox management, calendar control, project management, and operational follow-through without a full-time hire."
  active="virtual-assistant"
  serviceSchema={serviceSchema}
>

  <!-- ══════════════════════ OBJECT ASCII — NO BOTS ══════════════ -->
  <div class="page-sig" aria-hidden="true" data-reveal="fade">
    <div class="sig-chars">

      <!-- Inbox — no person -->
      <div class="sig-char">
        <pre class="sig-pre">
<span class="sh">╔═══════════╗</span>
<span class="va-inbox sh">║ ✓ INBOX 1 ║</span>
<span class="sm">╠═══════════╣</span>
<span class="va-inbox sh">║ ✓ INBOX 2 ║</span>
<span class="sm">╠═══════════╣</span>
<span class="va-inbox sh">║ ✓ INBOX 3 ║</span>
<span class="sh">╚═══════════╝</span></pre>
        <span class="sig-label">inbox zero</span>
      </div>

      <!-- Calendar — no person -->
      <div class="sig-char">
        <pre class="sig-pre">
<span class="sh">┌───────────┐</span>
<span class="sm">│ Mo Tu We  │</span>
<span class="va-cal sh">│ <span class="sh">◈</span>  <span class="sh">◈</span>  <span class="sh">◈</span>  │</span>
<span class="sm">│ Th Fr Sa  │</span>
<span class="va-cal sh">│ <span class="sh">◈</span>  <span class="sh">◈</span>  ·  │</span>
<span class="sh">└───────────┘</span></pre>
        <span class="sig-label">calendar managed</span>
      </div>

      <!-- Checklist — no person -->
      <div class="sig-char">
        <pre class="sig-pre">
<span class="va-task sh">[<span class="sh">✓</span>] Inbox done</span>
<span class="va-task sh">[<span class="sh">✓</span>] Calendar ok</span>
<span class="va-task sh">[<span class="sh">✓</span>] Report sent</span>
<span class="sm">[ ] Next item</span>
<span class="sm">[ ] And more…</span></pre>
        <span class="sig-label">nothing slips</span>
      </div>

    </div>
    <p class="sig-tagline">— <em>If it takes your time, it can be delegated.</em> —</p>
  </div>

  <!-- ═══════════════════════════════════════════════════════ HERO -->
  <section class="va-hero" aria-label="Virtual Assistant services">
    <div class="hero-orb orb-a" aria-hidden="true"></div>
    <span class="eyebrow" data-blur-in>Virtual Assistant Desk</span>
    <h1 class="va-title" data-word-reveal data-bee-stop>
      Executive support without the full-time overhead.
    </h1>
    <p class="va-sub" data-blur-in data-blur-delay="200">
      Dedicated remote support for founders and CEOs — inbox, calendar, operations, and projects handled so you can lead.
    </p>
    <div class="va-ctas" data-stagger data-stagger-gap="80">
      <a class="cta-link" href="https://wa.me/27602551513">Hire your VA <span class="arr">→</span></a>
      <a class="cta-link" href="/ai">AI Desk <span class="arr">→</span></a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ DELEGATION SVG -->
  <section class="delegation-section" aria-label="How delegation works" data-reveal="up">
    <span class="eyebrow">How Delegation Works</span>
    <h2 class="section-title">If it takes your time, it can be delegated.</h2>

    <div class="delegation-wrap">
      <svg class="delegation-svg" viewBox="0 0 660 180" aria-label="Delegation flow: You hand tasks to the Virtual Assistant who handles them, resulting in Done">
        <defs>
          <marker id="arr-del" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="rgba(123,45,45,.55)"/>
          </marker>
        </defs>
        <!-- You -->
        <rect x="10" y="40" width="140" height="100" rx="16" fill="var(--paper-card,#f6f2ea)" stroke="rgba(123,45,45,.28)" stroke-width="1.5"/>
        <text x="80" y="72"  text-anchor="middle" class="del-big">You</text>
        <text x="80" y="92"  text-anchor="middle" class="del-small">Founder / CEO</text>
        <text x="80" y="110" text-anchor="middle" class="del-small">Decision maker</text>
        <!-- Arrow 1 -->
        <path d="M154 90 L210 90" stroke="rgba(123,45,45,.45)" stroke-width="1.5" marker-end="url(#arr-del)"/>
        <!-- VA -->
        <rect x="215" y="40" width="230" height="100" rx="16" fill="rgba(123,45,45,.88)" stroke="none"/>
        <text x="330" y="72"  text-anchor="middle" class="del-big-inv">Virtual Assistant</text>
        <text x="330" y="92"  text-anchor="middle" class="del-small-inv">Inbox · Calendar · Tasks</text>
        <text x="330" y="110" text-anchor="middle" class="del-small-inv">Projects · Follow-ups</text>
        <!-- Arrow 2 -->
        <path d="M450 90 L506 90" stroke="rgba(123,45,45,.45)" stroke-width="1.5" marker-end="url(#arr-del)"/>
        <!-- Done -->
        <rect x="511" y="40" width="140" height="100" rx="16" fill="var(--paper-card,#f6f2ea)" stroke="rgba(123,45,45,.28)" stroke-width="1.5"/>
        <text x="581" y="82"  text-anchor="middle" class="del-big">Done.</text>
        <text x="581" y="102" text-anchor="middle" class="del-small">You focus on what</text>
        <text x="581" y="118" text-anchor="middle" class="del-small">only you can do.</text>
      </svg>

      <!-- ASCII fallback for very small screens -->
      <pre class="delegation-ascii ascii-diagram" aria-hidden="true">
<span class="hi">You</span> ──────▶ <span class="hi">Virtual Assistant</span> ──────▶ <span class="hi">Done.</span>
Founder       Inbox · Calendar · Tasks     You focus on
/ CEO         Projects · Follow-ups        what matters.</pre>
    </div>
  </section>

  <!-- ══════════════════════════════════════════ SERVICE BENTO GRID -->
  <section class="va-services" aria-label="VA services" data-reveal="up">
    <span class="eyebrow">What We Handle</span>
    <div class="bento-grid" data-stagger data-stagger-gap="80">

      <article class="glow-card svc-card">
        <h3 class="svc-title">Admin &amp; Operations</h3>
        <ul class="bento-list">
          <li>Inbox managed &amp; organised</li>
          <li>Calendar controlled &amp; optimised</li>
          <li>Follow-ups sent on schedule</li>
          <li>Reports prepared &amp; distributed</li>
        </ul>
        <p class="svc-footer">Quiet execution behind the scenes.</p>
      </article>

      <article class="glow-card svc-card">
        <h3 class="svc-title">Project Management</h3>
        <ul class="bento-list">
          <li>Timelines owned &amp; maintained</li>
          <li>Milestones tracked and hit</li>
          <li>Teams aligned without chasing</li>
          <li>Deliverables managed end-to-end</li>
        </ul>
        <p class="svc-footer">Nothing slips. Nothing gets lost.</p>
      </article>

      <article class="glow-card svc-card">
        <h3 class="svc-title">Marketing &amp; Content Support</h3>
        <ul class="bento-list">
          <li>Content created and scheduled</li>
          <li>Campaigns structured and briefed</li>
          <li>Social media managed</li>
          <li>Brand message distributed</li>
        </ul>
        <p class="svc-footer">Your message out. Consistently.</p>
      </article>

      <article class="glow-card svc-card">
        <h3 class="svc-title">AI &amp; Custom Tools</h3>
        <ul class="bento-list">
          <li>AI assistants built for your business</li>
          <li>Workflows automated end-to-end</li>
          <li>Tools tailored to your operations</li>
          <li>Systems that grow with your team</li>
        </ul>
        <p class="svc-footer">Built to work with you.</p>
      </article>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════ CTA -->
  <section class="va-cta-section" aria-label="Hire a virtual assistant" data-reveal="fade">
    <h2 class="cta-title" data-blur-in>Hire your virtual assistant today.</h2>
    <p class="cta-sub" data-blur-in data-blur-delay="150">Side by side. So you don't carry it alone.</p>
    <div data-stagger data-stagger-gap="80" class="cta-links">
      <a class="cta-link" href="https://wa.me/27602551513">WhatsApp us <span class="arr">→</span></a>
      <a class="cta-link" href="mailto:info@lulidigital.co.za">Email the desk <span class="arr">→</span></a>
    </div>
  </section>

</BaseLayout>


<style>
  /* ── Hero ───────────────────────────────────────────────────── */
  .va-hero {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 88px 0 80px;
  }
  .orb-a { width: 480px; height: 480px; top: -100px; left: -160px; }
  .va-title {
    font-size: clamp(36px, 5.5vw, 68px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -.035em;
    margin: 14px auto 20px;
    font-family: ui-serif, Georgia, serif;
    color: var(--ink, #141312);
    max-width: 780px;
  }
  .va-sub {
    font-size: clamp(15px, 1.8vw, 18px);
    line-height: 1.65;
    color: var(--muted, rgba(20,19,18,.66));
    margin: 0 auto 32px;
    max-width: 520px;
  }
  .va-ctas { display: flex; justify-content: center; gap: 28px; flex-wrap: wrap; }

  /* ── Delegation ─────────────────────────────────────────────── */
  .delegation-section {
    padding: 72px 0 80px;
    border-top: 1px solid rgba(30,24,22,.1);
  }
  .delegation-wrap { margin-top: 28px; }
  .delegation-svg {
    width: 100%;
    max-width: 680px;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .delegation-svg .del-big {
    font-family: ui-serif, Georgia, serif;
    font-size: 15px;
    font-weight: 700;
    fill: rgba(20,19,18,.9);
  }
  .delegation-svg .del-big-inv {
    font-family: ui-serif, Georgia, serif;
    font-size: 14px;
    font-weight: 700;
    fill: rgba(243,239,231,.95);
  }
  .delegation-svg .del-small {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 10px;
    fill: rgba(20,19,18,.5);
    letter-spacing: .04em;
  }
  .delegation-svg .del-small-inv {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 10px;
    fill: rgba(243,239,231,.7);
    letter-spacing: .04em;
  }
  .delegation-ascii { display: none; }

  /* ── Services ───────────────────────────────────────────────── */
  .va-services {
    padding: 72px 0 80px;
    border-top: 1px solid rgba(30,24,22,.1);
  }
  .svc-card {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .svc-title {
    font-size: clamp(17px, 2vw, 21px);
    font-weight: 700;
    margin: 0;
    letter-spacing: -.015em;
    font-family: ui-serif, Georgia, serif;
    line-height: 1.2;
    color: var(--ink, #141312);
  }
  .bento-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 7px; flex: 1; }
  .bento-list li { font-size: 13.5px; line-height: 1.55; color: var(--muted, rgba(20,19,18,.66)); padding-left: 14px; position: relative; }
  .bento-list li::before { content: "–"; position: absolute; left: 0; color: var(--brand, #7b2d2d); opacity: .55; }
  .svc-footer {
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--brand, #7b2d2d);
    font-weight: 600;
    margin: 0;
    margin-top: auto;
  }

  /* ── CTA ────────────────────────────────────────────────────── */
  .va-cta-section {
    text-align: center;
    padding: 80px 0 40px;
    border-top: 1px solid rgba(30,24,22,.1);
  }
  .cta-title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 700;
    letter-spacing: -.03em;
    margin: 0 0 10px;
    font-family: ui-serif, Georgia, serif;
  }
  .cta-sub { font-size: 15px; color: var(--muted, rgba(20,19,18,.62)); margin: 0 0 28px; }
  .cta-links { display: flex; justify-content: center; gap: 28px; flex-wrap: wrap; }

  /* ── Fonts ──────────────────────────────────────────────────── */
  .va-title, .svc-title, .cta-title, .section-title { font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif); }
  .va-sub, .svc-footer, .cta-sub { font-family: var(--font-body, "DM Sans", sans-serif); }

  /* ── Page signature ─────────────────────────────────────────── */
  .page-sig { padding: 48px 0 20px; text-align: center; }
  .sig-chars { display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; margin-bottom: 20px; }
  .sig-char { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .sig-pre { font-family: var(--font-mono, "SF Mono", ui-monospace, monospace); font-size: 13px; line-height: 1.45; margin: 0; white-space: pre; background: none; border: none; padding: 0; text-align: left; }
  .sh { color: var(--brand, #7b2d2d); }
  .sm { color: rgba(20,19,18,.42); }
  .sig-label { font-family: var(--font-body, "DM Sans", sans-serif); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted, rgba(20,19,18,.4)); font-weight: 600; }
  .sig-tagline { font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif); font-size: clamp(14px, 2vw, 18px); font-style: italic; color: var(--muted, rgba(20,19,18,.5)); margin: 0; }

  /* VA object animations */
  .va-inbox { display: block; animation: vaInbox 2.4s ease-in-out infinite; }
  .va-cal   { display: block; animation: vaCal   2s   step-end   infinite; }
  .va-task  { display: block; animation: vaTask  3s   ease-in-out infinite; }

  @keyframes vaInbox { 0%,100%{opacity:1}  50%{opacity:.5} }
  @keyframes vaCal   { 0%,70%,100%{opacity:1} 75%{opacity:.3} }
  @keyframes vaTask  { 0%,100%{transform:translateX(0)} 50%{transform:translateX(3px)} }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 520px) {
    .delegation-svg { display: none; }
    .delegation-ascii { display: block; font-size: 10px; padding: 18px 14px; }
    .va-hero { padding: 60px 0 60px; }
  }
  @media (max-width: 600px) {
    .bento-grid { grid-template-columns: 1fr; }
    .sig-chars { gap: 20px; }
    .sig-pre { font-size: 11px; }
  }
</style>

---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Virtual Assistant Desk · LuliDigital">
  <section class="section">
    <div class="wrap">
      <div class="inner-head reveal" data-reveal>
        <div class="eyebrow">VIRTUAL ASSISTANT DESK</div>
        <h2 class="h1">The Quiet Fix</h2>
        <p class="p">
          Systems, coordination, follow-through — designed to feel calm, fast, and reliable.
        </p>
      </div>

      <div class="rule rule--spaced"></div>

      <div class="front-grid">
        <article class="story reveal" data-reveal>
          <div class="eyebrow">WHAT IT SOLVES</div>
          <ul class="list">
            <li><span class="lux-highlight">Task tracking</span> and weekly reporting</li>
            <li>Project coordination across people + tools</li>
            <li>Client comms, follow-ups, reminders, handovers</li>
            <li>File hygiene: naming, versions, folders, approvals</li>
          </ul>
        </article>

        <article class="story reveal" data-reveal>
          <div class="eyebrow">DELIVERABLES</div>
          <ul class="list">
            <li>Project board setup (simple, clean, maintainable)</li>
            <li>Standard operating checklist for recurring work</li>
            <li>Weekly priorities + risk list</li>
            <li>Clean archive + handover pack</li>
          </ul>
        </article>
      </div>

      <div class="rule rule--spaced"></div>

      <div class="callout reveal" data-reveal>
        <div class="eyebrow">CONTACT</div>
        <div class="callout-grid">
          <a class="link link--underline" href="mailto:info@lulidigital.co.za">info@lulidigital.co.za →</a>
          <a class="link link--underline" href="https://wa.me/27602551513" target="_blank" rel="noreferrer">
            +27 60 255 1513 →
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
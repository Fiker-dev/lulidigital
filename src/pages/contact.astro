---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="Contact LuliDigital | Virtual Assistant Desk, Marketing & AI Services"
  description="Contact LuliDigital for Virtual Assistant Desk support, digital marketing, SEO, paid media, brand strategy, and AI automation services."
  active="contact"
>
  <section class="contact-invite" aria-labelledby="contact-title">
    <div class="invite-copy">
      <p class="invite-pill">Coffee with honey?</p>
      <header class="contact-head">
        <div class="kicker">You are invited</div>
        <h1 id="contact-title" class="headline" data-bee-stop>Come sit with the desk.</h1>
      </header>
      <p class="subhead">
        Bring the campaign, system, inbox, launch, or rough idea. We will bring a warm cup,
        a clear head, and a practical next step.
      </p>
      <div class="invite-actions" aria-label="Contact options">
        <a class="invite-btn invite-btn--primary" href="https://wa.me/27602551513" target="_blank" rel="noreferrer">
          WhatsApp the desk
        </a>
        <a class="invite-btn invite-btn--ghost" href="mailto:info@lulidigital.co.za">
          Email the desk
        </a>
      </div>
      <p class="human-note">Fastest reply: WhatsApp. Real person on the other side.</p>
    </div>

    <div class="coffee-scene" aria-hidden="true">
      <span class="window-light"></span>
      <span class="honey-jar"></span>
      <div class="steam steam--one"></div>
      <div class="steam steam--two"></div>
      <div class="steam steam--three"></div>
      <div class="honey-spoon">
        <span class="spoon-bowl"></span>
        <span class="spoon-stick"></span>
        <span class="honey-thread honey-thread--one"></span>
        <span class="honey-thread honey-thread--two"></span>
        <span class="honey-drop honey-drop--one"></span>
        <span class="honey-drop honey-drop--two"></span>
      </div>
      <div class="cup">
        <div class="coffee"></div>
        <div class="cup-lip"></div>
        <div class="cup-body">
          <span class="cup-glow"></span>
          <span class="cup-line"></span>
        </div>
        <div class="cup-handle"></div>
      </div>
      <div class="saucer"></div>
      <span class="surface-shadow"></span>
      <div class="table-note">tell us what you are building</div>
    </div>
  </section>

  <section class="contact-wrap" aria-label="Contact details">
    <div class="contact-card">
      <a class="contact-row" href="mailto:info@lulidigital.co.za">
        <span class="glyph" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="10" y="18" width="44" height="28" rx="3"></rect>
            <path d="M12 20l20 16L52 20"></path>
          </svg>
        </span>
        <span class="contact-text">
          <span class="label">Email the desk</span>
          <span class="value">info@lulidigital.co.za</span>
        </span>
      </a>

      <div class="divider"></div>

      <a class="contact-row" href="https://wa.me/27602551513" target="_blank" rel="noreferrer">
        <span class="glyph" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 10c6 6 8 10 6 14l-4 6c4 8 10 14 18 18l6-4c4-2 8 0 14 6l-6 8c-3 4-8 6-13 4C25 56 8 39 4 19c-2-5 0-10 4-13l8-6z"></path>
          </svg>
        </span>
        <span class="contact-text">
          <span class="label">WhatsApp the desk</span>
          <span class="value">+27 60 255 1513</span>
        </span>
      </a>
    </div>

    <p class="fineprint">Human reply. Clear next step. No ticket maze.</p>
  </section>

  <style>
    .headline { font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif); }
    .subhead, .label, .value, .fineprint, .kicker, .invite-pill, .invite-btn, .human-note, .table-note {
      font-family: var(--font-body, "DM Sans", sans-serif);
    }

    .contact-invite {
      max-width: 1180px;
      margin: 0 auto;
      padding: clamp(52px, 7vw, 92px) 24px clamp(26px, 4vw, 48px);
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(300px, .95fr);
      gap: clamp(32px, 6vw, 76px);
      align-items: center;
      color: rgba(20, 20, 20, .92);
    }
    .invite-copy { max-width: 620px; }
    .invite-pill {
      width: fit-content;
      margin: 0 0 22px;
      padding: 9px 15px;
      border-radius: 999px;
      border: 1px solid rgba(196, 119, 0, .28);
      background: linear-gradient(135deg, rgba(255, 236, 173, .82), rgba(255, 255, 255, .54));
      box-shadow: 0 14px 28px rgba(196, 119, 0, .10);
      font-size: 12px;
      letter-spacing: .16em;
      text-transform: uppercase;
      font-weight: 800;
      color: #8f5200;
    }
    .contact-head { margin-bottom: 16px; }
    .kicker {
      letter-spacing: .22em;
      font-size: 11px;
      text-transform: uppercase;
      color: #9d6a16;
      margin-bottom: 14px;
      font-weight: 800;
    }
    .headline {
      font-size: clamp(48px, 7vw, 104px);
      line-height: .92;
      margin: 0;
      font-weight: 800;
      letter-spacing: 0;
      max-width: 680px;
    }
    .subhead {
      margin: 0;
      max-width: 560px;
      font-size: clamp(17px, 1.5vw, 21px);
      line-height: 1.6;
      color: rgba(20, 20, 20, .68);
    }
    .invite-actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin-top: 28px;
    }
    .invite-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      padding: 0 24px;
      border-radius: 999px;
      font-size: 12px;
      letter-spacing: .18em;
      text-transform: uppercase;
      font-weight: 900;
      text-decoration: none;
      transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
    }
    .invite-btn:hover { transform: translateY(-2px); }
    .invite-btn--primary {
      color: #fff;
      background: linear-gradient(135deg, #c87600, #8c340f);
      box-shadow: 0 18px 36px rgba(196, 119, 0, .24);
    }
    .invite-btn--ghost {
      color: #8f5200;
      border: 1px solid rgba(196, 119, 0, .55);
      background: rgba(255, 255, 255, .5);
    }
    .human-note {
      margin: 18px 0 0;
      font-size: 13px;
      color: rgba(20, 20, 20, .54);
    }

    .coffee-scene {
      position: relative;
      min-height: 430px;
      border-radius: 32px;
      overflow: hidden;
      border: 1px solid rgba(166, 91, 0, .20);
      background:
        radial-gradient(circle at 20% 18%, rgba(255, 255, 255, .94) 0 9%, transparent 27%),
        radial-gradient(circle at 76% 68%, rgba(255, 190, 57, .28), transparent 36%),
        linear-gradient(145deg, rgba(255, 247, 218, .94), rgba(255, 255, 255, .62) 45%, rgba(244, 177, 50, .30));
      box-shadow:
        0 32px 80px rgba(74, 38, 0, .17),
        inset 0 1px 0 rgba(255, 255, 255, .82),
        inset 0 -40px 90px rgba(173, 91, 0, .10);
      isolation: isolate;
    }
    .coffee-scene::before {
      content: "";
      position: absolute;
      inset: 0;
      opacity: .24;
      background-image:
        linear-gradient(30deg, rgba(196, 119, 0, .14) 12%, transparent 12.5%, transparent 87%, rgba(196, 119, 0, .14) 87.5%, rgba(196, 119, 0, .14)),
        linear-gradient(150deg, rgba(196, 119, 0, .14) 12%, transparent 12.5%, transparent 87%, rgba(196, 119, 0, .14) 87.5%, rgba(196, 119, 0, .14));
      background-size: 82px 48px;
      z-index: -1;
    }
    .coffee-scene::after {
      content: "";
      position: absolute;
      left: 12%;
      right: 12%;
      bottom: 82px;
      height: 18px;
      border-radius: 999px;
      background: rgba(73, 35, 0, .10);
      filter: blur(12px);
    }
    .window-light {
      position: absolute;
      inset: -18% auto auto -12%;
      width: 58%;
      height: 58%;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 255, 255, .9), rgba(255, 255, 255, 0) 66%);
      filter: blur(10px);
      opacity: .82;
      z-index: 1;
    }
    .honey-jar {
      position: absolute;
      right: 8%;
      bottom: 82px;
      width: 78px;
      height: 92px;
      border-radius: 22px 22px 18px 18px;
      background:
        linear-gradient(90deg, rgba(255,255,255,.34), transparent 32%),
        linear-gradient(180deg, rgba(255, 214, 86, .50), rgba(169, 86, 0, .56));
      border: 1px solid rgba(126, 63, 0, .12);
      box-shadow: inset 10px 0 18px rgba(255,255,255,.20), 0 18px 40px rgba(92, 43, 0, .12);
      opacity: .42;
      transform: rotate(3deg);
      z-index: 1;
    }
    .honey-jar::before {
      content: "";
      position: absolute;
      left: 18px;
      right: 18px;
      top: -13px;
      height: 18px;
      border-radius: 8px 8px 4px 4px;
      background: linear-gradient(180deg, #f4d58a, #ad6500);
      box-shadow: inset 0 3px 5px rgba(255,255,255,.36);
    }
    .cup {
      position: absolute;
      left: 50%;
      bottom: 82px;
      width: min(62%, 330px);
      aspect-ratio: 1.12;
      transform: translateX(-50%);
      z-index: 4;
    }
    .cup-body {
      position: absolute;
      left: 7%;
      right: 7%;
      bottom: 0;
      height: 70%;
      border-radius: 8% 8% 44% 44%;
      background:
        radial-gradient(circle at 28% 22%, rgba(255,255,255,.88), transparent 17%),
        linear-gradient(105deg, #fff3cf 0%, #f4c164 28%, #d88914 59%, #a95700 100%);
      border: 1px solid rgba(94, 47, 0, .16);
      box-shadow:
        inset 20px 5px 30px rgba(255, 255, 255, .52),
        inset -30px -20px 34px rgba(94, 43, 0, .20),
        0 22px 42px rgba(94, 43, 0, .16);
    }
    .cup-lip {
      position: absolute;
      left: 0;
      right: 0;
      top: 16%;
      height: 29%;
      border-radius: 50%;
      background:
        radial-gradient(ellipse at 45% 32%, rgba(255,255,255,.92), rgba(255,255,255,.28) 39%, transparent 40%),
        linear-gradient(180deg, #fffaf0, #e7c17c 72%, #ae6508);
      border: 1px solid rgba(94, 47, 0, .18);
      box-shadow:
        inset 0 8px 18px rgba(255, 255, 255, .72),
        0 7px 18px rgba(85, 35, 0, .10);
      z-index: 2;
    }
    .cup-lip::after {
      content: "";
      position: absolute;
      left: 13%;
      right: 13%;
      top: 28%;
      height: 46%;
      border-radius: 50%;
      background:
        radial-gradient(ellipse at 33% 30%, rgba(212, 137, 32, .62), transparent 27%),
        radial-gradient(ellipse at 68% 45%, rgba(56, 18, 2, .96), rgba(79, 31, 3, .98) 45%, rgba(32, 9, 0, 1));
      box-shadow:
        inset 0 9px 20px rgba(255, 174, 49, .34),
        inset 0 -8px 16px rgba(0, 0, 0, .28);
    }
    .coffee {
      position: absolute;
      left: 15%;
      right: 15%;
      top: 24%;
      height: 14%;
      border-radius: 50%;
      background:
        radial-gradient(ellipse at 32% 31%, rgba(231, 154, 43, .78), transparent 24%),
        radial-gradient(ellipse at 66% 42%, #5b2002, #240800 74%);
      box-shadow: inset 0 9px 18px rgba(255, 187, 61, .20);
      z-index: 3;
      animation: coffeeBreath 5.8s ease-in-out infinite;
    }
    .cup-handle {
      position: absolute;
      right: -13%;
      top: 35%;
      width: 34%;
      height: 34%;
      border: 18px solid rgba(183, 104, 0, .76);
      border-left: 0;
      border-radius: 0 999px 999px 0;
      box-shadow: inset -7px -5px 13px rgba(91, 41, 0, .16);
    }
    .cup-glow {
      position: absolute;
      inset: 13% auto auto 14%;
      width: 38%;
      height: 26%;
      border-radius: 50%;
      background: rgba(255, 255, 255, .54);
      filter: blur(9px);
    }
    .cup-line {
      position: absolute;
      left: 21%;
      right: 21%;
      bottom: 26%;
      height: 2px;
      border-radius: 999px;
      background: rgba(112, 54, 0, .18);
    }
    .saucer {
      position: absolute;
      left: 50%;
      bottom: 60px;
      width: min(76%, 410px);
      height: 58px;
      transform: translateX(-50%);
      border-radius: 50%;
      background:
        radial-gradient(ellipse at 48% 38%, rgba(255,255,255,.78), transparent 37%),
        linear-gradient(180deg, rgba(255, 250, 232, .95), rgba(211, 139, 18, .28));
      border: 1px solid rgba(94, 47, 0, .12);
      box-shadow: 0 20px 38px rgba(85, 44, 0, .14);
      z-index: 2;
    }
    .honey-spoon {
      position: absolute;
      left: 15%;
      top: 24%;
      width: 72%;
      height: 100px;
      transform: rotate(-9deg);
      transform-origin: 42% 50%;
      animation: spoonFloat 6.8s ease-in-out infinite;
      z-index: 6;
    }
    .spoon-stick {
      position: absolute;
      left: 17%;
      right: 1%;
      top: 40px;
      height: 10px;
      border-radius: 999px;
      background:
        linear-gradient(180deg, rgba(255,255,255,.44), rgba(255,255,255,0) 42%),
        linear-gradient(90deg, #ffe09a 0%, #d08a1f 38%, #8f4300 100%);
      box-shadow: 0 10px 22px rgba(91, 41, 0, .20);
    }
    .spoon-bowl {
      position: absolute;
      left: 0;
      top: 22px;
      width: 86px;
      height: 48px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 35% 27%, rgba(255, 255, 255, .92), transparent 20%),
        radial-gradient(circle at 66% 63%, #9e4b00, #4c1d00 78%),
        linear-gradient(135deg, #ffd66c, #ad5c00);
      box-shadow:
        inset 9px 8px 16px rgba(255, 255, 255, .44),
        inset -11px -9px 18px rgba(69, 24, 0, .30),
        0 15px 25px rgba(87, 38, 0, .18);
    }
    .honey-thread {
      position: absolute;
      top: 58px;
      width: 5px;
      border-radius: 999px;
      background: linear-gradient(180deg, rgba(255, 227, 126, .95), rgba(190, 103, 0, .80));
      box-shadow: 0 0 12px rgba(255, 197, 63, .42);
      transform-origin: top center;
    }
    .honey-thread--one {
      left: 21%;
      height: 104px;
      animation: honeyStretch 4.8s ease-in-out infinite;
    }
    .honey-thread--two {
      left: 48%;
      height: 74px;
      opacity: .72;
      animation: honeyStretch 5.4s ease-in-out infinite .55s;
    }
    .honey-drop {
      position: absolute;
      width: 15px;
      border-radius: 999px;
      background:
        radial-gradient(circle at 35% 20%, rgba(255,255,255,.68), transparent 24%),
        linear-gradient(180deg, #ffe06d, #c87600);
      box-shadow: 0 8px 20px rgba(196, 119, 0, .22);
    }
    .honey-drop--one {
      left: 19.6%;
      top: 150px;
      height: 26px;
      animation: honeyDrop 4.8s ease-in-out infinite;
    }
    .honey-drop--two {
      left: 46.7%;
      top: 121px;
      height: 20px;
      opacity: .70;
      animation: honeyDrop 5.4s ease-in-out infinite .55s;
    }
    .steam {
      position: absolute;
      bottom: 292px;
      width: 52px;
      height: 120px;
      border-radius: 999px;
      border-left: 4px solid rgba(120, 64, 0, .11);
      border-top: 2px solid rgba(255, 255, 255, .22);
      filter: blur(.7px);
      animation: steamRise 5.2s ease-in-out infinite;
      z-index: 5;
    }
    .steam--one { left: 39%; }
    .steam--two { left: 49%; animation-delay: .8s; transform: scale(.92); }
    .steam--three { left: 58%; animation-delay: 1.4s; transform: scale(.78); }
    .surface-shadow {
      position: absolute;
      left: 22%;
      right: 16%;
      bottom: 58px;
      height: 28px;
      border-radius: 50%;
      background: rgba(65, 28, 0, .13);
      filter: blur(16px);
      z-index: 1;
    }
    .table-note {
      position: absolute;
      left: 26px;
      right: 26px;
      bottom: 24px;
      text-align: center;
      font-size: 11px;
      letter-spacing: .18em;
      text-transform: uppercase;
      font-weight: 800;
      color: rgba(89, 45, 0, .46);
    }
    @keyframes steamRise {
      0% { opacity: 0; transform: translateY(20px) scale(.82); }
      28% { opacity: .62; }
      100% { opacity: 0; transform: translateY(-34px) scale(1.12); }
    }
    @keyframes honeyStretch {
      0%, 100% { transform: scaleY(.82); opacity: .58; }
      48% { transform: scaleY(1.08); opacity: .96; }
    }
    @keyframes honeyDrop {
      0%, 100% { transform: translateY(-3px) scale(.9); opacity: .58; }
      48% { transform: translateY(9px) scale(1.05); opacity: .95; }
    }
    @keyframes spoonFloat {
      0%, 100% { transform: rotate(-9deg) translateY(0); }
      50% { transform: rotate(-7.5deg) translateY(5px); }
    }
    @keyframes coffeeBreath {
      0%, 100% { transform: scaleX(1); filter: brightness(1); }
      50% { transform: scaleX(1.025); filter: brightness(1.08); }
    }

    .contact-wrap {
      max-width: 980px;
      margin: 0 auto;
      padding: 10px 24px 80px;
      color: rgba(20, 20, 20, .92);
    }
    .contact-card {
      margin: 0 auto;
      max-width: 720px;
      background: rgba(255, 255, 255, .62);
      border: 1px solid rgba(30, 30, 30, .14);
      border-radius: 20px;
      box-shadow: 0 18px 40px rgba(20, 20, 20, .08), inset 0 1px 0 rgba(255, 255, 255, .65);
      backdrop-filter: blur(8px);
      padding: 6px;
    }
    .contact-card a,
    .contact-card a:visited {
      color: inherit !important;
      text-decoration: none !important;
    }
    .contact-row {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px 20px;
      border-radius: 16px;
      transition: transform .15s ease, background .15s ease;
      position: relative;
    }
    .contact-row:hover { background: rgba(255, 255, 255, .55); transform: translateY(-2px); }
    .contact-row::after {
      content: "->";
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(20, 20, 20, .45);
      font-size: 18px;
    }
    .glyph {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      background: rgba(245, 241, 232, .9);
      border: 1px solid rgba(30, 30, 30, .10);
      color: var(--brand, #7b2d2d);
      flex-shrink: 0;
    }
    .contact-text {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
      padding-right: 34px;
    }
    .label {
      font-size: 11px;
      letter-spacing: .18em;
      color: rgba(20, 20, 20, .5);
      text-transform: uppercase;
      font-weight: 600;
    }
    .value {
      font-size: 20px;
      line-height: 1.2;
      font-weight: 600;
      color: rgba(20, 20, 20, .9);
      word-break: break-word;
    }
    .divider { height: 1px; margin: 0 20px; background: rgba(20, 20, 20, .08); }
    .fineprint {
      text-align: center;
      margin: 14px 0 0;
      font-size: 11px;
      letter-spacing: .14em;
      color: rgba(20, 20, 20, .45);
      text-transform: uppercase;
    }

    @media (prefers-reduced-motion: reduce) {
      .steam,
      .honey-drop,
      .invite-btn,
      .contact-row {
        animation: none !important;
        transition: none !important;
      }
    }

    @media (max-width: 860px) {
      .contact-invite {
        grid-template-columns: 1fr;
        padding-top: 34px;
        text-align: center;
      }
      .invite-copy { max-width: none; }
      .invite-pill,
      .invite-actions {
        margin-left: auto;
        margin-right: auto;
        justify-content: center;
      }
      .subhead { margin-left: auto; margin-right: auto; }
      .coffee-scene {
        min-height: 330px;
        border-radius: 26px;
      }
      .cup { width: min(62%, 260px); bottom: 68px; }
      .saucer { bottom: 50px; }
      .surface-shadow { bottom: 49px; }
      .steam { bottom: 225px; }
      .honey-spoon { top: 18%; }
      .honey-jar {
        right: 7%;
        bottom: 64px;
        width: 62px;
        height: 76px;
      }
    }

    @media (max-width: 560px) {
      .contact-invite {
        padding: 28px 16px 22px;
        gap: 24px;
      }
      .headline { font-size: clamp(42px, 13vw, 60px); }
      .subhead { font-size: 16px; }
      .invite-actions {
        display: grid;
        grid-template-columns: 1fr;
        width: 100%;
        gap: 10px;
      }
      .invite-btn {
        width: 100%;
        min-height: 54px;
      }
      .coffee-scene {
        min-height: 304px;
        border-radius: 22px;
      }
      .honey-spoon {
        left: 8%;
        top: 16%;
        width: 84%;
      }
      .cup {
        width: min(72%, 230px);
        bottom: 62px;
      }
      .cup-handle {
        right: -12%;
        border-width: 14px;
      }
      .spoon-bowl {
        width: 74px;
        height: 42px;
      }
      .honey-thread--one { height: 82px; }
      .honey-thread--two { height: 58px; }
      .honey-drop--one { top: 128px; }
      .honey-drop--two { top: 106px; }
      .steam {
        bottom: 204px;
        height: 94px;
      }
      .saucer { bottom: 46px; }
      .surface-shadow { bottom: 45px; }
      .honey-jar {
        right: 5%;
        bottom: 58px;
        width: 52px;
        height: 64px;
      }
      .contact-wrap { padding: 12px 16px 60px; }
      .value { font-size: 17px; }
      .contact-row {
        padding: 18px 14px;
        gap: 12px;
      }
      .contact-row::after { right: 14px; }
      .glyph {
        width: 44px;
        height: 44px;
      }
    }
  </style>
</BaseLayout>

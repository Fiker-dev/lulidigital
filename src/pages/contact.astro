---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact LuliDigital | Virtual Assistant, Marketing & AI Services"
  description="Contact LuliDigital for executive virtual assistant support, digital marketing, SEO, paid media, brand strategy, and AI automation services."
  active="contact"
>

  <!-- ══════════════════════ OBJECT ASCII — NO BOTS ══════════════ -->
  <div class="page-sig" aria-hidden="true" data-reveal="fade">
    <div class="sig-chars">

      <!-- Envelope — no person -->
      <div class="sig-char">
        <pre class="sig-pre">
<span class="sh">╔═════════════════╗</span>
<span class="con-env sh">║╲               ╱║</span>
<span class="sh">║ ╲_____________╱ ║</span>
<span class="sh">║                 ║</span>
<span class="sh">╚═════════════════╝</span></pre>
        <span class="sig-label">send a note</span>
      </div>

      <!-- Speech bubble — no person -->
      <div class="sig-char">
        <pre class="sig-pre">
<span class="sh">╭─────────────────╮</span>
<span class="con-msg sh">│  hello there!   │</span>
<span class="sh">│  We're ready.   │</span>
<span class="sh">╰───┬─────────────╯</span>
<span class="con-dot sm">    ·</span>
<span class="con-dot sm">      ·</span></pre>
        <span class="sig-label">we're listening</span>
      </div>

      <!-- Coffee + notepad — no person -->
      <div class="sig-char">
        <pre class="sig-pre">
<span class="sh">  ╔═════╗</span>
<span class="sm">  ║  ✎  ║</span>
<span class="con-write sh">  ║~~~~~║</span>
<span class="sh">  ║~~~~~║</span>
<span class="sh">  ╚═════╝</span>
<span class="con-cup sh">   ☕</span></pre>
        <span class="sig-label">let's talk</span>
      </div>

    </div>
    <p class="sig-tagline">— <em>Fastest reply: WhatsApp. We actually pick up.</em> —</p>
  </div>

  <section class="contact-wrap">
    <header class="contact-head">
      <div class="kicker">Contact Desk</div>
      <h1 class="headline" data-bee-stop>Reach the desk.</h1>
      <p class="subhead">
        For campaigns, systems, or something you're building — send a note or message the desk.
      </p>
    </header>

    <div class="contact-card">
      <a class="contact-row" href="mailto:info@lulidigital.co.za">
        <span class="glyph" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="10" y="18" width="44" height="28" rx="3"></rect>
            <path d="M12 20l20 16L52 20"></path>
          </svg>
        </span>
        <span class="contact-text">
          <span class="label">Editorial Mail</span>
          <span class="value">info@lulidigital.co.za</span>
        </span>
      </a>

      <div class="divider"></div>

      <a class="contact-row" href="https://wa.me/27602551513" target="_blank" rel="noreferrer">
        <span class="glyph" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 10c6 6 8 10 6 14l-4 6c4 8 10 14 18 18l6-4c4-2 8 0 14 6l-6 8c-3 4-8 6-13 4C25 56 8 39 4 19c-2-5 0-10 4-13l8-6z"></path>
          </svg>
        </span>
        <span class="contact-text">
          <span class="label">WhatsApp Desk</span>
          <span class="value">+27 60 255 1513</span>
        </span>
      </a>
    </div>

    <p class="fineprint">Fastest reply: WhatsApp.</p>
  </section>

  <style>
    /* ── Fonts ────────────────────────────────────────────────── */
    .headline { font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif); }
    .subhead, .label, .value, .fineprint, .kicker { font-family: var(--font-body, "DM Sans", sans-serif); }

    /* ── Page signature ────────────────────────────────────────── */
    .page-sig { padding: 48px 0 20px; text-align: center; }
    .sig-chars { display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; margin-bottom: 20px; }
    .sig-char { display: flex; flex-direction: column; align-items: center; gap: 8px; }
    .sig-pre { font-family: var(--font-mono, "SF Mono", ui-monospace, monospace); font-size: 13px; line-height: 1.45; margin: 0; white-space: pre; background: none; border: none; padding: 0; text-align: left; }
    .sh { color: var(--brand, #7b2d2d); }
    .sm { color: rgba(20,19,18,.42); }
    .sig-label { font-family: var(--font-body, "DM Sans", sans-serif); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted, rgba(20,19,18,.4)); font-weight: 600; }
    .sig-tagline { font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif); font-size: clamp(14px, 2vw, 18px); font-style: italic; color: var(--muted, rgba(20,19,18,.5)); margin: 0; }

    /* Contact object animations */
    .con-env   { display: block; animation: conEnv   2.4s ease-in-out infinite; }
    .con-msg   { display: block; animation: conMsg   3s   ease-in-out infinite; }
    .con-dot   { display: block; animation: conDot   1.6s ease-in-out infinite; }
    .con-write { display: block; animation: conWrite 2s   step-end   infinite; }
    .con-cup   { display: block; animation: conCup   4s   ease-in-out infinite; }

    @keyframes conEnv   { 0%,100%{opacity:1}  50%{opacity:.5} }
    @keyframes conMsg   { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-3px)} }
    @keyframes conDot   { 0%,100%{opacity:0}  50%{opacity:1} }
    @keyframes conWrite { 0%,60%,100%{opacity:1} 65%{opacity:.2} }
    @keyframes conCup   { 0%,100%{transform:scale(1)} 50%{transform:scale(1.15)} }

    /* ── Contact layout ────────────────────────────────────────── */
    .contact-wrap {
      max-width: 980px;
      margin: 0 auto;
      padding: 40px 24px 80px;
      color: rgba(20,20,20,.92);
    }
    .contact-head { text-align: center; margin-bottom: 28px; }
    .kicker {
      letter-spacing: .22em;
      font-size: 11px;
      text-transform: uppercase;
      color: var(--muted, rgba(20,19,18,.5));
      margin-bottom: 14px;
      font-weight: 600;
    }
    .headline {
      font-size: clamp(44px, 5vw, 80px);
      line-height: .96;
      margin: 0 0 10px;
      font-weight: 700;
      letter-spacing: -.04em;
    }
    .subhead {
      margin: 0 auto;
      max-width: 520px;
      font-size: 16px;
      line-height: 1.65;
      color: rgba(20,20,20,.65);
    }

    .contact-card {
      margin: 34px auto 0;
      max-width: 720px;
      background: rgba(255,255,255,.62);
      border: 1px solid rgba(30,30,30,.14);
      border-radius: 20px;
      box-shadow: 0 18px 40px rgba(20,20,20,.08), inset 0 1px 0 rgba(255,255,255,.65);
      backdrop-filter: blur(8px);
      padding: 6px;
    }
    .contact-card a, .contact-card a:visited { color: inherit !important; text-decoration: none !important; }

    .contact-row {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px 20px;
      border-radius: 16px;
      transition: transform .15s ease, background .15s ease;
      position: relative;
    }
    .contact-row:hover { background: rgba(255,255,255,.55); transform: translateY(-2px); }
    .contact-row::after { content: "→"; position: absolute; right: 20px; top: 50%; transform: translateY(-50%); color: rgba(20,20,20,.45); font-size: 18px; }

    .glyph {
      width: 48px; height: 48px;
      display: grid; place-items: center;
      border-radius: 14px;
      background: rgba(245,241,232,.9);
      border: 1px solid rgba(30,30,30,.10);
      color: var(--brand, #7b2d2d);
      flex-shrink: 0;
    }
    .contact-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; padding-right: 28px; }
    .label { font-size: 11px; letter-spacing: .18em; color: rgba(20,20,20,.5); text-transform: uppercase; font-weight: 600; }
    .value { font-size: 20px; line-height: 1.2; font-weight: 600; color: rgba(20,20,20,.9); word-break: break-word; }
    .divider { height: 1px; margin: 0 20px; background: rgba(20,20,20,.08); }
    .fineprint { text-align: center; margin: 14px 0 0; font-size: 11px; letter-spacing: .14em; color: rgba(20,20,20,.45); text-transform: uppercase; }

    @media (max-width: 560px) {
      .contact-wrap { padding: 24px 16px 60px; }
      .value { font-size: 17px; }
      .sig-chars { gap: 20px; }
      .sig-pre { font-size: 11px; }
    }
  </style>
</BaseLayout>

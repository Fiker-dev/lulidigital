---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Contact — LuliDigital">
  <header class="masthead" data-reveal>
    <div class="masthead-topline">LULIDIGITAL TIMES • EDITION 001</div>
    <h1 class="brand"><span class="brand-word">LuliDigital</span></h1>
    <div class="brand-sub">CONTACT</div>

    <nav class="nav">
      <a href="/" class="nav-link">HOME</a>
      <a href="/marketing" class="nav-link">MARKETING</a>
      <a href="/ai" class="nav-link">AI</a>
      <a href="/contact" class="nav-link is-active">CONTACT</a>
    </nav>

    <div class="rule"></div>
  </header>

  <main class="page">
    <section class="contact" data-reveal>
      <h2 class="big-cta">Be smart. Get help. you can also contact us :)</h2>

      <div class="contact-grid">
        <div class="contact-item">
          <div class="kicker">EMAIL</div>
          <a class="editorial-link" href="mailto:info@lulidigital.co.za">info@lulidigital.co.za →</a>
        </div>

        <div class="contact-item">
          <div class="kicker">WHATSAPP</div>
          <a class="editorial-link" href="https://wa.me/27602551513" target="_blank">+27 60 255 1513 →</a>
        </div>
      </div>
    </section>
  </main>
</MainLayout>
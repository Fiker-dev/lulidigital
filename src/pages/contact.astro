---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="Contact LuliDigital | Virtual Assistant Desk, Marketing & AI Services"
  description="Contact LuliDigital for Virtual Assistant Desk support, digital marketing, SEO, paid media, brand strategy, and AI automation services."
  active="contact"
>
  <section class="contact-invite" aria-labelledby="contact-title">
    <div class="invite-copy">
      <p class="invite-pill">Coffee with honey?</p>
      <header class="contact-head">
        <div class="kicker">You are invited</div>
        <div class="headline-row">
          <h1 id="contact-title" class="headline">Come sit with us.</h1>
          <div class="desk-cup" aria-hidden="true">
            <span class="cup-steam cup-steam--one"></span>
            <span class="cup-steam cup-steam--two"></span>
            <span class="cup-steam cup-steam--three"></span>
            <span class="cup-rim" data-bee-rim></span>
            <span class="cup-coffee"></span>
            <span class="cup-body"></span>
            <span class="cup-handle"></span>
            <span class="cup-saucer"></span>
          </div>
        </div>
      </header>
      <p class="subhead">
        Bring the campaign, system, inbox, launch, or rough idea. We will bring a warm cup,
        a clear head, and a practical next step.
      </p>
      <div class="invite-actions" aria-label="Contact options">
        <a class="invite-btn invite-btn--primary" href="https://wa.me/27602551513" target="_blank" rel="noreferrer">
          WhatsApp the desk
        </a>
        <a class="invite-btn invite-btn--ghost" href="mailto:info@lulidigital.co.za">
          Email the desk
        </a>
      </div>
    </div>
  </section>

  <section class="contact-wrap" aria-label="Contact details">
    <div class="contact-card">
      <a class="contact-row" href="mailto:info@lulidigital.co.za">
        <span class="glyph" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="10" y="18" width="44" height="28" rx="3"></rect>
            <path d="M12 20l20 16L52 20"></path>
          </svg>
        </span>
        <span class="contact-text">
          <span class="label">Email the desk</span>
          <span class="value">info@lulidigital.co.za</span>
        </span>
      </a>

      <div class="divider"></div>

      <a class="contact-row" href="https://wa.me/27602551513" target="_blank" rel="noreferrer">
        <span class="glyph" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 10c6 6 8 10 6 14l-4 6c4 8 10 14 18 18l6-4c4-2 8 0 14 6l-6 8c-3 4-8 6-13 4C25 56 8 39 4 19c-2-5 0-10 4-13l8-6z"></path>
          </svg>
        </span>
        <span class="contact-text">
          <span class="label">WhatsApp the desk</span>
          <span class="value">+27 60 255 1513</span>
        </span>
      </a>
    </div>

  </section>

  <style>
    .headline { font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif); }
    .subhead, .label, .value, .fineprint, .kicker, .invite-pill, .invite-btn, .human-note {
      font-family: var(--font-body, "DM Sans", sans-serif);
    }

    .contact-invite {
      max-width: 1180px;
      margin: 0 auto;
      padding: clamp(52px, 8vw, 104px) 24px clamp(28px, 5vw, 58px);
      color: rgba(20, 20, 20, .92);
    }
    .invite-copy {
      max-width: 860px;
      margin: 0 auto;
      text-align: center;
    }
    .invite-pill {
      width: fit-content;
      margin: 0 auto 22px;
      padding: 9px 15px;
      border-radius: 999px;
      border: 1px solid rgba(196, 119, 0, .28);
      background: linear-gradient(135deg, rgba(255, 236, 173, .82), rgba(255, 255, 255, .54));
      box-shadow: 0 14px 28px rgba(196, 119, 0, .10);
      font-size: 12px;
      letter-spacing: .16em;
      text-transform: uppercase;
      font-weight: 800;
      color: #8f5200;
    }
    .contact-head { margin-bottom: 18px; }
    .kicker {
      letter-spacing: .22em;
      font-size: 11px;
      text-transform: uppercase;
      color: #9d6a16;
      margin-bottom: 16px;
      font-weight: 800;
    }
    .headline-row {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: clamp(8px, 1.4vw, 18px);
    }
    .headline {
      font-size: clamp(54px, 8vw, 112px);
      line-height: .92;
      margin: 0;
      font-weight: 800;
      letter-spacing: 0;
      max-width: 640px;
      text-wrap: balance;
    }
    .subhead {
      margin: 0 auto;
      max-width: 610px;
      font-size: clamp(17px, 1.5vw, 21px);
      line-height: 1.6;
      color: rgba(20, 20, 20, .68);
    }

    .desk-cup {
      position: relative;
      width: clamp(112px, 12vw, 160px);
      height: clamp(116px, 12vw, 166px);
      flex: 0 0 auto;
      transform: translate(-4px, 6px);
      filter: drop-shadow(0 24px 28px rgba(88, 43, 0, .16));
    }
    .cup-rim,
    .cup-coffee,
    .cup-body,
    .cup-handle,
    .cup-saucer {
      position: absolute;
      display: block;
    }
    .cup-body {
      left: 17%;
      right: 17%;
      bottom: 22%;
      height: 47%;
      border-radius: 9% 9% 38% 38% / 10% 10% 46% 46%;
      background:
        linear-gradient(90deg, rgba(255,255,255,.88), rgba(255,255,255,.18) 18%, transparent 34%),
        radial-gradient(ellipse at 34% 18%, rgba(255,255,255,.9), transparent 20%),
        linear-gradient(118deg, #fff5d6 0%, #f3c35d 32%, #d88118 67%, #9b4206 100%);
      border: 1px solid rgba(100, 46, 0, .22);
      box-shadow:
        inset 16px 6px 20px rgba(255,255,255,.46),
        inset -18px -12px 22px rgba(80, 32, 0, .24),
        inset 0 -8px 14px rgba(88, 36, 0, .12),
        0 16px 26px rgba(94, 43, 0, .16);
      z-index: 3;
    }
    .cup-body::before {
      content: "";
      position: absolute;
      left: 16%;
      right: 22%;
      top: 12%;
      height: 38%;
      border-radius: 50%;
      background: linear-gradient(90deg, rgba(255, 255, 255, .52), rgba(255, 255, 255, 0));
      transform: rotate(-13deg);
      pointer-events: none;
    }
    .cup-rim {
      left: 10%;
      right: 10%;
      bottom: 58.5%;
      height: 25%;
      border-radius: 50%;
      background:
        radial-gradient(ellipse at 50% 58%, rgba(62, 22, 2, .86) 0 38%, transparent 39%),
        linear-gradient(180deg, #fffaf0 0%, #f0c974 58%, #a84f06 100%);
      border: 1px solid rgba(100, 46, 0, .24);
      box-shadow:
        inset 0 8px 12px rgba(255,255,255,.78),
        inset 0 -7px 10px rgba(83, 33, 0, .18),
        0 5px 9px rgba(62, 25, 0, .12);
      z-index: 5;
    }
    .cup-rim::before {
      content: "";
      position: absolute;
      inset: 12% 9% 18%;
      border-radius: 50%;
      background:
        radial-gradient(ellipse at 34% 38%, rgba(255, 201, 94, .48), transparent 24%),
        radial-gradient(ellipse at 64% 52%, #4a1802 0%, #1c0700 72%);
      box-shadow: inset 0 2px 5px rgba(255, 209, 102, .24);
    }
    .cup-coffee {
      left: 19%;
      right: 19%;
      bottom: 65.5%;
      height: 10.5%;
      border-radius: 50%;
      background:
        radial-gradient(ellipse at 33% 38%, rgba(247, 174, 53, .82), transparent 23%),
        radial-gradient(ellipse at 72% 28%, rgba(255, 235, 174, .35), transparent 16%),
        radial-gradient(ellipse at 58% 48%, #5c2104, #1c0600 74%);
      box-shadow: inset 0 2px 4px rgba(255, 201, 95, .28);
      z-index: 6;
    }
    .cup-handle {
      right: 4%;
      bottom: 39%;
      width: 28%;
      height: 31%;
      border: clamp(8px, .8vw, 11px) solid rgba(184, 104, 8, .78);
      border-left: 0;
      border-radius: 0 999px 999px 0;
      box-shadow:
        inset -5px 1px 7px rgba(255,255,255,.42),
        4px 4px 10px rgba(73, 28, 0, .12);
      z-index: 2;
    }
    .cup-saucer {
      left: 4%;
      right: 4%;
      bottom: 13%;
      height: 21%;
      border-radius: 50%;
      background:
        radial-gradient(ellipse at 50% 34%, rgba(255,255,255,.88), transparent 33%),
        radial-gradient(ellipse at 50% 52%, rgba(145, 73, 0, .16), transparent 35%),
        linear-gradient(180deg, rgba(255, 250, 232, .98), rgba(216, 142, 20, .30));
      border: 1px solid rgba(117, 56, 0, .13);
      box-shadow:
        inset 0 -5px 10px rgba(96, 43, 0, .08),
        0 14px 24px rgba(85, 44, 0, .16);
      z-index: 1;
    }
    .cup-steam {
      position: absolute;
      bottom: 76.5%;
      width: 24px;
      height: 60px;
      border-radius: 999px;
      border-left: 3px solid rgba(108, 70, 28, .20);
      filter: blur(.2px);
      opacity: 0;
      animation: cupSteam 4.9s ease-in-out infinite;
      z-index: 2;
    }
    .cup-steam--one { left: 34%; }
    .cup-steam--two {
      left: 50%;
      height: 52px;
      animation-delay: .9s;
    }
    .cup-steam--three {
      left: 62%;
      height: 46px;
      animation-delay: 1.7s;
    }
    @keyframes cupSteam {
      0% { opacity: 0; transform: translate3d(0, 12px, 0) rotate(7deg) scale(.78); }
      28% { opacity: .72; }
      64% { opacity: .34; transform: translate3d(-6px, -18px, 0) rotate(-9deg) scale(1.02); }
      100% { opacity: 0; transform: translate3d(7px, -34px, 0) rotate(11deg) scale(1.16); }
    }

    .invite-actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 30px;
    }
    .invite-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      padding: 0 24px;
      border-radius: 999px;
      font-size: 12px;
      letter-spacing: .18em;
      text-transform: uppercase;
      font-weight: 900;
      text-decoration: none;
      transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
    }
    .invite-btn:hover { transform: translateY(-2px); }
    .invite-btn--primary {
      color: #fff;
      background: linear-gradient(135deg, #c87600, #8c340f);
      box-shadow: 0 18px 36px rgba(196, 119, 0, .24);
    }
    .invite-btn--ghost {
      color: #8f5200;
      border: 1px solid rgba(196, 119, 0, .55);
      background: rgba(255, 255, 255, .5);
    }
    .human-note {
      margin: 18px 0 0;
      font-size: 13px;
      color: rgba(20, 20, 20, .54);
    }

    .contact-wrap {
      max-width: 980px;
      margin: 0 auto;
      padding: 10px 24px 80px;
      color: rgba(20, 20, 20, .92);
    }
    .contact-card {
      margin: 0 auto;
      max-width: 720px;
      background: rgba(255, 255, 255, .62);
      border: 1px solid rgba(30, 30, 30, .14);
      border-radius: 20px;
      box-shadow: 0 18px 40px rgba(20, 20, 20, .08), inset 0 1px 0 rgba(255, 255, 255, .65);
      backdrop-filter: blur(8px);
      padding: 6px;
    }
    .contact-card a,
    .contact-card a:visited {
      color: inherit !important;
      text-decoration: none !important;
    }
    .contact-row {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px 20px;
      border-radius: 16px;
      transition: transform .15s ease, background .15s ease;
      position: relative;
    }
    .contact-row:hover { background: rgba(255, 255, 255, .55); transform: translateY(-2px); }
    .contact-row::after {
      content: "->";
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(20, 20, 20, .45);
      font-size: 18px;
    }
    .glyph {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      background: rgba(245, 241, 232, .9);
      border: 1px solid rgba(30, 30, 30, .10);
      color: var(--brand, #7b2d2d);
      flex-shrink: 0;
    }
    .contact-text {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
      padding-right: 34px;
    }
    .label {
      font-size: 11px;
      letter-spacing: .18em;
      color: rgba(20, 20, 20, .5);
      text-transform: uppercase;
      font-weight: 600;
    }
    .value {
      font-size: 20px;
      line-height: 1.2;
      font-weight: 600;
      color: rgba(20, 20, 20, .9);
      word-break: break-word;
    }
    .divider { height: 1px; margin: 0 20px; background: rgba(20, 20, 20, .08); }
    .fineprint {
      text-align: center;
      margin: 14px 0 0;
      font-size: 11px;
      letter-spacing: .14em;
      color: rgba(20, 20, 20, .45);
      text-transform: uppercase;
    }

    @media (prefers-reduced-motion: reduce) {
      .cup-steam,
      .cup-steam--three,
      .invite-btn,
      .contact-row {
        animation: none !important;
        transition: none !important;
      }
    }

    @media (max-width: 720px) {
      .contact-invite { padding: 34px 16px 22px; }
      .headline-row {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .headline { font-size: clamp(44px, 14vw, 64px); }
      .desk-cup {
        width: 132px;
        height: 136px;
        transform: none;
      }
      .subhead { font-size: 16px; }
      .invite-actions {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
        margin-top: 28px;
      }
      .invite-btn {
        width: 100%;
        min-height: 54px;
      }
      .contact-wrap { padding: 12px 16px 60px; }
      .value { font-size: 17px; }
      .contact-row {
        padding: 18px 14px;
        gap: 12px;
      }
      .contact-row::after { right: 14px; }
      .glyph {
        width: 44px;
        height: 44px;
      }
    }
  </style>
</BaseLayout>

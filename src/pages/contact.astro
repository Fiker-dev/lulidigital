---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="Contact LuliDigital | Virtual Assistant Desk, Marketing & AI Services"
  description="Contact LuliDigital for Virtual Assistant Desk support, digital marketing, SEO, paid media, brand strategy, and AI automation services."
  active="contact"
>
  <section class="contact-invite" aria-labelledby="contact-title" data-atmosphere="hero" data-hive-section>
    <div class="invite-copy">
      <p class="invite-pill">Coffee with honey?</p>
      <header class="contact-head">
        <div class="kicker">You are invited</div>
        <div class="headline-row">
          <h1 id="contact-title" class="headline">Come sit with us.</h1>
          <div class="desk-cup" aria-hidden="true">
            <span class="cup-steam cup-steam--one"></span>
            <span class="cup-steam cup-steam--two"></span>
            <span class="cup-steam cup-steam--three"></span>
            <span class="cup-steam cup-steam--four"></span>
            <span class="cup-rim" data-bee-rim>
              <span class="rim-glow"></span>
            </span>
            <span class="cup-coffee">
              <span class="crema-shimmer"></span>
            </span>
            <span class="cup-body">
              <span class="honey-drip"></span>
            </span>
            <span class="cup-handle"></span>
            <span class="cup-saucer">
              <span class="saucer-ring"></span>
            </span>
          </div>
        </div>
      </header>
      <p class="subhead">
        Bring the campaign, system, inbox, launch, or rough idea. We will bring a warm cup,
        a clear head, and a practical next step.
      </p>
      <div class="invite-actions" aria-label="Contact options">
        <a class="invite-btn invite-btn--primary" href="https://wa.me/27602551513" target="_blank" rel="noreferrer">
          WhatsApp the desk
        </a>
        <a class="invite-btn invite-btn--ghost" href="mailto:info@lulidigital.com">
          Email the desk
        </a>
      </div>
    </div>
  </section>

  <section class="contact-wrap" aria-label="Contact details" data-atmosphere="cta" data-hive-section>
    <div class="contact-card">
      <a class="contact-row" href="mailto:info@lulidigital.com">
        <span class="glyph" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="10" y="18" width="44" height="28" rx="3"></rect>
            <path d="M12 20l20 16L52 20"></path>
          </svg>
        </span>
        <span class="contact-text">
          <span class="label">Email the desk</span>
          <span class="value">info@lulidigital.com</span>
        </span>
      </a>

      <div class="divider"></div>

      <a class="contact-row" href="https://wa.me/27602551513" target="_blank" rel="noreferrer">
        <span class="glyph" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 10c6 6 8 10 6 14l-4 6c4 8 10 14 18 18l6-4c4-2 8 0 14 6l-6 8c-3 4-8 6-13 4C25 56 8 39 4 19c-2-5 0-10 4-13l8-6z"></path>
          </svg>
        </span>
        <span class="contact-text">
          <span class="label">WhatsApp the desk</span>
          <span class="value">+27 60 255 1513</span>
        </span>
      </a>
    </div>

  </section>

  <style>
    .headline { font-family: var(--font-display, "Fraunces", ui-serif, Georgia, serif); }
    .subhead, .label, .value, .fineprint, .kicker, .invite-pill, .invite-btn, .human-note {
      font-family: var(--font-body, "DM Sans", sans-serif);
    }

    .contact-invite {
      max-width: 1180px;
      margin: 0 auto;
      padding: clamp(52px, 8vw, 104px) 24px clamp(28px, 5vw, 58px);
      color: rgba(20, 20, 20, .92);
    }
    .invite-copy {
      max-width: 860px;
      margin: 0 auto;
      text-align: center;
    }
    .invite-pill {
      width: fit-content;
      margin: 0 auto 22px;
      padding: 9px 15px;
      border-radius: 999px;
      border: 1px solid rgba(196, 119, 0, .28);
      background: linear-gradient(135deg, rgba(255, 236, 173, .82), rgba(255, 255, 255, .54));
      box-shadow: 0 14px 28px rgba(196, 119, 0, .10);
      font-size: 12px;
      letter-spacing: .16em;
      text-transform: uppercase;
      font-weight: 800;
      color: #8f5200;
    }
    .contact-head { margin-bottom: 18px; }
    .kicker {
      letter-spacing: .22em;
      font-size: 11px;
      text-transform: uppercase;
      color: #9d6a16;
      margin-bottom: 16px;
      font-weight: 800;
    }
    .headline-row {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: clamp(8px, 1.4vw, 18px);
    }
    .headline {
      font-size: clamp(54px, 8vw, 112px);
      line-height: .92;
      margin: 0;
      font-weight: 800;
      letter-spacing: 0;
      max-width: 640px;
      text-wrap: balance;
    }
    .subhead {
      margin: 0 auto;
      max-width: 610px;
      font-size: clamp(17px, 1.5vw, 21px);
      line-height: 1.6;
      color: rgba(20, 20, 20, .68);
    }

    /* ── Cup container ─────────────────────────────────── */
    .desk-cup {
      position: relative;
      width: clamp(112px, 12vw, 164px);
      height: clamp(120px, 13vw, 172px);
      flex: 0 0 auto;
      transform: translate(-4px, 6px);
      filter: drop-shadow(0 28px 32px rgba(88, 43, 0, .20));
      animation: cupFloat 6s ease-in-out infinite;
    }
    .cup-rim,
    .cup-coffee,
    .cup-body,
    .cup-handle,
    .cup-saucer {
      position: absolute;
      display: block;
    }

    /* ── Cup body ───────────────────────────────────────── */
    .cup-body {
      left: 16%;
      right: 16%;
      bottom: 22%;
      height: 48%;
      border-radius: 8% 8% 36% 36% / 10% 10% 44% 44%;
      background:
        linear-gradient(100deg, rgba(255,255,255,.92) 0%, rgba(255,255,255,.14) 22%, transparent 38%),
        radial-gradient(ellipse at 30% 16%, rgba(255,255,255,.94), transparent 22%),
        linear-gradient(120deg, #fffae8 0%, #f5c96a 28%, #d98520 62%, #9b4206 100%);
      border: 1px solid rgba(100, 46, 0, .18);
      box-shadow:
        inset 18px 8px 22px rgba(255,255,255,.52),
        inset -20px -14px 24px rgba(80, 32, 0, .28),
        inset 0 -10px 16px rgba(88, 36, 0, .14),
        0 18px 30px rgba(94, 43, 0, .18);
      overflow: hidden;
      z-index: 3;
    }
    /* ceramic highlight ridge */
    .cup-body::before {
      content: "";
      position: absolute;
      left: 14%;
      right: 20%;
      top: 10%;
      height: 42%;
      border-radius: 50%;
      background: linear-gradient(110deg, rgba(255,255,255,.58), rgba(255,255,255,0));
      transform: rotate(-14deg);
      pointer-events: none;
    }

    /* ── Honey drip ─────────────────────────────────────── */
    .honey-drip {
      position: absolute;
      top: -6px;
      left: 44%;
      width: 8px;
      background: linear-gradient(180deg, rgba(245, 175, 12, .95) 0%, rgba(195, 110, 4, .85) 70%, rgba(195, 110, 4, 0) 100%);
      border-radius: 0 0 50% 50%;
      animation: honeyDrip 9s ease-in-out infinite;
      z-index: 4;
    }
    @keyframes honeyDrip {
      0%, 18%  { height: 0px; opacity: 0; }
      28%      { height: 26px; opacity: 1; }
      58%      { height: 38px; opacity: .9; }
      82%      { height: 44px; opacity: .7; }
      100%     { height: 44px; opacity: 0; }
    }

    /* ── Rim ────────────────────────────────────────────── */
    .cup-rim {
      left: 9%;
      right: 9%;
      bottom: 58%;
      height: 26%;
      border-radius: 50%;
      background:
        radial-gradient(ellipse at 50% 60%, rgba(56, 18, 2, .88) 0 36%, transparent 37%),
        linear-gradient(180deg, #fffdf4 0%, #f2cc7a 55%, #aa5208 100%);
      border: 1px solid rgba(100, 46, 0, .22);
      box-shadow:
        inset 0 10px 14px rgba(255,255,255,.82),
        inset 0 -8px 12px rgba(83, 33, 0, .20),
        0 6px 10px rgba(62, 25, 0, .14);
      z-index: 5;
      transition: box-shadow .5s ease;
    }
    /* inner coffee visible through rim opening */
    .cup-rim::before {
      content: "";
      position: absolute;
      inset: 14% 10% 20%;
      border-radius: 50%;
      background:
        radial-gradient(ellipse at 34% 38%, rgba(255, 201, 94, .52), transparent 26%),
        radial-gradient(ellipse at 66% 54%, #4a1802 0%, #1c0700 74%);
      box-shadow: inset 0 2px 6px rgba(255, 209, 102, .26);
    }
    /* golden rim glow when bee lands */
    .rim-glow {
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      background: transparent;
      box-shadow: 0 0 0 0 rgba(245, 175, 12, 0);
      transition: box-shadow .6s ease;
      pointer-events: none;
    }
    .desk-cup.bee-is-here .rim-glow {
      box-shadow:
        0 0 18px 6px rgba(245, 175, 12, .42),
        0 0 36px 10px rgba(245, 175, 12, .18);
    }
    .desk-cup.bee-is-here .cup-rim {
      box-shadow:
        inset 0 10px 14px rgba(255,255,255,.82),
        inset 0 -8px 12px rgba(83, 33, 0, .20),
        0 6px 10px rgba(62, 25, 0, .14),
        0 0 0 2px rgba(245, 175, 12, .5);
    }

    /* ── Coffee surface ─────────────────────────────────── */
    .cup-coffee {
      left: 18%;
      right: 18%;
      bottom: 65%;
      height: 11%;
      border-radius: 50%;
      background:
        radial-gradient(ellipse at 32% 36%, rgba(247, 180, 55, .84), transparent 24%),
        radial-gradient(ellipse at 70% 26%, rgba(255, 238, 178, .38), transparent 18%),
        radial-gradient(ellipse at 55% 50%, #5c2104, #1c0600 76%);
      box-shadow: inset 0 2px 5px rgba(255, 201, 95, .30);
      overflow: hidden;
      z-index: 6;
    }
    /* crema shimmer */
    .crema-shimmer {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: radial-gradient(ellipse at 44% 42%, rgba(255, 220, 120, .55) 0%, transparent 48%);
      animation: cremaShimmer 3.8s ease-in-out infinite;
    }
    @keyframes cremaShimmer {
      0%, 100% { opacity: .55; transform: scale(1) translateX(0); }
      50%       { opacity: .9; transform: scale(1.06) translateX(2px); }
    }

    /* ── Handle ─────────────────────────────────────────── */
    .cup-handle {
      right: 3%;
      bottom: 38%;
      width: 28%;
      height: 32%;
      border: clamp(9px, .9vw, 12px) solid rgba(192, 110, 10, .80);
      border-left: 0;
      border-radius: 0 999px 999px 0;
      box-shadow:
        inset -6px 2px 8px rgba(255,255,255,.46),
        5px 5px 12px rgba(73, 28, 0, .14);
      z-index: 2;
    }

    /* ── Saucer ─────────────────────────────────────────── */
    .cup-saucer {
      left: 3%;
      right: 3%;
      bottom: 12%;
      height: 22%;
      border-radius: 50%;
      background:
        radial-gradient(ellipse at 50% 32%, rgba(255,255,255,.90), transparent 34%),
        radial-gradient(ellipse at 50% 54%, rgba(145, 73, 0, .14), transparent 36%),
        linear-gradient(180deg, rgba(255, 252, 238, 1), rgba(218, 148, 24, .28));
      border: 1px solid rgba(117, 56, 0, .12);
      box-shadow:
        inset 0 -6px 12px rgba(96, 43, 0, .07),
        0 16px 28px rgba(85, 44, 0, .18);
      overflow: hidden;
      z-index: 1;
    }
    /* subtle coffee-ring stain */
    .saucer-ring {
      position: absolute;
      top: 28%;
      left: 24%;
      width: 30%;
      height: 56%;
      border-radius: 50%;
      border: 1px solid rgba(130, 60, 0, .13);
      background: transparent;
    }

    /* ── Steam ──────────────────────────────────────────── */
    .cup-steam {
      position: absolute;
      bottom: 77%;
      width: 9px;
      border-radius: 999px;
      background: rgba(255, 250, 240, .50);
      filter: blur(4px);
      opacity: 0;
      animation: cupSteam 5.2s ease-in-out infinite;
      z-index: 7;
    }
    .cup-steam--one  { left: 30%; height: 64px; }
    .cup-steam--two  { left: 46%; height: 54px; width: 8px; animation-delay: 1.1s; }
    .cup-steam--three{ left: 60%; height: 48px; width: 7px; animation-delay: 2.0s; }
    .cup-steam--four { left: 38%; height: 70px; width: 10px; animation-delay: .55s; }

    /* steam gets livelier when bee is here */
    .desk-cup.bee-is-here .cup-steam {
      animation-duration: 3s;
      background: rgba(255, 252, 230, .64);
    }

    @keyframes cupSteam {
      0%   { opacity: 0;   transform: translate3d(0, 10px, 0) scaleX(1) rotate(4deg); }
      22%  { opacity: .7; }
      52%  { opacity: .38; transform: translate3d(-7px, -20px, 0) scaleX(.7) rotate(-8deg); }
      80%  { opacity: .14; }
      100% { opacity: 0;   transform: translate3d(8px, -40px, 0) scaleX(.5) rotate(12deg); }
    }

    /* ── Float + wobble ─────────────────────────────────── */
    @keyframes cupFloat {
      0%, 100% { transform: translate(-4px, 6px); }
      50%       { transform: translate(-4px, 0px); }
    }
    @keyframes cupWobble {
      0%   { transform: translate(-4px, 6px) rotate(0deg); }
      18%  { transform: translate(-4px, 4px) rotate(-3deg); }
      36%  { transform: translate(-4px, 5px) rotate(2.5deg); }
      54%  { transform: translate(-4px, 4px) rotate(-1.5deg); }
      72%  { transform: translate(-4px, 5px) rotate(1deg); }
      100% { transform: translate(-4px, 6px) rotate(0deg); }
    }
    .desk-cup.cup-wobble {
      animation: cupWobble .55s ease, cupFloat 6s ease-in-out infinite .55s;
    }

    .invite-actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 30px;
    }
    .invite-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      padding: 0 24px;
      border-radius: 999px;
      font-size: 12px;
      letter-spacing: .18em;
      text-transform: uppercase;
      font-weight: 900;
      text-decoration: none;
      transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
    }
    .invite-btn:hover { transform: translateY(-2px); }
    .invite-btn--primary {
      color: #fff;
      background: linear-gradient(135deg, #c87600, #8c340f);
      box-shadow: 0 18px 36px rgba(196, 119, 0, .24);
    }
    .invite-btn--ghost {
      color: #8f5200;
      border: 1px solid rgba(196, 119, 0, .55);
      background: rgba(255, 255, 255, .5);
    }
    .human-note {
      margin: 18px 0 0;
      font-size: 13px;
      color: rgba(20, 20, 20, .54);
    }

    .contact-wrap {
      max-width: 980px;
      margin: 0 auto;
      padding: 10px 24px 80px;
      color: rgba(20, 20, 20, .92);
    }
    .contact-card {
      margin: 0 auto;
      max-width: 720px;
      background: rgba(255, 255, 255, .62);
      border: 1px solid rgba(30, 30, 30, .14);
      border-radius: 20px;
      box-shadow: 0 18px 40px rgba(20, 20, 20, .08), inset 0 1px 0 rgba(255, 255, 255, .65);
      backdrop-filter: blur(8px);
      padding: 6px;
    }
    .contact-card a,
    .contact-card a:visited {
      color: inherit !important;
      text-decoration: none !important;
    }
    .contact-row {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px 20px;
      border-radius: 16px;
      transition: transform .15s ease, background .15s ease;
      position: relative;
    }
    .contact-row:hover { background: rgba(255, 255, 255, .55); transform: translateY(-2px); }
    .contact-row::after {
      content: "->";
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(20, 20, 20, .45);
      font-size: 18px;
    }
    .glyph {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      background: rgba(245, 241, 232, .9);
      border: 1px solid rgba(30, 30, 30, .10);
      color: var(--brand, #7b2d2d);
      flex-shrink: 0;
    }
    .contact-text {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
      padding-right: 34px;
    }
    .label {
      font-size: 11px;
      letter-spacing: .18em;
      color: rgba(20, 20, 20, .5);
      text-transform: uppercase;
      font-weight: 600;
    }
    .value {
      font-size: 20px;
      line-height: 1.2;
      font-weight: 600;
      color: rgba(20, 20, 20, .9);
      word-break: break-word;
    }
    .divider { height: 1px; margin: 0 20px; background: rgba(20, 20, 20, .08); }
    .fineprint {
      text-align: center;
      margin: 14px 0 0;
      font-size: 11px;
      letter-spacing: .14em;
      color: rgba(20, 20, 20, .45);
      text-transform: uppercase;
    }

    @media (prefers-reduced-motion: reduce) {
      .cup-steam,
      .desk-cup,
      .crema-shimmer,
      .honey-drip,
      .invite-btn,
      .contact-row {
        animation: none !important;
        transition: none !important;
      }
    }

    @media (max-width: 720px) {
      .contact-invite { padding: 34px 16px 22px; }
      .headline-row {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .headline { font-size: clamp(44px, 14vw, 64px); }
      .desk-cup {
        width: 132px;
        height: 136px;
        transform: none;
      }
      .subhead { font-size: 16px; }
      .invite-actions {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
        margin-top: 28px;
      }
      .invite-btn {
        width: 100%;
        min-height: 54px;
      }
      .contact-wrap { padding: 12px 16px 60px; }
      .value { font-size: 17px; }
      .contact-row {
        padding: 18px 14px;
        gap: 12px;
      }
      .contact-row::after { right: 14px; }
      .glyph {
        width: 44px;
        height: 44px;
      }
    }
  </style>
</BaseLayout>

<script>
  const beeEl = document.getElementById("bee-guide");
  const cupEl = document.querySelector<HTMLElement>(".desk-cup");
  if (beeEl && cupEl) {
    const mo = new MutationObserver(() => {
      const landed = beeEl.classList.contains("is-cup-landed");
      if (landed && !cupEl.classList.contains("bee-is-here")) {
        cupEl.classList.remove("cup-wobble");
        void (cupEl as HTMLElement).offsetWidth;
        cupEl.classList.add("bee-is-here", "cup-wobble");
      } else if (!landed) {
        cupEl.classList.remove("bee-is-here", "cup-wobble");
      }
    });
    mo.observe(beeEl, { attributes: true, attributeFilter: ["class"] });
  }
</script>

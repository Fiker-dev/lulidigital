---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getWeeklyPageSeoTarget } from "../lib/seoAgent.js";

export const prerender = false;

const seoTarget = getWeeklyPageSeoTarget("/va-desk");

Astro.response.headers.set("Cache-Control", "s-maxage=604800, stale-while-revalidate=86400");

const serviceSchema = {
  "name": "Executive Virtual Assistant & Remote Operations Support Services",
  "serviceType": [
    "executive virtual assistant services",
    "remote executive assistant",
    "virtual assistant for founders",
    "virtual assistant for CEOs",
    "hire a virtual assistant",
    "online virtual assistant",
    "administrative support services",
    "inbox management services",
    "calendar management services",
    "project management virtual assistant",
    "remote admin support",
    "operations support services",
    "delegate business tasks",
    "virtual assistant for entrepreneurs",
    "AI executive assistant support",
    "human virtual assistant paired with AI",
  ],
  "description": "Executive virtual assistant services for founders, CEOs, and growing teams: remote admin support, inbox management, calendar control, project management, and operational follow-through — without the overhead of a full-time hire.",
};

const vaMarquee = [
  "Inbox Zero", "Calendar Cleared", "Follow-ups Sent", "Reports Filed",
  "Projects Tracked", "Meetings Scheduled", "Tasks Delegated", "Operations Handled",
  "Brief Prepared", "Deadlines Hit", "Stakeholders Aligned", "No Detail Missed",
];
---

<BaseLayout
  title="Executive Virtual Assistant Services for Founders & CEOs | LuliDigital"
  description="Executive virtual assistant services for founders, CEOs, and growing teams: remote admin support, inbox management, calendar control, project management, and operational follow-through without a full-time hire."
  active="virtual-assistant"
  seoTarget={seoTarget}
  serviceSchema={serviceSchema}
>

  <!-- ═══════════════════════════════════════════════════════ HERO -->
  <section class="va-hero" aria-label="Virtual Assistant services" data-bee-stop>
    <div class="va-desk-field" aria-hidden="true"></div>

    <div class="va-hero-split">
      <div class="va-hero-text">
        <span class="eyebrow va-eyebrow" data-blur-in>Executive Ops Desk</span>
        <h1 class="va-title" data-word-reveal>
          Executive support without the full-time overhead.
        </h1>
        <p class="va-sub" data-blur-in data-blur-delay="200">
          Dedicated remote support for founders and CEOs — inbox, calendar, operations, and projects handled so you can lead.
        </p>
        <div class="va-ctas" data-stagger data-stagger-gap="80">
          <a class="pill pill--filled magnetic" href="https://wa.me/27602551513">Hire your VA →</a>
          <a class="pill pill--outline magnetic" href="/ai-desk">AI Desk →</a>
        </div>
      </div>

      <!-- Animated task board character -->
      <div class="va-board" aria-hidden="true">
        <div class="vb-header">
          <span class="vb-dot vb-dot--r"></span>
          <span class="vb-dot vb-dot--y"></span>
          <span class="vb-dot vb-dot--g"></span>
          <span class="vb-title-bar">Today's Desk</span>
        </div>
        <div class="vb-tasks">
          <div class="vb-task vb-task--done" style="--ti:0">
            <span class="vb-check">✓</span>
            <span>Inbox cleared — 47 emails</span>
          </div>
          <div class="vb-task vb-task--done" style="--ti:1">
            <span class="vb-check">✓</span>
            <span>3 exec calls scheduled</span>
          </div>
          <div class="vb-task vb-task--done" style="--ti:2">
            <span class="vb-check">✓</span>
            <span>Q3 brief sent to team</span>
          </div>
          <div class="vb-task vb-task--active" style="--ti:3">
            <span class="vb-spinner"></span>
            <span>Weekly report — in progress</span>
          </div>
          <div class="vb-task vb-task--pending" style="--ti:4">
            <span class="vb-ring"></span>
            <span>Review invoice batch</span>
          </div>
        </div>
        <div class="vb-footer">
          <span class="vb-status-dot"></span>
          <span class="vb-status-text">VA active now</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════ MARQUEE -->
  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee-track">
      {[...vaMarquee, ...vaMarquee].map((item) => (
        <span class="marquee-item">{item}</span>
      ))}
    </div>
  </div>

  <section class="selling-point selling-point--va" aria-label="Human virtual assistant paired with AI selling point" data-reveal="up" data-bee-stop>
    <span class="eyebrow">Human + AI Support</span>
    <h2 class="selling-title">You get a human virtual assistant paired with an AI executive assistant.</h2>
    <p class="selling-copy">
      During the day, a real person keeps your inbox, calendar, projects, follow-ups, and operations moving with care.
      When the human sleeps, AI support can still answer, organise, route, and prepare the next step so your business
      does not go quiet just because the day ended.
    </p>
    <p class="selling-copy selling-copy--direct">
      Want to know how this would support your week? Talk to the desk and we will show you what can be delegated first.
    </p>
    <div class="selling-links">
      <a class="pill pill--filled magnetic" href="https://wa.me/27602551513">WhatsApp the desk</a>
      <a class="pill pill--outline magnetic" href="mailto:info@lulidigital.com">Email the desk</a>
    </div>
  </section>

  <!-- ════════════════════════ HUMAN + AI HONEYCOMB STORY -->
  <section class="delegation-section" aria-label="How human and AI assistant support work together" data-reveal="up" data-bee-stop>
    <div class="delegation-heading">
      <div>
        <span class="eyebrow">How Delegation Works</span>
        <h2 class="section-title">Human care and AI speed, working from the same hive.</h2>
      </div>
      <p>
        Your human assistant handles judgment, tone, relationships, and follow-through.
        AI helps prepare, sort, remind, draft, and keep the next step ready after hours.
      </p>
    </div>

    <div class="delegation-wrap">
      <div class="handoff-scene" aria-label="Bee moving between a human assistant and an AI assistant">
        <article class="handoff-cell handoff-cell--human">
          <div class="cartoon-assistant" aria-hidden="true">
            <svg class="assistant-anime" viewBox="0 0 220 220" role="img" aria-label="Premium anime style virtual assistant seated with a laptop">
              <defs>
                <linearGradient id="skinGlow" x1="0" x2="1" y1="0" y2="1">
                  <stop offset="0" stop-color="#ffd9bd"/>
                  <stop offset=".58" stop-color="#f4b28a"/>
                  <stop offset="1" stop-color="#d88861"/>
                </linearGradient>
                <linearGradient id="hairGlow" x1="0" x2="1" y1="0" y2="1">
                  <stop offset="0" stop-color="#120904"/>
                  <stop offset=".5" stop-color="#3a1d05"/>
                  <stop offset="1" stop-color="#7a4300"/>
                </linearGradient>
                <linearGradient id="jacketGlow" x1="0" x2="1" y1="0" y2="1">
                  <stop offset="0" stop-color="#211300"/>
                  <stop offset=".66" stop-color="#7a4300"/>
                  <stop offset="1" stop-color="#c98205"/>
                </linearGradient>
                <linearGradient id="chairGlow" x1="0" x2="1" y1="0" y2="1">
                  <stop offset="0" stop-color="#2c1a05"/>
                  <stop offset="1" stop-color="#8a5000"/>
                </linearGradient>
                <linearGradient id="laptopGlow" x1="0" x2="1" y1="0" y2="1">
                  <stop offset="0" stop-color="#fffdf4"/>
                  <stop offset=".7" stop-color="#f3efe7"/>
                  <stop offset="1" stop-color="#d8cfc0"/>
                </linearGradient>
              </defs>
              <ellipse cx="110" cy="198" rx="82" ry="13" fill="rgba(107,59,0,.16)"/>
              <path d="M61 96c0-39 21-67 55-67 32 0 53 26 53 67v60H61V96Z" fill="url(#chairGlow)" opacity=".26"/>
              <rect x="56" y="87" width="108" height="98" rx="30" fill="url(#chairGlow)"/>
              <path d="M54 124c-9-50 17-95 66-95 47 0 72 43 64 95l-15 47H69L54 124Z" fill="url(#chairGlow)" opacity=".34"/>
              <path d="M45 159c13-18 28-18 44-7" fill="none" stroke="#3f2300" stroke-width="11" stroke-linecap="round" opacity=".9"/>
              <path d="M175 159c-13-18-28-18-44-7" fill="none" stroke="#3f2300" stroke-width="11" stroke-linecap="round" opacity=".9"/>
              <path d="M88 183h45v17H88z" fill="#3f2300"/>
              <path d="M71 205h78" stroke="#3f2300" stroke-width="8" stroke-linecap="round"/>
              <path d="M62 94c0-43 23-76 58-76 34 0 57 30 57 76 0 32-13 65-31 80H94C75 157 62 126 62 94Z" fill="url(#hairGlow)"/>
              <path d="M76 88c0-34 17-56 43-56 27 0 44 22 44 56 0 32-19 57-44 57S76 120 76 88Z" fill="url(#skinGlow)"/>
              <path d="M76 84c15-4 31-16 44-34 12 17 28 26 42 31-3-31-20-49-43-49-25 0-41 20-43 52Z" fill="url(#hairGlow)"/>
              <path d="M72 95c-9 2-13 13-8 23 4 8 12 10 18 6" fill="url(#skinGlow)"/>
              <path d="M166 95c9 2 13 13 8 23-4 8-12 10-18 6" fill="url(#skinGlow)"/>
              <circle cx="76" cy="112" r="3.5" fill="#f5a41f"/>
              <circle cx="164" cy="112" r="3.5" fill="#f5a41f"/>
              <ellipse cx="103" cy="95" rx="7" ry="11" fill="#170c02"/>
              <ellipse cx="135" cy="95" rx="7" ry="11" fill="#170c02"/>
              <circle cx="106" cy="91" r="2.8" fill="#fff8df"/>
              <circle cx="138" cy="91" r="2.8" fill="#fff8df"/>
              <path d="M111 122c7 6 15 6 22 0" fill="none" stroke="#7a4300" stroke-width="4" stroke-linecap="round"/>
              <circle cx="91" cy="109" r="7" fill="rgba(245,164,31,.2)"/>
              <circle cx="149" cy="109" r="7" fill="rgba(245,164,31,.2)"/>
              <path d="M74 184c7-32 24-50 45-50s39 18 47 50H74Z" fill="url(#jacketGlow)"/>
              <path d="M108 138h24l-8 26h-8z" fill="#fff8df"/>
              <path d="M88 158c12 8 51 8 64 0" stroke="rgba(255,248,223,.5)" stroke-width="4" stroke-linecap="round"/>
              <path d="M74 160c-18 5-29 16-34 31" stroke="url(#skinGlow)" stroke-width="13" stroke-linecap="round"/>
              <path d="M164 160c18 5 29 16 34 31" stroke="url(#skinGlow)" stroke-width="13" stroke-linecap="round"/>
              <rect x="46" y="154" width="130" height="43" rx="9" fill="url(#laptopGlow)" stroke="rgba(107,59,0,.25)" stroke-width="2"/>
              <path d="M37 196h148" stroke="#d8cfc0" stroke-width="6" stroke-linecap="round"/>
              <circle cx="111" cy="175" r="7" fill="#f5a41f"/>
              <path d="M54 150c14-6 94-7 114 0" stroke="rgba(255,255,255,.55)" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </div>
          <span class="handoff-kicker">Human VA</span>
          <h3>Care, context, and follow-through.</h3>
          <p>Inbox, calendar, client tone, priorities, judgement calls, and the details that need a person.</p>
        </article>

        <div class="handoff-bridge" aria-hidden="true">
          <span class="bridge-line"></span>
          <svg class="bridge-bee" viewBox="0 0 96 72" aria-hidden="true">
            <g class="bridge-bee__wings">
              <ellipse cx="38" cy="18" rx="21" ry="12" fill="rgba(210,235,255,.72)" stroke="rgba(130,170,230,.42)" stroke-width="1"/>
              <ellipse cx="57" cy="19" rx="17" ry="10" fill="rgba(210,235,255,.58)" stroke="rgba(130,170,230,.42)" stroke-width="1"/>
            </g>
            <ellipse cx="42" cy="44" rx="23" ry="16" fill="#f5a41f"/>
            <rect x="23" y="31" width="10" height="26" rx="7" fill="rgba(20,10,0,.74)"/>
            <rect x="37" y="30" width="10" height="28" rx="7" fill="rgba(20,10,0,.74)"/>
            <rect x="51" y="32" width="8" height="24" rx="6" fill="rgba(20,10,0,.74)"/>
            <ellipse cx="42" cy="44" rx="23" ry="16" fill="none" stroke="#ffc94a" stroke-width="3" opacity=".18"/>
            <circle cx="68" cy="42" r="14" fill="#f5a41f"/>
            <circle cx="73" cy="37" r="5" fill="#130c04"/>
            <circle cx="74.5" cy="35.5" r="2" fill="#fff8df"/>
            <path d="M63 47 Q68 52 74 47" stroke="#130c04" stroke-width="1.8" fill="none" stroke-linecap="round"/>
            <path d="M12 46 L5 49" stroke="#130c04" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M66 29 Q63 17 60 9" stroke="#130c04" stroke-width="2" fill="none" stroke-linecap="round"/>
            <circle cx="60" cy="8" r="3.5" fill="#130c04"/>
            <path d="M72 29 Q75 17 80 10" stroke="#130c04" stroke-width="2" fill="none" stroke-linecap="round"/>
            <circle cx="80" cy="9" r="3.5" fill="#130c04"/>
          </svg>
          <span class="bridge-drip bridge-drip--one"></span>
          <span class="bridge-drip bridge-drip--two"></span>
        </div>

        <article class="handoff-cell handoff-cell--ai">
          <div class="ai-comb" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
          <span class="handoff-kicker">AI Support</span>
          <h3>Always ready with the next step.</h3>
          <p>Drafts, reminders, routing, summaries, task prep, and overnight support for repetitive work.</p>
        </article>
      </div>

      <div class="handoff-proof" aria-label="Human and AI support split">
        <span><strong>Human handles:</strong> trust, nuance, relationships.</span>
        <span><strong>AI handles:</strong> speed, memory, repeatable steps.</span>
        <span><strong>You get:</strong> cleaner days and fewer loose ends.</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ METRICS STRIP -->
  <div class="metrics-strip" aria-label="VA impact" data-reveal="up">
    <div class="metric-item">
      <span class="metric-num metric-word">Human care</span>
      <span class="metric-label">judgment, tone, follow-through</span>
    </div>
    <div class="metric-divider" aria-hidden="true"></div>
    <div class="metric-item">
      <span class="metric-num metric-word">AI backup</span>
      <span class="metric-label">reminders, drafts, routing</span>
    </div>
    <div class="metric-divider" aria-hidden="true"></div>
    <div class="metric-item">
      <span class="metric-num metric-word">Cleaner days</span>
      <span class="metric-label">fewer loose ends to chase</span>
    </div>
  </div>

  <!-- ══════════════════════════════════════════ SERVICE BENTO GRID -->
  <section class="va-services" aria-label="VA services" data-reveal="up" data-bee-stop>
    <span class="eyebrow">What We Handle</span>
    <div class="bento-grid" data-stagger data-stagger-gap="80">

      <article class="glow-card svc-card" data-tilt="7" data-reveal="float-l" data-reveal-delay="0">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:12px;height:100%">
          <div class="svc-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <h3 class="svc-title">Admin &amp; Operations</h3>
          <ul class="bento-list">
            <li style="--li-i:0">Inbox managed &amp; organised</li>
            <li style="--li-i:1">Calendar controlled &amp; optimised</li>
            <li style="--li-i:2">Follow-ups sent on schedule</li>
            <li style="--li-i:3">Reports prepared &amp; distributed</li>
          </ul>
          <p class="svc-footer">Quiet execution behind the scenes.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="drop" data-reveal-delay="100">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:12px;height:100%">
          <div class="svc-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
          </div>
          <h3 class="svc-title">Project Management</h3>
          <ul class="bento-list">
            <li style="--li-i:0">Timelines owned &amp; maintained</li>
            <li style="--li-i:1">Milestones tracked and hit</li>
            <li style="--li-i:2">Teams aligned without chasing</li>
            <li style="--li-i:3">Deliverables managed end-to-end</li>
          </ul>
          <p class="svc-footer">Nothing slips. Nothing gets lost.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="float-r" data-reveal-delay="200">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:12px;height:100%">
          <div class="svc-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 19-9-9 19-2-8-8-2z"/></svg>
          </div>
          <h3 class="svc-title">Marketing &amp; Content Support</h3>
          <ul class="bento-list">
            <li style="--li-i:0">Content created and scheduled</li>
            <li style="--li-i:1">Campaigns structured and briefed</li>
            <li style="--li-i:2">Social media managed</li>
            <li style="--li-i:3">Brand message distributed</li>
          </ul>
          <p class="svc-footer">Your message out. Consistently.</p>
        </div>
      </article>

      <article class="glow-card svc-card" data-tilt="7" data-reveal="pop" data-reveal-delay="300">
        <div class="tilt-layer" style="display:flex;flex-direction:column;gap:12px;height:100%">
          <div class="svc-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M7 8V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/><circle cx="12" cy="14" r="2"/></svg>
          </div>
          <h3 class="svc-title">AI &amp; Custom Tools</h3>
          <ul class="bento-list">
            <li style="--li-i:0">AI assistants built for your business</li>
            <li style="--li-i:1">Workflows automated end-to-end</li>
            <li style="--li-i:2">Tools tailored to your operations</li>
            <li style="--li-i:3">Systems that grow with your team</li>
          </ul>
          <p class="svc-footer">Built to work with you.</p>
        </div>
      </article>

    </div>
  </section>

  <!-- ══════════════════════════════ BOLD DARK STATEMENT -->
  <section class="bold-statement" aria-label="VA promise">
    <div class="bs-inner">
      <p class="bs-line" data-reveal="up" data-reveal-delay="0">Your time is finite.</p>
      <p class="bs-line bs-accent" data-reveal="up" data-reveal-delay="140">Delegate everything else.</p>
    </div>
    <div class="bs-reel" aria-hidden="true">
      <div class="bs-reel-track">
        <span class="bsr-word">Inbox</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Calendar</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Projects</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Follow-ups</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Reports</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Operations</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Inbox</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Calendar</span><span class="bsr-sep">—</span>
        <span class="bsr-word">Projects</span><span class="bsr-sep">—</span>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════ LIVE DESK FEED -->
  <div class="desk-feed" aria-hidden="true">
    <span class="df-badge"><span class="df-dot"></span>Live</span>
    <div class="df-track-wrap">
      <div class="df-track">
        {[
          "Inbox cleared — 47 emails handled this morning",
          "3 executive calls blocked and confirmed",
          "Weekly report prepared and sent to stakeholders",
          "Project timeline updated — milestones on track",
          "Follow-up sequence sent to 5 warm leads",
          "Deep work calendar blocks set — zero conflicts",
          "Invoice batch reviewed and filed",
          "Inbox cleared — 47 emails handled this morning",
          "3 executive calls blocked and confirmed",
          "Weekly report prepared and sent to stakeholders",
        ].map((item) => (
          <>
            <span class="df-item">{item}</span>
            <span class="df-sep" aria-hidden="true">·</span>
          </>
        ))}
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════ CTA -->
  <section class="va-cta-section" aria-label="Hire a virtual assistant" data-reveal="fade" data-bee-final>
    <h2 class="cta-title" data-blur-in>Hire your virtual assistant today.</h2>
    <p class="cta-sub" data-blur-in data-blur-delay="150">Side by side. So you don't carry it alone.</p>
    <div data-stagger data-stagger-gap="80" class="cta-links">
      <a class="pill pill--filled magnetic" href="https://wa.me/27602551513">WhatsApp us →</a>
      <a class="pill pill--outline magnetic" href="mailto:info@lulidigital.com">Email the desk →</a>
    </div>
  </section>

</BaseLayout>


<style>
  /* ── Hero ───────────────────────────────────────────────────── */
  .va-hero {
    --va-blue: var(--honey-dark, #6b3b00);
    --va-blue-soft: rgba(245,164,31,.18);
    --va-paper: #fff4c9;
    position: relative;
    overflow: hidden;
    padding: 88px 0 72px;
    isolation: isolate;
    background:
      radial-gradient(circle at 76% 18%, rgba(255,212,90,.28), transparent 30%),
      linear-gradient(115deg, rgba(245,164,31,.2), transparent 42%),
      linear-gradient(180deg, rgba(255,248,223,.62), transparent 76%);
  }
  .va-desk-field {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(30deg, transparent 34%, rgba(182,109,0,.18) 35%, rgba(182,109,0,.18) 36%, transparent 37%) 0 0 / 54px 94px,
      linear-gradient(150deg, transparent 34%, rgba(182,109,0,.13) 35%, rgba(182,109,0,.13) 36%, transparent 37%) 0 0 / 54px 94px,
      radial-gradient(circle at 18% 24%, rgba(245,164,31,.24), transparent 28%);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .va-desk-field::after {
    content: "";
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 14%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(245,164,31,.72), transparent);
    animation: deskSweep 4.8s ease-in-out infinite;
  }
  @keyframes deskSweep {
    0%,100% { transform: translateY(0); opacity: .25; }
    50% { transform: translateY(-26px); opacity: .7; }
  }
  .va-eyebrow { color: var(--va-blue); }

  .va-hero-split {
    display: grid;

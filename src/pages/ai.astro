---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="AI Desk — LuliDigital">
  <header class="masthead" data-reveal>
    <div class="masthead-topline">LULIDIGITAL TIMES • EDITION 001</div>
    <h1 class="brand"><span class="brand-word">LuliDigital</span></h1>
    <div class="brand-sub">AI DESK</div>

    <nav class="nav">
      <a href="/" class="nav-link">HOME</a>
      <a href="/marketing" class="nav-link">MARKETING</a>
      <a href="/ai" class="nav-link is-active">AI</a>
      <a href="/contact" class="nav-link">CONTACT</a>
    </nav>

    <div class="rule"></div>
  </header>

  <main class="page">
    <section class="simple" data-reveal>
      <div class="kicker">AI DESK</div>
      <h2 class="headline">Automation that stays human.</h2>
      <p class="body">
        We build assistants, agents, and workflows that reduce busywork and keep teams aligned.
      </p>
    </section>
  </main>
</MainLayout>
---
import BaseLayout from "../layouts/BaseLayout.astro";

const serviceSchema = {
  "name": "AI Automation, Conversational AI & Agent Implementation Services",
  "serviceType": [
    "AI automation services",
    "AI workflow automation",
    "conversational AI assistant",
    "AI agent implementation",
    "business process automation",
    "AI integration services",
    "custom AI chatbot development",
    "intelligent automation services",
    "AI automation for business",
    "custom AI assistant development",
    "AI automation for SMB",
    "enterprise AI automation",
  ],
  "description": "LuliDigital builds AI automation systems for business: conversational AI assistants, AI workflow automation, and custom agent implementation. Practical AI integration for executives and growing teams — shipped in weeks.",
};
---

<BaseLayout
  title="AI Automation Services, Conversational AI & Agent Implementation | LuliDigital"
  description="LuliDigital builds AI automation systems for business: conversational AI assistants, AI workflow automation, and AI agent implementation. Practical AI integration for executives and growing teams — shipped in weeks."
  active="ai"
  serviceSchema={serviceSchema}
>

  <!-- ═══════════════════════════════════════════════════════ HERO -->
  <section class="ai-hero" aria-label="AI services">
    <div class="hero-orb orb-a" aria-hidden="true"></div>
    <span class="eyebrow" data-blur-in>AI Desk</span>
    <h1 class="ai-title" data-word-reveal>
      AI automation that ships in weeks, not months.
    </h1>
    <p class="ai-sub" data-blur-in data-blur-delay="200">
      Conversational AI assistants, workflow automation, and agent implementation —
      practical, managed, and live without the enterprise overhead.
    </p>
    <div class="ai-hero-ctas" data-stagger data-stagger-gap="80">
      <a class="cta-link" href="https://wa.me/27602551513">Talk to us <span class="arr">→</span></a>
      <a class="cta-link" href="/marketing">Marketing Desk <span class="arr">→</span></a>
    </div>
  </section>

  <!-- ════════════════════════════════════════ ASCII WORKFLOW DIAGRAM -->
  <section class="diagram-section" aria-label="How AI works for your business" data-reveal="up">
    <span class="eyebrow">How It Works</span>
    <h2 class="section-title">Your business. Smarter systems.</h2>

    <pre class="ascii-diagram" role="img" aria-label="AI workflow: Your business inputs go into AI processing which outputs answers, actions and reports">
  <span class="dim">YOUR BUSINESS</span>           <span class="dim">LANA AI</span>                 <span class="dim">OUTPUT</span>
  ┌───────────┐       ┌────────────────┐       ┌──────────┐
  │ <span class="hi">Question</span>  │ <span class="hi">────▶</span> │   <span class="hi">AI Process</span>   │ <span class="hi">────▶</span> │ <span class="hi">Answer</span>   │
  │ <span class="hi">Task</span>      │       │   <span class="hi">+ Memory</span>    │       │ <span class="hi">Action</span>   │
  │ <span class="hi">Data</span>      │       │   <span class="hi">+ Context</span>   │       │ <span class="hi">Report</span>   │
  └───────────┘       └────────────────┘       └──────────┘</pre>
  </section>

  <!-- ═══════════════════════════════════════════════ AI LOOP SVG -->
  <section class="loop-section" aria-label="The AI learning loop" data-reveal="up">
    <span class="eyebrow">The AI Loop</span>
    <h2 class="section-title">Always learning. Always on.</h2>

    <div class="loop-wrap">
      <svg class="loop-svg" viewBox="0 0 400 400" aria-label="Circular workflow showing Query, Process, Response and Learn stages connected in a loop">
        <defs>
          <marker id="arrowhead" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="rgba(123,45,45,.55)"/>
          </marker>
        </defs>
        <!-- Guide circle -->
        <circle cx="200" cy="200" r="130" fill="none" stroke="rgba(123,45,45,.1)" stroke-width="1" stroke-dasharray="4 6"/>
        <!-- Nodes -->
        <circle cx="200" cy="70"  r="44" fill="var(--paper-card,#f6f2ea)" stroke="rgba(123,45,45,.3)" stroke-width="1.5"/>
        <circle cx="330" cy="200" r="44" fill="rgba(123,45,45,.9)"        stroke="none"/>
        <circle cx="200" cy="330" r="44" fill="var(--paper-card,#f6f2ea)" stroke="rgba(123,45,45,.3)" stroke-width="1.5"/>
        <circle cx="70"  cy="200" r="44" fill="var(--paper-card,#f6f2ea)" stroke="rgba(123,45,45,.3)" stroke-width="1.5"/>
        <!-- Arrows -->
        <path d="M238 84 A130 130 0 0 1 316 162"  fill="none" stroke="rgba(123,45,45,.4)" stroke-width="1.5" marker-end="url(#arrowhead)"/>
        <path d="M330 244 A130 130 0 0 1 238 316" fill="none" stroke="rgba(123,45,45,.4)" stroke-width="1.5" marker-end="url(#arrowhead)"/>
        <path d="M162 316 A130 130 0 0 1 84 244"  fill="none" stroke="rgba(123,45,45,.4)" stroke-width="1.5" marker-end="url(#arrowhead)"/>
        <path d="M70 156 A130 130 0 0 1 162 84"   fill="none" stroke="rgba(123,45,45,.4)" stroke-width="1.5" marker-end="url(#arrowhead)"/>
        <!-- Labels -->
        <text x="200" y="65"  text-anchor="middle" dominant-baseline="middle" class="node-label">Query</text>
        <text x="330" y="195" text-anchor="middle" dominant-baseline="middle" class="node-label-inv">Process</text>
        <text x="200" y="325" text-anchor="middle" dominant-baseline="middle" class="node-label">Response</text>
        <text x="70"  y="195" text-anchor="middle" dominant-baseline="middle" class="node-label">Learn</text>
      </svg>
    </div>
  </section>

  <!-- ══════════════════════════════════════════ SERVICE BENTO GRID -->
  <section class="services-section" aria-label="AI services we build" data-reveal="up">
    <span class="eyebrow">What We Build</span>
    <div class="bento-grid" data-stagger data-stagger-gap="80">

      <article class="glow-card svc-card">
        <h3 class="svc-title">Conversational AI assistant</h3>
        <ul class="bento-list">
          <li>Customer questions answered 24/7</li>
          <li>Leads qualified, scored &amp; routed</li>
          <li>Follow-ups triggered automatically</li>
        </ul>
        <p class="svc-footer">Always on. Always on-brand.</p>
      </article>

      <article class="glow-card svc-card">
        <h3 class="svc-title">Internal AI agent</h3>
        <ul class="bento-list">
          <li>Contracts &amp; SOPs found in seconds</li>
          <li>Staff questions answered automatically</li>
          <li>Knowledge bases made queryable</li>
        </ul>
        <p class="svc-footer">Your team's second brain.</p>
      </article>

      <article class="glow-card svc-card bento-card--wide">
        <h3 class="svc-title">AI workflow automation</h3>
        <ul class="bento-list bento-list--cols">
          <li>Repetitive tasks automated end-to-end</li>
          <li>Reports generated &amp; distributed on schedule</li>
          <li>Approvals, routing &amp; follow-ups handled without input</li>
        </ul>
        <p class="svc-footer">Less manual work. More capacity.</p>
      </article>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════ FULL SERVICE LIST -->
  <section class="full-services" aria-label="Full list of AI services" data-reveal="up">
    <span class="eyebrow">All Services</span>
    <div class="bento-grid" data-stagger data-stagger-gap="60">
      {[
        { name: "AI workflow automation", desc: "End-to-end automation of repetitive business processes — reporting, routing, approvals, and follow-ups." },
        { name: "Conversational AI assistants", desc: "Custom AI chatbots trained on your business, deployed on your website, tools, or internal platforms." },
        { name: "AI agent implementation", desc: "Autonomous AI agents that execute multi-step tasks, make decisions, and move work forward without manual input." },
        { name: "Business process automation", desc: "Mapping, redesigning, and automating high-friction processes across operations, sales, and support." },
        { name: "AI integration services", desc: "Connecting AI systems to your existing tools — CRMs, inboxes, databases, and platforms." },
        { name: "Custom AI assistant development", desc: "Bespoke AI assistants built around your brand, knowledge base, and operational workflows." },
      ].map(({ name, desc }) => (
        <article class="glow-card mini-card">
          <h4 class="mini-title">{name}</h4>
          <p class="mini-desc">{desc}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════ CTA -->
  <section class="ai-cta" aria-label="Get started with AI" data-reveal="fade">
    <h2 class="cta-title" data-blur-in>Ready to automate?</h2>
    <p class="cta-sub">Most systems ship in 2–6 weeks.</p>
    <div data-stagger data-stagger-gap="80" class="cta-links">
      <a class="cta-link" href="https://wa.me/27602551513">Talk to the desk <span class="arr">→</span></a>
      <a class="cta-link" href="/virtual-assistant">Visit VA Desk <span class="arr">→</span></a>
    </div>
  </section>

</BaseLayout>


<style>
  /* ── Hero ───────────────────────────────────────────────────── */
  .ai-hero {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 88px 0 80px;
  }
  .orb-a { width: 500px; height: 500px; top: -80px; right: -160px; }
  .ai-title {
    font-size: clamp(36px, 5.5vw, 72px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -.035em;
    margin: 14px 0 20px;
    font-family: ui-serif, Georgia, serif;
    color: var(--ink, #141312);
    max-width: 780px;
    margin-left: auto;
    margin-right: auto;
  }
  .ai-sub {
    font-size: clamp(15px, 1.8vw, 18px);
    line-height: 1.65;
    color: var(--muted, rgba(20,19,18,.66));
    margin: 0 auto 32px;
    max-width: 560px;
  }
  .ai-hero-ctas { display: flex; justify-content: center; gap: 28px; flex-wrap: wrap; }

  /* ── Diagram ────────────────────────────────────────────────── */
  .diagram-section {
    padding: 72px 0 80px;
    border-top: 1px solid rgba(30,24,22,.1);
  }
  .diagram-section .ascii-diagram { margin: 24px 0; }

  /* ── AI Loop SVG ────────────────────────────────────────────── */
  .loop-section {
    padding: 72px 0 80px;
    border-top: 1px solid rgba(30,24,22,.1);
  }
  .loop-wrap { display: flex; justify-content: center; margin-top: 28px; }
  .loop-svg {
    width: 100%;
    max-width: 340px;
    height: auto;
    display: block;
  }
  .loop-svg .node-label {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 11px;
    fill: rgba(20,19,18,.8);
    letter-spacing: .08em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .loop-svg .node-label-inv {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 11px;
    fill: rgba(243,239,231,.92);
    letter-spacing: .08em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* ── Service cards ──────────────────────────────────────────── */
  .services-section {
    padding: 72px 0 80px;
    border-top: 1px solid rgba(30,24,22,.1);
  }
  .svc-card {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .svc-title {
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    margin: 0;
    letter-spacing: -.015em;
    font-family: ui-serif, Georgia, serif;
    line-height: 1.2;
    color: var(--ink, #141312);
  }
  .svc-footer {
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--brand, #7b2d2d);
    font-weight: 600;
    margin: 0;
    margin-top: auto;
  }
  .bento-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 7px; flex: 1; }
  .bento-list li { font-size: 13.5px; line-height: 1.55; color: var(--muted, rgba(20,19,18,.66)); padding-left: 14px; position: relative; }
  .bento-list li::before { content: "–"; position: absolute; left: 0; color: var(--brand, #7b2d2d); opacity: .55; }
  .bento-list--cols { columns: 2; gap: 16px; display: block; }
  .bento-list--cols li { break-inside: avoid; }

  /* ── Full services ──────────────────────────────────────────── */
  .full-services {
    padding: 72px 0 80px;
    border-top: 1px solid rgba(30,24,22,.1);
  }
  .mini-card { padding: 24px 22px; display: flex; flex-direction: column; gap: 10px; }
  .mini-title {
    font-size: 15px;
    font-weight: 700;
    margin: 0;
    letter-spacing: -.01em;
    color: var(--ink, #141312);
  }
  .mini-desc {
    font-size: 13px;
    line-height: 1.65;
    color: var(--muted, rgba(20,19,18,.62));
    margin: 0;
  }

  /* ── CTA ────────────────────────────────────────────────────── */
  .ai-cta {
    text-align: center;
    padding: 80px 0 40px;
    border-top: 1px solid rgba(30,24,22,.1);
  }
  .cta-title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 700;
    letter-spacing: -.03em;
    margin: 0 0 10px;
    font-family: ui-serif, Georgia, serif;
  }
  .cta-sub { font-size: 15px; color: var(--muted, rgba(20,19,18,.62)); margin: 0 0 28px; }
  .cta-links { display: flex; justify-content: center; gap: 28px; flex-wrap: wrap; }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 600px) {
    .ai-hero { padding: 60px 0 60px; }
    .diagram-section .ascii-diagram { font-size: 9px; padding: 18px 14px; }
    .bento-list--cols { columns: 1; }
  }
</style>
